  p = 0; wp_puts(b, &p, "renders     "); wp_puti(b, &p, wp_frames); wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c)); y = y + WP_ROW;

  p = 0; wp_puts(b, &p, "pump loops  "); wp_puti(b, &p, wp_loops); wp_end(b, &p);
