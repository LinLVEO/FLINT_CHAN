  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c)); y = y + WP_ROW;

  p = 0; wp_puts(b, &p, "refresh     "); wp_puti(b, &p, WP_REFRESH_MS); wp_puts(b, &p, " ms"); wp_end(b, &p);
