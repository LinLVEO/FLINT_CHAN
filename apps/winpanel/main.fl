int wp_layer_state = 0;         // the four-state verdict of the last sample (WP_LAY_*)
int wp_zcover = 0;              // 1 = a visible non-minimized window above us overlaps our rect (v7)
int wp_cover_h = 0;             // v7 (M7): the handle of that window, 0 = exposed
// v8 (M8): the hotkey claim and the peek state. `peek` = the user is holding the chord right now,
// `latch` = `top` was locked while peeking (so it stays after the keys are released).
int wp_hk_ok = 0;               // 1 = we really hold an exclusive combo
int wp_hk_vk = 0;               // ...and which VK it is (0 = none available)
int wp_hk_which = -1;           // index into the candidate chain (-1 = none)
