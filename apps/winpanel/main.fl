  if (wp_hit_repaint(wp_btn(c, wp_cx, y, WP_PROBE_W, WP_NAVBTN_H, "Probe")) == 1) { wp_start_probe(); }
  wp_btn_label(c, wp_cx, y, WP_PROBE_W, WP_NAVBTN_H, "Probe", wp_ctext(c));
