  wp_puti(out, &p, wp_fgv_t); wp_puts(out, &p, ","); wp_puti(out, &p, wp_fgv_r); wp_puts(out, &p, ",");
  wp_puti(out, &p, wp_fgv_b); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fg_overlap="); wp_puti(out, &p, wp_fg_owns_spot(WP_X, WP_Y, WP_X + WP_W, WP_Y + WP_H));
  wp_puts(out, &p, "\n");
  // the same question as the DECISION asks it (self excluded, visible, not minimized)
  wp_puts(out, &p, "fg_owns_spot=");
  wp_puti(out, &p, wp_fg_owns_spot(WP_X, WP_Y, WP_X + WP_W, WP_Y + WP_H)); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fg_pid_query="); wp_puti(out, &p, wp_fg_pid_query(wp_fgv_h)); wp_puts(out, &p, "\n");
  // the same question asked the OTHER way: the pid must not depend on which of the two legal ways of
