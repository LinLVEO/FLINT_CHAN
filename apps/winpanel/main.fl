  // ---- v8 (M8): the hotkey claim and the peek state ---------------------------------------------
  // The judge reads these to learn WHICH combo to inject (so no key is hard-coded in the judge) and
  // then proves the claim is real by trying the same combo from its own process (expect 1409).
  wp_puts(out, &p, "hk_ok="); wp_puti(out, &p, wp_hk_ok); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "hk_which="); wp_puti(out, &p, wp_hk_which); wp_puts(out, &p, "\n");
