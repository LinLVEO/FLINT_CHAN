int wp_hk_probe_fail = 0;       // how many candidates were refused (== WP_HK_N means hk none)
int wp_peek = 0;                // 1 = the hold-to-peek is active on this frame
int wp_peek_latch = 0;          // 1 = `top` locked while peeking
