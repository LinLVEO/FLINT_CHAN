  wp_puts(out, &p, "ring_drop="); wp_puti(out, &p, WP_RING_DROP); wp_puts(out, &p, "\n");
  // the same verdict function the window loop uses, applied to the recorded raw flags: the self-check
  // can therefore recompute `layer` from `zcover`/`topbit` and never has to trust this line.
  wp_layer_state = wp_layer_of(wp_iconic, wp_topbit, wp_zcover);
  // the layer: `layer` is the four-state verdict, `zcover` the raw cover flag, `topbit` the raw
  // WS_EX_TOPMOST bit, `layer_mode` the selector the user set (0 top / 1 normal / 2 auto).
  wp_puts(out, &p, "layer="); wp_puts(out, &p, wp_layer_word(wp_layer_state)); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "zcover="); wp_puti(out, &p, wp_zcover); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "topbit="); wp_puti(out, &p, wp_topbit); wp_puts(out, &p, "\n");
