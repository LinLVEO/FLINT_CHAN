  // ---- v6 (A/B/C): the three things this round added, each as its OWN field ---------------------
  // The self-check recomputes every one of these from main.fl's constants (the two alpha formulas)
  // or from the window itself (the layer verdict); nothing here is trusted as truth.
  wp_puts(out, &p, "pct="); wp_puti(out, &p, wp_pct); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fill_a="); wp_puti(out, &p, wp_filla); wp_puts(out, &p, "\n");
