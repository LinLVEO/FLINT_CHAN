int wp_opa = 0;                 // the alpha the last painted frame asked the window layer for
// v6 (A): the percent that same frame settled on, and the two per-pixel alphas it drove from it --
// reported in the dump so the self-check can recompute them from main.fl's own constants.
int wp_pct = 0;
int wp_filla = 0;
int wp_ringa = 0;
// v6 (B/C) state
