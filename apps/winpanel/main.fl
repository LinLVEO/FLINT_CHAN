// main.fl -- winpanel v4: 1024x736 (= 2.5x v3's AREA), a SECONDARY Settings page whose FLGUI
// opacity slider really drives the whole-window alpha, and a FOURTH nav tab (Startup) that really
// reads the two registry Run keys with four read-only advapi32 entries (zero write entries).
//
// Lineage (every round kept its predecessor's evidence alive):
//   v1 (git 9c127f1) drew straight into the window DC every ~16 ms -> the user reported flicker.
//   v2 (git be3a040) moved the whole frame onto the FLGUI four-step protocol (gui_begin -> command
//        stream -> gui_end -> render the WHOLE frame into one offscreen DIB -> a single
//        gui_win_show). That killed the flicker (0 of 66 sampled frames differed, vs 19..34 for v1
//        under the same ruler) but it uploaded ~64 frames/s forever, measured at ~51.8% of one core
//        while idle -- almost all of it the library's per-pixel alpha.
//   v3 (git 105ea7c) grew to 640x460, made blue-white the default theme with a Theme toggle, and
//        rendered/uploaded only when something on screen really changed (idle = 0 uploads, 0 ms).
//   v4 (this file) keeps every v3 contract byte for byte in behaviour and adds:
//     1. 1024x736 = 2.5x v3's AREA (linear x1.6: font 16->20, title 32->40, bottom 26->32,
//        nav 132->176). That is the work order's own reading of "2.5x bigger"; linear 2.5 would be
//        1600x1150 whose height 1150 > this machine's 1080 screen. Every number below is a
//        single-point constant and the self-check recomputes every rectangle from THESE literals.
//     2. a secondary page: the title bar's Setup button opens a Settings page that covers the
//        content area (the nav column stays live, so the tabs still work) and contains the FLGUI
//        slider widget, a live "Opacity <n>" label and a Back button. The current value lives in
//        the FLGUI STATE POOL (id = gui_hash("winpanel.opacity")), so it survives frames, and it
//        drives the whole-window constant alpha (Surf.const_a / BLENDFUNCTION.Alpha -- the knob v3
//        had fixed at 236). Dragging is input, so the frame is repainted on the spot; v3's idle
//        rule (paint only when something changed) is untouched.
//     3. a fourth nav tab, Startup, that reads the VALUE NAMES of
//        HKCU\Software\Microsoft\Windows\CurrentVersion\Run and its HKLM twin. Four read-only
//        advapi32 entries are used (open / enumerate / size-query / close) and there is no write
//        entry anywhere in this file: the self-check counts the three write names in this source
//        and requires 0. A key that cannot be opened degrades to "unavailable" and the app exits 0.
//
// Build: E:\FLINT-lab\flint.exe E:\FLINT-lab\apps\winpanel\main.fl -gui -o <same dir>\winpanel.exe
// Switches (same channels as v1..v3; all optional, all inside the app dir):
//   panel.dump  exists -> headless: no window, write the text report, exit 0
//   panel.src   first line = snapshot path override (how the "missing data" case is tested)
//   panel.ports exists -> port list file is authoritative (zero sockets at all)
//   panel.reg   line 1 / line 2 = HKCU / HKLM subkey override (how the "key does not exist"
//               degradation path is tested against a subkey that really is not there)
//   tmp\winpanel\fps.on exists -> write the cumulative ledger loops/renders/tick (diagnostic)
// Absolute paths are deliberate: these are the contracts of the self-check script, not user config.
include "flgui_win32.fl"
include "io_lib.fl"
include "http_lib.fl"

// The only two api lines this app adds for the data side: the transcode pair. GetTickCount comes in
// with flgui_win32.fl; all socket/file/ui entries come in with the three libs above.
api kernel32 int MultiByteToWideChar(int, int, int, int, int, int);
api kernel32 int WideCharToMultiByte(int, int, int, int, int, int, int, int);

// ===== v6 (B/C): the window-layer probe and the real minimize -- all user32 =====================
// Eight entries, all of them user32 (so the module count cannot grow):
//   SetWindowPos     : the layer switch itself (z-order only: NOMOVE|NOSIZE|NOACTIVATE = 0x13)
//   GetWindowLongA   : GWL_EXSTYLE (-20) -> is the WS_EX_TOPMOST bit (0x8) really set?
//   FindWindowA      : the handle of Shell_TrayWnd, used as a POSITIVE hWndInsertAfter anchor
//   IsIconic         : the real-minimize gate (stop building and flushing frames while iconic)
//   SetWindowLongA   : WS_EX_APPWINDOW (0x40000) at startup, so the panel owns a taskbar button
//   GetWindow        : v7 (M7) GW_HWNDPREV(3) -- walk upwards in the z-order
//   IsWindowVisible  : v7 (M7) -- a cover candidate must be visible (and not minimized)
// v6 also declared WindowFromPoint here for the cover verdict; v7 REMOVED that declaration. Measured
// 2026-10-10 (tmp\m7\zprobe-run.txt / hit-probe-run.txt / clickthrough-run.txt): while the panel was
// topmost, painted and really receiving clicks, every WindowFromPoint probe answered about
// explorer's DESKTOP window -- it never said "mine", so the verdict was pinned at "covered".
// WHY FindWindowA and not HWND_TOPMOST(-1)/HWND_NOTOPMOST(-2): those two constants are NEGATIVE and
// the compiler's codegen zero-extends a negative immediate on its way into a pointer-width argument
// (measured: tmp\m6\api-negs.fl disassembles to "mov eax,0; sub eax,2" -> rdx = 0x00000000FFFFFFFE),
// so the kernel sees an invalid handle and answers SetWindowPos with error 1400. Inserting after a
// system TOPMOST window (the tray) has the same documented effect and uses a POSITIVE handle. The
// measured evidence for both halves is in tmp\m6\ (layerps-tray-run.txt, api-negs-run.txt).
api user32 int SetWindowPos(int, int, int, int, int, int, int);
api user32 int GetWindowLongA(int, int);
api user32 int FindWindowA(int, int);
api user32 int IsIconic(int);
api user32 int SetWindowLongA(int, int, int);
api user32 int GetWindow(int, int);
api user32 int IsWindowVisible(int);
// ===== v10 (M12): the FOREGROUND-driven `auto` rule -- TWO new entries, all user32 ===============
//   GetForegroundWindow : whose window is in front for the USER right now. This is what the user
//                         asked for (2026-10-11: "I still need to be able to cover it with the
//                         FOCUSED window"). The old rule was driven by a freshly started window and
//                         by the z-order walk above us, which cannot tell "the user just brought that
//                         window up" from "that window has been parked there for an hour". An
//                         already-open window that the user clicks becomes the foreground window
//                         even when the z-order does not change, so the foreground is the only
//                         signal that answers the question the user actually asked. Import ledger:
//                         81 -> 83 entries with GetWindowThreadProcessId below, still 7 modules
//                         (user32 was already imported), cap 96.
api user32 int GetForegroundWindow();
//   GetWindowThreadProcessId : the process a window handle belongs to. The user asked for it by
//                         name (2026-10-11: "add enough foreground readings for the judge, e.g.
//                         fg_pid / fg_overlap / fg_is_self"), and it is what makes those readings
//                         cross-checkable from OUTSIDE the app: the judge can ask the OS for the
//                         foreground window's pid itself and compare. Import ledger: +1 entry.
api user32 int GetWindowThreadProcessId(int, int);
// ===== v13 (M14): "does this press belong to the panel?" -- ZERO new imports =====================
// The obvious ruler here is WindowFromPoint, and it is deliberately NOT used: it takes its POINT
// **by value** (an 8-byte struct in one register), while this toolchain's api parameters can only be
// declared `int` (32-bit, sign-extended into the argument register -- SPEC's api grammar), and the
// integer type itself wraps at 32 bits. Measured in tmp\m14\wp-abi.fl: packing x into the low half and
// y into the high half produced 960 instead of 540*2^32+960, and passing a POINTER to the struct
// answered 0. So the same question is answered with the ruler this app already trusts (M7's
// GW_HWNDPREV walk plus GetWindowRect): see wp_press_is_mine() below. No import is added by that.

// ===== v8 (M8): the hold-to-peek / lock-to-top hotkey -- all user32, module count stays 7 =========
//   RegisterHotKey   : claim a combo EXCLUSIVELY. Measured (tmp\m8\hotkey-probe-run.txt): a second
//                      process asking for a combo we hold gets ERROR_HOTKEY_ALREADY_REGISTERED(1409)
//                      -- so the claim is real, the conflict is detectable, and the claim dies with
//                      the process (killing the holder frees the combo; no ghost registration).
//   UnregisterHotKey : hand it back on the way out.
// The key state itself is POLLED with GetAsyncKeyState (already declared by flgui_win32.fl): a
// registration only reports the PRESS, so "is it still held" has to be polled anyway -- and that is
// also why lib\ stays untouched (WM_HOTKEY never has to be plumbed through the pump).
api user32 int RegisterHotKey(int, int, int, int);
api user32 int UnregisterHotKey(int, int);

// ===== Phase B: the ONLY four extra entries, all READ-ONLY (advapi32) ===========================
// RegOpenKeyExA   : open one of the two Run keys for reading (KEY_READ = 0x20019)
// RegEnumValueA   : enumerate the VALUE NAMES of that key
// RegQueryValueExA: ask one value's data SIZE (lpData = 0 => size query only, reads no data)
// RegCloseKey     : close the handle again
// There is deliberately no RegSetValueExA / RegCreateKeyExA / RegDeleteKeyA / RegDeleteValueA in
// this file -- the app can only ever look. The self-check greps for those names and requires 0.
api advapi32 int RegOpenKeyExA(int, int, int, int, int);
api advapi32 int RegEnumValueA(int, int, int, int, int, int, int, int);
api advapi32 int RegQueryValueExA(int, int, int, int, int, int);
api advapi32 int RegCloseKey(int);

// ===== M4r: non-blocking port probe -- THREE extra ws2_32 entries ==============================
// Why: `connect()` to a CLOSED loopback port on this machine takes ~2045 ms (measured three ways in
// the v1 round: in-process 2047/2031/2062 ms, .NET TcpClient 2041~2053 ms, :9 and the LAN address
// the same), so the old blocking probe froze the message loop two seconds per dead port -- a 5-port
// round cost ~8.5 s and a click during that window was simply lost. Now the socket is put in
// non-blocking mode, connect() returns straight away (WSAEWOULDBLOCK) and select() waits at most
// WP_PROBE_TO_MS for writability; SO_ERROR then says whether that writability means CONNECTED or
// REFUSED. A really listening local port completes the connect immediately (~0 ms).
api ws2_32 int ioctlsocket(int, int, int);   // FIONBIO
api ws2_32 int select(int, int, int, int, int);
api ws2_32 int getsockopt(int, int, int, int, int);   // SO_ERROR

// ===== v5 (A): the ONE new entry this round -- a single shell32 call ===========================
// shell32's ShellExecuteA takes hwnd, verb, file, params, dir, showCmd. Every call site below
// LITERAL "open" as the verb; there is no register write, no "/c" command line and no elevation
// request anywhere in the app (the self-check greps for exactly that, and counts the call sites).
// The app can therefore only ever OPEN something -- it cannot run a command of its own.
// NOTE: the self-check counts the occurrences of the call token below and expects exactly one per
// launcher plus this declaration line, so no comment or page string may spell it with a "(".
api shell32 int ShellExecuteA(int, int, int, int, int, int);

// ===== single-point geometry ===================================================================
// Every rectangle in this file is derived from the numbers below (or from an expression over
// them). The self-check reads these same literals back out of THIS FILE and recomputes its own
// expected rectangles from them, then compares against what it finds in the app's command table --
// so no coordinate in the self-check is ever hand-written.
int WP_X = 448;              // window left (centred: (1920 - 1024) / 2 on this machine's screen)
int WP_Y = 172;              // window top (centred: (1080 - 736) / 2)
int WP_W = 1024;             // window width  (= v3's 640 x 1.6)
int WP_H = 736;              // window height (= v3's 460 x 1.6; area = 2.5x v3's 294400)
int WP_TITLE_H = 40;         // title bar height
int WP_NAV_W = 176;          // left nav column width
int WP_BOT_H = 32;           // bottom bar height
int WP_FONT = 20;            // body font size (px) handed to gui_win_font_init
int WP_LINE_H = 24;          // label line height (= WP_FONT + 4)
int WP_ROW = 56;             // page row pitch
int WP_LIST_ROW = 36;        // startup list row pitch (tighter: 12 rows must fit one page)
int WP_CXGAP = 18;           // nav column -> content gap (content x = WP_NAV_W + WP_CXGAP)
int WP_NAVBTN_X = 12;        // nav button left
int WP_NAVBTN_W = 152;       // = WP_NAV_W - 2 * WP_NAVBTN_X
int WP_NAVBTN_H = 44;        // nav button height
int WP_NAVBTN_Y0 = 64;       // first nav button top
int WP_NAVBTN_DY = 60;       // nav button pitch
int WP_TBTN_H = 30;          // title bar button height
int WP_TBTN_W = 38;          // title bar square button width (collapse / close)
int WP_THEME_W = 88;         // Theme button width
int WP_SETUP_W = 88;         // Setup button width (sits left of Theme)
int WP_PAD_R = 8;            // right margin of the title button cluster
int WP_GAP = 10;             // gap between title bar buttons
int WP_BAR_H = 22;           // disk utilisation bar height
int WP_BAR_DY = 30;          // disk label -> its bar offset
int WP_DISK_BLK = 72;        // disk block pitch (label row + bar)
int WP_STATE_DX = 260;       // port row: name -> state word offset
int WP_PROBE_W = 140;        // Probe button width
int WP_REFRESH_MS = 2000;
// the settings page (secondary page) is laid out from these five
int WP_SPAD = 40;            // setup card inner padding (left/right)
int WP_SP_PAD = 24;          // setup card top padding
int WP_SL_GAP = 18;          // slider -> value label gap
int WP_BACK_W = 120;         // Back button width
// v6 (B): the settings page carries the window-layer row too, so it needs its own width and the gap
// between the transparency line and that row.
int WP_LAYER_W = 300;        // the whole Layer row's width (three buttons side by side)
int WP_LAY_GAP = 14;         // transparency line -> layer row gap
// v10 (M12): the Layer row is THREE BUTTONS (Top / Normal / Auto), not one cycling button. The user
// reported (2026-10-11): "your round-robin is anti-human -- it jumps to the bottom and then I cannot
// click it any more". One press = one position, and no third of the row can ever select a position
// the user did not ask for. The three rects tile WP_LAYER_W exactly: 3 * WP_LAYBTN_W + 2 *
// WP_LAYBTN_GAP = 300, and they are pairwise disjoint by construction (this is what the self-check
// recomputes and what the on-screen dump reports as geo_layer_top/normal/auto_rect).
int WP_LAYBTN_W = 92;        // one layer button width
int WP_LAYBTN_GAP = 12;      // gap between two layer buttons
int WP_LAYBTN_DX = 104;      // pitch (WP_LAYBTN_W + WP_LAYBTN_GAP)
// ===== transparency knob (Phase A; PERCENTAGE since M4r) =======================================
// The window's constant alpha (Surf.const_a). v3 had it fixed at 236; v4 put it on the slider.
// The alpha floor is 120 (the work order's floor: below that the panel stops being readable) and
// 255 = "as opaque as this knob can go". v5 NOTE (now history): back then even at 0% the panel was
// still semi-transparent, because the surface's own per-pixel fill alpha (fill_a = 200 / ring_a = 70,
// written by gui_win_surf in lib\flgui_win32.fl) multiplied into it -- the knob only scaled a base
// that was itself ~78% opaque. v6 (A) fixes that from this side: the same percent now drives
// fill_a/ring_a too, so 0% is REALLY opaque and 100% reproduces the library's own values.
// The pool starts cleared, so 0 means "not set yet" and WP_OPA_DEF is used -- that keeps v3's
// delivered look (alpha 236 = 14%) as the startup state.
// Scale (user's wording, 2026-10-10: "transparency as a percentage, the top end takes the original
// minimum"):
//   0%   = alpha 255 = the least transparent this knob goes
//   100% = alpha 120 = the ORIGINAL MINIMUM (the most transparent this knob goes)
int WP_OPA_DEF = 236;        // startup alpha (= 14%)
int WP_OPA_MIN = 120;        // alpha at 100% transparency
int WP_OPA_MAX = 255;        // alpha at 0% transparency
int WP_PCT_MAX = 100;        // the slider works in percent, 0..100
// v6 (A): the two per-pixel alpha channels the app now drives with the same percent (see
// wp_fill_a_of / wp_ring_a_of). 255 - drop = the library's own gui_win_surf values (200 / 70), so
// pct = 100 reproduces today's pixels exactly while pct = 0 becomes really opaque.
int WP_FILL_DROP = 55;       // fill_a: 255 at 0% -> 200 at 100%
int WP_RING_DROP = 185;      // ring_a: 255 at 0% -> 70 at 100%

// ===== v6 (B/C): window layer + real minimize ==================================================
// The three positions the Setup page cycles through. `auto` is not a z-order call of its own: it is
// the rule "demote while covered, go back to the front once the sample points are all ours again".
int WP_LAYER_TOP = 0;
int WP_LAYER_NORMAL = 1;
int WP_LAYER_AUTO = 2;
int WP_LAYER_MODES = 3;
// hWndInsertAfter values that are legal on THIS toolchain (positive / zero):
//   0 = HWND_TOP    : top of the normal z-order (does NOT set WS_EX_TOPMOST)
//   1 = HWND_BOTTOM : goes behind everything and really CLEARS WS_EX_TOPMOST
// The tray handle (a positive int) is the anchor that really sets WS_EX_TOPMOST again -- see the
// api block at the top of this file for why -1 / -2 are unusable here.
int WP_ZWIN_TOP = 0;
int WP_ZWIN_BOTTOM = 1;
int WP_ZWIN_BEHIND = 3;        // v7 (M7): the local trace code for "put just below the coverer"
int WP_ZWIN_NOTOP = 4;         // v9 (M10): HWND_NOTOPMOST -- the FRONT of the non-topmost band
// the two extended-style bits this round cares about
int WP_EX_TOPMOST = 8;         // WS_EX_TOPMOST
int WP_EX_APPWINDOW = 0x40000; // WS_EX_APPWINDOW -- what gives the panel its taskbar button
// the four layer verdicts (dump field `layer=`)
int WP_LAY_TOP = 0;
int WP_LAY_COVERED = 1;
int WP_LAY_NORMAL = 2;
int WP_LAY_MIN = 3;
// ===== v8 (M8): hotkey / peek constants =========================================================
// virtual-key codes (GetAsyncKeyState takes a VK, not a character)
int WP_VK_CONTROL = 0x11;
int WP_VK_MENU = 0x12;
int WP_VK_MBUTTON = 4;         // VK_MBUTTON -- the keyboard-free fallback
int WP_VK_T = 0x54;            // T = lock to top
// RegisterHotKey modifiers / flags: MOD_ALT(1) | MOD_CONTROL(2), plus MOD_NOREPEAT(0x4000)
int WP_HK_MODS = 3;
int WP_HK_NOREPEAT = 0x4000;
// the candidate chain, in preference order. Why a chain: the combo may already belong to somebody
// else (measured: 1409), and when that happens we must not silently do nothing -- we walk on and
// SHOW which combo we ended up with (bottom bar + dump), so "I pressed it and nothing happened" can
// always be explained. All candidates taken => hk none, and the middle button still works.
int WP_HK_N = 3;
int WP_HK_VK0 = 0x57;          // W
int WP_HK_VK1 = 0x50;          // P
int WP_HK_VK2 = 0x79;          // F10
int WP_PEEK_MBTN_MS = 300;     // hold the middle button this long => peek too
// v15 (M16): how long a click on the panel suppresses the `auto` give-way. It exists so the panel
// does not slide back under the window the user just pulled it out from (M12); it must NOT last
// forever, or the cover logic looks dead (measured: with a window that stays focused, the old
// "until the foreground changes" rule kept the panel in front indefinitely).
int WP_HOLD_MS = 8000;
int WP_HK_ID = 1;              // the id we register under (0 = our own thread queue)
// ===== registry list (Phase B / v5) ============================================================
int WP_REG_MAX = 12;         // names stored per key (capacity of the slot table)
int WP_REGL_SLOT = 64;       // bytes per stored name
int WP_REG_SCAN = 64;        // value indexes scanned per key (a runaway guard)
// theme mode values (the pool starts cleared, so mode 0 -- blue white -- is the default)
int WP_THEME_LIGHT = 0;
int WP_THEME_DARK = 1;
// page ids (0..3) and the "settings page is open" flag
int WP_PAGE_LOCAL = 0;
int WP_PAGE_PORTS = 1;
int WP_PAGE_SELF = 2;
int WP_PAGE_STARTUP = 3;
// v5 pages: the nav column grows from 4 tabs to 7 (the same gui_button row, one pitch lower each)
int WP_PAGE_ACTIONS = 4;
int WP_PAGE_SYSTEM = 5;
int WP_PAGE_ENV = 6;
int WP_PAGES = 7;                // how many nav tabs exist (the self-check reads this literal)

// ===== v5 (A) the Actions page: a 2 x 5 grid of one-click launchers =============================
// Every rectangle is derived from these seven numbers. WP_ACT_DX = WP_ACT_W + 42 and the second
// column therefore ends at WP_NAV_W + WP_CXGAP + WP_ACT_DX + WP_ACT_W = 996 = WP_W - 28.
int WP_ACT_N = 10;               // buttons on the page
int WP_ACT_COLS = 2;             // grid columns
int WP_ACT_W = 380;              // button width
int WP_ACT_H = 44;               // button height (= WP_NAVBTN_H)
int WP_ACT_DX = 422;             // column pitch
int WP_ACT_DY = 60;              // row pitch (= WP_NAVBTN_DY)
int WP_ACT_Y0 = 106;             // first row top (= WP_TITLE_H + WP_ROW + 10)
int WP_ACT_ROWS = 5;             // rows (= WP_ACT_N / WP_ACT_COLS)
int WP_ACT_TEST = 8;             // id of the button the self-check's REAL click drives (notepad)

// ===== v5 (B/C/D) registry read-only surface ====================================================
// Four Run/RunOnce keys share one storage layout (WP_REG_MAX names per key, WP_REGL_SLOT bytes
// each); the v4 scalars became arrays because there are four keys now, not two. WP_REG_VIEW is how
// many rows of one key are drawn and WP_START_ROWS is the whole page's row budget (so a machine
// with many autostarts can never paint the list over the bottom bar).
int WP_RG_KEYS = 4;              // 0 = HKCU Run, 1 = HKLM Run, 2 = HKCU RunOnce, 3 = HKLM RunOnce
int WP_REG_VIEW = 6;             // names drawn per key (the rest become "... +k more")
int WP_START_ROWS = 18;          // total list rows the Startup page may draw
// the System page: four strings read with RegQueryValueExA into WP_SYS_SLOT-byte slots
int WP_SYS_N = 4;
int WP_SYS_SLOT = 128;
// the Env page: two hives, WP_ENVN_MAX names per hive, name + value per slot, WP_ENVN_VIEW drawn
int WP_ENVN_MAX = 32;
int WP_ENVN_SLOT = 112;          // WP_ENVN_NAME + WP_ENVN_VAL
int WP_ENVN_NAME = 40;
int WP_ENVN_VAL = 72;
int WP_ENVN_VIEW = 12;
int WP_ENV_SCAN = 64;
int WP_ENV_ROW = 26;
int WP_ENV_ROWS = 22;            // total list rows the Env page may draw

// ===== v9 (M9): the language table (lang.en.txt / lang.zh.txt) ==================================
// Two banks live in ONE arena: bank 0 (en) at wp_lang[0], bank 1 (zh) at wp_lang[WP_LANG_HALF].
// Each bank owns WP_LANG_SLOT offset/length entries, so the ACTIVE bank costs one multiply to read
// and a language switch never re-reads a file. The key set is the work order's appendix A, in that
// order: wp_lang_key() is the ONE table the parser matches against, and the WP_LK_* ids below are
// its indexes. A value the file does not define leaves its length at 0 and wp_L() answers with the
// built-in English literal -- the panel must never paint an empty label.
int WP_LANG_N = 30;              // canonical keys in the table (identical in both files)
int WP_LANG_SLOT = 32;           // slots per bank in wp_lang_off / wp_lang_len
int WP_LANG_HALF = 4096;         // bytes per bank inside wp_lang
int WP_LANG_EN = 0;              // the language id AND the bank index (0 = en, 1 = zh)
int WP_LANG_ZH = 1;
// the key ids, in the parser's own order (= the order of lang.en.txt / lang.zh.txt)
int WP_LK_APP_TITLE = 0;
int WP_LK_NAV_LOCAL = 1;
int WP_LK_NAV_PORTS = 2;
int WP_LK_NAV_SELF = 3;
int WP_LK_NAV_STARTUP = 4;
int WP_LK_NAV_ACTIONS = 5;
int WP_LK_NAV_SYSTEM = 6;
int WP_LK_NAV_ENV = 7;
int WP_LK_SETUP_TITLE = 8;
int WP_LK_SETUP_LANGUAGE = 9;
int WP_LK_SETUP_OPACITY = 10;
int WP_LK_SETUP_TRANSPARENCY = 11;
int WP_LK_SETUP_LAYER = 12;
int WP_LK_SETUP_THEME = 13;
int WP_LK_SETUP_SAVE = 14;
int WP_LK_SETUP_RELOAD = 15;
int WP_LK_SETUP_RESET = 16;
int WP_LK_SETUP_CFG_LINE = 17;
int WP_LK_SETUP_BACK = 18;
int WP_LK_BAR_OPACITY = 19;
int WP_LK_BAR_LANG = 20;
int WP_LK_BAR_CFG = 21;
int WP_LK_HINT_OPACITY = 22;
int WP_LK_STATE_LOADED = 23;
int WP_LK_STATE_DEFAULT = 24;
int WP_LK_STATE_WRITE_FAIL = 25;
int WP_LK_COMMON_ON = 26;
int WP_LK_COMMON_OFF = 27;
int WP_LK_LANG_EN = 28;
int WP_LK_LANG_ZH = 29;

// ===== v9 (M9): the file config (apps\winpanel\winpanel.cfg) ====================================
// Why a file in the exe's own directory: io_lib's whole-file read/write primitives are already linked
// into this app (0 new imports), and an absolute path is the convention panel.src / panel.reg /
// panel.dump already follow here. The keys this round persists are the five knobs the user can see
// (ver / lang / opacity / layer / theme) plus `hotkey`, a READ-ONLY record of the combo the last run
// claimed. An unknown key is ignored but COUNTED (dump cfg_unknown); a value outside its range is
// clamped (dump cfg_clamped). A file that cannot be read is not an error: every knob takes its
// default and the dump says cfg=default.
int WP_CFG_NKEYS = 6;            // the six keys above (hotkey is written, deliberately not read back)
int WP_CFG_OPA_DEF = 86;         // the "Opacity" number that goes with WP_OPA_DEF = 100 - pct(236)
int WP_CFG_ST_DEF = 0;           // cfg=default     (no readable file: every knob is at its default)
int WP_CFG_ST_LOADED = 1;        // cfg=loaded      (the file was read)
int WP_CFG_ST_WFAIL = 2;         // cfg=write_fail  (a Save could not reach the disk)
// v9 (M9): the settings page gains a Language row, a Config row (three buttons) and a cfg info line.
// Every row below is derived from these five numbers, and the Back button is derived from the last
// row -- so the judge recomputes the whole chain from THESE literals, never from a hand-written y.
int WP_CFG_GAP = 14;             // gap between the new settings rows
int WP_CFG_LANG_W = 300;         // the "Language: EN|ZH" button width (= WP_LAYER_W)
int WP_CFG_BTN_W = 120;          // each of the Save / Reload / Reset buttons (= WP_BACK_W)
int WP_CFG_DX = 130;             // pitch between those three buttons
int WP_CFG_INFO_H = 44;          // the cfg info line plus the gap that follows it

// ===== globals (literal initialisers only: the boot side refuses expressions) ==================
char wp_raw[4160];
char wp_txt[4160];
char wp_wide[8320];
char wp_mem[96];
char wp_stamp[48];
char wp_t1[192];
char wp_reg[3072];              // 4 keys x WP_REG_MAX slots x WP_REGL_SLOT bytes of value names
char wp_sys[512];               // 4 x WP_SYS_SLOT: product / display version / build / cpu string
char wp_env[7168];              // 2 hives x WP_ENVN_MAX slots x (name 40 + value 72)
char wp_opalabel[64];           // the live "Opacity <n>" label, copied out of the arena in wp_seq
char wp_trlabel[64];            // v5: the live "Transparency <n>" label of the same frame
char wp_barlabel[192];          // v5: the live bottom-bar text of the final frame
char wp_opadef[64];             // v5: the "Opacity <n>" line at the DEFAULT alpha (before any drag)
char wp_trdef[64];              // v5: the "Transparency <n>" line at that same moment

char wp_lang[8192];            // v9 (M9): both language banks, ANSI (TextOutA takes ANSI directly)
char wp_navbuf[96];            // v9 (M9): the nav label being built; gui_text_put copies it whole
// v9 (M9) state. wp_lang_off holds ABSOLUTE offsets into wp_lang, so wp_L() is one index away; a
// length of 0 means "this key is not in the file" and wp_L() answers with the built-in English
// literal from wp_L_def() instead -- a missing key can therefore never paint an empty label.
int wp_lang_off[64];           // bank * WP_LANG_SLOT + key id -> byte offset into wp_lang
int wp_lang_len[64];           // ... and the value length (0 = key missing -> built-in English)
int wp_lang_n[4];              // key=value lines really found in each language file
int wp_lang_miss[4];           // canonical keys that file did not define
int wp_lang_bytes[4];          // raw UTF-8 bytes the read handed back (0 = the file was unreadable)
int wp_lang_id = 0;            // the ACTIVE language (WP_LANG_EN / WP_LANG_ZH)
int wp_lang_fallback = 0;      // 1 = the active bank is incomplete -> English literals are painted
// v9 (M9) config state. wp_cfg doubles as the read buffer and the buffer Save builds its text in.
char wp_cfg[512];              // the cfg file's bytes (<= 460) and the text Save writes
char wp_cfgtmp[64];            // one cfg value, as a NUL-terminated string
int wp_cfg_read = 0;           // bytes the read handed back (0 = there is no readable file)
int wp_cfg_state = 0;          // WP_CFG_ST_DEF / LOADED / WFAIL (the word the info line shows)
int wp_cfg_keys = 0;           // how many of the six known keys the file really carries
int wp_cfg_unknown = 0;        // key=value lines whose key is not one of the six
int wp_cfg_clamped = 0;        // values that were out of range and got clamped
int wp_cfg_write = 1;          // 1 = the last Save reached the disk, 0 = it did not
int wp_cfg_save_n = 0;         // how many times Save really wrote the file
int wp_cfg_reload_n = 0;       // how many times Reload ran
int wp_cfg_reset_n = 0;        // how many times Reset ran
int wp_cfg_ver = 1;            // the file's own version field
int wp_cfg_opacity = 86;       // the "Opacity" number in the file (100 = alpha 120, 0 = alpha 255)
int wp_cfg_theme = 0;          // WP_THEME_LIGHT / WP_THEME_DARK as read from the file
// The layer the FILE asked for. Why a second variable: dump mode resets wp_layer_mode to `top` at the
// start of every wp_seq run (so the two theme runs compare equal states), which would otherwise hide
// the file's own value from the judge.
int wp_cfg_layer = 0;

