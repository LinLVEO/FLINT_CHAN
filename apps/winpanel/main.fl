int wp_peek_mb_t0 = 0;          // GetTickCount when the middle button went down (0 = not down)
int wp_peek_saved_mode = 0;     // the layer mode to restore when the peek ends
int wp_latch_saved_mode = 1;    // v8: the mode that stood BEFORE the lock (what `T` goes back to)
int wp_peek_saved_cover = 0;    // ...and the cover verdict at that moment
int wp_peek_n = 0;              // how many peeks happened (trace)
int wp_topbit = 0;              // the WS_EX_TOPMOST bit read back with GetWindowLongA(hwnd, -20)
int wp_iconic = 0;              // 1 = IsIconic(hwnd) was true on the last frame
int wp_win_top = 0;             // local z-order action taken by the last layer switch (1 = TOP)
int wp_swp_ok = 0;              // BOOL SetWindowPos returned (diagnostic, never assumed)
int wp_tray_h = 0;              // Shell_TrayWnd handle (the positive TOPMOST anchor), 0 = not found
int wp_skip = 0;                // v6 (C): frames skipped because the window was minimized
int wp_skips = 0;               // v6 (C): how many such skips so far (dump evidence for the gate)
int wp_ex_now = 0;              // exstyle before the APPWINDOW bit was added (taskbar evidence)
int wp_ex_new = 0;              // SetWindowLongA's previous value (0 = it refused)
int wp_ex_read = 0;             // exstyle read back after the hide/show round
int wp_restored = 0;            // 1 = the window came back from minimized (geometry must be intact)
int wp_lay_t0 = 0;              // last time the layer was sampled / the auto rule ran
int wp_margin = 0;              // x inset used for the cover samples (matches the nav column width)
int wp_auto_on = 0;             // v6 (B): 1 = the `auto` policy has already demoted the window
// v10 (M12): the foreground-driven `auto` state. `wp_fg_h` is the window GetForegroundWindow
// answered on the last auto sample, `wp_user_hold` is the short-lived "the user just pressed me"
// suppression and `wp_user_fg` is the foreground window that stood when that press happened. The
// panel is WS_EX_NOACTIVATE, so a press on the panel does NOT change the foreground; the hold is
// therefore released by the NEXT real foreground change (wp_foreground_new), never by a timer.
// v10 (M12): the foreground reading the `auto` rule consumes (see wp_fg_compute below). Module state
// rather than a struct return, because FLINT returns structs by pointer only. Fields are PLANE ints,
// the window handle included, because this app never dereferences a handle.
int wp_fgv_h = 0;               // GetForegroundWindow's answer for this frame
int wp_fgv_pid = 0;             // its process id
int wp_fgv_self = 0;            // 1 = the foreground window IS this process's panel
int wp_fgv_visible = 0;         // 1 = IsWindowVisible said so
int wp_fgv_iconic = 0;          // 1 = IsIconic said so
int wp_fgv_l = 0;               // its window rect, straight from GetWindowRect
int wp_fgv_t = 0;
int wp_fgv_r = 0;
int wp_fgv_b = 0;
int wp_fg_h = 0;                // GetForegroundWindow's answer on the last auto sample
int wp_fg_top = 0;              // v12 (M13): 1 = the foreground window is ABOVE the panel (z-order walk)
int wp_fg_t0 = 0;               // v12 (M13): when wp_fg_top was sampled (the 2 s policy cadence)
int wp_fg_owns = 0;             // v12 (M13): the raw overlap predicate (visible, not minimized, overlaps)
int wp_fg_keep = 0;             // v12 (M13): edge detector for the "owns but is below me" trace line
int wp_user_hold = 0;           // 1 = the user just touched the panel; do not go back under
int wp_hold_t0 = 0;             // v15 (M16): when that suppression was armed (wp_hold_t0 = 0 => not armed)
int wp_user_fg = 0;             // the foreground window at that moment (the hold's release key)
int wp_user_n = 0;              // how many real user presses have raised the panel (diagnostic)
int wp_fg_yield = 0;            // 1 = the last auto sample decided "the foreground window owns the spot"
int wp_fresh = 0;               // v10: 1 = the panel has just arrived at `auto`; show, then judge
// v14 (M15): "the user is MOVING a window right now" + the verified-give-way state. WHY they exist is
// measured in tmp\m15\probe-drag-2-run-before.txt / probe-drag-clean-run-before.txt: a real caption
// CLICK on a window raises it over the panel (z# 37 -> 34) so `auto` then gives way, but a real caption
// DRAG of a window that is ALREADY the foreground window does NOT raise it at all (z# 37 -> 37 for the
// whole drag and 6 s after the release), so the M13 LEVEL reading honestly answers "the foreground
// window is BELOW me" and the give-way decision was refused for the entire drag. wp_drag_* is fed from
// the frame's own foreground reading (wp_fgv_*) plus in.down, so the detector costs no extra API call.
int wp_drag_h = 0;              // the foreground window the drag tracker last compared against
int wp_drag_l = 0;              // that window's rect on the previous frame with the button down
int wp_drag_t = 0;
int wp_drag_r = 0;
int wp_drag_b = 0;
int wp_drag_have = 0;           // 1 = the rect above belongs to wp_drag_h and the button was already down
int wp_drag_seen = 0;           // 1 = the foreground window MOVED while the button was held (a real drag)
int wp_yield_t0 = 0;            // v14: when the last give-way move was issued (the retry cadence)
int wp_layer_apply = 0;         // 1 = the Setup row changed the selector; the loop performs the move
int wp_layer_hit = 0;           // v6: what the Layer row's own hit test returned on this frame
int wp_lay_pick = -1;           // v10 (M12): which of the three layer buttons was pressed (-1 = none)
// v1.4.28 (B1-5): was `= 0 - 1`; the old compiler silently dropped the `- 1` (value really was 0).
int wp_pressn = 0;              // v6 diagnostic: press edges the app has seen
// v13 (M14): wp_pressn above now counts ONLY presses that really landed on the panel (the gate below),
// because the platform layer polls the GLOBAL button -- before this cut it counted every click on the
// desktop. `wp_reln` still counts every release edge the OS reports (it is an input-edge counter, not
// a "the user touched me" counter).
int wp_press_me = 0;            // v13 (M14): 1 = this press edge landed on the panel (wp_press_is_mine)
int wp_press_cx = 0;            // v13 (M14): the cursor position read for that press edge
int wp_press_cy = 0;
int wp_reln = 0;                // v6 diagnostic: how many release edges the app has seen
int wp_dbg = 0;                 // v6: 1 = write the layer/minimize trace (file gated, absent = no I/O)
int wp_hb_t0 = 0;               // v15 (M16, DIAGNOSTIC): the heartbeat trace's own 1 s tick
int wp_hk_t0 = 0;               // v15 (M16): when the hotkey claim was last re-verified
int wp_hk_lost = 0;             // v15 (M16): 1 = another process took our combo after we claimed it
int wp_restores = 0;            // v6: how many times the window came back from minimized
int wp_mins = 0;                // v6: how many times the minimize button really took it down
// v5: the four Run/RunOnce keys and the two "read one value" pages share indexes 0..3
int wp_rg_n[8];                 // names stored per key
int wp_rg_more[8];              // names beyond WP_REG_MAX (reported as "+k more")
int wp_rg_st[8];                // 1 = that key opened, 0 = unavailable
int wp_rg_cb[8];                // bytes the RegQueryValueExA size queries reported for that key
int wp_sys_mask = 0;            // bit i = the i-th system string was read ok (one bit per value)
int wp_env_n[4];                // names stored per Environment hive
int wp_env_st[4];               // 1 = that hive opened
int wp_env_more[4];             // names beyond WP_ENVN_MAX
int wp_reg_q = 0;               // successful size queries (all four keys)
// v5 state
int wp_last_act = 0;            // 0 = no action pressed yet, else 1 + the id of the last one

// ===== theme: the single place the two library presets are called ==============================
// Work order rule: the theme may only change by calling gui_theme_default / gui_theme_light_blue,
// from exactly ONE call site, and no other ctx field may be touched while switching. The mode
// lives in the FLGUI state pool (id = gui_hash("winpanel.theme")) so it survives frames; the pool
// starts cleared, so mode 0 = blue white = the work order's default.
int wp_theme_key() { return gui_hash("winpanel.theme"); }

int wp_theme_mode() {
  int v = gui_pool_get(wp_theme_key());
  if (v == WP_THEME_DARK) { return WP_THEME_DARK; }
  return WP_THEME_LIGHT;
}

// the ONE call site: both presets are called from here and nowhere else in this file
int wp_theme_apply(struct GuiCtx *c, int mode) {
  gui_theme_light_blue(c);                       // default = blue white (this also lays the base)
  if (mode == WP_THEME_DARK) { gui_theme_default(c); }
  return mode;
}

int wp_theme_toggle() {
  int v = WP_THEME_LIGHT;
  if (wp_theme_mode() == WP_THEME_DARK) { v = WP_THEME_LIGHT; } else { v = WP_THEME_DARK; }
  gui_pool_set(wp_theme_key(), v);
  return v;
}

// Theme-derived ink colours: the app never hard-codes a theme colour. Every value below is read out
// of the ctx AFTER wp_theme_apply, so the two presets stay the only colour authority.
int wp_ctext(struct GuiCtx *c) { return c->theme_text; }
int wp_cdim(struct GuiCtx *c) { return c->theme_text_dim; }
int wp_cacc(struct GuiCtx *c) { return c->theme_box; }

// ===== the opacity knob (Phase A): the value lives in the FLGUI state pool ======================
// Why the pool and not a plain global: the work order requires the value to survive frames, and the
// pool is this library's designated home for cross-frame state (the app itself owns no per-widget
// storage in immediate mode). Reading through wp_opa_get() means a cleared pool (0) yields the
// default, so a fresh process starts at exactly v3's alpha.
int wp_opa_key() { return gui_hash("winpanel.opacity"); }

int wp_opa_get() {
  int v = gui_pool_get(wp_opa_key());
  if (v < WP_OPA_MIN) { return WP_OPA_DEF; }
  if (v > WP_OPA_MAX) { return WP_OPA_MAX; }
  return v;
}

int wp_opa_set(int v) {
  if (v < WP_OPA_MIN) { v = WP_OPA_MIN; }
  if (v > WP_OPA_MAX) { v = WP_OPA_MAX; }
  gui_pool_set(wp_opa_key(), v);
  wp_opa = v;
  return v;
}

// alpha <-> percent (M4r). Both directions round to nearest so the pair round-trips EXACTLY for
// every percent in 0..100 (judged by verify-panel.ps1's own recomputation, not by this comment):
//   alpha(pct) = 255 - round(pct * 135 / 100)     135 = 255 - 120
//   pct(alpha) = round((255 - alpha) * 100 / 135)
int wp_alpha_of(int pct) {
  if (pct < 0) { pct = 0; }
  if (pct > WP_PCT_MAX) { pct = WP_PCT_MAX; }
  return WP_OPA_MAX - (pct * (WP_OPA_MAX - WP_OPA_MIN) + 50) / WP_PCT_MAX;
}

int wp_pct_of(int a) {
  if (a < WP_OPA_MIN) { a = WP_OPA_MIN; }
  if (a > WP_OPA_MAX) { a = WP_OPA_MAX; }
  return ((WP_OPA_MAX - a) * WP_PCT_MAX + 67) / (WP_OPA_MAX - WP_OPA_MIN);
}

// ===== v6 (A): the surface's own per-pixel alpha is driven by the SAME knob =====================
// Why this exists: the knob above only scales Surf.const_a, and UpdateLayeredWindow multiplies it by
// the surface's per-pixel alpha (lib\ui_lib.fl writes fill_a = 200 / ring_a = 70 for every FLGUI
// window, see gui_win_surf in lib\flgui_win32.fl). At 0% that leaves the panel ~78% opaque -- the
// user's "it is still semi-transparent at 0%". The fix is on THIS side: the app already writes
// Surf.const_a every frame, so it now writes the two per-pixel channels the same way.
//   pct = 0   -> fill_a = 255, ring_a = 255   (the whole window is truly opaque)
//   pct = 100 -> fill_a = 200, ring_a = 70    (exactly the library's own values: pixel-identical)
// The library is not touched at all: these two fields are part of struct Surf.
int wp_fill_a_of(int pct) {
  if (pct < 0) { pct = 0; }
  if (pct > WP_PCT_MAX) { pct = WP_PCT_MAX; }
  return 255 - (WP_FILL_DROP * pct) / WP_PCT_MAX;
}

int wp_ring_a_of(int pct) {
  if (pct < 0) { pct = 0; }
  if (pct > WP_PCT_MAX) { pct = WP_PCT_MAX; }
  return 255 - (WP_RING_DROP * pct) / WP_PCT_MAX;
}

// the ONE place the three opacity outputs are recomputed from the pool value: the window's constant
// alpha plus the surface's two per-pixel channels. The window mode calls it every frame, so the knob
// reaches the screen on the very frame it moved.
int wp_opa_apply(struct Surf *s) {
  wp_pct = wp_pct_of(wp_opa_get());
  wp_opa = wp_alpha_of(wp_pct);
  wp_filla = wp_fill_a_of(wp_pct);
  wp_ringa = wp_ring_a_of(wp_pct);
  s->const_a = wp_opa;
  s->fill_a = wp_filla;
  s->ring_a = wp_ringa;
  return wp_opa;
}

// ===== v6 (B): window-layer measurement and switching ==========================================
// Everything below is a MEASUREMENT: SetWindowPos' own BOOL is kept, the WS_EX_TOPMOST bit is read
// back out of the window, and the cover verdict comes from WindowFromPoint. Nothing here assumes the
// switch worked -- if the shell refuses the move, the dump says so.
//
// the shell's tray window: a TOPMOST window whose handle is a positive int, so it can be used as the
// hWndInsertAfter anchor that promotes this window into the topmost band (see the api block).
int wp_tray_find() {
  if (wp_tray_h != 0) { return wp_tray_h; }
  // v6 FIX: FindWindowA is (lpClassName, lpWindowName) -- with the arguments the other way round
  // this returned 0, wp_zw() silently fell back to HWND_TOP, and the `top` selector never actually
  // re-entered the topmost band (the app's own trace showed zw=1 while the mode said `top`).
  // Verified outside the app: FindWindowA("Shell_TrayWnd", 0) = 65728, FindWindowA(0, "...") = 0.
  wp_tray_h = FindWindowA("Shell_TrayWnd", 0);
  return wp_tray_h;
}

// v7 (M7) FIX: "am I covered?" is answered by the Z-ORDER, not by WindowFromPoint.
// Measured 2026-10-10 (tmp\m7\zprobe-run.txt, hit-probe-run.txt, clickthrough-run.txt): while the
// panel was topmost (z-order walk: index 15 of 185, only Edge above it), painted on screen and
// really RECEIVING clicks (a control-group foreground test rules click-through out), all seven
// WindowFromPoint probes -- its own five sample points plus the centre and the title bar -- answered
// about explorer's desktop window. The old scan therefore reported `covered` forever: the Setup
// page's `state:` line called a topmost panel covered, and the `auto` policy could never promote it
// back (tmp\m7\auto-probe-run.txt: the topmost bit was cleared on the press and was still clear
// 15 s / 8 samples after the coverer was destroyed).
// This walk asks the question directly: is any VISIBLE, non-minimized window above us in the
// z-order overlapping the panel rect? Its handle lands in wp_cover_h so `auto` can yield to just
// that window (see wp_zw_behind).
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int * (call sites pass the int * g.hwnd/win)
int wp_cover_scan(int *hwnd, int l, int t, int r, int b) {
  int w = 0;
  int n = 0;
  struct RECT cr;
  wp_cover_h = 0;
  w = GetWindow(hwnd, 3);              // GW_HWNDPREV = the window directly above us
  while ((w != 0) && (n < 64)) {
    n = n + 1;
    if (IsWindowVisible(w) == 1) {
      if (IsIconic(w) == 0) {          // a minimized window keeps WS_VISIBLE but covers nothing
        cr.l = 0; cr.t = 0; cr.r = 0; cr.b = 0;
        GetWindowRect(w, &cr);
        if ((cr.l < r) && (cr.r > l) && (cr.t < b) && (cr.b > t)) {
          wp_cover_h = w;
          return 1;
        }
      }
    }
    w = GetWindow(w, 3);
  }
  return 0;
}

// ===== v10 (M12): the FOREGROUND reading ========================================================
// The user's second report (2026-10-11) is about windows that were ALREADY OPEN before the panel
// started: "it does not judge windows that are already running". That rules out every trigger based
// on "a window appeared" or "an activation changed": an old browser that the user clicks becomes the
// foreground window WITHOUT any z-order change at all, so only GetForegroundWindow answers the
// question. These functions are the whole input of the `auto` rule, and wp_dump_run prints the same
// reading so the judge can cross-check it against its own GetForegroundWindow call (fg_pid /
// fg_overlap / fg_is_self in the dump).
int wp_fg_pid_query(int w) {
  int pid = 0;
  if (w == 0) { return 0; }
  GetWindowThreadProcessId(w, &pid);
  return pid;
}

// v10 (M12): is_self is the ONE field a global cannot hold: "the foreground window is MY window"
// compares two 64-bit addresses, and FLINT refuses to write an address value into a global int (the
// high half would be lost). So the caller passes the panel handle it ALREADY holds as a local, and
// the comparison happens here -- the flag itself is a plain 0/1 and can live in a global.
// In headless dump mode the caller passes 0 (there is no panel window), so is_self is 0 there.
int wp_fg_compute(int *self) {
  struct RECT fr;
  wp_fgv_h = GetForegroundWindow();
  wp_fgv_self = 0;
  if ((self != 0) && (wp_fgv_h == self)) { wp_fgv_self = 1; }
  wp_fgv_visible = 0;
  wp_fgv_iconic = 0;
  wp_fgv_pid = 0;
  fr.l = 0; fr.t = 0; fr.r = 0; fr.b = 0;
  if (wp_fgv_h != 0) {
    wp_fgv_pid = wp_fg_pid_query(wp_fgv_h);
    if (IsWindowVisible(wp_fgv_h) == 1) { wp_fgv_visible = 1; }
    if (IsIconic(wp_fgv_h) == 1) { wp_fgv_iconic = 1; }
    GetWindowRect(wp_fgv_h, &fr);
  }
  wp_fgv_l = fr.l; wp_fgv_t = fr.t; wp_fgv_r = fr.r; wp_fgv_b = fr.b;
  return wp_fgv_h;
}

// Does the foreground window really own a spot over the panel? The user's wording is "the window I
// have in focus must be able to cover it", so the rule is: SOME OTHER window is in front for the
// user, it is really on screen (visible, not minimized), and its rect intersects the panel's. A
// covered panel then keeps a low profile -- and, since the panel is WS_EX_NOACTIVATE, a press on the
// panel does NOT change the foreground, which is exactly why "the foreground is me" also counts as
// "do not go under" (otherwise the user could never click the panel back).
// The caller must have run wp_fg_compute() for this frame first.
int wp_fg_owns_spot(int l, int t, int r, int b) {
  if (wp_fgv_h == 0) { return 0; }
  if (wp_fgv_self == 1) { return 0; }
  if (wp_fgv_visible != 1) { return 0; }
  if (wp_fgv_iconic == 1) { return 0; }
  if ((wp_fgv_l < r) && (wp_fgv_r > l) && (wp_fgv_t < b) && (wp_fgv_b > t)) { return 1; }
  return 0;
}

// Same intersection test, but for the DUMP's own reading: the panel has no window in headless mode,
// so the judge supplies the rect it wants the question asked about (the panel's own geometry).
int wp_fg_overlap(int l, int t, int r, int b) {
  wp_fg_compute(0);
  return wp_fg_owns_spot(l, t, r, b);
}

// ===== v12 (M13): the LEVEL condition ===========================================================
// The user's third report (2026-10-11 09:5x): "the window judgement does not consider the LEVEL --
// anything in range gets pushed up". wp_fg_owns_spot answers "does the foreground window overlap me,
// is it visible and not minimized", and `giving way` is implemented as wp_zw_behind(), i.e. SetWindowPos
// (panel, HWND_NOTOPMOST-anchored-at-that-window) = "put me directly BELOW that window". If the window
// was ALREADY below the panel, that move lifts it over the panel -- measured (tmp\m13\
// probe-behind-fg-run-before.txt, PHASE C): panel z#34 / notepad z#37 before, panel z#37 / notepad z#34
// after, with the app's own trace showing zw=3 (WP_ZWIN_BEHIND). So the level has to be part of the
// decision: the panel gives way only to a foreground window that is really IN FRONT of it.
//
// The ruler is the one M7 established: walk upwards from the panel with GW_HWNDPREV and look for the
// foreground window. A window FAMILY counts too (a foreground popup whose owner/frame is on the chain,
// or a sibling of the same process that is really on screen): that is what the pid comparison is for --
// comparing handles alone would miss "the foreground is a child of a window that is above me".
// Walking the whole chain without meeting it means the foreground window is BELOW the panel.
// Sampled at the same 2 s cadence as the cover verdict (plus on the fresh frame), never per iteration.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_fg_above(int *hwnd, int fg) {
  int w = 0;
  int n = 0;
  if (fg == 0) { return 0; }
  w = GetWindow(hwnd, 3);              // GW_HWNDPREV = the window directly above us
  while ((w != 0) && (n < 256)) {
    n = n + 1;
    if (w == fg) { return 1; }
    if (IsWindowVisible(w) == 1) {
      if (IsIconic(w) == 0) {
        if ((wp_fgv_pid != 0) && (wp_fg_pid_query(w) == wp_fgv_pid)) { return 1; }
      }
    }
    w = GetWindow(w, 3);
  }
  return 0;
}

// v14 (M15): the post-move ruler. The core rule of this cut is "a give-way move is only latched once it
// has been CONFIRMED", so after every wp_zw_behind() the same z-order walk M13 established answers the
// question again: is the window we just stepped aside for really above us now? Measured (tmp\m15\
// probe-drag-cover-run-before.txt PHASE G -- the probe's own SetWindowPos during a held drag: ret=True
// err=0, panel z#34 -> 37 / window 37 -> 34, and the new order survived further drag steps and the
// release), so a CONFIRMED answer is the normal case; an unconfirmed one leaves the latch DOWN, which is
// what makes the next sample retry instead of giving up on the spot forever.
// It refreshes wp_fg_top as a side effect (the walk already happened) so the frames that follow agree
// with what the move actually achieved, and marks the level reading as fresh.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_verify_yield(int *hwnd, int fg) {
  wp_fg_t0 = GetTickCount();
  wp_fg_top = wp_fg_above(hwnd, fg);
  if (wp_fg_top == 1) { return 1; }
  return 0;
}

// ===== v13 (M14): does a press belong to the panel? =============================================
// The platform layer polls the GLOBAL left button (GetAsyncKeyState(1) in lib\flgui_win32.fl), so
// in.pressed fires for a click ANYWHERE on the desktop. Without this test every such click raised the
// panel to the front of the normal band, re-armed the user-hold (so `auto` stopped giving way) and
// bumped the press counter -- the user's third report (2026-10-11 09:5x): "the window judgement does
// not consider the LEVEL -- anything in range gets pushed up". Measured before the fix
// (tmp\m14\probe-anyclick-run-before.txt): a click on a notepad outside the panel raised pressn and
// wrote a `press` trace line at mx=-220 my=-116, i.e. outside this window's client area.
//
// The test is: the cursor is inside OUR rect, and NO visible non-minimized window ABOVE us has a rect
// containing the cursor. The second half is what the cheap "is the cursor in my client area" answer
// misses, and it is exactly the user's case: the cursor is inside our rect, but another window is on
// top and owns the click. WHY not WindowFromPoint: it wants its POINT by value and this toolchain's api
// parameters are 32-bit `int`s, so the 8-byte struct cannot travel (measured, tmp\m14\wp-abi.fl).
// KNOWN BOUNDARY: this is a RECT test, so a layered window that is transparent at the cursor, or a
// shaped window, still counts as covering (WindowFromPoint would look through it). That can only make
// the panel ignore a press it could have taken -- never the reverse -- and it is recorded in the
// acceptance file's v13 section. Cost: the walk runs only on a press edge, not per frame.
// card T-20261012-210751 (T1 cut 2): hwnd is an HWND (an address class) -- inside the function it only feeds Win32 APIs
//   (GetWindowRect / GetWindow) and never takes part in arithmetic => it is a handle by semantics, so the parameter must be int * (SPEC decision 17).
//   It used to be declared as an int parameter while call sites passed the real pointer win = exactly the shape this cut must reject (the high 32 bits were dropped).
int wp_press_is_mine(int *hwnd, int cx, int cy) {
  struct RECT wr;
  struct RECT cr;
  int w = 0;
  int n = 0;
  if (hwnd == 0) { return 0; }
  wr.l = 0; wr.t = 0; wr.r = 0; wr.b = 0;
  GetWindowRect(hwnd, &wr);
  if (cx < wr.l) { return 0; }
  if (cx >= wr.r) { return 0; }
  if (cy < wr.t) { return 0; }
  if (cy >= wr.b) { return 0; }
  w = GetWindow(hwnd, 3);              // GW_HWNDPREV = the window directly above us
  while ((w != 0) && (n < 256)) {
    n = n + 1;
    if (IsWindowVisible(w) == 1) {
      if (IsIconic(w) == 0) {
        cr.l = 0; cr.t = 0; cr.r = 0; cr.b = 0;
        GetWindowRect(w, &cr);
        if ((cx >= cr.l) && (cx < cr.r) && (cy >= cr.t) && (cy < cr.b)) { return 0; }
      }
    }
    w = GetWindow(w, 3);
  }
  return 1;
}

// The suppression's release key: the user touched the panel (wp_user_hold), and the panel must stay
// where the user just put it until the FOREGROUND really moves on. NOT a timer: a 2 s timer would
// put the panel back under the very window the user just pulled it out from under, which is the
// second half of the report ("it does not come back when I click it").
int wp_foreground_new() {
  int fg = 0;
  fg = GetForegroundWindow();
  if (fg == wp_user_fg) { return 0; }
  return 1;
}

// ===== v10 (M12): Layer row -> 1 of 3 (Top / Normal / Auto) =====================================
// End x of button i inside the WP_LAYER_W row -- used by the self-check's own recomputation.
int wp_lay_btn_end(int i) { return wp_lay_x(i) + WP_LAYBTN_W; }

// the four-state verdict. `top` needs the READ-BACK TOPMOST bit (a window that merely sits first in
// the normal z-order is NOT topmost and is reported as `normal`).
int wp_layer_of(int iconic, int topbit, int cover) {
  if (iconic == 1) { return WP_LAY_MIN; }
  if (cover == 1) { return WP_LAY_COVERED; }
  if (topbit == 1) { return WP_LAY_TOP; }
  return WP_LAY_NORMAL;
}

// one z-order move: pos 1 = HWND_TOP (normal front), pos 0 = HWND_BOTTOM (leaves the topmost band
// too AND parks the window behind everything -- v10 stopped using it, see wp_layer_switch), pos 2 =
// behind the tray (enters the topmost band again), pos 4 = front of the normal band. Returns
// SetWindowPos' BOOL.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *; `after` stays a value (HWND_* constants / handle values)
int wp_zw(int *hwnd, int pos) {
  int after = 0;
  if (pos == 2) {
    after = wp_tray_find();
    if (after == 0) { pos = 1; }        // no tray handle: fall back to the normal front
  }
  if (pos == 1) { after = WP_ZWIN_TOP; }
  if (pos == 0) { after = WP_ZWIN_BOTTOM; }
  // v9 (M10): HWND_NOTOPMOST = -2. A negative value in an argument EXPRESSION is exactly what card
  // T-20261010-122541 fixed (int values are sign-extended into the 64-bit argument registers now), so
  // this must stay a function-local expression -- never a global initialiser (the boot side refuses
  // expressions there, see the note above the globals).
  if (pos == 4) { after = 0 - 2; }
  wp_swp_ok = SetWindowPos(hwnd, after, 0, 0, 0, 0, 0x13);
  wp_win_top = pos;
  return wp_swp_ok;
}

// v9 (M10): the "show me" move -- front of the NORMAL band, not topmost. Measured rules that force
// two calls: (a) HWND_NOTOPMOST (-2) reorders only a window that IS topmost -- on an already
// non-topmost window it returns TRUE and does nothing; (b) HWND_TOP (0) and BringWindowToTop() are
// silently ignored for a background process. The only move that really re-orders is a BAND
// TRANSITION, so: -1 into the topmost band, then -2 down to the front of the normal band
// (tmp\m10\probe-zw-inspect.ps1 measured z#15 -> z#28, above every inactive normal window and below
// every topmost one). One call to `wp_zw(hwnd, 4)` alone would leave the panel at its old depth --
// the first fix attempt did exactly that and could never come back.
// v10 (M12) uses this for THREE things now: the `normal` selector (instead of HWND_BOTTOM), the
// `auto` policy's "show me", and the user-press raise -- so it is declared BEFORE its first caller.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_auto_front(int *hwnd) {
  wp_zw(hwnd, 2);
  return wp_zw(hwnd, 4);
}

// the three-position selector: `top` really re-enters the topmost band, `normal` really leaves it,
// and `auto` makes no move of its own -- the policy right below decides in the same iteration.
// v10 (M12) FIX for the user's report "normal jumps to the bottom and then I cannot click it any
// more": `normal` used to be wp_zw(hwnd, 0) = HWND_BOTTOM, which parks the panel BEHIND every window
// on the desktop. Measured 2026-10-11 (tmp\m12\probe-reach.ps1, before this change): with layer=
// normal the panel sat at absolute z#175 (of 175) and WindowFromPoint(panel centre) answered about
// ANOTHER process's window -- i.e. a real click at the panel could not reach it at all. `normal` now
// means HWND_NOTOPMOST via the band round trip (front of the NORMAL band, the same move the auto
// policy uses), so NO position the user can select can ever bury the panel below the reachable
// z-order. `top` is still a real topmost position.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_layer_switch(int *hwnd) {
  if (wp_layer_mode == WP_LAYER_TOP) { return wp_zw(hwnd, 2); }
  if (wp_layer_mode == WP_LAYER_AUTO) { return 1; }
  return wp_auto_front(hwnd);
}

// v7 (M7): the `auto` demote. HWND_BOTTOM hides the panel behind EVERY window on a busy desktop,
// after which the "covered verdict cleared" condition the promote branch waits for can never come
// true again (measured before this fix: tmp\m7\auto-probe-run.txt -- 8 samples / ~15 s and the
// topmost bit never came back). Yielding to the coverer itself keeps the panel as far forward as it
// can be while still giving way: SetWindowPos(hwnd, coverer, ...) puts us directly BELOW it.
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => int *; coverer stays a value (wp_fg_h is a global int)
int wp_zw_behind(int *hwnd, int coverer) {
  // v10 (M12): `coverer` is now the FOREGROUND window (the auto rule yields to it), but the fallback
  // is no longer HWND_BOTTOM: pos 0 would park the panel behind the whole desktop, which is exactly
  // the "I cannot click it any more" state. With no anchor to yield to, the front of the normal band
  // is the honest place to be.
  if (coverer == 0) { return wp_auto_front(hwnd); }
  wp_swp_ok = SetWindowPos(hwnd, coverer, 0, 0, 0, 0, 0x13);
  wp_win_top = WP_ZWIN_BEHIND;
  return wp_swp_ok;
}

// `auto`: the decision itself lives in the frame loop (only state CHANGES move the window). This
// helper is the dump's own recomputation of the OLD cover-driven rule and is deliberately kept: the
// z-order walk it feeds (wp_cover_scan / wp_zcover) is still sampled and still printed, so the dump
// and the on-screen `state:` line keep showing what the z-order says while the DECISION is taken
// from the foreground (the judge can therefore compare the two readings).
int wp_layer_auto_want(int cover) {
  if (cover == 1) { return 1; }
  return 0;
}

// ===== v8 (M8): hold-to-peek / lock-to-top ======================================================
// Claim the first combo the system grants. Every step is a MEASUREMENT: the BOOL is kept, the combo
// we ended up with is reported (bottom bar + dump), and "none available" is a normal, VISIBLE
// outcome rather than a silent failure -- the middle-button fallback still peeks.
int wp_hk_probe() {
  int i = 0;
  int vk = 0;
  int ok = 0;
  wp_hk_ok = 0;
  wp_hk_vk = 0;
  wp_hk_which = 0 - 1;
  wp_hk_probe_fail = 0;
  while (i < WP_HK_N) {
    vk = WP_HK_VK2;
    if (i == 0) { vk = WP_HK_VK0; }
    if (i == 1) { vk = WP_HK_VK1; }
    ok = RegisterHotKey(0, WP_HK_ID, WP_HK_MODS | WP_HK_NOREPEAT, vk);
    if (ok == 1) {
      wp_hk_ok = 1;
      wp_hk_vk = vk;
      wp_hk_which = i;
      i = WP_HK_N;
    } else {
      wp_hk_probe_fail = wp_hk_probe_fail + 1;
      i = i + 1;
    }
  }
  return wp_hk_ok;
}

// the combo we really hold, in the notation the bottom bar shows
char *wp_hk_name() {
  if (wp_hk_which == 0) { return "^!W"; }
  if (wp_hk_which == 1) { return "^!P"; }
  if (wp_hk_which == 2) { return "^!F10"; }
  return "none";
}

// v15 (M16): can the WHOLE chord be pressed right now? This is what the peek actually needs, and it
// is deliberately INDEPENDENT of whether RegisterHotKey granted us the combo.
// WHY (measured 2026-10-11 M16, tmp\m16\probe-diag2/4 + the diagnostic trace keys): when every
// candidate was already taken by somebody else, the instance reported hk_ok=0 while the three keys
// were really down -- and the peek was gated behind `wp_hk_ok == 1`, so the chord did NOTHING and
// nothing on screen said why. That is the user's report "the hotkey sometimes does not take effect".
// The middle-button fallback below has always been independent of the claim for exactly this reason;
// this makes the keyboard path follow the same rule.
// Safety: the candidates are Ctrl+Alt+W / Ctrl+Alt+P / Ctrl+Alt+F10. None of them is a system chord,
// so reading their physical state cannot hijack somebody else's input (the C6x4 audit note still
// applies to INJECTION, which only ever uses a combo this process holds).
int wp_chord_down() {
  int i = 0;
  int vk = 0;
  if ((GetAsyncKeyState(WP_VK_CONTROL) & 0x8000) == 0) { return 0; }
  if ((GetAsyncKeyState(WP_VK_MENU) & 0x8000) == 0) { return 0; }
  while (i < WP_HK_N) {
    vk = WP_HK_VK2;
    if (i == 0) { vk = WP_HK_VK0; }
    if (i == 1) { vk = WP_HK_VK1; }
    if ((GetAsyncKeyState(vk) & 0x8000) != 0) { return 1; }
    i = i + 1;
  }
  return 0;
}

// v15 (M16): re-verify the claim every wp_hk_t0 tick. Somebody else may register our combo AFTER we
// took it; the panel then keeps believing it holds the hotkey (its own dump still said hk_ok=1) while
// WM_HOTKEY never arrives again -- a silent failure. RegisterHotKey answers 1409
// (ERROR_HOTKEY_ALREADY_REGISTERED) in that case, so the claim is re-asked and, if it was taken, the
// candidate chain is walked again (P, then F10). Unregistering a combo we no longer hold is a
// harmless no-op, which is why the check can run without side effects.
int wp_hk_recheck() {
  int ok = 0;
  if (wp_hk_ok == 0) { return 0; }
  wp_hk_lost = 0;
  ok = RegisterHotKey(0, WP_HK_ID, WP_HK_MODS | WP_HK_NOREPEAT, wp_hk_vk);
  if (ok == 1) { return 1; }
  UnregisterHotKey(0, WP_HK_ID);
  wp_hk_lost = 1;
  wp_hk_probe();
  wp_trace("hk-lost");
  return 0;
}

// Poll the chord every frame: a registration only reports the PRESS, so "still held" must be polled
// (injected input is visible to GetAsyncKeyState -- tmp\m8\hotkey-probe-run.txt step 5, which is what
// lets the judge drive this whole feature from a script).
//   press  edge : remember the standing layer mode, then PEEK (temporary topmost)
//   while held  : `T` toggles the LOCK (= the same `top` state the Setup row selects)
//   release edge: restore the remembered mode -- an `auto` panel goes back to its own verdict instead
//                 of quietly turning into `top`; a locked one stays on top and `top` becomes standing
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_peek_poll(int *hwnd) {
  int held = 0;
  int tnow = 0;
  int tkey = 0;
  // v15 (M16): the chord test no longer depends on the claim (see wp_chord_down). The old form was
  //   if (wp_hk_ok == 1) { ...ctrl/alt/wp_hk_vk... }
  // and it went completely dead whenever every candidate was already taken -- the user's "sometimes
  // it does not take effect", with no visible reason.
  held = wp_chord_down();
  // keyboard-free fallback: hold the middle button for WP_PEEK_MBTN_MS. It works even when every
  // candidate combo was refused, and it never arbitrates with anybody's keyboard.
  tnow = GetTickCount();
  if ((GetAsyncKeyState(WP_VK_MBUTTON) & 0x8000) != 0) {
    if (wp_peek_mb_t0 == 0) { wp_peek_mb_t0 = tnow; }
    if ((tnow - wp_peek_mb_t0) >= WP_PEEK_MBTN_MS) { held = 1; }
  } else {
    wp_peek_mb_t0 = 0;
  }
  if ((held == 1) && (wp_peek == 0)) {
    wp_peek = 1;
    wp_peek_n = wp_peek_n + 1;
    // Only remember the standing mode when we are NOT already latched: a second hold (the one that
    // unlocks) must not overwrite it with `top`, otherwise unlocking would "restore" the lock.
    // Measured with C6x4's first run: the unlock read back 0x080C0008 and this is why.
    if (wp_peek_latch == 0) { wp_peek_saved_mode = wp_layer_mode; }
    wp_peek_saved_cover = wp_zcover;
    wp_zw(hwnd, 2);
    wp_trace("peek-on");
  }
  if (held == 1) {
    // v15 (M16): re-assert the peek every frame while the chord is down, not only on the edge.
    // Why: the peek is a promise the user can see ("while I hold this, the panel is in front of what
    // I am looking at"), and the rest of the loop is free to move the window -- the `auto` policy's
    // 2 s sample, the 5 s hotkey re-verify, a press handler. One SetWindowPos per frame while the
    // chord is held makes "chord down => I am in front" true by construction, and the cost is paid
    // only during the hold.
    if (wp_peek == 1) { wp_zw(hwnd, 2); }
    tkey = 0;
    if ((GetAsyncKeyState(WP_VK_T) & 0x8000) != 0) { tkey = 1; }
    if ((tkey == 1) && (wp_peek_key_prev == 0)) {
      if (wp_peek_latch == 0) {
        wp_latch_saved_mode = wp_peek_saved_mode;   // what `T` will go back to
        wp_peek_latch = 1;
        wp_layer_mode = WP_LAYER_TOP;
        wp_auto_on = 0;
        wp_zw(hwnd, 2);
        wp_trace("lock");
      } else {
        wp_peek_latch = 0;
        wp_layer_mode = wp_latch_saved_mode;        // the mode from BEFORE the lock, not `top`
        if (wp_layer_mode == WP_LAYER_AUTO) { wp_fresh = 1; wp_auto_on = 0; } else { wp_auto_on = 0; }
        wp_trace("unlock");
      }
    }
    wp_peek_key_prev = tkey;
  } else {
    wp_peek_key_prev = 0;
  }
  if ((held == 0) && (wp_peek == 1)) {
    wp_peek = 0;
    if (wp_peek_latch == 1) {
      wp_layer_mode = WP_LAYER_TOP;
      wp_zw(hwnd, 2);
      wp_trace("peek-off-locked");
    } else {
      wp_layer_mode = wp_peek_saved_mode;
      if (wp_layer_mode == WP_LAYER_TOP) { wp_zw(hwnd, 2); }
      if (wp_layer_mode == WP_LAYER_NORMAL) { wp_zw(hwnd, 0); }
      if (wp_layer_mode == WP_LAYER_AUTO) { wp_auto_on = 2; }
      wp_trace("peek-off");
    }
  }
  return wp_peek;
}

char *wp_layer_word(int st) {
  if (st == WP_LAY_TOP) { return "top"; }
  if (st == WP_LAY_COVERED) { return "covered"; }
  if (st == WP_LAY_MIN) { return "min"; }
  return "normal";
}

char *wp_layer_mode_word() {
  if (wp_layer_mode == WP_LAYER_TOP) { return "top"; }
  if (wp_layer_mode == WP_LAYER_AUTO) { return "auto"; }
  return "normal";
}

// v10 (M12): the same three words, addressed by POSITION instead of by the live mode -- the three
// layer buttons must each print their own name no matter which one is selected.
char *wp_layer_mode_word_of(int m) {
  if (m == WP_LAYER_TOP) { return "top"; }
  if (m == WP_LAYER_AUTO) { return "auto"; }
  return "normal";
}

// ===== v6 (C): the REAL minimize ===============================================================
// `-` asks the shell for SW_MINIMIZE(6) and the frame loop stops building/flushing while IsIconic
// says the window is down (see the loop in main). Restoring is the shell's job (the taskbar button)
// or SW_RESTORE -- both put the geometry back exactly where it was (measured, tmp\m6\probe-min-run.txt).
// T1-2 (card T-20261012-210751): hwnd is an HWND (an address) => the parameter is int *
int wp_minimize(int *hwnd) {
  ShowWindow(hwnd, 6);                 // SW_MINIMIZE
  wp_iconic = IsIconic(hwnd);
  if (wp_iconic == 1) { wp_mins = wp_mins + 1; }
  wp_trace("minimize");
  return wp_iconic;
}

// the diagnostic channel for exactly the states this round added (file gated, like the frame ledger:
// absent file = not one byte written). It is what makes a REAL click checkable from outside: the
// self-check can watch whether the selector / the minimize actually reached the app.
int wp_trace(char *tag) {
  // v13 (M14): 320, not 192 -- the press-gate fields pushed the line past 200 characters and the
  // buffer is written without a bound check, so 192 was an overflow into the neighbouring locals.
  // v14 (M15): 384 -- aon/drag/fgtop were added and the measured line is already ~205 characters.
  char tb[384];
  int tp = 0;
  if (wp_dbg == 0) { return 0; }
  wp_puts(tb, &tp, tag);
  wp_puts(tb, &tp, " mode="); wp_puti(tb, &tp, wp_layer_mode);
  wp_puts(tb, &tp, " state="); wp_puti(tb, &tp, wp_layer_state);
  wp_puts(tb, &tp, " zcover="); wp_puti(tb, &tp, wp_zcover);
  wp_puts(tb, &tp, " topbit="); wp_puti(tb, &tp, wp_topbit);
  wp_puts(tb, &tp, " swp="); wp_puti(tb, &tp, wp_swp_ok);
  wp_puts(tb, &tp, " zw="); wp_puti(tb, &tp, wp_win_top);
  // v14 (M15): the give-way state, so the app's own log says whether the panel had already yielded
  // (`aon`), whether the user was dragging a window onto it (`drag`) and what the LEVEL ruler last
  // answered (`fgtop`). The judge and the probes read these instead of guessing.
  wp_puts(tb, &tp, " aon="); wp_puti(tb, &tp, wp_auto_on);
  wp_puts(tb, &tp, " drag="); wp_puti(tb, &tp, wp_drag_seen);
  wp_puts(tb, &tp, " fgtop="); wp_puti(tb, &tp, wp_fg_top);
  wp_puts(tb, &tp, " iconic="); wp_puti(tb, &tp, wp_iconic);
  wp_puts(tb, &tp, " mins="); wp_puti(tb, &tp, wp_mins);
  wp_puts(tb, &tp, " restores="); wp_puti(tb, &tp, wp_restores);
  wp_puts(tb, &tp, " tick="); wp_puti(tb, &tp, GetTickCount());
  wp_puts(tb, &tp, " mx="); wp_puti(tb, &tp, wp_mx);
  wp_puts(tb, &tp, " my="); wp_puti(tb, &tp, wp_my);
  wp_puts(tb, &tp, " hit="); wp_puti(tb, &tp, wp_layer_hit);
  wp_puts(tb, &tp, " setup="); wp_puti(tb, &tp, wp_setup);
  wp_puts(tb, &tp, " pressn="); wp_puti(tb, &tp, wp_pressn);
  wp_puts(tb, &tp, " reln="); wp_puti(tb, &tp, wp_reln);
  // v13 (M14): the press-gate readings, so the app's own log can be audited from outside:
  //   pcx/pcy = the cursor the gate read for the last press edge, pme = the gate's verdict,
  //   usern = how many presses have raised the panel, peek = the peek state at that moment.
  wp_puts(tb, &tp, " pcx="); wp_puti(tb, &tp, wp_press_cx);
  wp_puts(tb, &tp, " pcy="); wp_puti(tb, &tp, wp_press_cy);
  wp_puts(tb, &tp, " pme="); wp_puti(tb, &tp, wp_press_me);
  wp_puts(tb, &tp, " usern="); wp_puti(tb, &tp, wp_user_n);
  wp_puts(tb, &tp, " peek="); wp_puti(tb, &tp, wp_peek);
  // v15 (M16, DIAGNOSTIC): the hotkey half, so "the chord did nothing" can be split into its three
  // possible causes from outside the process -- (1) no combo was claimed at all (hk_ok/hk_vk),
  // (2) the poll's OWN reading of the three keys (kctrl/kalt/kk), (3) the result of the poll (peekn).
  // This block is temporary instrumentation for the M16 measurement round; it is removed when the
  // measured cause is fixed (see the M16 work order).
  wp_puts(tb, &tp, " hk_ok="); wp_puti(tb, &tp, wp_hk_ok);
  wp_puts(tb, &tp, " hk_vk="); wp_puti(tb, &tp, wp_hk_vk);
  wp_puts(tb, &tp, " kctrl="); wp_puti(tb, &tp, (GetAsyncKeyState(WP_VK_CONTROL) & 0x8000));
  wp_puts(tb, &tp, " kalt="); wp_puti(tb, &tp, (GetAsyncKeyState(WP_VK_MENU) & 0x8000));
  wp_puts(tb, &tp, " kk="); wp_puti(tb, &tp, (GetAsyncKeyState(wp_hk_vk) & 0x8000));
  wp_puts(tb, &tp, " peekn="); wp_puti(tb, &tp, wp_peek_n);
  // v9 (M9): the three config actions and the language, so a REAL click on Save / Reload / Reset is
  // checkable from outside the process (the judge reads this file back, it does not trust the app).
  wp_puts(tb, &tp, " csave="); wp_puti(tb, &tp, wp_cfg_save_n);
  wp_puts(tb, &tp, " creload="); wp_puti(tb, &tp, wp_cfg_reload_n);
  wp_puts(tb, &tp, " creset="); wp_puti(tb, &tp, wp_cfg_reset_n);
  wp_puts(tb, &tp, " cfg="); wp_puti(tb, &tp, wp_cfg_state);
  wp_puts(tb, &tp, " lang="); wp_puti(tb, &tp, wp_lang_id);
  wp_puts(tb, &tp, "\n");
  std::file_write("E:\\FLINT-lab\\tmp\\winpanel\\panel-layer.txt", tb, tp);
  return tp;
}

// ===== UTF-8 -> ANSI (two steps: ask the wide count, then convert) =============================
// w = caller-provided wide staging buffer. Raw input is capped at 4000 bytes by the caller, so
// need <= 4000 and need*2+16 <= 8016 <= 8320 (wp_wide). Returns bytes written incl. terminator.
int wp_utf8_to_ansi(char *src, char *dst, int cap, char *w) {
  int need = 0;
  int got = 0;
  need = MultiByteToWideChar(65001, 0, src, 0 - 1, 0, 0);
  if (need <= 0) { return 0 - 1; }
  if (need > 4000) { return 0 - 5; }
  got = MultiByteToWideChar(65001, 0, src, 0 - 1, w, need);
  if (got <= 0) { return 0 - 3; }
  got = WideCharToMultiByte(0, 0, w, 0 - 1, dst, cap, 0, 0);
  if (got <= 0) { return 0 - 4; }
  return got;
}

// ===== tiny key=value reader (same shape as v1) ================================================
// index of the value start for "key=" found at the START of a line; -1 = not found
int wp_kv_val(char *buf, int n, char *key) {
  int kl = 0;
  int i = 0;
  int ls = 0;
  int j = 0;
  int ok = 1;
  while (key[kl] != 0) { kl = kl + 1; }
  while (i < n) {
    if (i == ls) {
      j = 0;
      ok = 1;
      while (j < kl) {
        if (i + j >= n) { ok = 0; break; }
        if (buf[i + j] != key[j]) { ok = 0; break; }
        j = j + 1;
      }
      if (ok == 1 && i + kl < n) {
        if (buf[i + kl] == '=') { return i + kl + 1; }
      }
    }
    if (buf[i] == 10) { ls = i + 1; }
    i = i + 1;
  }
  return 0 - 1;
}

// end of that value (line end)
int wp_kv_end(char *buf, int n, int start) {
  int i = start;
  while (i < n) {
    if (buf[i] == 10) { break; }
    if (buf[i] == 13) { break; }
    i = i + 1;
  }
  return i;
}

// integer value; missing / not a number = -1
int wp_kv_int(char *buf, int n, char *key) {
  int v = wp_kv_val(buf, n, key);
  int r = 0;
  int c = 0;
  int neg = 0;
  if (v < 0) { return 0 - 1; }
  if (v >= n) { return 0 - 1; }
  if (buf[v] == '-') { neg = 1; v = v + 1; }
  while (v < n) {
    c = buf[v] % 256;
    if (c < 48) { break; }
    if (c > 57) { break; }
    r = r * 10 + (c - 48);
    v = v + 1;
  }
  if (neg == 1) { return 0 - r; }
  return r;
}

// copy the [start,end) slice into dst and NUL-terminate it (the widget layer wants a C string).
// Returns the length copied. This is the v2 fix for the "index pair has no terminator" trap.
int wp_slice(char *dst, char *src, int start, int end, int cap) {
  int n = 0;
  int i = start;
  while (i < end) {
    if (n >= cap - 1) { break; }
    dst[n] = src[i];
    n = n + 1;
    i = i + 1;
  }
  dst[n] = 0;
  return n;
}

// value of key as a NUL-terminated string; returns length, -1 = key absent
int wp_kv_str(char *buf, int n, char *key, char *dst, int cap) {
  int v = 0;
  int e = 0;
  v = wp_kv_val(buf, n, key);
  if (v < 0) { dst[0] = 0; return 0 - 1; }
  e = wp_kv_end(buf, n, v);
  return wp_slice(dst, buf, v, e, cap);
}

// NUL-terminated copy of s into d (the language has no string assignment)
int wp_strcpy(char *d, char *s) {
  int i = 0;
  while (s[i] != 0) { d[i] = s[i]; i = i + 1; }
  d[i] = 0;
  return i;
}

// ===== v9 (M9): the language table -- one parser, two banks, and always a label =================
// The canonical key names, in key-id order: this is the ONE table the parser matches against, and
// it is also the order of lang.en.txt / lang.zh.txt. The judge reads those two files itself and
// compares its own key sets with the counts this app reports (dump lang_keys_en / lang_keys_zh),
// so the app never gets to grade its own homework.
char *wp_lang_key(int k) {
  if (k == WP_LK_APP_TITLE) { return "app.title"; }
  if (k == WP_LK_NAV_LOCAL) { return "nav.local"; }
  if (k == WP_LK_NAV_PORTS) { return "nav.ports"; }
  if (k == WP_LK_NAV_SELF) { return "nav.self"; }
  if (k == WP_LK_NAV_STARTUP) { return "nav.startup"; }
  if (k == WP_LK_NAV_ACTIONS) { return "nav.actions"; }
  if (k == WP_LK_NAV_SYSTEM) { return "nav.system"; }
  if (k == WP_LK_NAV_ENV) { return "nav.env"; }
  if (k == WP_LK_SETUP_TITLE) { return "setup.title"; }
  if (k == WP_LK_SETUP_LANGUAGE) { return "setup.language"; }
  if (k == WP_LK_SETUP_OPACITY) { return "setup.opacity"; }
  if (k == WP_LK_SETUP_TRANSPARENCY) { return "setup.transparency"; }
  if (k == WP_LK_SETUP_LAYER) { return "setup.layer"; }
  if (k == WP_LK_SETUP_THEME) { return "setup.theme"; }
  if (k == WP_LK_SETUP_SAVE) { return "setup.save"; }
  if (k == WP_LK_SETUP_RELOAD) { return "setup.reload"; }
  if (k == WP_LK_SETUP_RESET) { return "setup.reset"; }
  if (k == WP_LK_SETUP_CFG_LINE) { return "setup.cfg_line"; }
  if (k == WP_LK_SETUP_BACK) { return "setup.back"; }
  if (k == WP_LK_BAR_OPACITY) { return "bar.opacity"; }
  if (k == WP_LK_BAR_LANG) { return "bar.lang"; }
  if (k == WP_LK_BAR_CFG) { return "bar.cfg"; }
  if (k == WP_LK_HINT_OPACITY) { return "hint.opacity"; }
  if (k == WP_LK_STATE_LOADED) { return "state.loaded"; }
  if (k == WP_LK_STATE_DEFAULT) { return "state.default"; }
  if (k == WP_LK_STATE_WRITE_FAIL) { return "state.write_fail"; }
  if (k == WP_LK_COMMON_ON) { return "common.on"; }
  if (k == WP_LK_COMMON_OFF) { return "common.off"; }
  if (k == WP_LK_LANG_EN) { return "lang.en"; }
  if (k == WP_LK_LANG_ZH) { return "lang.zh"; }
  return "";
}

// The built-in English table: pure ASCII, always compiled in, and the answer whenever the active
// bank has no value for a key. Its values are byte-identical to lang.en.txt on purpose -- that file
// is a copy of this table that a translator can edit, not a second source of truth.
char *wp_L_def(int id) {
  if (id == WP_LK_APP_TITLE) { return "winpanel"; }
  if (id == WP_LK_NAV_LOCAL) { return "Local"; }
  if (id == WP_LK_NAV_PORTS) { return "Ports"; }
  if (id == WP_LK_NAV_SELF) { return "Self"; }
  if (id == WP_LK_NAV_STARTUP) { return "Startup"; }
  if (id == WP_LK_NAV_ACTIONS) { return "Actions"; }
  if (id == WP_LK_NAV_SYSTEM) { return "System"; }
  if (id == WP_LK_NAV_ENV) { return "Env"; }
  if (id == WP_LK_SETUP_TITLE) { return "Settings"; }
  if (id == WP_LK_SETUP_LANGUAGE) { return "Language"; }
  if (id == WP_LK_SETUP_OPACITY) { return "Opacity"; }
  if (id == WP_LK_SETUP_TRANSPARENCY) { return "Transparency"; }
  if (id == WP_LK_SETUP_LAYER) { return "Layer"; }
  if (id == WP_LK_SETUP_THEME) { return "Theme"; }
  if (id == WP_LK_SETUP_SAVE) { return "Save"; }
  if (id == WP_LK_SETUP_RELOAD) { return "Reload"; }
  if (id == WP_LK_SETUP_RESET) { return "Reset"; }
  if (id == WP_LK_SETUP_CFG_LINE) { return "cfg"; }
  if (id == WP_LK_SETUP_BACK) { return "Back"; }
  if (id == WP_LK_BAR_OPACITY) { return "opacity"; }
  if (id == WP_LK_BAR_LANG) { return "lang"; }
  if (id == WP_LK_BAR_CFG) { return "cfg"; }
  if (id == WP_LK_HINT_OPACITY) { return "window transparency / opacity, 0-100"; }
  if (id == WP_LK_STATE_LOADED) { return "loaded"; }
  if (id == WP_LK_STATE_DEFAULT) { return "default"; }
  if (id == WP_LK_STATE_WRITE_FAIL) { return "write_fail"; }
  if (id == WP_LK_COMMON_ON) { return "On"; }
  if (id == WP_LK_COMMON_OFF) { return "Off"; }
  if (id == WP_LK_LANG_EN) { return "EN"; }
  if (id == WP_LK_LANG_ZH) { return "ZH"; }
  return "";
}

// the file behind one bank. Absolute on purpose: it is the same convention panel.src / panel.reg
// already use, and GetModuleFileNameA is deliberately NOT introduced this round (it is an import).
char *wp_lang_path(int bank) {
  if (bank == WP_LANG_ZH) { return "E:\\FLINT-lab\\apps\\winpanel\\lang.zh.txt"; }
  return "E:\\FLINT-lab\\apps\\winpanel\\lang.en.txt";
}

// How many "key=value" lines a bank holds. The rule is deliberately the crude one a text tool would
// use as well -- a line that does not start with '#' and carries at least one '=' -- because the
// judge counts the same file with the same rule and the two numbers have to be equal (that is C10a).
int wp_lang_count(int bank, int n) {
  int i = 0;
  int c = 0;
  int ls = 1;
  int cm = 0;
  int base = bank * WP_LANG_HALF;
  while (i < n) {
    if (ls == 1) { cm = 0; if (wp_lang[base + i] == '#') { cm = 1; } ls = 0; }
    if (cm == 0) {
      if (wp_lang[base + i] == '=') { c = c + 1; cm = 2; }
    }
    if (wp_lang[base + i] == 10) { ls = 1; }
    i = i + 1;
  }
  return c;
}

// Parse one bank in place. Pass 1 remembers every canonical key's value slice; pass 2 writes the
// NUL that turns each slice into a C string. Two passes ON PURPOSE: NUL-ing a line ending while the
// scan is still running would hide the FOLLOWING line from wp_kv_val's line-start test.
int wp_lang_parse(int bank, int n) {
  int base = bank * WP_LANG_SLOT;
  int bb = bank * WP_LANG_HALF;
  int k = 0;
  int v = 0;
  int e = 0;
  k = 0;
  while (k < WP_LANG_SLOT) {
    wp_lang_off[base + k] = 0;
    wp_lang_len[base + k] = 0;
    k = k + 1;
  }
  wp_lang_n[bank] = wp_lang_count(bank, n);
  wp_lang_miss[bank] = 0;
  k = 0;
  while (k < WP_LANG_N) {
    v = wp_kv_val(&wp_lang[bb], n, wp_lang_key(k));
    if (v >= 0) {
      e = wp_kv_end(&wp_lang[bb], n, v);
      wp_lang_off[base + k] = bb + v;
      wp_lang_len[base + k] = e - v;
    } else {
      wp_lang_miss[bank] = wp_lang_miss[bank] + 1;
    }
    k = k + 1;
  }
  k = 0;
  while (k < WP_LANG_N) {
    if (wp_lang_len[base + k] > 0) {
      wp_lang[wp_lang_off[base + k] + wp_lang_len[base + k]] = 0;
    }
    k = k + 1;
  }
  return wp_lang_n[bank];
}

// Read one language file: UTF-8 on disk (tool friendly, diffable) -> ANSI in the bank (TextOutA
// draws ANSI directly, so no new api is needed). A file that cannot be read is a REPORTED state
// (wp_lang_bytes = 0, every key missing), never a crash and never a blank label.
int wp_lang_read(int bank) {
  int n = 0;
  int rc = 0;
  int tlen = 0;
  int bb = bank * WP_LANG_HALF;
  wp_lang_bytes[bank] = 0;
  wp_lang[bb] = 0;
  n = std::file_read(wp_lang_path(bank), wp_raw, 4096);
  if (n < 0) { n = 0; }
  if (n > 4090) { n = 4090; }
  wp_raw[n] = 0;
  wp_lang_bytes[bank] = n;
  rc = wp_utf8_to_ansi(wp_raw, &wp_lang[bb], WP_LANG_HALF - 1, wp_wide);
  if (rc > 0) {
    tlen = rc - 1;
  } else {
    tlen = 0;
    wp_lang[bb] = 0;
  }
  if (tlen > WP_LANG_HALF - 1) { tlen = WP_LANG_HALF - 1; }
  return wp_lang_parse(bank, tlen);
}

// the active bank is complete? A missing FILE and a missing KEY both mean the same thing to the
// painter: fall back to the built-in English literal rather than draw nothing.
int wp_lang_apply() {
  if (wp_lang_id != WP_LANG_ZH) { wp_lang_id = WP_LANG_EN; }
  wp_lang_fallback = 0;
  if (wp_lang_n[wp_lang_id] <= 0) { wp_lang_fallback = 1; }
  if (wp_lang_miss[wp_lang_id] > 0) { wp_lang_fallback = 1; }
  return wp_lang_fallback;
}

int wp_lang_switch(int id) {
  wp_lang_id = id;
  return wp_lang_apply();
}

// both banks are read ONCE at startup, so a language switch is a multiply, not a disk read (and the
// per-frame rule of this app -- no file I/O while painting -- stays intact).
int wp_lang_load_all() {
  wp_lang_read(WP_LANG_EN);
  wp_lang_read(WP_LANG_ZH);
  return wp_lang_apply();
}

char *wp_lang_word() {
  if (wp_lang_id == WP_LANG_ZH) { return "zh"; }
  return "en";
}

// the ONE lookup every drawn word goes through: the active bank's slice, else built-in English
char *wp_L(int id) {
  return wp_L_bank(wp_lang_id, id);
}

// the same lookup for a NAMED bank: what lets the dump hand the judge one word out of EACH file
// (so "the app really parsed the value" is checkable, not just "it counted the lines").
char *wp_L_bank(int bank, int id) {
  int idx = 0;
  if (id < 0) { return wp_L_def(id); }
  if (id >= WP_LANG_N) { return wp_L_def(id); }
  if (bank != WP_LANG_ZH) { bank = WP_LANG_EN; }
  idx = bank * WP_LANG_SLOT + id;
  if (wp_lang_len[idx] > 0) { return &wp_lang[wp_lang_off[idx]]; }
  return wp_L_def(id);
}

// one nav label: the ">" prefix still marks the selected tab, the word comes from the table. The
// scratch buffer is safe because gui_text_put COPIES the bytes into the text arena at once (verified
// in lib\flgui.fl:442-457 before this was written), and the hit test / the label draw below hand the
// very same pointer to the very same string.
int wp_nav_build(int page, int id) {
  int p = 0;
  if (wp_page == page) { wp_puts(wp_navbuf, &p, ">  "); } else { wp_puts(wp_navbuf, &p, "   "); }
  wp_puts(wp_navbuf, &p, wp_L(id));
  wp_end(wp_navbuf, &p);
  return 0;
}

// ===== v9 (M9): the cfg file -- read at startup, written by Save ================================
// The key names, in the order Save writes them. This list is also what decides whether a line in the
// file is "known" (anything else is ignored and counted in cfg_unknown).
char *wp_cfg_key(int k) {
  if (k == 0) { return "ver"; }
  if (k == 1) { return "lang"; }
  if (k == 2) { return "opacity"; }
  if (k == 3) { return "layer"; }
  if (k == 4) { return "theme"; }
  if (k == 5) { return "hotkey"; }
  return "";
}

char *wp_cfg_path() { return "E:\\FLINT-lab\\apps\\winpanel\\winpanel.cfg"; }

// exact string equality (the language has no strcmp; wp_kv_val is a prefix-style matcher and would
// answer "yes" where this must answer "no")
int wp_streq(char *a, char *b) {
  int i = 0;
  while (a[i] != 0) {
    if (a[i] != b[i]) { return 0; }
    i = i + 1;
  }
  if (b[i] != 0) { return 0; }
  return 1;
}

// does the line's key -- the bytes [ls, eq) -- name EXACTLY this key?
int wp_cfg_key_is(char *buf, int ls, int eq, char *key) {
  int i = 0;
  while (key[i] != 0) {
    if (ls + i >= eq) { return 0; }
    if (buf[ls + i] != key[i]) { return 0; }
    i = i + 1;
  }
  if (ls + i != eq) { return 0; }
  return 1;
}

// Count the key=value lines whose key is not one of the six. The line rule is the same crude one the
// language-table counter uses (a '#' at the START of a line comments it out, CR/LF both end a line),
// so a reader can check both by eye with one rule in mind.
int wp_cfg_unknown_n(char *buf, int n) {
  int i = 0;
  int ls = 0;
  int cm = 0;
  int eq = 0 - 1;
  int un = 0;
  int k = 0;
  int hit = 0;
  while (i <= n) {
    if ((i == n) || (buf[i] == 10) || (buf[i] == 13)) {
      if ((cm == 0) && (eq > ls)) {
        hit = 0;
        k = 0;
        while (k < WP_CFG_NKEYS) {
          if (wp_cfg_key_is(buf, ls, eq, wp_cfg_key(k)) == 1) { hit = 1; }
          k = k + 1;
        }
        if (hit == 0) { un = un + 1; }
      }
      ls = i + 1;
      cm = 0;
      eq = 0 - 1;
    } else {
      if (ls == i) {
        if (buf[i] == '#') { cm = 1; }
      }
      if (cm == 0) {
        if (eq < 0) {
          if (buf[i] == '=') { eq = i; }
        }
      }
    }
    i = i + 1;
  }
  return un;
}

// how many of the six known keys the file carries (the number the Setup page's info line shows)
int wp_cfg_keys_n(char *buf, int n) {
  int k = 0;
  int c = 0;
  while (k < WP_CFG_NKEYS) {
    if (wp_kv_val(buf, n, wp_cfg_key(k)) >= 0) { c = c + 1; }
    k = k + 1;
  }
  return c;
}

// a whole-string integer, -1 = not a number at all. wp_kv_int cannot tell "0" from "abc": it stops
// at the first non-digit and answers 0, which would hide a clamped value from the dump.
int wp_cfg_int_of(char *s) {
  int i = 0;
  int v = 0;
  if (s[0] == 0) { return 0 - 1; }
  while (s[i] != 0) {
    if (s[i] < 48) { return 0 - 1; }
    if (s[i] > 57) { return 0 - 1; }
    v = v * 10 + (s[i] - 48);
    i = i + 1;
  }
  return v;
}

// the defaults, in ONE place: "no file", an unreadable file and Reset all come through here
int wp_cfg_defaults() {
  wp_cfg_ver = 1;
  wp_lang_id = WP_LANG_EN;
  wp_cfg_opacity = WP_CFG_OPA_DEF;
  wp_layer_mode = WP_LAYER_TOP;
  wp_cfg_layer = WP_LAYER_TOP;
  wp_cfg_theme = WP_THEME_LIGHT;
  return 0;
}

// read every value the file defines into the state. A MISSING key keeps its default and is not a
// clamp; only a value that is present and out of range counts in cfg_clamped.
int wp_cfg_values() {
  int v = 0;
  wp_cfg_ver = wp_kv_int(wp_cfg, wp_cfg_read, "ver");
  if (wp_cfg_ver < 0) { wp_cfg_ver = 1; }
  v = wp_kv_str(wp_cfg, wp_cfg_read, "lang", wp_cfgtmp, 24);
  if (v >= 0) {
    if (wp_streq(wp_cfgtmp, "zh") == 1) { wp_lang_id = WP_LANG_ZH; }
    else {
      if (wp_streq(wp_cfgtmp, "en") == 1) { wp_lang_id = WP_LANG_EN; }
      else { wp_cfg_clamped = wp_cfg_clamped + 1; }
    }
  }
  v = wp_kv_str(wp_cfg, wp_cfg_read, "opacity", wp_cfgtmp, 24);
  if (v >= 0) {
    v = wp_cfg_int_of(wp_cfgtmp);
    if (v < 0) { wp_cfg_clamped = wp_cfg_clamped + 1; }
    else {
      if (v > WP_PCT_MAX) { v = WP_PCT_MAX; wp_cfg_clamped = wp_cfg_clamped + 1; }
      wp_cfg_opacity = v;
    }
  }
  v = wp_kv_str(wp_cfg, wp_cfg_read, "layer", wp_cfgtmp, 24);
  if (v >= 0) {
    wp_layer_mode = WP_LAYER_TOP;
    if (wp_streq(wp_cfgtmp, "normal") == 1) { wp_layer_mode = WP_LAYER_NORMAL; }
    if (wp_streq(wp_cfgtmp, "auto") == 1) { wp_layer_mode = WP_LAYER_AUTO; }
    if ((wp_streq(wp_cfgtmp, "top") == 0) && (wp_streq(wp_cfgtmp, "normal") == 0) && (wp_streq(wp_cfgtmp, "auto") == 0)) {
      wp_cfg_clamped = wp_cfg_clamped + 1;
    }
    wp_cfg_layer = wp_layer_mode;      // kept separately: wp_seq resets wp_layer_mode in dump mode
  }
  v = wp_kv_str(wp_cfg, wp_cfg_read, "theme", wp_cfgtmp, 24);
  if (v >= 0) {
    if (wp_streq(wp_cfgtmp, "dark") == 1) { wp_cfg_theme = WP_THEME_DARK; }
    else {
      if (wp_streq(wp_cfgtmp, "light") == 1) { wp_cfg_theme = WP_THEME_LIGHT; }
      else { wp_cfg_clamped = wp_cfg_clamped + 1; }
    }
  }
  return 0;
}

// cfg -> live state: the language bank, the opacity pool value and the theme pool value. The layer
// selector is a plain global, so wp_cfg_values already set it.
int wp_cfg_apply_state() {
  wp_lang_apply();
  wp_opa_set(wp_alpha_of(WP_PCT_MAX - wp_cfg_opacity));
  gui_pool_set(wp_theme_key(), WP_THEME_LIGHT);
  if (wp_cfg_theme == WP_THEME_DARK) { gui_pool_set(wp_theme_key(), WP_THEME_DARK); }
  return 0;
}

// read the file (if any) into the state. Called once at startup and again by Reload.
int wp_cfg_load() {
  wp_cfg_state = WP_CFG_ST_DEF;
  wp_cfg_read = 0;
  wp_cfg_unknown = 0;
  wp_cfg_clamped = 0;
  wp_cfg_keys = 0;
  wp_cfg_defaults();
  wp_cfg_read = std::file_read(wp_cfg_path(), wp_cfg, 480);
  if (wp_cfg_read < 0) { wp_cfg_read = 0; }
  if (wp_cfg_read > 460) { wp_cfg_read = 460; }
  wp_cfg[wp_cfg_read] = 0;
  if (wp_cfg_read > 0) {
    wp_cfg_state = WP_CFG_ST_LOADED;
    wp_cfg_unknown = wp_cfg_unknown_n(wp_cfg, wp_cfg_read);
    wp_cfg_keys = wp_cfg_keys_n(wp_cfg, wp_cfg_read);
    wp_cfg_values();
  }
  return wp_cfg_state;
}

char *wp_cfg_word() {
  if (wp_cfg_state == WP_CFG_ST_WFAIL) { return "write_fail"; }
  if (wp_cfg_state == WP_CFG_ST_LOADED) { return "loaded"; }
  return "default";
}

// Save writes the LIVE state (what the user is looking at), not the last parsed one, so pressing
// Save right after moving a knob stores that knob. A failed write is reported, never fatal.
int wp_cfg_save() {
  int p = 0;
  int rc = 0;
  wp_cfg_opacity = WP_PCT_MAX - wp_pct_of(wp_opa_get());
  wp_cfg_theme = wp_theme_mode();
  p = 0;
  wp_puts(wp_cfg, &p, "# winpanel config -- written by the panel itself (key=value, # comments)\n");
  wp_puts(wp_cfg, &p, "ver="); wp_puti(wp_cfg, &p, wp_cfg_ver); wp_puts(wp_cfg, &p, "\n");
  wp_puts(wp_cfg, &p, "lang="); wp_puts(wp_cfg, &p, wp_lang_word()); wp_puts(wp_cfg, &p, "\n");
  wp_puts(wp_cfg, &p, "opacity="); wp_puti(wp_cfg, &p, wp_cfg_opacity); wp_puts(wp_cfg, &p, "\n");
  wp_puts(wp_cfg, &p, "layer="); wp_puts(wp_cfg, &p, wp_layer_mode_word()); wp_puts(wp_cfg, &p, "\n");
  wp_puts(wp_cfg, &p, "theme="); wp_puts(wp_cfg, &p, wp_theme_word()); wp_puts(wp_cfg, &p, "\n");
  wp_puts(wp_cfg, &p, "hotkey="); wp_puts(wp_cfg, &p, wp_hk_name()); wp_puts(wp_cfg, &p, "\n");
  rc = std::file_write(wp_cfg_path(), wp_cfg, p);
  if (rc == 1) {
    wp_cfg_save_n = wp_cfg_save_n + 1;
    wp_cfg_state = WP_CFG_ST_LOADED;
    wp_cfg_keys = WP_CFG_NKEYS;
    wp_cfg_write = 1;
  } else {
    wp_cfg_state = WP_CFG_ST_WFAIL;
    wp_cfg_write = 0;
  }
  wp_trace("cfgsave");
  return rc;
}

// Reset puts BOTH the memory and the disk back to the defaults (the work order's own wording), so it
// defaults first and then saves -- the file that remains on disk is a fresh default file.
int wp_cfg_reset() {
  wp_cfg_defaults();
  wp_cfg_unknown = 0;
  wp_cfg_clamped = 0;
  wp_cfg_keys = 0;
  wp_opa_set(wp_alpha_of(WP_PCT_MAX - wp_cfg_opacity));
  gui_pool_set(wp_theme_key(), WP_THEME_LIGHT);
  wp_cfg_reset_n = wp_cfg_reset_n + 1;
  wp_cfg_save();
  wp_trace("cfgreset");
  return 0;
}

// Reload re-reads the cfg AND the two language files: that is the point of a Reload button while the
// user is editing lang.zh.txt (the startup read is once; this is the one other read in the app).
int wp_cfg_reload() {
  wp_cfg_reload_n = wp_cfg_reload_n + 1;
  wp_cfg_load();
  wp_lang_load_all();
  wp_cfg_apply_state();
  wp_trace("cfgreload");
  return wp_cfg_state;
}

char *wp_theme_word() {
  if (wp_theme_mode() == WP_THEME_DARK) { return "dark"; }
  return "light";
}

// copy the stored registry name (slot, index) into the report buffer d at *pos; returns its length
// (byte-wise on purpose: the table holds raw ANSI bytes and must reach the file unchanged)
int wp_putslot(char *d, int *pos, int slot, int idx) {
  int off = slot * (WP_REG_MAX * WP_REGL_SLOT) + idx * WP_REGL_SLOT;
  int k = 0;
  while (k < WP_REGL_SLOT) {
    if (wp_reg[off + k] == 0) { break; }
    d[*pos] = wp_reg[off + k];
    *pos = *pos + 1;
    k = k + 1;
  }
  return k;
}

// ===== text building helpers (report + labels) =================================================
// v5: copy one Environment name (which = 0) or value (which = 1) out of the two-hive table
int wp_putenvslot(char *d, int *pos, int slot, int idx, int which) {
  int off = slot * (WP_ENVN_MAX * WP_ENVN_SLOT) + idx * WP_ENVN_SLOT;
  int base = off;
  int cap = WP_ENVN_NAME;
  int k = 0;
  if (which == 1) { base = off + WP_ENVN_NAME; cap = WP_ENVN_VAL; }
  while (k < cap) {
    if (wp_env[base + k] == 0) { break; }
    d[*pos] = wp_env[base + k];
    *pos = *pos + 1;
    k = k + 1;
  }
  return k;
}

int wp_puts(char *d, int *pos, char *s) {
  int i = 0;
  while (s[i] != 0) { d[*pos] = s[i]; *pos = *pos + 1; i = i + 1; }
  return 0;
}

int wp_putb(char *d, int *pos, char *s, int n) {
  int i = 0;
  while (i < n) { d[*pos] = s[i]; *pos = *pos + 1; i = i + 1; }
  return 0;
}

int wp_puti(char *d, int *pos, int v) {
  char b[24];
  int n = 0;
  if (v < 0) { wp_puts(d, pos, "-"); v = 0 - v; }
  n = std::itoa(v, b);
  return wp_putb(d, pos, b, n);
}

int wp_end(char *b, int *p) { b[*p] = 0; return 0; }

// "key=<int>" ; a negative value means the datum is absent -> print "missing"
int wp_putkv(char *d, int *pos, char *k, int v) {
  wp_puts(d, pos, k);
  if (v < 0) { return wp_puts(d, pos, "missing"); }
  return wp_puti(d, pos, v);
}

// int into a label buffer; a negative value renders "missing" instead of a bogus number
int wp_num_or_missing(char *b, int *p, int v) {
  if (v < 0) { return wp_puts(b, p, "missing"); }
  return wp_puti(b, p, v);
}

// decimal run inside [start,len) of a byte buffer: the first run of digits at or after `start` is
// parsed, 0 when there is none (the dump uses this to read the value back out of the LIVE label the
// widget layer actually drew). M4r: the label prefix changed length ("Opacity " -> "Transparency ")
// so the run is now FOUND instead of assumed to start exactly at `start`.
int wp_atoi_at(char *t, int len, int start) {
  int i = start;
  int v = 0;
  while (i < len) {
    if (t[i] >= 48) { if (t[i] <= 57) { break; } }
    i = i + 1;
  }
  while (i < len) {
    if (t[i] < 48) { break; }
    if (t[i] > 57) { break; }
    v = v * 10 + (t[i] - 48);
    i = i + 1;
  }
  return v;
}

// ===== snapshot load / field extraction ========================================================
int wp_load(char *path) {
  int n = 0;
  int rc = 0;
  int tlen = 0;
  n = std::file_read(path, wp_raw, 4000);
  if (n > 0) { wp_raw[n] = 0; } else { n = 0; wp_raw[0] = 0; }
  rc = wp_utf8_to_ansi(wp_raw, wp_txt, 4000, wp_wide);
  if (rc > 0) { tlen = rc - 1; } else { tlen = 0; wp_txt[0] = 0; }
  wp_snap_bytes = n;
  wp_ansi_bytes = rc;
  wp_tlen = tlen;
  return tlen;
}

int wp_refresh_fields() {
  wp_mem_ok = 0;
  wp_t1_ok = 0;
  wp_stamp_ok = 0;
  wp_mem[0] = 0;
  wp_t1[0] = 0;
  wp_stamp[0] = 0;
  if (wp_snap_bytes > 0) { wp_ok = 1; } else { wp_ok = 0; }
  if (wp_ok == 0) {
    wp_tasks = 0 - 1;
    wp_cand = 0 - 1;
    wp_sd = 0 - 1;
    wp_sw = 0 - 1;
    wp_si = 0 - 1;
    wp_dc = 0 - 1;
    wp_de = 0 - 1;
    return 0;
  }
  if (wp_kv_str(wp_txt, wp_tlen, "mem_time", wp_mem, 96) >= 0) { wp_mem_ok = 1; }
  if (wp_kv_str(wp_txt, wp_tlen, "task_first", wp_t1, 160) >= 0) { wp_t1_ok = 1; }
  if (wp_kv_str(wp_txt, wp_tlen, "stamp", wp_stamp, 48) >= 0) { wp_stamp_ok = 1; }
  wp_tasks = wp_kv_int(wp_txt, wp_tlen, "tasks_open");
  wp_cand = wp_kv_int(wp_txt, wp_tlen, "cand");
  wp_sd = wp_kv_int(wp_txt, wp_tlen, "sec_danger");
  wp_sw = wp_kv_int(wp_txt, wp_tlen, "sec_warn");
  wp_si = wp_kv_int(wp_txt, wp_tlen, "sec_info");
  wp_dc = wp_kv_int(wp_txt, wp_tlen, "disk_c_free_x10");
  wp_de = wp_kv_int(wp_txt, wp_tlen, "disk_e_free_x10");
  return 0;
}

// ===== "has anything the panel shows really changed?" ==========================================
// v3's idle rule: the 2 s refresh still re-reads the file every time (that contract is unchanged),
// but a repaint is only triggered when the digest of what is on screen moves. A frozen snapshot
// therefore means zero uploads, while a rewritten one shows up within one refresh tick.
int wp_bytesum(char *b, int n) {
  int i = 0;
  int s = 0;
  while (i < n) { s = s * 131 + b[i]; i = i + 1; }
  return s;
}

int wp_state_digest() {
  int s = 0;
  s = wp_bytesum(wp_txt, wp_tlen);
  s = s * 1009 + wp_snap_bytes;
  s = s * 1009 + wp_ansi_bytes;
  s = s * 1009 + wp_pu0 * 3 + wp_pu1 * 5 + wp_pu2 * 7 + wp_pu3 * 11 + wp_pu4 * 13;
  s = s * 1009 + wp_port_src;
  s = s * 1009 + wp_probe_i;
  return s;
}

// re-read the data sources; returns 1 when what the panel shows really changed
int wp_reload(char *path) {
  int dig = 0;
  int chg = 0;
  wp_load(path);
  wp_refresh_fields();
  if (wp_port_src == 1) {
    if (wp_read_ports_file() == 0) {
      wp_pu0 = 3; wp_pu1 = 3; wp_pu2 = 3; wp_pu3 = 3; wp_pu4 = 3;
    }
  }
  dig = wp_state_digest();
  if (dig != wp_prev_dig) { chg = 1; }
  wp_prev_dig = dig;
  return chg;
}

// ===== local TCP port probe (NON-BLOCKING since M4r) ===========================================
// Old shape: blocking connect -- on this machine a CLOSED localhost port costs ~2045 ms, so the
// message loop froze for two seconds per dead port. New shape (all three extra ws2_32 entries are
// declared in the api block at the top of this file):
//   socket -> ioctlsocket(FIONBIO) -> connect -> select(write, WP_PROBE_TO_MS) -> getsockopt(SO_ERROR)
// A port that is really listening finishes the connect immediately (loopback), so the common case
// costs ~0 ms; a dead port costs the select budget, not two seconds.
// Returns 1 = up, 2 = down.
int WP_PROBE_TO_MS = 120;          // per-dead-port select() budget (ms)
int FIONBIO = 0x8004667E;          // ioctlsocket non-blocking command
int SOL_SOCKET_ = 0xFFFF;
int SO_ERROR_ = 0x1007;
int wp_port_probe(int port) {
  char wsa[400];
  char sa[16];
  char fds[528];                   // fd_set on Win64: u_int fd_count + 4 pad + SOCKET[64] x 8 bytes
  char tv[8];                      // struct timeval { long tv_sec; long tv_usec; }
  char opt[8];
  char nbmode[8];
  int i = 0;
  int sk = 0;
  int r = 0;
  int n = 0;
  int err = 0;
  int olen = 4;
  if (WSAStartup(0x0202, wsa) != 0) { return 2; }      // Winsock 2.2
  sk = socket(2, 1, 6);
  if (sk == 0 - 1) { WSACleanup(); return 2; }
  i = 0;
  while (i < 8) { nbmode[i] = 0; i = i + 1; }
  nbmode[0] = 1;                                        // u_long mode = 1 (non-blocking)
  ioctlsocket(sk, FIONBIO, nbmode);
  i = 0;
  while (i < 16) { sa[i] = 0; i = i + 1; }
  sa[0] = 2; sa[1] = 0;
  sa[2] = port / 256; sa[3] = port - (port / 256) * 256;   // sin_port, network byte order
  sa[4] = 127; sa[5] = 0; sa[6] = 0; sa[7] = 1;            // 127.0.0.1
  r = connect(sk, sa, 16);
  if (r == 0) { closesocket(sk); WSACleanup(); return 1; }
  // hand-built write fd_set (the struct's layout is fixed by Winsock on x64: count, 4 pad, then
  // 8-byte SOCKET entries -- the handle is written as its low 4 bytes plus four zero bytes)
  i = 0;
  while (i < 528) { fds[i] = 0; i = i + 1; }
  fds[0] = 1;
  fds[8] = sk % 256; fds[9] = (sk / 256) % 256; fds[10] = (sk / 65536) % 256; fds[11] = (sk / 16777216) % 256;
  i = 0;
  while (i < 8) { tv[i] = 0; i = i + 1; }
  tv[4] = (WP_PROBE_TO_MS * 1000) % 256;
  tv[5] = ((WP_PROBE_TO_MS * 1000) / 256) % 256;
  n = select(0, 0, fds, 0, tv);
  err = 0 - 1;
  if (n > 0) {
    opt[0] = 0; opt[1] = 0; opt[2] = 0; opt[3] = 0;
    olen = 4;
    if (getsockopt(sk, SOL_SOCKET_, SO_ERROR_, opt, &olen) == 0) { err = (opt[0] & 255) + (opt[1] & 255) * 256; }
  }
  closesocket(sk);
  WSACleanup();
  if (err == 0) { return 1; }
  return 2;
}

// port state from the optional list file: 1 up / 2 down / 3 key absent
int wp_port_file(char *buf, int n, char *key) {
  int v = wp_kv_val(buf, n, key);
  if (v < 0) { return 3; }
  if (v >= n) { return 3; }
  if (buf[v] == 'u') { return 1; }
  if (buf[v] == 'd') { return 2; }
  return 3;
}

// returns 1 = file was there and is now authoritative, 0 = no file
int wp_read_ports_file() {
  char pbuf[1200];
  int pf = 0;
  pf = std::file_read("E:\\FLINT-lab\\apps\\winpanel\\panel.ports", pbuf, 1000);
  if (pf <= 0) { return 0; }
  pbuf[pf] = 0;
  wp_pu0 = wp_port_file(pbuf, pf, "3080");
  wp_pu1 = wp_port_file(pbuf, pf, "8080");
  wp_pu2 = wp_port_file(pbuf, pf, "8090");
  wp_pu3 = wp_port_file(pbuf, pf, "8091");
  wp_pu4 = wp_port_file(pbuf, pf, "8092");
  wp_port_src = 1;
  wp_probe_i = 5;
  return 1;
}

// one port per frame while a probe run is in flight (keeps the block to ~2 s, not ~8 s)
int wp_probe_step() {
  int tk = 0;
  if (wp_probe_i >= 5) { return 0; }
  tk = GetTickCount();
  if (wp_probe_i == 0) { wp_pu0 = wp_port_probe(3080); }
  if (wp_probe_i == 1) { wp_pu1 = wp_port_probe(8080); }
  if (wp_probe_i == 2) { wp_pu2 = wp_port_probe(8090); }
  if (wp_probe_i == 3) { wp_pu3 = wp_port_probe(8091); }
  if (wp_probe_i == 4) { wp_pu4 = wp_port_probe(8092); }
  wp_probe_ms = GetTickCount() - tk;
  wp_probe_total = wp_probe_total + wp_probe_ms;
  wp_probe_i = wp_probe_i + 1;
  return 1;
}

int wp_start_probe() {
  if (wp_port_src == 1) { wp_read_ports_file(); return 0; }
  wp_pu0 = 0; wp_pu1 = 0; wp_pu2 = 0; wp_pu3 = 0; wp_pu4 = 0;
  wp_probe_i = 0;
  wp_probe_ms = 0;
  wp_probe_total = 0;
  return 0;
}

// ===== Phase B / v5 (B, C, D): read-only registry reading ======================================
// The four autostart subkey paths. panel.reg (a test hook of the same family as panel.src /
// panel.ports) overrides them, one per line, so the "key does not exist" degradation path can be
// exercised against a subkey that really is not there. Absent file = the four real keys; a file
// with only two lines overrides the two Run keys and leaves the two RunOnce keys real (that is
// exactly what the v4 degradation check writes).
int wp_reg_paths(char *s0, char *s1, char *s2, char *s3) {
  char cfg[1024];
  int cn = 0;
  int e1 = 0;
  int s = 0;
  int e2 = 0;
  int e3 = 0;
  int e4 = 0;
  wp_strcpy(s0, "Software\\Microsoft\\Windows\\CurrentVersion\\Run");
  wp_strcpy(s1, "Software\\Microsoft\\Windows\\CurrentVersion\\Run");
  wp_strcpy(s2, "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce");
  wp_strcpy(s3, "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce");
  cn = std::file_read("E:\\FLINT-lab\\apps\\winpanel\\panel.reg", cfg, 1000);
  if (cn <= 0) { return 0; }
  cfg[cn] = 0;
  e1 = wp_kv_end(cfg, cn, 0);
  if (e1 > 0) { wp_slice(s0, cfg, 0, e1, 256); }
  s = e1;
  while (s < cn) {
    if (cfg[s] != 13) { if (cfg[s] != 10) { break; } }
    s = s + 1;
  }
  e2 = wp_kv_end(cfg, cn, s);
  if (e2 > s) { wp_slice(s1, cfg, s, e2, 256); }
  s = e2;
  while (s < cn) {
    if (cfg[s] != 13) { if (cfg[s] != 10) { break; } }
    s = s + 1;
  }
  e3 = wp_kv_end(cfg, cn, s);
  if (e3 > s) { wp_slice(s2, cfg, s, e3, 256); }
  s = e3;
  while (s < cn) {
    if (cfg[s] != 13) { if (cfg[s] != 10) { break; } }
    s = s + 1;
  }
  e4 = wp_kv_end(cfg, cn, s);
  if (e4 > s) { wp_slice(s3, cfg, s, e4, 256); }
  return 1;
}

// Read the VALUE NAMES of one autostart key into the slot table of `slot`
// (0 = HKCU Run, 1 = HKLM Run, 2 = HKCU RunOnce, 3 = HKLM RunOnce).
// Returns the number of names stored, or -1 when the key cannot be opened (the degradation path).
// Every call reads only: open / enumerate / size query / close. No data of any value is read
// (RegQueryValueExA runs with lpData = 0, which is the documented way to ask for the size only).
int wp_reg_read(int hive, char *sub, int slot) {
  char nm[256];
  int hk = 0;
  int rc = 0;
  int i = 0;
  int cch = 0;
  int cb = 0;
  int n = 0;
  int more = 0;
  int base = 0;
  int off = 0;
  int k = 0;
  int q = 0;
  hk = 0;
  rc = RegOpenKeyExA(hive, sub, 0, 0x20019, &hk);      // KEY_READ
  if (rc != 0) { return 0 - 1; }
  base = slot * (WP_REG_MAX * WP_REGL_SLOT);
  i = 0;
  while (i < WP_REG_SCAN) {
    cch = 255;
    nm[0] = 0;
    rc = RegEnumValueA(hk, i, nm, &cch, 0, 0, 0, 0);
    if (rc != 0) { break; }                            // 259 = ERROR_NO_MORE_ITEMS = done
    cb = 0;
    rc = RegQueryValueExA(hk, nm, 0, 0, 0, &cb);       // size query only (lpData = 0)
    if (rc == 0) {
      q = q + 1;
      wp_rg_cb[slot] = wp_rg_cb[slot] + cb;
    }
    if (n < WP_REG_MAX) {
      off = base + n * WP_REGL_SLOT;
      k = 0;
      while (k < cch) {
        if (k >= WP_REGL_SLOT - 1) { break; }
        wp_reg[off + k] = nm[k];
        k = k + 1;
      }
      wp_reg[off + k] = 0;
      n = n + 1;
    } else {
      more = more + 1;
    }
    i = i + 1;
  }
  rc = RegCloseKey(hk);
  wp_rg_n[slot] = n;
  wp_rg_more[slot] = more;
  wp_reg_q = wp_reg_q + q;
  return n;
}

int wp_reg_all() {
  char sub0[256];
  char sub1[256];
  char sub2[256];
  char sub3[256];
  int i = 0;
  wp_reg_q = 0;
  i = 0;
  while (i < 8) {
    wp_rg_n[i] = 0; wp_rg_more[i] = 0; wp_rg_st[i] = 0; wp_rg_cb[i] = 0;
    i = i + 1;
  }
  wp_reg_paths(sub0, sub1, sub2, sub3);
  if (wp_reg_read(0x80000001, sub0, 0) >= 0) { wp_rg_st[0] = 1; }   // HKCU Run
  if (wp_reg_read(0x80000002, sub1, 1) >= 0) { wp_rg_st[1] = 1; }   // HKLM Run
  if (wp_reg_read(0x80000001, sub2, 2) >= 0) { wp_rg_st[2] = 1; }   // HKCU RunOnce
  if (wp_reg_read(0x80000002, sub3, 3) >= 0) { wp_rg_st[3] = 1; }   // HKLM RunOnce
  return 0;
}

// v5 (B): read ONE string value of one key (open / query / close -- still read-only). Returns the
// string length, or -1 when either step fails. A REG_DWORD is rendered as a decimal integer so the
// page never prints raw binary; every other type is copied as a NUL-terminated string.
int wp_reg_getstr(int hive, char *sub, char *val, char *dst, int cap) {
  char raw[8];
  int hk = 0;
  int rc = 0;
  int cb = 0;
  int ty = 0;
  int i = 0;
  int v = 0;
  hk = 0;
  ty = 0;
  rc = RegOpenKeyExA(hive, sub, 0, 0x20019, &hk);
  if (rc != 0) { return 0 - 1; }
  cb = cap - 1;
  dst[0] = 0;
  rc = RegQueryValueExA(hk, val, 0, &ty, dst, &cb);
  RegCloseKey(hk);
  if (rc != 0) { return 0 - 2; }
  if (ty == 4) {                                     // REG_DWORD: 4 little-endian bytes -> decimal
    i = 0;
    while (i < 4) { raw[i] = dst[i]; i = i + 1; }
    v = raw[0] + raw[1] * 256 + raw[2] * 65536 + raw[3] * 16777216;
    i = 0;
    if (v == 0) { dst[0] = 48; i = 1; }
    while (v > 0) {
      if (i >= cap - 1) { break; }
      dst[i] = 48 + v % 10;
      v = v / 10;
      i = i + 1;
    }
    // digits came out reversed; flip them in place
    cb = i;
    i = 0;
    while (i < cb / 2) {
      ty = dst[i];
      dst[i] = dst[cb - 1 - i];
      dst[cb - 1 - i] = ty;
      i = i + 1;
    }
    dst[cb] = 0;
    return cb;
  }
  if (cb > cap - 1) { cb = cap - 1; }
  dst[cb] = 0;
  i = 0;
  while (i < cb) {
    if (dst[i] == 0) { break; }
    i = i + 1;
  }
  dst[i] = 0;
  return i;
}

// v5 (B): the four strings the System page shows. One bit per value in wp_sys_mask, so a single
// missing key can be told apart from all four missing.
int wp_sys_read() {
  char sub0[256];
  char sub1[256];
  int i = 0;
  wp_strcpy(sub0, "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion");
  wp_strcpy(sub1, "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0");
  wp_sys_mask = 0;
  i = 0;
  while (i < WP_SYS_N) { wp_sys[i * WP_SYS_SLOT] = 0; i = i + 1; }
  if (wp_reg_getstr(0x80000002, sub0, "ProductName", &wp_sys[0 * WP_SYS_SLOT], WP_SYS_SLOT) >= 0) { wp_sys_mask = wp_sys_mask + 1; }
  if (wp_reg_getstr(0x80000002, sub0, "DisplayVersion", &wp_sys[1 * WP_SYS_SLOT], WP_SYS_SLOT) >= 0) { wp_sys_mask = wp_sys_mask + 2; }
  if (wp_reg_getstr(0x80000002, sub0, "CurrentBuild", &wp_sys[2 * WP_SYS_SLOT], WP_SYS_SLOT) >= 0) { wp_sys_mask = wp_sys_mask + 4; }
  if (wp_reg_getstr(0x80000002, sub1, "ProcessorNameString", &wp_sys[3 * WP_SYS_SLOT], WP_SYS_SLOT) >= 0) { wp_sys_mask = wp_sys_mask + 8; }
  return wp_sys_mask;
}

// v5 (C): read one Environment hive. Names AND values (the value is what "the first characters of
// the value" needs), each truncated into its own slot. Still read-only: open / enumerate / query /
// close.
int wp_env_read(int hive, char *sub, int slot) {
  char nm[256];
  char val[256];
  int hk = 0;
  int rc = 0;
  int i = 0;
  int cch = 0;
  int cb = 0;
  int ty = 0;
  int n = 0;
  int more = 0;
  int base = 0;
  int off = 0;
  int k = 0;
  hk = 0;
  ty = 0;
  rc = RegOpenKeyExA(hive, sub, 0, 0x20019, &hk);
  if (rc != 0) { return 0 - 1; }
  base = slot * (WP_ENVN_MAX * WP_ENVN_SLOT);
  i = 0;
  while (i < WP_ENV_SCAN) {
    cch = 255;
    nm[0] = 0;
    rc = RegEnumValueA(hk, i, nm, &cch, 0, 0, 0, 0);
    if (rc != 0) { break; }
    val[0] = 0;
    cb = 255;
    rc = RegQueryValueExA(hk, nm, 0, &ty, val, &cb);
    if (rc != 0) { val[0] = 0; cb = 0; }
    if (n < WP_ENVN_MAX) {
      off = base + n * WP_ENVN_SLOT;
      k = 0;
      while (k < cch) {
        if (k >= WP_ENVN_NAME - 1) { break; }
        wp_env[off + k] = nm[k];
        k = k + 1;
      }
      wp_env[off + k] = 0;
      k = 0;
      while (k < cb) {
        if (k >= WP_ENVN_VAL - 1) { break; }
        wp_env[off + WP_ENVN_NAME + k] = val[k];
        k = k + 1;
      }
      wp_env[off + WP_ENVN_NAME + k] = 0;
      n = n + 1;
    } else {
      more = more + 1;
    }
    i = i + 1;
  }
  RegCloseKey(hk);
  wp_env_n[slot] = n;
  wp_env_more[slot] = more;
  return n;
}

int wp_env_all() {
  int i = 0;
  i = 0;
  while (i < 4) { wp_env_n[i] = 0; wp_env_st[i] = 0; wp_env_more[i] = 0; i = i + 1; }
  if (wp_env_read(0x80000001, "Environment", 0) >= 0) { wp_env_st[0] = 1; }
  if (wp_env_read(0x80000002, "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment", 1) >= 0) { wp_env_st[1] = 1; }
  return 0;
}

// ===== port wording / colours ==================================================================
char *wp_st_word(int st) {
  if (st == 1) { return "up"; }
  if (st == 2) { return "down"; }
  if (st == 3) { return "missing"; }
  return "--";
}

// up keeps a semantic green (readable on both themes); down / missing / neutral come from the
// theme itself, so v3 carries no hard-coded dark-only palette any more.
int wp_st_col(struct GuiCtx *c, int st) {
  if (st == 1) { return 0x0060C060; }
  if (st == 2) { return c->theme_danger; }
  if (st == 3) { return c->theme_box; }
  return c->theme_text_dim;
}

// port state word for the report: 1 up / 2 down / 3 missing / anything else = not probed
int wp_put_st(char *d, int *pos, int st) {
  if (st == 1) { return wp_puts(d, pos, "up\n"); }
  if (st == 2) { return wp_puts(d, pos, "down\n"); }
  if (st == 3) { return wp_puts(d, pos, "missing\n"); }
  return wp_puts(d, pos, "wait\n");
}

// ===== paint helpers (explicit rects: no reliance on the auto layout cursor) ===================
// A button that was really clicked must be painted once more next frame: the frame that consumed
// the click was already built with the OLD state (immediate mode). Without this the "only paint
// when dirty" rule would swallow page/theme switches -- that is the trap this flag closes.
int wp_hit_repaint(int hit) {
  if (hit == 1) { wp_dirty = 2; return 1; }
  return 0;
}

// panel fill (kind 1 -> theme_panel): the three chrome bars are cards over the base.
//
// WHY the app paints its own whole client area every frame (found while building v3, measured):
//   the library's background pass (`surf_paint`, in lib\ui_lib.fl) does
//   `if (s->br_fill == 0) s->br_fill = CreateSolidBrush(fill);` -- it caches ONE brush built from
//   the colour of the FIRST frame. That is invisible as long as an app never changes its theme,
//   which was true of every app until now: after a runtime switch to the dark theme the window
//   base kept the LIGHT colours (measured: screen pixels at (500,200) stayed F6F8FB = the light
//   theme_bg while the title bar went 5D5D5D). The library must not be touched this round, so the
//   app paints its own base: a full-client kind 11 fill drawn after the library's background pass
//   covers the stale fill. The base colour is therefore theme_track, not theme_bg.
int wp_fill_panel(struct GuiCtx *c, int x, int y, int w, int h) {
  struct GuiRect r;
  r.x = x; r.y = y; r.w = w; r.h = h;
  gui_item_at(c, &r);
  gui_text_put(c, "");
  if (gui_clip_visible(c)) { gui_push(c, 1); }
  return 0;
}

// base fill (kind 11 -> theme_track). Why exactly kind 11, measured twice:
//   * it is the only theme field whose command is a PLAIN rect fill distinct from theme_panel:
//     gwb_box_kind(11) = 0 (no rounding), gwb_box_edge(11) = 0 (no border), no shadow (kind 1
//     only), and no slider thumb as long as the NEXT command is not kind 5 or an equal-height
//     kind 12 (gwb_thumb_plan). The base is the first command of every frame and the next one is
//     the title bar (kind 1) => the thumb heuristic returns 0 before it can paint anything.
//   * the bars must NOT be kind 11: each of them is followed by its label (kind 5), which the
//     renderer reads as "a slider whose value is 0" and answers with a circular theme_fill thumb
//     (measured: a 32px blue disc in the title bar's corner and a 26px one at the bottom left).
// So: base = track, chrome bars = panel cards -- which is also the modern blue-white look (white
// cards on a light blue-grey base; in the dark theme #202020 cards on a #303030 base).
int wp_fill_base(struct GuiCtx *c, int x, int y, int w, int h) {
  struct GuiRect r;
  r.x = x; r.y = y; r.w = w; r.h = h;
  gui_item_at(c, &r);
  gui_text_put(c, "");
  if (gui_clip_visible(c)) { gui_push(c, 11); }
  return 0;
}

// text with an explicit colour (kind 5 honours gui_cmd_col)
int wp_label_col(struct GuiCtx *c, int x, int y, int w, char *s, int col) {
  struct GuiRect r;
  r.x = x; r.y = y; r.w = w; r.h = c->line_h;
  gui_item_at(c, &r);
  gui_text_put_col(c, s, col);
  if (gui_clip_visible(c)) { gui_push(c, 5); }
  return 0;
}

int wp_btn(struct GuiCtx *c, int x, int y, int w, int h, char *s) {
  struct GuiRect r;
  int hit = 0;
  r.x = x; r.y = y; r.w = w; r.h = h;
  gui_next_rect(c, &r);
  hit = gui_button(c, s);
  return hit;
}

// Every button gets its label drawn on top of it as a SEPARATE text command, because the platform
// layer renders text for `kind 5` only: `gui_button` hands its string to the command table (it is
// used for the hit id and the width), but the one and only `TextOutA` in lib\flgui_win32.fl sits in
// the `k == 5` branch -- so a button's own text never reaches the screen. Measured on the v2
// delivery as well (its tabs / title buttons / Probe were blank boxes): this is an app-side fix of
// a library-level gap, which the hard boundary of this round leaves untouched.
int wp_btn_label(struct GuiCtx *c, int x, int y, int w, int h, char *s, int col) {
  int tw = gui_text_w(s);
  int tx = x + (w - tw) / 2;
  int ty = y + (h - c->line_h) / 2;
  if (tw > w) { tx = x; }
  if (tx < x) { tx = x; }
  if (ty < y) { ty = y; }
  return wp_label_col(c, tx, ty, tw, s, col);
}

int wp_bar(struct GuiCtx *c, int x, int y, int w, int h, int v, int mx) {
  struct GuiRect r;
  r.x = x; r.y = y; r.w = w; r.h = h;
  gui_next_rect(c, &r);
  gui_progressbar(c, "", v, mx);
  return 0;
}

// "DISK C:  used x.y / total x.y G   pct%"
int wp_disk_line(char *b, int *p, char *name, int free_x10, int total_x10) {
  int used = 0;
  int pct = 0;
  wp_puts(b, p, name);
  wp_puts(b, p, "  used ");
  if (free_x10 < 0) { return wp_puts(b, p, "missing"); }
  used = total_x10 - free_x10;
  if (used < 0) { used = 0; }
  pct = used * 100 / total_x10;
  wp_puti(b, p, used / 10);
  wp_puts(b, p, ".");
  wp_puti(b, p, used % 10);
  wp_puts(b, p, " / ");
  wp_puti(b, p, total_x10 / 10);
  wp_puts(b, p, ".");
  wp_puti(b, p, total_x10 % 10);
  wp_puts(b, p, " G   ");
  wp_puti(b, p, pct);
  return wp_puts(b, p, "%");
}

// one disk block (label row + utilisation bar); returns the y for the next block
int wp_disk_block(struct GuiCtx *c, int y, char *name, int free_x10, int total_x10, int w) {
  char b[256];
  int p = 0;
  int v = 0;
  p = 0;
  wp_disk_line(b, &p, name, free_x10, total_x10);
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c));
  v = 0;
  if (free_x10 >= 0) {
    v = total_x10 - free_x10;
    if (v < 0) { v = 0; }
  }
  wp_bar(c, wp_cx, y + WP_BAR_DY, w, WP_BAR_H, v, total_x10);
  return y + WP_DISK_BLK;
}

// nav labels: the selected item is marked with a ">" prefix (no Tab widget exists yet, so the
// four gui_buttons ARE the page tabs -- the work order explicitly allows a prefix marker).
char *wp_nav1() { wp_nav_build(WP_PAGE_LOCAL, WP_LK_NAV_LOCAL); return wp_navbuf; }
char *wp_nav2() { wp_nav_build(WP_PAGE_PORTS, WP_LK_NAV_PORTS); return wp_navbuf; }
char *wp_nav3() { wp_nav_build(WP_PAGE_SELF, WP_LK_NAV_SELF); return wp_navbuf; }
char *wp_nav4() { wp_nav_build(WP_PAGE_STARTUP, WP_LK_NAV_STARTUP); return wp_navbuf; }
char *wp_nav5() { wp_nav_build(WP_PAGE_ACTIONS, WP_LK_NAV_ACTIONS); return wp_navbuf; }
char *wp_nav6() { wp_nav_build(WP_PAGE_SYSTEM, WP_LK_NAV_SYSTEM); return wp_navbuf; }
char *wp_nav7() { wp_nav_build(WP_PAGE_ENV, WP_LK_NAV_ENV); return wp_navbuf; }

int wp_port_row(struct GuiCtx *c, int y, char *name, int st) {
  char b[80];
  int p = 0;
  wp_puts(b, &p, name);
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, WP_STATE_DX, b, wp_ctext(c));
  p = 0;
  wp_puts(b, &p, wp_st_word(st));
  wp_end(b, &p);
  wp_label_col(c, wp_cx + WP_STATE_DX, y, 240, b, wp_st_col(c, st));
  return 0;
}

// ===== title bar cluster (derived from WP_W, so no coordinate is spelled twice) ================
int wp_tbtn_y() { return (WP_TITLE_H - WP_TBTN_H) / 2; }
int wp_close_x() { return WP_W - WP_PAD_R - WP_TBTN_W; }
int wp_theme_x() { return wp_close_x() - WP_GAP - WP_THEME_W; }
int wp_setupbtn_x() { return wp_theme_x() - WP_GAP - WP_SETUP_W; }
// v6 (C): the title cluster gained the REAL minimize button; the collapse control moved one slot
// left and now says "<<". Both are still derived from WP_W, so no coordinate is spelled twice.
int wp_min_x() { return wp_setupbtn_x() - WP_GAP - WP_TBTN_W; }
int wp_coll_x() { return wp_min_x() - WP_GAP - WP_TBTN_W; }
int wp_drag_max_x() { return wp_coll_x() - WP_GAP; }

// ===== the settings page (the secondary page; it covers the content area) ======================
int wp_setup_x() { return WP_NAV_W; }
int wp_setup_y() { return WP_TITLE_H; }
int wp_setup_w() { return WP_W - WP_NAV_W; }
int wp_setup_h() { return WP_H - WP_TITLE_H - WP_BOT_H; }
int wp_sp_lx() { return WP_NAV_W + WP_SPAD; }
int wp_sp_lw() { return (WP_W - WP_NAV_W) - 2 * WP_SPAD; }
int wp_sp_ty() { return WP_TITLE_H + WP_SP_PAD; }
int wp_sl_y() { return wp_sp_ty() + 2 * WP_ROW; }
// v5: TWO value lines under the slider -- "Opacity <n>" then "Transparency <n>". Both are the same
// knob read from its two ends (opacity = 100 - transparency) and both are plain 0..100 integers.
int wp_opa_y() { return wp_sl_y() + WP_LINE_H + WP_SL_GAP; }
int wp_tr_y() { return wp_opa_y() + WP_LINE_H; }
// v6 (B): the "Layer:" row sits one line + gap under the transparency line, and the Back button is
// pushed one row further down (wp_back_y) so the three rows never overlap.
int wp_layer_y() { return wp_tr_y() + WP_LINE_H + WP_LAY_GAP; }
// v10 (M12): the three layer buttons all sit on the wp_layer_y() row. The x positions are derived
// from ONE pitch so the self-check can recompute each of them from the same constants main.fl uses.
int wp_lay_x(int i) { return wp_sp_lx() + i * WP_LAYBTN_DX; }
// v9 (M9): the Language row, the Config row and the cfg info line sit under the `state:` line that
// follows the Layer row, and Back is derived from the info line -- ONE chain, no spelled-out y. The
// judge mirrors this very chain over the same constants (see verify-panel.ps1's geo expectations).
int wp_state_y() { return wp_layer_y() + WP_NAVBTN_H + 4; }
int wp_lang_y() { return wp_state_y() + WP_LINE_H + WP_CFG_GAP; }
int wp_cfg_y() { return wp_lang_y() + WP_NAVBTN_H + WP_CFG_GAP; }
int wp_cfginfo_y() { return wp_cfg_y() + WP_NAVBTN_H + 4; }
int wp_back_y() { return wp_cfginfo_y() + WP_CFG_INFO_H; }

// ===== the four pages =========================================================================
int wp_page_local(struct GuiCtx *c) {
  char b[320];
  int p = 0;
  int y = 0;
  int w = 0;
  w = WP_W - wp_cx - 28;
  y = WP_TITLE_H + 10;

  wp_label_col(c, wp_cx, y, 620, "ENGINE  state-snapshot.txt", wp_cdim(c));
  y = y + WP_ROW;

  p = 0;
  wp_puts(b, &p, "MEM   ");
  if (wp_mem_ok == 1) { wp_puts(b, &p, wp_mem); } else { wp_puts(b, &p, "missing"); }
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c));
  y = y + WP_ROW;

  // task_first carries Chinese in the real snapshot: this row is the live proof that the
  // UTF-8 -> ANSI path plus the NUL-terminated slice really renders CJK.
  p = 0;
  wp_puts(b, &p, "TASK1 ");
  if (wp_t1_ok == 1) { wp_puts(b, &p, wp_t1); } else { wp_puts(b, &p, "missing"); }
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_cacc(c));
  y = y + WP_ROW;

  p = 0;
  wp_puts(b, &p, "TASKS ");
  wp_num_or_missing(b, &p, wp_tasks);
  wp_puts(b, &p, " open    CAND ");
  wp_num_or_missing(b, &p, wp_cand);
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c));
  y = y + WP_ROW;

  p = 0;
  wp_puts(b, &p, "SEC   danger ");
  wp_num_or_missing(b, &p, wp_sd);
  wp_puts(b, &p, "   warn ");
  wp_num_or_missing(b, &p, wp_sw);
  wp_puts(b, &p, "   info ");
  wp_num_or_missing(b, &p, wp_si);
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c));
  y = y + WP_ROW + 6;

  y = wp_disk_block(c, y, "DISK C:", wp_dc, WP_TOTAL_C_X10, w);
  y = wp_disk_block(c, y, "DISK E:", wp_de, WP_TOTAL_E_X10, w);
  return 0;
}

