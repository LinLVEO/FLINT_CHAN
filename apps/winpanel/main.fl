  wp_puts(out, &p, "layer_mode_word="); wp_puts(out, &p, wp_layer_mode_word()); wp_puts(out, &p, "\n");
  // ---- v10 (M12): the foreground reading the `auto` rule consumes --------------------------------
  // Every number here is a live OS answer taken during THIS dump run (GetForegroundWindow /
  // GetWindowThreadProcessId / IsWindowVisible / IsIconic / GetWindowRect), never a stored claim. The
  // judge asks the same questions from its own process and compares: that is what makes "auto is
  // driven by the FOREGROUND window" checkable with the app's own numbers as a second witness.
  //   fg_overlap  : does the foreground rect intersect the PANEL's rect (the panel's own geometry,
  //                 since headless mode has no window)
  //   fg_is_self  : is the foreground window this process's panel window (always 0 headless: there
  //                 is no panel window; it is computed by the same code path the window mode uses)
  wp_fg_compute(0);              // headless: no panel window, so is_self is 0 by construction
  wp_puts(out, &p, "fg_pid="); wp_puti(out, &p, wp_fgv_pid); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fg_is_self="); wp_puti(out, &p, wp_fgv_self); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fg_visible="); wp_puti(out, &p, wp_fgv_visible); wp_puts(out, &p, "\n");
  wp_puts(out, &p, "fg_iconic="); wp_puti(out, &p, wp_fgv_iconic); wp_puts(out, &p, "\n");
