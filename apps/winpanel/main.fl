  wp_puts(b, &p, "/5   last ");
  wp_puti(b, &p, wp_probe_ms);
  wp_puts(b, &p, " ms   total ");
  wp_puti(b, &p, wp_probe_total);
  wp_puts(b, &p, " ms");
  wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_cdim(c));
  return 0;
}

