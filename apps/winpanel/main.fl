  p = 0; wp_puts(b, &p, "window      "); wp_puti(b, &p, WP_W); wp_puts(b, &p, " x "); wp_puti(b, &p, WP_H); wp_end(b, &p);
  wp_label_col(c, wp_cx, y, 620, b, wp_ctext(c));
