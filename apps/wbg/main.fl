int g_px[1024];
int g_py[1024];
int g_drag = -1;
char g_wtext[2048];

int kind_color(int off, int len) {
  int h = 0;
  int i = 0;
  int c = 0;
  while (i < len) { h = (h * 31 + g_buf[off + i]) % 997; i = i + 1; }
  c = h % 6;
  if (c == 0) { return 0x6A5ACD; }
  if (c == 1) { return 0x3C9B3C; }
  if (c == 2) { return 0xB07A2A; }
  if (c == 3) { return 0xA03C3C; }
  if (c == 4) { return 0x3C7BA0; }
  return 0x8A3CA0;
}

int node_at(int x, int y) {
  int i = 0;
  while (i < g_nn) {
    int dx = g_px[i] - x;
    int dy = g_py[i] - y;
    if (dx * dx + dy * dy < 900) { return i; }
    i = i + 1;
  }
  return 0 - 1;
}

// 简单力导向：斥力(150px 内) + 弹簧(有边拉近) + 夹回窗口
int layout_graph() {
  int i = 0;
  int j = 0;
  int it = 0;
  i = 0;
  while (i < g_nn) {
    g_px[i] = 260 + (i % 6) * 110;
    g_py[i] = 120 + (i / 6) * 110;
    i = i + 1;
  }
  it = 0;
  while (it < 80) {
    i = 0;
    while (i < g_nn) {
      j = i + 1;
      while (j < g_nn) {
        int dx = g_px[j] - g_px[i];
        int dy = g_py[j] - g_py[i];
        int d2 = dx * dx + dy * dy;
        if (d2 < 400) { d2 = 400; }
        if (d2 < 22500) {
          int f = 700000 / d2;
          g_px[i] = g_px[i] - dx * f / 100;
          g_py[i] = g_py[i] - dy * f / 100;
          g_px[j] = g_px[j] + dx * f / 100;
          g_py[j] = g_py[j] + dy * f / 100;
        }
        j = j + 1;
      }
      i = i + 1;
    }
    i = 0;
    while (i < g_ne) {
      int a = find_node_in_buf(g_e[i].aoff, g_e[i].alen);
      int b = find_node_in_buf(g_e[i].boff, g_e[i].blen);
      if (a >= 0 && b >= 0 && a != b) {
        int dx = g_px[b] - g_px[a];
        int dy = g_py[b] - g_py[a];
        g_px[a] = g_px[a] + dx / 30;
        g_py[a] = g_py[a] + dy / 30;
        g_px[b] = g_px[b] - dx / 30;
        g_py[b] = g_py[b] - dy / 30;
      }
      i = i + 1;
    }
    it = it + 1;
  }
  i = 0;
  while (i < g_nn) {
    if (g_px[i] < 70) { g_px[i] = 70; }
    if (g_px[i] > 930) { g_px[i] = 930; }
    if (g_py[i] < 70) { g_py[i] = 70; }
    if (g_py[i] > 630) { g_py[i] = 630; }
    i = i + 1;
  }
  return 1;
}

int draw_wtext(int *dc, int x, int y, int off, int len) {
  int wl = MultiByteToWideChar(65001, 0, &g_buf[off], len, &g_wtext[0], 1020);
  if (wl <= 0) { return 0; }
  TextOutW(dc, x, y, &g_wtext[0], wl);
  return wl;
}

int draw_graph(int *hwnd) {
  int *dc = GetDC(hwnd);
  int i = 0;
  if (dc == 0) { return 0; }
  SelectObject(dc, GetStockObject(18));
  SetDCBrushColor(dc, 0x1E1E1E);
  PatBlt(dc, 0, 0, 1000, 700, 0xF00021);
  SetBkMode(dc, 1);
  // 边
  SelectObject(dc, GetStockObject(7));
  SetDCBrushColor(dc, 0x505050);
  i = 0;
  while (i < g_ne) {
    int a = find_node_in_buf(g_e[i].aoff, g_e[i].alen);
    int b = find_node_in_buf(g_e[i].boff, g_e[i].blen);
    if (a >= 0 && b >= 0) {
      MoveToEx(dc, g_px[a], g_py[a], 0);
      LineTo(dc, g_px[b], g_py[b]);
      SetTextColor(dc, 0x808080);
      int mx = (g_px[a] + g_px[b]) / 2;
      int my = (g_py[a] + g_py[b]) / 2;
      draw_wtext(dc, mx + 4, my - 8, g_e[i].roff, g_e[i].rlen);
    }
    i = i + 1;
  }
  // 节点
  i = 0;
  while (i < g_nn) {
    int col = kind_color(g_n[i].koff, g_n[i].klen);
    SelectObject(dc, GetStockObject(0));
    SetDCBrushColor(dc, col);
    SelectObject(dc, CreateSolidBrush(col));
    Ellipse(dc, g_px[i] - 26, g_py[i] - 26, g_px[i] + 26, g_py[i] + 26);
    SetTextColor(dc, 0xE0E0E0);
    draw_wtext(dc, g_px[i] - 20, g_py[i] + 34, g_n[i].noff, g_n[i].nlen);
    i = i + 1;
  }
  ReleaseDC(hwnd, dc);
  return 0;
}

int wbg_wndproc(int *hwnd, int msg, int *wp, int *lp) {
  if (msg == 0x000F) {
    draw_graph(hwnd);
    ValidateRect(hwnd, 0);
    return 0;
  }
  if (msg == 0x0201) {
    int x = lp % 65536;
    int y = (lp / 65536) % 65536;
    g_drag = node_at(x, y);
    return 0;
  }
  if (msg == 0x0200) {
    int x = lp % 65536;
    int y = (lp / 65536) % 65536;
    if (g_drag >= 0 && g_drag < g_nn) {
      g_px[g_drag] = x;
      g_py[g_drag] = y;
      InvalidateRect(hwnd, 0, 0);
    }
    return 0;
  }
  if (msg == 0x0202) { g_drag = 0 - 1; return 0; }
  if (msg == 0x0010) { ExitProcess(0); return 0; }
  return DefWindowProcA(hwnd, msg, wp, lp);
}

int log_step(char *s) {
  struct FileSt f;
  if (std::open(&f, "wbg.log", 2) == 0) { return 0; }
  std::write(&f, s, slen(s));
  std::write(&f, "\n", 1);
  std::close(&f);
  return 1;
}
int gui_main() {
  struct WNDCLASS wc;
  int *h = 0;
  struct MSG m;
  if (load_file() == 0) {
    print(["找不到 world.txt（先用 add 建一个）\n"]);
    return 1;
  }
  parse_all();
  layout_graph();
  wc.style = 0;
  wc.fn = &wbg_wndproc;
  wc.cb1 = 0; wc.cb2 = 0;
  wc.inst = GetModuleHandleA(0);
  wc.icon = 0; wc.cur = LoadCursorA(0, 32512); wc.brush = 0; wc.menu = 0;
  wc.cls = "FLINTWBG";
  if (RegisterClassA(&wc) == 0) { return 1; }
  h = CreateWindowExA(0, wc.cls, "wbg - world graph", 0x00CF0000, 120, 90, 1000, 700, 0, 0, 0, 0);
  if (h == 0) { return 2; }
  ShowWindow(h, 1);
  while (GetMessageA(&m, 0, 0, 0) != 0) {
    TranslateMessage(&m);
    DispatchMessageA(&m);
  }
  return 0;
}
// ===== main =====
int main() {
  char a[512];
  char b[512];
  char c[512];
  char d[512];
  int n = 0;
  int i = 0;
  SetConsoleOutputCP(65001);
  g_path[0] = 119; g_path[1] = 111; g_path[2] = 114; g_path[3] = 108; g_path[4] = 100;
  g_path[5] = 46; g_path[6] = 116; g_path[7] = 120; g_path[8] = 116; g_path[9] = 0;

  load_cmdline();
  n = get_argc();
  if (n <= 1) {
    print(["wbg — 世界观图谱\n"]);
    print(["  用法: wbg <命令> [参数]\n"]);
    print(["    ls [kind]              列节点\n"]);
    print(["    show <name>            一个节点的全部关系\n"]);
    print(["    add <kind> <name> [note]\n"]);
    print(["    link <from> <rel> <to>\n"]);
    print(["    rm <name>              删节点（连带删它的边）\n"]);
    print(["    check                  校验\n"]);
    return gui_main();
    return 0;
  }

  get_arg(1, &a[0], 512);
  if (load_file() == 0) {
    // 没有 world.txt：只有 add 能创建
    if (seq(&a[0], slen(&a[0]), "add") != 0) {
      print(["找不到 world.txt（先用 add 建一个）\n"]);
      return 1;
    }
  }
  parse_all();

  if (seq(&a[0], slen(&a[0]), "ls") != 0) {
    if (n > 2) { get_arg(2, &b[0], 512); return cmd_ls(&b[0]); }
    return cmd_ls(0);
  }
  if (seq(&a[0], slen(&a[0]), "show") != 0) {
    if (n <= 2) { print(["show 要一个名字\n"]); return 1; }
    get_arg(2, &b[0], 512);
    return cmd_show(&b[0]);
  }
  if (seq(&a[0], slen(&a[0]), "add") != 0) {
    if (n <= 3) { print(["add 要 kind 和 name\n"]); return 1; }
    get_arg(2, &b[0], 512);
    get_arg(3, &c[0], 512);
    if (n > 4) { get_arg(4, &d[0], 512); return cmd_add(&b[0], &c[0], &d[0]); }
    return cmd_add(&b[0], &c[0], 0);
  }
  if (seq(&a[0], slen(&a[0]), "link") != 0) {
    if (n <= 4) { print(["link 要 from rel to\n"]); return 1; }
    get_arg(2, &b[0], 512);
    get_arg(3, &c[0], 512);
    get_arg(4, &d[0], 512);
    return cmd_link(&b[0], &c[0], &d[0]);
  }
  if (seq(&a[0], slen(&a[0]), "check") != 0) { return cmd_check(); }
  if (seq(&a[0], slen(&a[0]), "rm") != 0) {
    if (n <= 2) { print(["rm 要一个名字\n"]); return 1; }
    get_arg(2, &b[0], 512);
    return cmd_rm(&b[0]);
    return 1;
  }
  print(["不认识的命令: ", a, "\n"]);
  return 1;
}
