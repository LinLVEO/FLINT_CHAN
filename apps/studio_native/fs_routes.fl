// fs_routes.fl — 目录遍历（/api/dirs、/api/files）
// WIN32_FIND_DATAA（x64，4 字节对齐，共 320 字节）：
//   0   dwFileAttributes          4 ftCreationTime(8)   12 ftLastAccessTime(8)
//   20  ftLastWriteTime(8)        28 nFileSizeHigh      32 nFileSizeLow
//   36  dwReserved0               40 dwReserved1
//   44  cFileName[260]            304 cAlternateFileName[14]
// ⚠️ 结构体一律建在 char 缓冲上按字节偏移访问（局部 int 数组是 8 字节槽，会把布局撑歪）。

int g_outn = 0;            // g_out 的写游标（列目录时边遍历边拼 JSON）

int seq(char *a, char *b) {
  int i = 0;
  while (a[i] != 0 && b[i] != 0) {
    if (a[i] != b[i]) { return 0; }
    i = i + 1;
  }
  return a[i] == b[i];
}

int has_ext(char *name, char *ext) {
  int n = 0;
  int m = 0;
  int i = 0;
  n = sl(name);
  m = sl(ext);
  if (n < m) { return 0; }
  while (i < m) {
    if (name[n - m + i] != ext[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}

int fs_attr(char *fd) {
  return (fd[0] & 255) + (fd[1] & 255) * 256 + (fd[2] & 255) * 65536 + (fd[3] & 255) * 16777216;
}

int fs_size(char *fd) {
  return (fd[32] & 255) + (fd[33] & 255) * 256 + (fd[34] & 255) * 65536 + (fd[35] & 255) * 16777216;
}

int glob_of(char *out, char *dir) {
  int n = 0;
  n = ap(out, 0, dir);
  out[n] = 92; n = n + 1;
  out[n] = 42; n = n + 1;   // '*'
  out[n] = 0;
  return n;
}

// 列目录：kind 1=只要目录 2=只要 .fl 文件
// 条目直接写进 g_out（调用方负责前后各补 "[" 与 "]"）
int list_dir(char *dir, char *relPrefix, int depth, int kind, int *count) {
  char pat[600];
  char fd[320];
  char name[300];
  char rel[600];
  char sub[600];
  char *h = 0;      // 64 位句柄（v1.10.1：api 的 ptr 形参 / ptr 返回）
  int ok = 0;
  int i = 0;
  int n = 0;
  int isd = 0;
  int rl = 0;
  int p = 0;
  int q = 0;

  glob_of(pat, dir);
  h = FindFirstFileA(pat, fd);
  if (h == 0) { return 0; }
  ok = 1;
  while (ok != 0) {
    i = 44;
    n = 0;
    while (fd[i] != 0 && n < 298) { name[n] = fd[i]; n = n + 1; i = i + 1; }
    name[n] = 0;
    if (name[0] != 46) {   // 跳过 . 开头的（. 与 .. 自然也被跳掉，且不列 .git）
      if (seq(name, "..") == 0) {
        isd = 0;
        if ((fs_attr(fd) & 16) != 0) { isd = 1; }
        p = 0;
        p = ap(rel, 0, relPrefix);
        if (p > 0) { rel[p] = 47; p = p + 1; }
        p = ap(rel, p, name);
        rel[p] = 0;
        rl = p;
        if (isd == 1 && (kind == 1 || kind == 3)) {
          if (*count > 0) { g_out[g_outn] = 44; g_outn = g_outn + 1; }
          g_outn = ap(g_out, g_outn, "{\"path\":\"");
          g_outn = json_esc(g_out, g_outn, rel, rl);
          g_outn = ap(g_out, g_outn, "\",\"dir\":true}");
          *count = *count + 1;
        }
        if (isd == 0 && (kind == 2 || kind == 3)) {
          if (has_ext(name, ".fl") != 0) {
            if (*count > 0) { g_out[g_outn] = 44; g_outn = g_outn + 1; }
            g_outn = ap(g_out, g_outn, "{\"path\":\"");
            g_outn = json_esc(g_out, g_outn, rel, rl);
            g_outn = ap(g_out, g_outn, "\",\"bytes\":");
            g_outn = apnum(g_out, g_outn, fs_size(fd));
            g_outn = ap(g_out, g_outn, "}");
            *count = *count + 1;
          }
        }
        if (isd == 1 && depth < 4) {
          if (*count < 300) {
            q = ap(sub, 0, dir);
            sub[q] = 92; q = q + 1;
            q = ap(sub, q, name);
            sub[q] = 0;
            list_dir(sub, rel, depth + 1, kind, count);
          }
        }
      }
    }
    ok = FindNextFileA(h, fd);
  }
  FindClose(h);
  return *count;
}
