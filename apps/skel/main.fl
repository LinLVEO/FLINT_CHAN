// skel.fl — 文件骨架提取器（给读的人/读的模型看）
//
// 为什么有它：读一个大文件（4000 行的 C、800 行的 FLINT、1200 行的 md）时，
//   最贵的是"不知道里面有什么就整读"。skel 先给出「函数/结构体/标题/注意行 + 行号」，
//   再定点读，省掉反复 grep 与全文读。
//
// 用法：skel <文件>
// 输出：
//   <path>: <bytes> bytes
//     <line>  F  <首 56 字符>      函数定义
//     <line>  S  <...>             结构体 / struct 定义
//     <line>  H  <...>             markdown 标题
//     <line>  D  <...>             #define
//     <line>  !  <...>             TODO / FIXME / XXX / ⚠ 等注意行
//
// 判据（别把它当编译器）：只做"行首形态"判断，不做语法分析——它要的是"够快够准"，
//   不是"完整 AST"。JSON/纯文本也能用（没有命中就只输出文件头）。

api kernel32 ptr GetCommandLineA();
api kernel32 ptr VirtualAlloc(int, int, int, int);
api kernel32 ptr VirtualFree(int, int, int);
api kernel32 int ExitProcess(int);

include "io_lib.fl"

// ===== 参数：取第一个参数（去引号）=====
int sk_args(char *out, int cap) {
  char *cmd = GetCommandLineA();
  int i = 0;
  int o = 0;
  int q = 0;
  while (cmd[i] == 32 || cmd[i] == 9) { i = i + 1; }
  if (cmd[i] == 34) {
    i = i + 1;
    while (cmd[i] != 0 && cmd[i] != 34) { i = i + 1; }
    if (cmd[i] == 34) { i = i + 1; }
  } else {
    while (cmd[i] != 0 && cmd[i] != 32 && cmd[i] != 9) { i = i + 1; }
  }
  while (cmd[i] == 32 || cmd[i] == 9) { i = i + 1; }
  if (cmd[i] == 0) { return 0; }
  if (cmd[i] == 34) { q = 1; i = i + 1; }
  while (cmd[i] != 0 && o < cap - 2) {
    if (q == 1) {
      if (cmd[i] == 34) { break; }
    } else {
      if (cmd[i] == 32 || cmd[i] == 9) { break; }
    }
    out[o] = cmd[i];
    o = o + 1;
    i = i + 1;
  }
  out[o] = 0;
  return o;
}

// 在 [a,b) 里找子串 w（NUL 结尾）；命中返回 1
int has(char *buf, int a, int b, char *w) {
  int n = 0;
  while (w[n] != 0) { n = n + 1; }
  if (n == 0) { return 0; }
  int i = a;
  while (i + n <= b) {
    int k = 0;
    while (k < n) {
      if (buf[i + k] != w[k]) { break; }
      k = k + 1;
    }
    if (k == n) { return 1; }
    i = i + 1;
  }
  return 0;
}

// 行首是否以 w 开头（w 是 NUL 结尾）
int pref(char *buf, int a, int b, char *w) {
  int n = 0;
  while (w[n] != 0) { n = n + 1; }
  if (a + n > b) { return 0; }
  int k = 0;
  while (k < n) {
    if (buf[a + k] != w[k]) { return 0; }
    k = k + 1;
  }
  return 1;
}

// 路径是否以 t 结尾
int ends(char *s, char *t) {
  int ls = 0;
  while (s[ls] != 0) { ls = ls + 1; }
  int lt = 0;
  while (t[lt] != 0) { lt = lt + 1; }
  if (lt > ls) { return 0; }
  int i = 0;
  while (i < lt) {
    if (s[ls - lt + i] != t[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}

// 行首（跳过空格/制表）位置
int first_nonspace(char *buf, int a, int b) {
  int i = a;
  while (i < b) {
    if (buf[i] != 32 && buf[i] != 9 && buf[i] != 13) { break; }
    i = i + 1;
  }
  return i;
}

// 打印一行：缩进 + 行号 + 标记 + 前 56 字符
int emit(char *buf, int a, int b, int line, char *tag) {
  print(["  "]);
  print([line]);
  print([tag]);
  int i = first_nonspace(buf, a, b);
  int n = 0;
  while (i < b && n < 56) {
    char c = buf[i];
    if (c == 10 || c == 13) { break; }
    print([c]);
    i = i + 1;
    n = n + 1;
  }
  print(["\n"]);
  return 0;
}

int main() {
  char argbuf[512];
  int n = sk_args(argbuf, 512);
  if (n < 1) {
    print(["usage: skel <file>\n"]);
    return 2;
  }
  char *path = argbuf;
  int sz = std::file_size(path);
  if (sz < 0) {
    print(["skel: cannot open ", path, "\n"]);
    return 1;
  }
  char *buf = VirtualAlloc(0, sz + 16, 0x3000, 4);
  if (buf == 0) { return 1; }
  int got = std::file_read(path, buf, sz + 1);
  if (got <= 0) {
    print(["skel: read failed ", path, "\n"]);
    return 1;
  }
  if (got > sz) { got = sz; }
  buf[got] = 0;

  print([path, ": ", got, " bytes\n"]);

  int is_md = ends(path, ".md");
  int line = 1;
  int i = 0;
  int ls = 0;
  int shown = 0;
  while (i <= got) {
    if (i == got || buf[i] == 10) {
      // 处理 [ls, i)
      int a = first_nonspace(buf, ls, i);
      if (a < i) {
        // md 的标题常写在引用块里（`> ## 标题`）——跳过 `>` 和空格再判断
        int a2 = a;
        if (buf[a2] == '>') {
          a2 = a2 + 1;
          while (a2 < i && (buf[a2] == 32 || buf[a2] == 9)) { a2 = a2 + 1; }
        }
        char c0 = buf[a2];
        char c1 = 0;
        if (a2 + 1 < i) { c1 = buf[a2 + 1]; }
        int is_comment = 0;
        if (c0 == '/' && c1 == '/') { is_comment = 1; }
        // 注意行优先（注释里的 TODO 也要报）
        if (has(buf, a, i, "TODO") == 1 || has(buf, a, i, "FIXME") == 1 || has(buf, a, i, "XXX") == 1) {
          if (shown < 400) { emit(buf, ls, i, line, "  !  "); shown = shown + 1; }
        } else if (is_comment == 0) {
          // md 标题（任何文件都认）
          if (c0 == '#' && c1 == '#') {
            if (shown < 400) { emit(buf, ls, i, line, "  H  "); shown = shown + 1; }
          }
          // 下面三类只对代码文件有意义（.md 里全是正文，误报率高）
          else if (is_md == 0 && c0 == '#' && has(buf, a, a + 8, "#define") == 1) {
            if (shown < 400) { emit(buf, ls, i, line, "  D  "); shown = shown + 1; }
          }
          else if (is_md == 0 && has(buf, a, a + 8, "struct ") == 1 && has(buf, a, i, "{") == 1) {
            if (shown < 400) { emit(buf, ls, i, line, "  S  "); shown = shown + 1; }
          }
          // 函数定义：有 '('、无 ';'、不是赋值行、不是控制流
          else if (is_md == 0 && has(buf, a, i, "(") == 1 && has(buf, a, i, ";") == 0 && has(buf, a, i, "=") == 0) {
            int ctrl = pref(buf, a, i, "return") + pref(buf, a, i, "if") + pref(buf, a, i, "while") +
                       pref(buf, a, i, "for") + pref(buf, a, i, "switch") + pref(buf, a, i, "else") +
                       pref(buf, a, i, "case") + pref(buf, a, i, "sizeof") + pref(buf, a, i, "{") +
                       pref(buf, a, i, "}") + pref(buf, a, i, "*") + pref(buf, a, i, "|") +
                       pref(buf, a, i, "&") + pref(buf, a, i, ")") + pref(buf, a, i, ",");
            if (ctrl == 0 && shown < 400) { emit(buf, ls, i, line, "  F  "); shown = shown + 1; }
          }
        }
      }
      line = line + 1;
      ls = i + 1;
    }
    i = i + 1;
  }
  if (shown == 0) { print(["  (no structure found)\n"]); }
  print(["[", shown, " items]\n"]);
  VirtualFree(buf, 0, 0x8000);
  return 0;
}
