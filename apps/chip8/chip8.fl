// chip8.fl — CHIP-8 无头自测前端：核心在 chip8_core.fl，本文件只放 10 项位掩码用例（判据 = 42）
// 编译：hlc.exe apps\chip8\chip8.fl ｜ boot\b1_emit.exe apps\chip8\chip8.fl
include "chip8_core.fl"
int main() {
  struct C8 c;
  char mem[4096];
  int fb[2048];
  int mask = 0;

  // ---- T1: 6XNN 装载 + 7XNN 回绕 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x60FF);
  c8_poke2(mem, 0x202, 0x7002);
  c8_exec(&c, mem, fb);
  c8_exec(&c, mem, fb);
  if (c.v[0] == 0x01) { mask = mask | 1; }

  // ---- T2: 8XY4 加法进位 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x60FF);
  c8_poke2(mem, 0x202, 0x6102);
  c8_poke2(mem, 0x204, 0x8014);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (c.v[0] == 0x01 && c.v[0xF] == 1) { mask = mask | 2; }

  // ---- T3: 位运算 OR / AND / XOR ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x60F0);
  c8_poke2(mem, 0x202, 0x613C);
  c8_poke2(mem, 0x204, 0x8200);      // V2 = V0
  c8_poke2(mem, 0x206, 0x8211);      // V2 |= V1 => FC
  c8_poke2(mem, 0x208, 0x8300);      // V3 = V0
  c8_poke2(mem, 0x20A, 0x8312);      // V3 &= V1 => 30
  c8_poke2(mem, 0x20C, 0x8400);      // V4 = V0
  c8_poke2(mem, 0x20E, 0x8413);      // V4 ^= V1 => CC
  int k = 0;
  while (k < 8) { c8_exec(&c, mem, fb); k = k + 1; }
  if (c.v[2] == 0xFC && c.v[3] == 0x30 && c.v[4] == 0xCC) { mask = mask | 4; }

  // ---- T4: 右移 / 左移 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x6081);
  c8_poke2(mem, 0x202, 0x8066);
  c8_poke2(mem, 0x204, 0x6180);
  c8_poke2(mem, 0x206, 0x811E);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  int r1 = c.v[0];
  int f1 = c.v[0xF];
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (r1 == 0x40 && f1 == 1 && c.v[1] == 0x00 && c.v[0xF] == 1) { mask = mask | 8; }

  // ---- T5: 减法借位 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x6005);
  c8_poke2(mem, 0x202, 0x6109);
  c8_poke2(mem, 0x204, 0x8015);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (c.v[0] == 0xFC && c.v[0xF] == 0) { mask = mask | 16; }

  // ---- T6: call / ret ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x2300);
  c8_poke2(mem, 0x202, 0x6107);
  c8_poke2(mem, 0x300, 0x00EE);
  c8_exec(&c, mem, fb);
  int sp1 = c.sp;
  c8_exec(&c, mem, fb);
  c8_exec(&c, mem, fb);
  if (sp1 == 1 && c.v[1] == 7) { mask = mask | 32; }

  // ---- T7: 条件跳过 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x6007);
  c8_poke2(mem, 0x202, 0x3007);
  c8_poke2(mem, 0x204, 0x6199);
  c8_poke2(mem, 0x206, 0x4205);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (c.v[1] == 0) { mask = mask | 64; }

  // ---- T8: BCD / 寄存器存取 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x60EA);
  c8_poke2(mem, 0x202, 0xA400);
  c8_poke2(mem, 0x204, 0xF033);
  c8_poke2(mem, 0x206, 0xA410);
  c8_poke2(mem, 0x208, 0xF055);
  c8_poke2(mem, 0x20A, 0x6100);
  c8_poke2(mem, 0x20C, 0xF165);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  int b0 = c8_rd(mem, 0x400);
  int b1 = c8_rd(mem, 0x401);
  int b2 = c8_rd(mem, 0x402);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (b0 == 2 && b1 == 3 && b2 == 4 && c.v[0] == 234) { mask = mask | 128; }

  // ---- T9: 画精灵 + 碰撞 ----
  c8_reset(&c, mem, fb);
  c8_wr(mem, 0x300, 0x80);
  c8_wr(mem, 0x301, 0x40);
  c8_poke2(mem, 0x200, 0xA300);
  c8_poke2(mem, 0x202, 0xD012);
  c8_poke2(mem, 0x204, 0xD012);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  int p0 = fb[0];
  int p1 = fb[64 + 1];
  int cl = c.v[0xF];
  c8_exec(&c, mem, fb);
  if (p0 == 1 && p1 == 1 && cl == 0 && fb[0] == 0 && c.v[0xF] == 1) { mask = mask | 256; }

  // ---- T10: 延迟计时器 ----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x6009);
  c8_poke2(mem, 0x202, 0xF015);
  c8_poke2(mem, 0x204, 0xF107);
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (c.dt == 9 && c.v[1] == 9) { mask = mask | 512; }

  // ---- T11: EX9E（按着该键就跳过下一条）----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0x6005);      // V0 = 5
  c8_poke2(mem, 0x202, 0xE09E);      // 键 5 按着 ⇒ 跳过 0x204
  c8_poke2(mem, 0x204, 0x6199);      // 必须被跳过
  c.key = 5;
  c8_exec(&c, mem, fb); c8_exec(&c, mem, fb); c8_exec(&c, mem, fb);
  if (c.v[1] == 0) { mask = mask | 1024; }

  // ---- T12: FX0A（等键：没按时 PC 不动，按下后写进 VX）----
  c8_reset(&c, mem, fb);
  c8_poke2(mem, 0x200, 0xF00A);
  c8_exec(&c, mem, fb);
  int pc_wait = c.pc;
  c.key = 7;
  c8_exec(&c, mem, fb);
  if (pc_wait == 0x200 && c.v[0] == 7) { mask = mask | 2048; }

  // ---- T13: 键盘端到端（keys.ch8：键值 ×8 当 X 坐标画精灵）----
  c8_reset(&c, mem, fb);
  c8_wr(mem, 0x300, 0xC0);
  c8_wr(mem, 0x301, 0x30);
  c8_poke2(mem, 0x200, 0xF00A);      // V0 = 等键
  c8_poke2(mem, 0x202, 0x800E);      // V0 <<= 1
  c8_poke2(mem, 0x204, 0x800E);      // V0 <<= 1
  c8_poke2(mem, 0x206, 0x800E);      // V0 <<= 1 ⇒ x = key*8
  c8_poke2(mem, 0x208, 0x6100);      // V1 = 0
  c8_poke2(mem, 0x20A, 0xA300);      // I = 0x300
  c8_poke2(mem, 0x20C, 0xD012);      // 在 (key*8, 0) 画两行
  c8_poke2(mem, 0x20E, 0x1200);      // 回等键
  c.key = 4;
  k = 0;
  while (k < 7) { c8_exec(&c, mem, fb); k = k + 1; }
  if (c.v[0] == 32 && fb[32] == 1 && fb[33] == 1) { mask = mask | 4096; }

  if (mask == 8191) { return 42; }
  return mask;
}
