// f113_shockwave.fl -- 七彩冲击波（蓄力 -> 环扩散）：SDF 环带 + 彩虹色相 + 二次缓出
// 判据：8 位掩码全亮 -> 42；否则退当前掩码。
//
//   bit0  start 参数：power 夹到 1..3、active=1、r=10、maxr=80+power*70、life=26
//   bit1  tick 半径递增：t=1 -> 25，t=13 -> 167（二次缓出）
//   bit2  power 影响最大半径：power1 maxr=150、power3 maxr=290
//   bit3  生命周期：tick 26 次后 active=0（之后 tick 不再动）
//   bit4  环带命中：中心附近（半径 0）不命中；半径 167 附近的矩形命中；远处不命中
//   bit5  色相：0=纯红、42=黄、85≈绿、170≈蓝
//   bit6  蓄力映射：0->1、30->2、60->3
//   bit7  draw 画到 64x64 缓冲上有像素 + 同序列两次半径一致（确定性）
include "../../lib/shockwave.fl"

int main() {
  struct Shockwave s;
  struct Shockwave s2;
  struct GfxBuf b;
  int mem[4096];
  int m = 0;
  int r1 = 0;
  int r13 = 0;
  int r2a = 0;
  int r2b = 0;
  int col = 0;
  int i = 0;
  int n = 0;
  char *px = 0;

  // ---- bit0：start 参数 + power 夹取 ----
  if (sw_start(&s, 100, 100, 2) == 0) { return 1; }
  if (s.active == 1) { if (s.r == 10) { if (s.maxr == 220) { if (s.life == 26) { m = m | 1; } } } }
  if ((m & 1) == 0) { m = m & ~1; }
  sw_start(&s, 0, 0, 9);   // 夹到 3
  if (s.power != 3) { m = m & ~1; }

  // ---- bit1：半径递增（t=1 -> 25；t=13 -> 167）----
  sw_start(&s, 100, 100, 2);
  sw_tick(&s);
  r1 = s.r;
  i = 1;
  while (i < 13) { sw_tick(&s); i = i + 1; }
  r13 = s.r;
  if (r1 == 25) { if (r13 == 167) { m = m | 2; } }
  if ((m & 2) == 0) { m = m & ~2; }

  // ---- bit2：power 1 / 3 的 maxr ----
  sw_start(&s, 0, 0, 1);
  if (s.maxr == 150) { sw_start(&s, 0, 0, 3); if (s.maxr == 290) { m = m | 4; } }
  if ((m & 4) == 0) { m = m & ~4; }

  // ---- bit3：生命周期（26 次后 active=0；再 tick 半径不变）----
  sw_start(&s, 0, 0, 2);
  i = 0;
  while (i < 26) { sw_tick(&s); i = i + 1; }
  if (s.active == 0) {
    r2a = s.r;
    sw_tick(&s);
    r2b = s.r;
    if (r2a == r2b) { m = m | 8; }
  }
  if ((m & 8) == 0) { m = m & ~8; }

  // ---- bit4：环带命中判定 ----
  sw_start(&s, 100, 100, 3);   // maxr 290
  i = 0;
  while (i < 13) { sw_tick(&s); i = i + 1; }
  // 此时 r=167（power3 的同一缓动：10+(290-10)*507/676=10+210=220? 计算不同，按实测定）
  // 直接用 s.r 附近的矩形：圆心为 (100,100)，矩形放在 (100 + s.r - 6, 94, 12, 12)
  if (sw_hit(&s, 100, 100, 12, 12) == 0) { m = m | 16; }           // 中心不命中
  if (sw_hit(&s, 100 + s.r - 6, 94, 12, 12) != 1) { m = m & ~16; } // 环上命中
  if (sw_hit(&s, 100 + s.r + 200, 94, 12, 12) != 0) { m = m & ~16; } // 远处不命中

  // ---- bit5：色相 ----
  if (sw_hue(0) == 0x00FF0000) { m = m | 32; } else { m = m & ~32; }
  col = sw_hue(85);
  if (((col >> 8) & 255) == 255) { if ((col >> 16) < 32) { } else { m = m & ~32; } }
  if (((col >> 8) & 255) != 255) { m = m & ~32; }
  col = sw_hue(170);
  if ((col & 255) != 255) { m = m & ~32; }
  if (((col >> 8) & 255) > 32) { m = m & ~32; }

  // ---- bit6：蓄力映射 ----
  if (sw_charge_power(0, 60) == 1) { if (sw_charge_power(30, 60) == 2) { if (sw_charge_power(60, 60) == 3) { m = m | 64; } } }
  if ((m & 64) == 0) { m = m & ~64; }

  // ---- bit7：draw 有像素 + 确定性 ----
  b.bits = mem;
  b.w = 64;
  b.h = 64;
  b.stride = 64;
  i = 0;
  while (i < 4096) { mem[i] = 0; i = i + 1; }
  sw_start(&s, 32, 32, 2);
  sw_tick(&s);                 // t=1 -> r=25，环在 64x64 缓冲内
  n = sw_draw(&b, &s, 0, 0);
  if (n > 0) { m = m | 128; } else { m = m & ~128; }
  // 确定性：同参数同序列两次半径一致
  sw_start(&s, 32, 32, 2);
  sw_start(&s2, 32, 32, 2);
  i = 0;
  while (i < 17) { sw_tick(&s); sw_tick(&s2); i = i + 1; }
  if (s.r != s2.r) { m = m & ~128; }

  if (m != 255) { return m; }
  return 42;
}
