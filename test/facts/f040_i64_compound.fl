// f040_i64_compound.fl -- int_64 P2: COMPOUND ASSIGNMENT (+= -= *= /= %= <<= >>= &= |= ^=)
// on a 64-bit left value, across every storage class.
//
// WHAT IS UNDER TEST (before P2 every one of these was a loud compile error:
// "int_64 的复合赋值（op）暂不支持（v1.7.0 P0 边界：复合通路是 32 位）"):
//   (a) all ten operators exist for an int_64 left value;
//   (b) width: the read-modify-write is 64-bit, so bit 63 survives (an int / int_32 style
//       32-bit compound path would only touch the low half -- silent wrong values);
//   (c) the value domain matches the corresponding binary operator exactly: 2^64 wraparound
//       (MAX += 1 -> MIN, MAX *= 2 -> -2), signed division truncating toward zero (-7/2 = -3),
//       remainder taking the sign of the dividend (-7%3 = -1), arithmetic >>, and the shift
//       count masking to `count & 63` (<<= 64 is a no-op, same as `<<` in P1);
//   (d) every storage class takes it: local slot, global, int_64 array element with a variable
//       index, `*p` through an int_64*, `q[i]` through an int_64*, and a struct int_64 field;
//   (e) the expression value is the NEW value (`int_64 y = (x += 10);` -> y == 15);
//   (f) the ordinary int compound path is untouched (`int ni = 7; ni += 3; ni *= 2;` -> 20).
//
// HOW IT IS IMPLEMENTED (design decision D11: sugar must flatten at source level, no new
// codegen path): parse.c rewrites `LV op= RHS` into the already-supported form
//     t = &LV;   *t = *t op RHS      (t = one anonymous int_64* frame slot per site)
// so the existing P1 64-bit emitters for the binary operator do all the work, and the left
// value is evaluated EXACTLY ONCE (the address is taken once; see f041 for the call-counter
// proof). Nothing is added to src\codegen.c.
//
// SENTINEL: one bit per check; exit 42 only when the whole mask is 2147483647.
// The program prints the observed values first.
//
// HOW THE EXPECTED VALUES WERE COMPUTED (never hand-typed): Node.js BigInt, one shot
// (E:\FLINT-lab\tmp\int64p2\tmp\i64calc.js, which simulates the pinned semantics:
//  wrap to int64, shift count & 63, sar, trunc-toward-zero div, remainder sign of dividend).
//   node tmp\i64calc.js    ->   15, -5, -2, -3, -1, -9223372036854775808, (same), -2,
//                               2147483647, 255, 8589934592, -256, 1099511627777,
//                               1099511627876, 1099511627776, 1, 1099511627776,
//                               5497558138880, 5, 1099511627777, 1, 4294967296,
//                               4294967297, 1, 1099511627776, 1, 1099511627779, 15,
//                               -9223372036854775808, 9223372036854775807, 20
//   (in the order the assertions appear below)
//
// REVIEW COMMAND (worktree: replace E:\FLINT-lab with E:\FLINT-lab\tmp\int64p2):
//   powershell -NoProfile -ExecutionPolicy Bypass -File "E:\FLINT-lab\test\facts\facts-run.ps1" -Probe f040_i64_compound -Compiler flint -ExpectExit 42
// criterion: program exit = 42, stdout contains "mask=2147483647"
//
// WHY THE OPPOSITE END (boot) IS NOT COMPARED: boot has no int_64 yet (P2), so this probe is
// flint-only by design -- it is NOT a boot divergence (see docs decision D10 / int64 research 2.10).
//
// ASCII only, no BOM. No includes. 42 = all bits set, 7 = at least one bit missing.
int_64 g = 100;

struct S { int_64 f; }

int main() {
  int_64 maxv = 9223372036854775807;
  int_64 minv = 0 - 9223372036854775807 - 1;
  int mask = 0;

  // ---- the ten operators, small values first ----
  int_64 x = 10;
  x += 5;
  if (x == 15) { mask = mask + 1; }
  x -= 20;
  if (x == (0 - 5)) { mask = mask + 2; }

  int_64 m = maxv;
  m *= 2;                                   // 2^64 wraparound: (2^63-1)*2 == -2
  if (m == (0 - 2)) { mask = mask + 4; }

  int_64 d = 0 - 7;
  d /= 2;                                   // signed: truncation toward zero
  if (d == (0 - 3)) { mask = mask + 8; }

  int_64 r = 0 - 7;
  r %= 3;                                   // remainder takes the dividend's sign
  if (r == (0 - 1)) { mask = mask + 16; }

  int_64 sh = 1;
  sh <<= 63;                                // 1 << 63 = MIN
  if (sh == minv) { mask = mask + 32; }
  sh <<= 64;                                // count & 63 == 0 -> no-op (same rule as <<)
  if (sh == minv) { mask = mask + 64; }

  int_64 ar = 0 - 8;
  ar >>= 2;                                 // arithmetic shift keeps the sign
  if (ar == (0 - 2)) { mask = mask + 128; }
  int_64 hi = maxv;
  hi >>= 32;
  if (hi == 2147483647) { mask = mask + 256; }

  int_64 an = 0 - 1;
  an &= 255;
  if (an == 255) { mask = mask + 512; }
  int_64 orv = 0;
  orv |= 8589934592;                        // 2^33: needs bit 33, dead above 32 bits
  if (orv == 8589934592) { mask = mask + 1024; }
  int_64 xr = 0 - 1;
  xr ^= 255;
  if (xr == (0 - 256)) { mask = mask + 2048; }

  // ---- storage class: local slot ----
  int_64 loc = 1;
  loc += 1099511627776;                     // 1 + 2^40
  if (loc == 1099511627777) { mask = mask + 4096; }

  // ---- storage class: global ----
  g += 1099511627776;
  if (g == 1099511627876) { mask = mask + 8192; }
  g -= 100;
  if (g == 1099511627776) { mask = mask + 16384; }
  g >>= 40;
  if (g == 1) { mask = mask + 32768; }

  // ---- storage class: int_64 array element with a variable index ----
  int_64 a[4];
  a[0] = 0;
  a[1] = 0;
  a[2] = 0;
  a[3] = 5;
  int i = 2;
  a[i] += 1099511627776;
  if (a[2] == 1099511627776) { mask = mask + 65536; }
  i = 3;
  a[i] *= 1099511627776;
  if (a[3] == 5497558138880) { mask = mask + 131072; }
  a[i] /= 1099511627776;
  if (a[3] == 5) { mask = mask + 262144; }

  // ---- storage class: struct int_64 field ----
  struct S s;
  s.f = 1099511627776;
  s.f += 1;
  if (s.f == 1099511627777) { mask = mask + 524288; }
  s.f -= 1099511627776;
  if (s.f == 1) { mask = mask + 1048576; }

  // ---- storage class: *p through an int_64* ----
  int_64 v = 0;
  int_64 *p = &v;
  *p |= 4294967296;                         // 2^32
  if (v == 4294967296) { mask = mask + 2097152; }
  *p += 1;
  if (v == 4294967297) { mask = mask + 4194304; }
  *p ^= 4294967296;
  if (v == 1) { mask = mask + 8388608; }
  *p <<= 40;
  if (v == 1099511627776) { mask = mask + 16777216; }
  *p >>= 40;
  if (v == 1) { mask = mask + 33554432; }

  // ---- storage class: q[i] through an int_64* ----
  int_64 q[2];
  q[0] = 0;
  q[1] = 3;
  int_64 *qp = &q[0];
  qp[1] += 1099511627776;
  if (q[1] == 1099511627779) { mask = mask + 67108864; }

  // ---- the expression value is the NEW value ----
  int_64 e1 = 5;
  int_64 ev = (e1 += 10);
  if (ev == 15 && e1 == 15) { mask = mask + 134217728; }

  // ---- overflow in both directions ----
  int_64 w = maxv;
  w += 1;
  if (w == minv) { mask = mask + 268435456; }
  int_64 w2 = minv;
  w2 -= 1;
  if (w2 == maxv) { mask = mask + 536870912; }

  // ---- the ordinary int compound path is untouched ----
  int ni = 7;
  ni += 3;
  ni *= 2;
  if (ni == 20) { mask = mask + 1073741824; }

  print(["x=", x, " m=", m, " d=", d, " r=", r, " sh=", sh, " ar=", ar, "\n"]);
  print(["hi=", hi, " an=", an, " orv=", orv, " xr=", xr, " loc=", loc, " g=", g, "\n"]);
  print(["a2=", a[2], " a3=", a[3], " s.f=", s.f, " v=", v, " q1=", q[1], " ev=", ev, "\n"]);
  print(["w=", w, " w2=", w2, " ni=", ni, " mask=", mask, " expect=2147483647\n"]);
  if (mask == 2147483647) { return 42; }
  return 7;
}
