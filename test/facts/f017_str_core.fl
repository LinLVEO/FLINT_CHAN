// f017_str_core.fl -- probe for lib\dstr_lib.fl (dynamic string Str: len + cap, auto-grow, NUL-ended).
// One bit per check; all 31 lit (mask 2147483647) => exit 42.  A red run prints the mask and returns
// it, so the failing check is visible at a glance (one bit per check, never a single sum).
//
//   bit  value      what it pins
//    0        1  init(cap 0): returns 0, cap == 64 (default), len 0, str_s usable (first byte 0)
//    1        2  init again while p != 0 returns -1 and the first buffer's cap is untouched
//    2        4  add("hello") == 5, content and str_len agree
//    3        8  add("") == 5 = current length (appending the empty string is a legal no-op)
//    4       16  add(0) == -1 and the content is untouched
//    5       32  addc(',') == 6 and the content reads back
//    6       64  addn(t, 3) == 9 (the "slice" entry point: n bytes at most)
//    7      128  addn(t, 99) == 18 -- n larger than the real string is NOT an error (stops at NUL)
//    8      256  addn(t, -3) == -1 and the length is untouched
//    9      512  addn(0, 3) == -1
//   10     1024  addint(-42) == 21 and the content ends with "-42"
//   11     2048  init(-7) == 0 with cap == 64 (cap < 1 means "default", not an error)
//   12     4096  init(5) == 0 with cap == 5 (an explicit small cap is honoured as declared)
//   13     8192  addint(0) == 1 and the content is "0"
//   14    16384  addint(2147483647) == 10 and the content is "2147483647"
//   15    32768  addint(0x80000000) == 11 and the content is "-2147483648" (INT_MIN, negative domain)
//   16    65536  clear: len 0, cap preserved (still 8), first byte 0
//   17   131072  after clear an add of "xy" == 2 with cap still 8 (the capacity really was kept)
//   18   262144  free: returns 0 and p/len/cap are all cleared
//   19   524288  free again: returns 0 (idempotent) and p is still 0
//   20  1048576  uninitialised (p == 0): str_len == 0, str_s == 0, clear == 0 -- all safe
//   21  2097152  uninitialised: add / addc / addint / addn all return -1 (never a silent write)
//   22  4194304  s == 0 (null struct pointer): init -1, len -1, clear 0, free 0, str_s 0
//   23  8388608  init(0x40000001) == -1, p stays 0 (no half-done state) and add still returns -1
//   24 16777216  growth through the public API: init(1) then 300 x add("ab"), every return value right
//   25 33554432  ... and all 600 bytes match the generator, with the trailing NUL at [600]
//   26 67108864  init(5) then add of 10 bytes: content right and cap >= 11 (grow path reallocs)
//   27  134217728 white box: str_igrow(&m, 100) == 0, cap >= 100, content carried over unchanged
//   28  268435456 white box: the GROWTH-PATH GUARD -- str_igrow(&m, 0x40000001) == -1 with cap and
//                 content untouched, and str_igrow(&m, 0) == -1 (need < 1 is a loud failure too)
//   29  536870912 addc writes the low 8 bits: addc(300) -> 44, addc(-1) -> 255
//   30 1073741824 addc(0) really writes an embedded NUL: len counts 3 but str_s only shows "A"
//
// Content checks borrow the untouched str_lib (std::streq / std::strlen) as an independent witness, so
// the probe is not judging itself with its own code.  No raw pointer value is ever printed (ASLR would
// make the two ends differ); only the mask and derived strings are printed.  Pure ASCII on purpose.
//
// bit 28 is a deliberate WHITE-BOX check: the growth-path guard cannot be reached cheaply through the
// public API (that would need a real 1 GiB of appended data), so the probe calls the internal str_igrow
// directly.  A rename of that internal part makes this probe fail loudly, which is the intent.

include "../../lib/str_lib.fl"
include "../../lib/dstr_lib.fl"

int main() {
  int f = 0;

  // ---- A: init / add / addc / addn chain on one struct (bits 0..10) ----
  struct Str a;
  a.p = 0; a.len = 0; a.cap = 0;
  if (std::str_init(&a, 0) == 0) {
    char *s0 = std::str_s(&a);
    if (a.cap == 64 && a.len == 0 && std::str_len(&a) == 0 && s0 != 0 && s0[0] == 0) { f = f | 1; }
  }
  if (std::str_init(&a, 0) < 0) {
    if (a.cap == 64) { f = f | 2; }
  }
  if (std::str_add(&a, "hello") == 5) {
    char *s2 = std::str_s(&a);
    if (std::str_len(&a) == 5 && std::streq(s2, "hello") == 1) { f = f | 4; }
  }
  if (std::str_add(&a, "") == 5) {
    if (std::streq(std::str_s(&a), "hello") == 1) { f = f | 8; }
  }
  if (std::str_add(&a, 0) < 0) {
    if (std::streq(std::str_s(&a), "hello") == 1) { f = f | 16; }
  }
  if (std::str_addc(&a, ',') == 6) {
    if (std::streq(std::str_s(&a), "hello,") == 1) { f = f | 32; }
  }
  if (std::str_addn(&a, " world!!!", 3) == 9) {
    if (std::streq(std::str_s(&a), "hello, wo") == 1) { f = f | 64; }
  }
  if (std::str_addn(&a, " world!!!", 99) == 18) {
    if (std::streq(std::str_s(&a), "hello, wo world!!!") == 1) { f = f | 128; }
  }
  if (std::str_addn(&a, " world!!!", 0 - 3) < 0) {
    if (std::str_len(&a) == 18) { f = f | 256; }
  }
  if (std::str_addn(&a, 0, 3) < 0) { f = f | 512; }
  if (std::str_addint(&a, 0 - 42) == 21) {
    if (std::streq(std::str_s(&a), "hello, wo world!!!-42") == 1) { f = f | 1024; }
  }
  std::str_free(&a);

  // ---- B: cap defaults and an explicit small cap (bits 11..12) ----
  struct Str b1;
  b1.p = 0; b1.len = 0; b1.cap = 0;
  if (std::str_init(&b1, 0 - 7) == 0) {
    if (b1.cap == 64) { f = f | 2048; }
  }
  std::str_free(&b1);
  struct Str b2;
  b2.p = 0; b2.len = 0; b2.cap = 0;
  if (std::str_init(&b2, 5) == 0) {
    if (b2.cap == 5) { f = f | 4096; }
  }
  std::str_free(&b2);

  // ---- C: addint edges: 0 / INT_MAX / INT_MIN (bits 13..15) ----
  struct Str c;
  c.p = 0; c.len = 0; c.cap = 0;
  std::str_init(&c, 0);
  if (std::str_addint(&c, 0) == 1) {
    if (std::streq(std::str_s(&c), "0") == 1) { f = f | 8192; }
  }
  std::str_clear(&c);
  if (std::str_addint(&c, 2147483647) == 10) {
    if (std::streq(std::str_s(&c), "2147483647") == 1) { f = f | 16384; }
  }
  std::str_clear(&c);
  if (std::str_addint(&c, 0x80000000) == 11) {
    if (std::streq(std::str_s(&c), "-2147483648") == 1) { f = f | 32768; }
  }
  std::str_free(&c);

  // ---- D: clear keeps the capacity (bits 16..17) ----
  struct Str d;
  d.p = 0; d.len = 0; d.cap = 0;
  if (std::str_init(&d, 8) == 0) {
    std::str_add(&d, "abc");
    if (std::str_clear(&d) == 0) {
      char *ds = std::str_s(&d);
      if (std::str_len(&d) == 0 && ds != 0 && ds[0] == 0 && d.cap == 8) { f = f | 65536; }
    }
    if (std::str_add(&d, "xy") == 2) {
      if (d.cap == 8 && std::streq(std::str_s(&d), "xy") == 1) { f = f | 131072; }
    }
  }
  std::str_free(&d);

  // ---- E: free is idempotent and clears the struct (bits 18..19) ----
  struct Str e;
  e.p = 0; e.len = 0; e.cap = 0;
  std::str_init(&e, 0);
  std::str_add(&e, "zz");
  if (std::str_free(&e) == 0) {
    if (e.p == 0 && e.len == 0 && e.cap == 0) { f = f | 262144; }
  }
  if (std::str_free(&e) == 0) {
    if (e.p == 0) { f = f | 524288; }
  }

  // ---- F: the uninitialised state is safe (bits 20..21) ----
  struct Str g;
  g.p = 0; g.len = 0; g.cap = 0;
  char *gs = std::str_s(&g);
  if (std::str_len(&g) == 0 && gs == 0 && std::str_clear(&g) == 0) { f = f | 1048576; }
  if (std::str_add(&g, "y") < 0) {
    if (std::str_addc(&g, 'y') < 0) {
      if (std::str_addint(&g, 1) < 0) {
        if (std::str_addn(&g, "y", 1) < 0) { f = f | 2097152; }
      }
    }
  }

  // ---- G: a null struct pointer is answered, not crashed (bit 22) ----
  int gn0 = std::str_init(0, 0);
  int gn1 = std::str_len(0);
  int gn2 = std::str_clear(0);
  int gn3 = std::str_free(0);
  char *gn4 = std::str_s(0);
  if (gn0 < 0 && gn1 < 0 && gn2 == 0 && gn3 == 0 && gn4 == 0) { f = f | 4194304; }

  // ---- H: the init cap ceiling (bit 23): > 1 GiB is refused before any allocation ----
  struct Str h;
  h.p = 0; h.len = 0; h.cap = 0;
  if (std::str_init(&h, 0x40000001) < 0) {
    if (h.p == 0 && h.cap == 0 && std::str_add(&h, "x") < 0) { f = f | 8388608; }
  }
  std::str_free(&h);

  // ---- I: growth through the public API, byte for byte (bits 24..25) ----
  struct Str i;
  i.p = 0; i.len = 0; i.cap = 0;
  if (std::str_init(&i, 1) == 0) {
    int n = 0;
    int ok = 1;
    while (n < 300) {
      if (std::str_add(&i, "ab") != n * 2 + 2) { ok = 0; }
      n = n + 1;
    }
    if (ok == 1 && std::str_len(&i) == 600) { f = f | 16777216; }
    char *is = std::str_s(&i);
    int same = 1;
    int j = 0;
    while (j < 600) {
      int want = 'b';
      if (j % 2 == 0) { want = 'a'; }
      if (is[j] != want) { same = 0; }
      j = j + 1;
    }
    if (same == 1 && is != 0 && is[600] == 0) { f = f | 33554432; }
  }
  std::str_free(&i);

  // ---- J: an explicit small cap grows correctly (bit 26) ----
  struct Str k;
  k.p = 0; k.len = 0; k.cap = 0;
  if (std::str_init(&k, 5) == 0) {
    if (k.cap == 5 && std::str_add(&k, "abcdefghij") == 10) {
      char *ks = std::str_s(&k);
      if (ks != 0 && std::streq(ks, "abcdefghij") == 1 && k.cap >= 11) { f = f | 67108864; }
    }
  }
  std::str_free(&k);

  // ---- K: the growth funnel itself: success + the capacity guard on EVERY growth path (bits 27..28) ----
  struct Str m;
  m.p = 0; m.len = 0; m.cap = 0;
  std::str_init(&m, 8);
  std::str_add(&m, "keep");
  if (str_igrow(&m, 100) == 0) {
    if (m.cap >= 100 && std::streq(std::str_s(&m), "keep") == 1) { f = f | 134217728; }
  }
  int cap_now = m.cap;
  if (str_igrow(&m, 0x40000001) < 0) {
    if (m.cap == cap_now && std::streq(std::str_s(&m), "keep") == 1) {
      if (str_igrow(&m, 0) < 0) { f = f | 268435456; }
    }
  }
  std::str_free(&m);

  // ---- L: addc writes the low 8 bits, including a real embedded NUL (bits 29..30) ----
  struct Str q;
  q.p = 0; q.len = 0; q.cap = 0;
  std::str_init(&q, 8);
  if (std::str_addc(&q, 300) == 1) {
    char *qs = std::str_s(&q);
    if (qs != 0 && (qs[0] & 255) == 44) {
      std::str_clear(&q);
      std::str_addc(&q, 0 - 1);
      char *qs2 = std::str_s(&q);
      if (qs2 != 0 && (qs2[0] & 255) == 255) { f = f | 536870912; }
    }
  }
  std::str_clear(&q);
  std::str_addc(&q, 'A');
  std::str_addc(&q, 0);
  std::str_addc(&q, 'B');
  char *qs3 = std::str_s(&q);
  if (std::str_len(&q) == 3 && qs3 != 0 && qs3[0] == 'A' && qs3[1] == 0 && qs3[2] == 'B') { f = f | 1073741824; }
  std::str_free(&q);

  print(["f017_str_core mask=", f, "\n"]);
  if (f == 2147483647) { return 42; }
  return f;
}
