// f099_2darr.fl -- 二维数组 `int m[32][17]`（v2.2.0 最小形态）
// 判据：8 位位掩码全亮（255）-> 退出 42。
//
//   bit0  基本写读：m[0][0] = 7 读回
//   bit1  行列不混：m[1][0] 与 m[0][1] 是两个独立单元
//   bit2  row-major（独立裁判）：int *p = &m[0][0]; p[1*17+2] == m[1][2]
//         —— 若布局是列优先或 stride 不是 17，这里必错
//   bit3  下标是表达式：m[i+1][j*2]（i/j 是变量，不是字面量）
//   bit4  边界：首元素 (0,0) 与末元素 (31,16) 都写读正确
//   bit5  与一维数组并存：同函数里 int a[8] 照常工作
//   bit6  覆盖写 + 行边界不串：m[0][16] 与 m[1][0] 相邻且互不覆盖
//   bit7  全量填充 32×17 + 校验和 147696（= Σk, k=0..543）+ 尾随哨兵变量不被写坏
int main() {
  int m[32][17];
  int a[8];
  int i = 0;
  int j = 0;
  int mask = 0;
  int guard = 12345;

  // bit0：基本写读
  m[0][0] = 7;
  if (m[0][0] == 7) { mask = mask | 1; }

  // bit1：行列不混（同值写在 (1,0) / (0,1)，必须各读各的）
  m[1][0] = 11;
  m[0][1] = 22;
  if (m[1][0] == 11 && m[0][1] == 22) { mask = mask | 2; }

  // bit2：row-major 布局（用 &m[0][0] 的一维别名做独立裁判）
  m[1][2] = 33;
  int *p = &m[0][0];
  if (p[1 * 17 + 2] == 33) { mask = mask | 4; }

  // bit3：下标是表达式
  i = 2;
  j = 3;
  m[i + 1][j * 2] = 44;
  if (m[3][6] == 44 && p[3 * 17 + 6] == 44) { mask = mask | 8; }

  // bit4：首末边界
  m[31][16] = 55;
  if (m[31][16] == 55 && m[0][0] == 7) { mask = mask | 16; }

  // bit5：与一维数组并存
  a[5] = 66;
  if (a[5] == 66 && m[1][2] == 33) { mask = mask | 32; }

  // bit6：覆盖写 + 行边界不串（m[0][16] 与 m[1][0] 是相邻槽）
  m[0][16] = 77;
  m[1][0] = 88;
  if (m[0][16] == 77 && m[1][0] == 88) { mask = mask | 64; }

  // bit7：全量填充 + 校验和 + 哨兵
  int sum = 0;
  for (i = 0; i < 32; i = i + 1) {
    for (j = 0; j < 17; j = j + 1) {
      m[i][j] = i * 17 + j;
    }
  }
  for (i = 0; i < 32; i = i + 1) {
    for (j = 0; j < 17; j = j + 1) {
      sum = sum + m[i][j];
    }
  }
  if (sum == 147696 && guard == 12345 && m[31][16] == 543) { mask = mask | 128; }

  print(["f099 mask=", mask, "\n"]);
  if (mask == 255) { return 42; }
  return mask;
}
