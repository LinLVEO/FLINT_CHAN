// f120_hash.fl -- hash_lib 探针：MD5 / SHA1 / SHA256（8 位掩码全亮 255 -> 退出 42）
// 判据（期望值 = 公开测试向量，先由 test\tmp\t120_dump.fl 跑出实际字节、核对一致后才写死）：
//   bit0  std::md5("", 0, d) == 16，逐字节等于 d41d8cd98f00b204e9800998ecf8427e
//   bit1  std::md5("abc", 3, d) == 16，逐字节等于 900150983cd24fb0d6963f7d28e17f72
//   bit2  std::sha1("", 0, d) == 20，逐字节等于 da39a3ee5e6b4b0d3255bfef95601890afd80709
//   bit3  std::sha1("abc", 3, d) == 20，逐字节等于 a9993e364706816aba3e25717850c26c9cd0d89d
//   bit4  std::sha256("", 0, d) == 32，逐字节等于 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//   bit5  std::sha256("abc", 3, d) == 32，逐字节等于 ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//   bit6  同一输入连续两次 sha256：返回 32 且两段结果逐字节相同（确定性，且与 bit5 向量一致）
//   bit7  长度参数被尊重：同一块内存（"abcd"）n=3 与 n=4 的结果不同，且 n=3 等于 "abc" 向量
//         （同一个指针只改 n ⇒ 证明走的是 n，不是 strlen 把尾巴吃掉）
include "../../lib/codec_lib.fl"

// 逐字节比两段（长度 n）：相等 1 / 不等 0
int f120_eq(char *a, char *b, int n) {
  int i = 0;
  while (i < n) {
    if (a[i] != b[i]) { return 0; }
    i = i + 1;
  }
  return 1;
}

int main() {
  char d[32];
  char d2[32];
  char src4[4];
  int mask = 0;
  int n = 0;
  int n2 = 0;

  // ---- 期望向量（公开测试值，逐字节赋值：char 数组不支持整体初始化/字符串初始化）----
  char v0[16];   // MD5("")
  char v1[16];   // MD5("abc")
  char v2[20];   // SHA1("")
  char v3[20];   // SHA1("abc")
  char v4[32];   // SHA256("")
  char v5[32];   // SHA256("abc")

  v0[0] = 0xd4;  v0[1] = 0x1d;  v0[2] = 0x8c;  v0[3] = 0xd9;
  v0[4] = 0x8f;  v0[5] = 0x00;  v0[6] = 0xb2;  v0[7] = 0x04;
  v0[8] = 0xe9;  v0[9] = 0x80;  v0[10] = 0x09; v0[11] = 0x98;
  v0[12] = 0xec; v0[13] = 0xf8; v0[14] = 0x42; v0[15] = 0x7e;

  v1[0] = 0x90;  v1[1] = 0x01;  v1[2] = 0x50;  v1[3] = 0x98;
  v1[4] = 0x3c;  v1[5] = 0xd2;  v1[6] = 0x4f;  v1[7] = 0xb0;
  v1[8] = 0xd6;  v1[9] = 0x96;  v1[10] = 0x3f; v1[11] = 0x7d;
  v1[12] = 0x28; v1[13] = 0xe1; v1[14] = 0x7f; v1[15] = 0x72;

  v2[0] = 0xda;  v2[1] = 0x39;  v2[2] = 0xa3;  v2[3] = 0xee;
  v2[4] = 0x5e;  v2[5] = 0x6b;  v2[6] = 0x4b;  v2[7] = 0x0d;
  v2[8] = 0x32;  v2[9] = 0x55;  v2[10] = 0xbf; v2[11] = 0xef;
  v2[12] = 0x95; v2[13] = 0x60; v2[14] = 0x18; v2[15] = 0x90;
  v2[16] = 0xaf; v2[17] = 0xd8; v2[18] = 0x07; v2[19] = 0x09;

  v3[0] = 0xa9;  v3[1] = 0x99;  v3[2] = 0x3e;  v3[3] = 0x36;
  v3[4] = 0x47;  v3[5] = 0x06;  v3[6] = 0x81;  v3[7] = 0x6a;
  v3[8] = 0xba;  v3[9] = 0x3e;  v3[10] = 0x25; v3[11] = 0x71;
  v3[12] = 0x78; v3[13] = 0x50; v3[14] = 0xc2; v3[15] = 0x6c;
  v3[16] = 0x9c; v3[17] = 0xd0; v3[18] = 0xd8; v3[19] = 0x9d;

  v4[0] = 0xe3;  v4[1] = 0xb0;  v4[2] = 0xc4;  v4[3] = 0x42;
  v4[4] = 0x98;  v4[5] = 0xfc;  v4[6] = 0x1c;  v4[7] = 0x14;
  v4[8] = 0x9a;  v4[9] = 0xfb;  v4[10] = 0xf4; v4[11] = 0xc8;
  v4[12] = 0x99; v4[13] = 0x6f; v4[14] = 0xb9; v4[15] = 0x24;
  v4[16] = 0x27; v4[17] = 0xae; v4[18] = 0x41; v4[19] = 0xe4;
  v4[20] = 0x64; v4[21] = 0x9b; v4[22] = 0x93; v4[23] = 0x4c;
  v4[24] = 0xa4; v4[25] = 0x95; v4[26] = 0x99; v4[27] = 0x1b;
  v4[28] = 0x78; v4[29] = 0x52; v4[30] = 0xb8; v4[31] = 0x55;

  v5[0] = 0xba;  v5[1] = 0x78;  v5[2] = 0x16;  v5[3] = 0xbf;
  v5[4] = 0x8f;  v5[5] = 0x01;  v5[6] = 0xcf;  v5[7] = 0xea;
  v5[8] = 0x41;  v5[9] = 0x41;  v5[10] = 0x40; v5[11] = 0xde;
  v5[12] = 0x5d; v5[13] = 0xae; v5[14] = 0x22; v5[15] = 0x23;
  v5[16] = 0xb0; v5[17] = 0x03; v5[18] = 0x61; v5[19] = 0xa3;
  v5[20] = 0x96; v5[21] = 0x17; v5[22] = 0x7a; v5[23] = 0x9c;
  v5[24] = 0xb4; v5[25] = 0x10; v5[26] = 0xff; v5[27] = 0x61;
  v5[28] = 0xf2; v5[29] = 0x00; v5[30] = 0x15; v5[31] = 0xad;

  // ---- bit0：MD5("") ----
  n = std::md5("", 0, d);
  if (n == 16) {
    if (f120_eq(d, v0, 16) == 1) { mask = mask | 1; }
  }

  // ---- bit1：MD5("abc") ----
  n = std::md5("abc", 3, d);
  if (n == 16) {
    if (f120_eq(d, v1, 16) == 1) { mask = mask | 2; }
  }

  // ---- bit2：SHA1("") ----
  n = std::sha1("", 0, d);
  if (n == 20) {
    if (f120_eq(d, v2, 20) == 1) { mask = mask | 4; }
  }

  // ---- bit3：SHA1("abc") ----
  n = std::sha1("abc", 3, d);
  if (n == 20) {
    if (f120_eq(d, v3, 20) == 1) { mask = mask | 8; }
  }

  // ---- bit4：SHA256("") ----
  n = std::sha256("", 0, d);
  if (n == 32) {
    if (f120_eq(d, v4, 32) == 1) { mask = mask | 16; }
  }

  // ---- bit5：SHA256("abc") ----
  n = std::sha256("abc", 3, d);
  if (n == 32) {
    if (f120_eq(d, v5, 32) == 1) { mask = mask | 32; }
  }

  // ---- bit6：确定性（同一输入连跑两次，两段结果逐字节相同，且都等于向量）----
  n = std::sha256("abc", 3, d);
  n2 = std::sha256("abc", 3, d2);
  if (n == 32 && n2 == 32) {
    if (f120_eq(d, d2, 32) == 1 && f120_eq(d, v5, 32) == 1) { mask = mask | 64; }
  }

  // ---- bit7：长度参数被尊重（同一块内存 "abcd"：n=3 与 n=4 必须不同；n=3 还得等于 "abc"）----
  src4[0] = 0x61;   // 'a'
  src4[1] = 0x62;   // 'b'
  src4[2] = 0x63;   // 'c'
  src4[3] = 0x64;   // 'd'
  n = std::sha256(src4, 3, d);
  n2 = std::sha256(src4, 4, d2);
  if (n == 32 && n2 == 32) {
    if (f120_eq(d, d2, 32) == 0) {
      if (f120_eq(d, v5, 32) == 1) { mask = mask | 128; }
    }
  }

  print(["f120 mask=", mask, "\n"]);
  if (mask == 255) { return 42; }
  return mask;
}
