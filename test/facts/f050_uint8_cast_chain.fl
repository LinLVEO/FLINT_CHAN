// f050_uint8_cast_chain.fl -- v1.9.0 uint_8 wrap (store truncation) + the explicit cast chains
// the SPEC pins by number: (uint_8)300 == 44, (uint_64)(int)-1 == 18446744073709551615 (sign-extend
// on widening, C11 6.3.1.3 value conversion), (uint_32)(int_64)-1 == 4294967295, (int)(uint_32)-1 == -1, (uint_32)(uint_64)-1.
//
// WHY THIS PROBE EXISTS: `(uint_64)(int)-1` is the row where "sign extend the 32-bit source"
// and "zero extend it" differ (2^64-1 vs 4294967295). SPEC pins the *sign-extend* answer (C11 6.3.1.3), so a
// zero-extend-based widening implementation fails exactly one bit here. The uint_8 row pins that the
// store truncates mod 256 while `(uint_8)255 + 1` stays 256 (integer promotion, C11 6.5.6).
//
// HOW THE EXPECTED VALUES WERE COMPUTED (never hand-typed):
//   node test\facts\uint-exp.js        (section "== f050")
//
// SENTINEL: one bit per check; exit 42 only when the mask is 1023 (all ten bits).
// ASCII only, no BOM. No includes.
int main() {
  uint_8 x = 255;
  x = x + 1;                      // store truncation: 256 -> 0

  int m = 0;
  if ((uint_8)300 == 44) { m = m + 1; }
  if (x == 0) { m = m + 2; }
  if ((uint_64)(int)(0 - 1) == (uint_64)0 - 1) { m = m + 4; }   // 2^64-1（字面量超 INT64_MAX，用表达式写）
  if ((uint_32)(int_64)(0 - 1) == 4294967295) { m = m + 8; }
  if ((int)(uint_32)(0 - 1) == 0 - 1) { m = m + 16; }
  if ((uint_32)(uint_64)(0 - 1) == 4294967295) { m = m + 32; }
  if ((uint_8)256 == 0) { m = m + 64; }
  if ((uint_8)(0 - 1) == 255) { m = m + 128; }
  if ((uint_64)4294967296 == 4294967296) { m = m + 256; }
  if ((uint_8)255 + 1 == 256) { m = m + 512; }   // integer promotion: uint_8 + int -> int

  print(["(uint_8)300=", (uint_8)300, " (uint_64)(int)-1=", (uint_64)(int)(0 - 1),
         " mask=", m, " expect=1023\n"]);
  if (m == 1023) { return 42; }
  return 7;
}
