// f043_cast_int_from_dbl.fl -- v1.8.0 C-style cast: `(int)x` where x is double.
//
// WHY THIS PROBE EXISTS: the double -> int row must truncate TOWARD ZERO (C semantics) and
// return 0x80000000 for values that do not fit in 32 bits (the same rule as to_int and as the
// hardware cvttsd2si). Rounding (3.9 -> 4) or modulo wrapping (-3.9 -> huge) would both be
// silent wrong values; the boundaries 2147483647 / 2147483648 / -2147483648 / -2147483649 pin
// exactly where "fits" ends.
//
// HOW THE EXPECTED VALUES WERE COMPUTED (never hand-typed):
//   node test\facts\cast-exp.js        (section "== f043"; d2i32 = trunc, OOR -> 0x80000000)
//   -> 3.9 -> 3 ｜ -3.9 -> -3 ｜ 0.5 -> 0 ｜ -0.5 -> 0 ｜ 2147483647.0 -> 2147483647 ｜
//      2147483648.0 -> -2147483648 ｜ -2147483648.0 -> -2147483648 ｜
//      -2147483649.0 -> -2147483648 ｜ 1.0 -> 1 ｜ 1000000.75 -> 1000000
//
// SENTINEL: one bit per check; exit 42 only when the mask is 1023 (all ten bits).
// ASCII only, no BOM. No includes.
int main() {
  double d0 = 3.9;
  double d1 = 0.0 - 3.9;
  double d2 = 0.5;
  double d3 = 0.0 - 0.5;
  double d4 = 2147483647.0;
  double d5 = 2147483648.0;
  double d6 = 0.0 - 2147483648.0;
  double d7 = 0.0 - 2147483649.0;
  double d8 = 1.0;
  double d9 = 1000000.75;

  int m = 0;
  if ((int)d0 == 3) { m = m + 1; }
  if ((int)d1 == 0 - 3) { m = m + 2; }
  if ((int)d2 == 0) { m = m + 4; }
  if ((int)d3 == 0) { m = m + 8; }
  if ((int)d4 == 2147483647) { m = m + 16; }
  if ((int)d5 == 0 - 2147483648) { m = m + 32; }
  if ((int)d6 == 0 - 2147483648) { m = m + 64; }
  if ((int)d7 == 0 - 2147483648) { m = m + 128; }
  if ((int)d8 == 1) { m = m + 256; }
  if ((int)d9 == 1000000) { m = m + 512; }

  print(["(int)3.9=", (int)d0, " (int)-3.9=", (int)d1, " (int)0.5=", (int)d2, "\n"]);
  print(["(int)2^31=", (int)d5, " (int)-2^31-1=", (int)d7, " (int)1000000.75=", (int)d9, "\n"]);
  print(["mask=", m, " expect=1023\n"]);
  if (m == 1023) { return 42; }
  return 7;
}
