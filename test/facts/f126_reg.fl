// f126_reg.fl -- sys_lib §6 注册表读写探针（HKCU 真读真写，结尾清理）
// 判据：8 位位掩码全亮（255）-> 退出 42。
//
//   bit0  reg_set_str("HKCU\Software\FLINT_F126", "v", "hello", 5) == 1（建键 + 写值）
//   bit1  reg_get_str 读回长度 5 且逐字节等于 "hello"
//   bit2  不存在的值 -> -1
//   bit3  cap=3 读 "hello" -> -1（响亮失败），且 3 字节哨兵 A/B/C 一个都没被写坏
//   bit4  覆盖写 "world" 后读回长度 5 且等于 "world"
//   bit5  reg_del_str("v") == 1，之后读 "v" -> -1
//   bit6  reg_del_key("HKCU\Software\FLINT_F126") == 1
//   bit7  非法根前缀 "BADROOT\x"：set/del_str/del_key 全 0、get -1，且不崩
//
// ⚠️ 本探针会真的写用户注册表（HKCU\Software\FLINT_F126）；无论哪条判据没过，结尾都清理该键。
// 所有判据用字面量/字节，不做任何拼接。
include "../../lib/sys_lib.fl"

// 逐字节比两个 C 串（含结尾 NUL）。相等 1 / 不等 0。
int f126_eq(char *a, char *b) {
  int i = 0;
  while (1) {
    if (a[i] != b[i]) { return 0; }
    if (a[i] == 0) { return 1; }
    i = i + 1;
  }
}

int main() {
  char buf[64];
  char small[3];
  int mask = 0;
  int n = 0;

  // bit0：建键 + 写字符串值
  if (std::reg_set_str("HKCU\\Software\\FLINT_F126", "v", "hello", 5) == 1) {
    mask = mask | 1;
  }

  // bit1：读回长度 5 + 内容 "hello"
  buf[0] = 0;
  n = std::reg_get_str("HKCU\\Software\\FLINT_F126", "v", buf, 64);
  if (n == 5) {
    if (f126_eq(buf, "hello") == 1) { mask = mask | 2; }
  }

  // bit2：不存在的值必须 -1
  if (std::reg_get_str("HKCU\\Software\\FLINT_F126", "no_such_value_f126", buf, 64) == -1) {
    mask = mask | 4;
  }

  // bit3：cap=3 读 5 字节值必须响亮 -1，且哨兵一个字节都不写
  small[0] = 65;
  small[1] = 66;
  small[2] = 67;
  if (std::reg_get_str("HKCU\\Software\\FLINT_F126", "v", small, 3) == -1) {
    if (small[0] == 65 && small[1] == 66 && small[2] == 67) { mask = mask | 8; }
  }

  // bit4：覆盖写 "world"，读回必须是新值（长度 5）
  if (std::reg_set_str("HKCU\\Software\\FLINT_F126", "v", "world", 5) == 1) {
    buf[0] = 0;
    n = std::reg_get_str("HKCU\\Software\\FLINT_F126", "v", buf, 64);
    if (n == 5) {
      if (f126_eq(buf, "world") == 1) { mask = mask | 16; }
    }
  }

  // bit5：删值返回 1，删完再读必须 -1
  if (std::reg_del_str("HKCU\\Software\\FLINT_F126", "v") == 1) {
    if (std::reg_get_str("HKCU\\Software\\FLINT_F126", "v", buf, 64) == -1) {
      mask = mask | 32;
    }
  }

  // bit6：删键（此时键下已无值）返回 1
  if (std::reg_del_key("HKCU\\Software\\FLINT_F126") == 1) {
    mask = mask | 64;
  }

  // bit7：非法根前缀全拒绝，且进程不崩
  if (std::reg_set_str("BADROOT\\x", "v", "x", 1) == 0) {
    if (std::reg_get_str("BADROOT\\x", "v", buf, 64) == -1) {
      if (std::reg_del_str("BADROOT\\x", "v") == 0) {
        if (std::reg_del_key("BADROOT\\x") == 0) { mask = mask | 128; }
      }
    }
  }

  // 收尾清理：不管前面哪条没过，都把这个测试键清干净（键已不存在时返回 0，忽略即可）。
  std::reg_del_str("HKCU\\Software\\FLINT_F126", "v");
  std::reg_del_str("HKCU\\Software\\FLINT_F126", "no_such_value_f126");
  std::reg_del_key("HKCU\\Software\\FLINT_F126");

  print(["f126 mask=", mask, "\n"]);
  if (mask == 255) { return 42; }
  return mask;
}
