// libpath1.fl — B2x：include 免相对路径（回退到编译器自带 lib 目录）
// 本文件目录下没有 num_lib.fl/fmt_lib.fl → 走 <编译器目录>\lib\ 候选
include "num_lib.fl"
include "fmt_lib.fl"
int main() {
  char b[16];
  int p = std::itoa(42, b);
  if (p != 2) return 1;
  if (b[0] != '4') return 2;
  if (b[1] != '2') return 3;
  p = std::fmt_int(b, 0, 7);
  std::fmt_end(b, p);
  if (b[0] != '7') return 4;
  return 42;
}
