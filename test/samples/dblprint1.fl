// v1.2.3 浮点打印：`print([d])` 直接打 double（定点 6 位小数 + 四舍五入）
// 实现 = **纯 FLINT 自写** `_flint_out_dbl`（编译期内置输出库，见 src/main.c）——
//   零 PE 改动、不需要 legacy msvcrt 的 `_fltused`（SPEC 记录的首选路线）。
//   它能这么写，是因为 v1.2.2 刚打通「函数形参 double」：double 值能当一个实参传进去。
// 本样本双重断言：① stdout 逐字比对（真正的格式化行为）② 退出码 15（4 项数值断言位掩码）
double half(double x) { return x / 2.0; }   // 定义在 main 之后 → 顺带钉住前向调用

int main() {
  print(["basic: ", 1.5, " ", -2.25, " ", 0.0, "\n"]);
  print(["round: ", 0.9999999, " ", 2.0 / 3.0, "\n"]);       // 进位到整数部分 / 六位四舍五入
  print(["big: ", 123456.789, " neg: ", -0.5, "\n"]);
  print(["call: ", half(5.0), " expr: ", 1.0 + 2.5, " end", "\n"]);
  print(["guard: ", 1.0 / 0.0, "|", 0.0 / 0.0, "\n"]);        // 不静默：越界/NaN 打标记串

  int r = 0;
  if (half(5.0) == 2.5) { r |= 1; }                    // 打印的数确实是原值
  if (2.0 / 3.0 > 0.6 && 2.0 / 3.0 < 0.7) { r |= 2; }
  if (1.0 / 0.0 > 1.0) { r |= 4; }                     // +Inf 存在（比较通路）
  if (!(0.0 / 0.0 == 0.0 / 0.0)) { r |= 8; }           // NaN 不等于自身
  print(["r=", r, "\n"]);
  return r;   // 15
}
