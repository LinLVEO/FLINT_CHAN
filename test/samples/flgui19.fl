// flgui19.fl — FLGUI 原生 IME（M4r，2026-10-25 用户拍板"必须原生"）：**UTF-16→UTF-8 转码 ＋ IME 默认态**的无头契约
// 为什么有这个样本：IME 上屏吐的是 **UTF-16**，本库全部文本是 **UTF-8** ⇒ `u16_to_u8` 是整条中文输入链的"水位线"，
//   它错一个字节，上屏就是乱码；而"拼音 → 候选 → 上屏"这条真路**没法用 SendInput 脚本化**（合成串是输入法投递的），
//   所以这里把**能无头钉死的**全钉住：转码字节、默认态、没窗口时的安全返回。
//   真输入那半的判据在 `tmp\probe-ime.ps1`（真键打 nihao → 空格上屏 ⇒ 存盘前缀必须是 你好 的 6 字节）。
// 本样本**不建窗**：只调库函数 + 读全局。
// 判据（8 位全亮 = 255 ⇒ exit 42；每位一格，不写成一个总和）：
//   bit 0  默认态：gui_ime_on / gui_ime_clen / gui_ime_rlen 全 0
//   bit 1  u16_to_u8(你好) == 6 字节
//   bit 2  那 6 字节逐字节 == E4 BD A0 E5 A5 BD
//   bit 3  u16 "AB" == 2 字节，且 = 41 42
//   bit 4  wlen = 0 ⇒ 返回 0（空输入不写输出）
//   bit 5  gui_ime_at(0, …) == 0（没有窗口就不该报位置，也不许崩）
//   bit 6  u16_to_u8(你好吗) == 9 字节（三字，验"多字连续"不串位）
//   bit 7  单个 'A' ⇒ 1 字节 0x41（最小规模，防"只在大串上对"）
include "flgui_win32.fl"

int f19_res = 0;

int main() {
  char w[32];
  char o[64];
  int n = 0;
  int i = 0;

  // bit 0：默认态
  if (gui_ime_on == 0 && gui_ime_clen == 0 && gui_ime_rlen == 0) { f19_res = f19_res | 1; }

  // 你好 = U+4F60 U+597D（UTF-16LE：60 4F 7D 59）
  w[0] = 0x60; w[1] = 0x4F;
  w[2] = 0x7D; w[3] = 0x59;
  n = u16_to_u8(&w[0], 2, &o[0], 64);
  if (n == 6) { f19_res = f19_res | 2; }
  if (n == 6) {
    if ((o[0] & 255) == 0xE4 && (o[1] & 255) == 0xBD && (o[2] & 255) == 0xA0 && (o[3] & 255) == 0xE5 && (o[4] & 255) == 0xA5 && (o[5] & 255) == 0xBD) {
      f19_res = f19_res | 4;
    }
  }

  // "AB"（41 00 42 00）
  w[0] = 0x41; w[1] = 0x00;
  w[2] = 0x42; w[3] = 0x00;
  n = u16_to_u8(&w[0], 2, &o[0], 64);
  if (n == 2) { if ((o[0] & 255) == 0x41 && (o[1] & 255) == 0x42) { f19_res = f19_res | 8; } }

  // wlen = 0
  n = u16_to_u8(&w[0], 0, &o[0], 64);
  if (n == 0) { f19_res = f19_res | 16; }

  // gui_ime_at(0, ...)
  i = gui_ime_at(0, 10, 20);
  if (i == 0) { f19_res = f19_res | 32; }

  // 你好吗（+U+5417 = 17 54）
  w[0] = 0x60; w[1] = 0x4F;
  w[2] = 0x7D; w[3] = 0x59;
  w[4] = 0x17; w[5] = 0x54;
  n = u16_to_u8(&w[0], 3, &o[0], 64);
  if (n == 9) { f19_res = f19_res | 64; }

  // 单字 'A'
  w[0] = 0x41; w[1] = 0x00;
  n = u16_to_u8(&w[0], 1, &o[0], 64);
  if (n == 1) { if ((o[0] & 255) == 0x41) { f19_res = f19_res | 128; } }

  print(["F19 res=", f19_res, " want=255\n"]);
  if (f19_res == 255) { return 42; }
  return f19_res;
}
