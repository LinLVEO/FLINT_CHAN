// v1.2.1 double 阶段2 第一口：函数**返回 double**（位掩码 = 一眼看出哪一位没进去；
// 期望退出码 127）；每项命中置 1<<k；最后 return r（全中 = 127）
//
// ⚠️ 样本设计要点（防「正例无鉴别力」）：返回的**小数部分必须带进断言**——
//    若实现把 double 返回值静默截断成 int（旧 bug），`half()*2.0==1.0`（0.5→0 → 得 0）立刻红。
double half() { return 0.5; }                    // 直接返回 double 字面量
double fromint() { return 7; }                   // int → double 自动提升（C 语义）
int idint(int x) { return x; }                   // 普通 int 返回（对照组）

// 自然流到末尾 = 隐式返回 0.0（其位型全 0 → xmm0 天然就是 0.0）
//   旧实现会在末尾补 `mov eax,0`，但分支里已算好的 xmm0 返回值因此被毁
double maybe(int x) {
  if (x == 1) {
    return 1.5;
  }
}

int main() {
  int r = 0;

  // ① 直接返回小数字面量：2.0 * 0.5 = 1.0（截断实现会得 0）
  if (half() * 2.0 == 1.0) r |= 1;

  // ② int 表达式自动提升：7 + 0.5 = 7.5
  if (fromint() + 0.5 == 7.5) r |= 2;

  // ③ 返回值参与算术链：0.5*3 + 0.5*2 = 2.5
  if (half() * 3.0 + half() * 2.0 == 2.5) r |= 4;

  // ④ 作实参 / 嵌套调用：idint(to_int(3.5)) = 3
  //    （3.5 不是 0.5 的整数倍 —— 直接传半值取整会静默错）
  if (idint(to_int(3.5)) == 3) r |= 8;

  // ⑤ 返回值比较：1.0 < 1.5 < 2.0（两侧都是 double 比较通路）
  if (1.0 < maybe(1) && maybe(1) < 2.0) r |= 16;

  // ⑥ 隐式返回 0.0：maybe(2) 走到函数末尾 → 必须恰好 0.0
  if (maybe(2) == 0.0) r |= 32;

  // ⑦（诊断项）显式返回带小数的值经 to_int 截断 → 2（不是 3）
  if (to_int(maybe(1)) == 1) r |= 64;

  print(["dblret 位掩码 = ", to_int(half()), " / ", r, "\n"]);
  return r;
}
