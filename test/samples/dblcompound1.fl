// v1.2.4 浮点阶段2 收尾（一）：双重复合赋值 + double 数组
// 位掩码 9 项 = 511（每项命中置 1<<k）——退出码即二进制成绩单。
// 覆盖：变量/数组元素上的 += -= *= /=（值走 SSE，不碰整数 32 位路径）、
//   int 右值自动提升（d += 1）、int 赋给 double 元素（a[0] = 3）、数组元素参与算术与函数调用。
// 鉴别力要点：若复合赋值错误地走整数路径（32 位读-改-写 8 字节 double 槽），
//   第 5~7 项（数组的和/差）与打印输出会立刻错——而不是"看起来对"。
double half(double x) { return x / 2.0; }

int main() {
  int r = 0;
  double d = 1.5;

  d += 1.0;                        // 2.5（int 字面量 → double）
  if (d == 2.5) { r |= 1; }
  d *= 2.0;                        // 5.0
  if (d == 5.0) { r |= 2; }
  d -= 0.5;                        // 4.5
  if (d == 4.5) { r |= 4; }
  d /= 1.5;                        // 3.0
  if (d == 3.0) { r |= 8; }
  d += 1;                          // int 右值自动提升：3.0 + 1.0 = 4.0
  if (d == 4.0) { r |= 16; }

  double a[3];
  a[0] = 1.5;
  a[1] = 2.25;
  a[2] = a[0] + a[1];              // 3.75
  if (a[2] == 3.75) { r |= 32; }
  a[1] += 0.75;                    // 3.0（数组元素复合赋值）
  if (a[1] == 3.0) { r |= 64; }
  if (a[2] - a[0] == 2.25) { r |= 128; }
  a[0] = 3;                        // int → double 元素（自动提升）
  if (a[0] == 3.0) { r |= 256; }

  print(["d=", d, " a=", a[0], ",", a[1], ",", a[2], " half=", half(a[2]), " r=", r, "\n"]);
  return r;   // 511
}
