// audit2.fl — v1.0.6.2 盲区审计 A2：char 直接变量前后缀/位反/赋值·复合赋值表达式值语义
// 修复前：char 赋值/复合赋值表达式值 = 未截断 32 位运算结果（(c=300) 值 300 而 c 存 44，
// x != c 违反窄类型语义；++/-- 因字节指令天然一致，赋值路径漏截断）
// 修复后：表达式值 = 存储字节（movzx 截断，对齐 C 窄类型赋值语义）
int main() {
  // —— 1. 前缀 ++/-- 值语义 + 字节回绕（0..255）——
  char c = 254;
  char v = ++c;
  if (v != 255) return 1;
  if (c != 255) return 2;
  char w = ++c;          // 255 回绕 → 0
  if (w != 0) return 3;
  if (c != 0) return 4;
  char d = 1;
  char x = --d;
  if (x != 0) return 5;
  char y = --d;          // 0 回绕 → 255
  if (y != 255) return 6;
  if (d != 255) return 7;
  // —— 2. 后缀 ++/-- 值语义（旧值）+ 回绕 ——
  char e = 10;
  char a = e++;
  if (a != 10) return 8;
  if (e != 11) return 9;
  char f = 255;
  char g = f++;          // 旧 255；f → 0
  if (g != 255) return 10;
  if (f != 0) return 11;
  char h = 0;
  char i = h--;          // 旧 0；h → 255
  if (i != 0) return 12;
  if (h != 255) return 13;
  // —— 3. 位反 ~（char 读 movzx → int 提升 32 位取反）——
  char j = 0;
  int r = ~j;
  if (r != -1) return 14;
  char k = 0x0F;
  int s = ~k;
  if (s != -16) return 15;
  // —— 4. 赋值表达式值 = 截断存储字节（v1.0.6.2 修复点）——
  char m;
  int t = (m = 300);
  if (t != 44) return 16;
  if (m != 44) return 17;
  int u = (m = ~m);      // ~44 = 0xFFFFFFD3 → 存储低字节 0xD3 = 211
  if (u != 211) return 18;
  if (m != 211) return 19;
  // —— 5. 复合赋值表达式值 = 截断存储字节（v1.0.6.2 修复点）+ 回绕 ——
  char n = 200;
  int p = (n += 100);    // 300 → 44
  if (p != 44) return 20;
  if (n != 44) return 21;
  int q = (n -= 100);    // 44-100=-56 → 字节 0xC8 = 200
  if (q != 200) return 22;
  if (n != 200) return 23;
  char o = 6;
  int z = (o *= 7);
  if (z != 42) return 24;
  char b3 = 250;
  int b4 = (b3 += 10);   // 260 → 4
  if (b4 != 4) return 25;
  // —— 6. 一致性：int x = (c = ...) 后 x == c 恒成立 ——
  char c2 = 200;
  int x2 = (c2 = 300);
  if (x2 != c2) return 26;
  char c3 = 0x80;
  int x3 = (c3 += 0x80); // 128+128=256 → 0
  if (x3 != c3) return 27;
  if (x3 != 0) return 28;
  // —— 7. 间接 char 目标（数组元素/char*）赋值·复合赋值表达式值同样截断 ——
  char buf[4];
  int d1 = (buf[0] = 300);
  if (d1 != 44) return 29;
  if (buf[0] != 44) return 30;
  buf[1] = 0;
  char *qp = buf + 1;
  int d2 = (qp[0] += 300);   // 0+300=300 → 44
  if (d2 != 44) return 31;
  if (buf[1] != 44) return 32;
  return 0;
}
