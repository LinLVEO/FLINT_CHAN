// tern1.fl —— v1.3.1 三元运算符 ?: 的成绩单（8 项位掩码 = 255）
// 每项只测「只有实现对才可能过」的观察点：极性两侧都测、副作用只发生一次、右结合、
// double 分支的 int→double 自动提升。
// 退出码 = 各项位之和（哪一位没亮就是哪一项错，二进制成绩单）。

int pick(int a, int b, int c) {
  return c ? a : b;          // ① 三元当返回值（函数返回路径）
}

int main() {
  int r = 0;
  int x = 3;
  int y = 7;

  // ② 条件为真 → 取真分支（极性：真）
  if ((x < y ? 11 : 22) == 11) r |= 1;

  // ③ 条件为假 → 取假分支（极性：假）——只测一侧就等于给「恒取真分支」的实现留门
  if ((x > y ? 11 : 22) == 22) r |= 2;

  // ④ 只求值被选中的那一支：假分支里的自增**不能**发生
  int n = 0;
  int v = 1 ? 5 : (n = n + 99);
  if (v == 5 && n == 0) r |= 4;

  // ⑤ 反向：真分支的副作用**必须**发生（两项一起才说明"选对了那一支"，而不是两边都/都不求值）
  int m = 0;
  int w = 0 ? 5 : (m = m + 3);
  if (w == 3 && m == 3) r |= 8;

  // ⑥ 右结合：a ? b : (c ? d : e)（左结合会算成 (a?b:c) ? d : e = 3 也对，故取值刻意让两者不同）
  int z = 0 ? 1 : 0 ? 2 : 3;
  if (z == 3) r |= 16;

  // ⑦ 当实参 + 条件里嵌比较：两个方向都调一次
  if (pick(4, 5, x < y) == 4 && pick(4, 5, x > y) == 5) r |= 32;

  // ⑧ 结果参与二元运算（优先级的可见后果：整体先算完再 * 2）
  if (2 + (x < y ? 10 : 20) * 2 == 22) r |= 64;

  // ⑨ double 分支：int 侧自动提升为 double（不静默丢精度），整支结果按 double 走 xmm0
  double d = x < y ? 1.5 : 2;
  double e = x > y ? 1.5 : 2;
  if (d == 1.5 && e == 2.0) r |= 128;

  return r;
}
