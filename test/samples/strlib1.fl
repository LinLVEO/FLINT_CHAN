// strlib1.fl — str_lib 第一批验证：len / eq / compare / copy / append / find / has_prefix
// 逐项位掩码累加，全过 → 退出码 42
include "../../lib/str_lib.fl"

int main() {
  int r = 0;

  if (std::strlen("") == 0) r |= 1;
  if (std::strlen("abc") == 3) r |= 2;

  if (std::streq("abc", "abc") == 1) r |= 4;
  if (std::streq("abc", "abd") == 0) r |= 8;
  if (std::streq("abc", "ab") == 0) r |= 16;

  if (std::strcmp("abc", "abd") == -1) r |= 32;
  if (std::strcmp("abc", "abc") == 0) r |= 64;
  if (std::strcmp("abd", "abc") == 1) r |= 128;

  char buf[64];
  if (std::strcpy(buf, "hello") == 5) r |= 256;
  if (std::streq(buf, "hello") == 1) r |= 512;
  if (std::strcat(buf, " world") == 11) r |= 1024;
  if (std::streq(buf, "hello world") == 1) r |= 2048;

  if (std::strstr("hello world", "world") == 6) r |= 4096;
  if (std::strstr("hello", "xyz") == -1) r |= 8192;
  if (std::strstr("aaa", "aa") == 0) r |= 16384;

  if (std::strpre("hello", "he") == 1) r |= 32768;
  if (std::strpre("hello", "lo") == 0) r |= 65536;
  if (std::strpre("hello", "") == 1) r |= 131072;

  if (r == 262143) return 42;
  return r;
}
