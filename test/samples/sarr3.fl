// sarr3.fl — v1.4.4：结构体数组字段的**布局规则**位掩码（全对 = 15）
//   FLINT 语义（与既有数组一致）：char 元素 1 字节；int/double 元素 8 字节槽。
//   这条测试的意义：**char 数组字段给的是 C 布局**（1 字节），
//   所以「声明式描述 Win32 结构」＝ 用 char 数组当字节垫片 + 把 32 位字段拆成 4 个 char
//   （见 hw.fl 的 MIB_IF_ROW2 计划用法）。
// ① 字段偏移：a[8] 之后，b 应在字节 8、c 应在字节 16
// ② 写 a[i] 不干扰 b / c
// ③ 写 b 不干扰 a[7]
// ④ 结构体总大小 = 24 字节（8 + 8 + 8）→ 用"再放一个结构体实例"的方式间接自证互不重叠
// 退出码位掩码：bit0 ①、bit1 ②、bit2 ③、bit3 ④（全对 = 15）
struct L { char a[8]; int b; int c; }

int main() {
  struct L x;
  struct L y;
  int r = 0;

  // ① 偏移：a[0..7] 写满，b/c 写值，互不干扰 ⇒ 偏移是 8 / 16
  x.a[0] = 1; x.a[1] = 2; x.a[2] = 3; x.a[3] = 4;
  x.a[4] = 5; x.a[5] = 6; x.a[6] = 7; x.a[7] = 8;
  x.b = 111; x.c = 122;
  if (x.a[0] == 1 && x.a[7] == 8 && x.b == 111 && x.c == 122) r = r | 1;

  // ② 改 b 不影响任何 a[i]
  x.b = 200;
  if (x.b == 200 && x.a[0] == 1 && x.a[7] == 8 && x.c == 122) r = r | 2;

  // ③ 改 a[7] 不影响 b
  x.a[7] = 77;
  if (x.a[7] == 77 && x.b == 200 && x.c == 122) r = r | 4;

  // ④ 两个实例互不重叠（同一套字段各写各的）
  y.a[0] = 9; y.b = 300; y.c = 400;
  if (y.a[0] == 9 && y.b == 300 && y.c == 400 && x.a[0] == 1 && x.b == 200 && x.c == 122) r = r | 8;

  return r;
}
