// pow1.fl —— v1.0.11 ^^ 幂运算符（位掩码断言：每位一项，退出码 = 掩码 4095）
// 决策 49 语义：右结合、高于一元负号与乘法、0^^0=1、负指数=0、溢出按 32 位回绕
int main() {
  int r = 0;
  if (2 ^^ 10 == 1024) r = r | 1;              // bit0 基本幂
  if (2 ^^ 3 ^^ 2 == 512) r = r | 2;           // bit1 右结合：2^(3^2)
  if (-2 ^^ 2 == -4) r = r | 4;                // bit2 幂紧于一元负号：-(2^2)
  if (0 ^^ 0 == 1) r = r | 8;                  // bit3 0^^0
  if (3 * 2 ^^ 3 == 24) r = r | 16;            // bit4 高于乘法
  if (2 ^^ 0 == 1) r = r | 32;                 // bit5 指数 0
  if (1 ^^ 100 == 1) r = r | 64;               // bit6 底数 1
  if ((-2) ^^ 3 == -8) r = r | 128;            // bit7 负底数
  if (2 ^^ -1 == 0) r = r | 256;               // bit8 负指数 = 0
  if (2 ^^ 31 == 0x80000000) r = r | 512;      // bit9 溢出 32 位回绕（-2147483648）
  if ((2 ^^ 3) ^^ 2 == 64) r = r | 1024;       // bit10 显式括号 = 左结合
  if (5 ^^ 3 == 125) r = r | 2048;             // bit11 普通幂
  return r;
}
