// m1_float.fl — 浮窗 M1：FLINT-UI 第一个"真应用"雏形
// 置顶半透明无边框浮窗（WS_EX_TOPMOST|WS_EX_LAYERED + alpha）+ WM_NCHITTEST 全窗拖动
// + putnum 数字显示（单字符 int 槽逐位 TextOutA，突破"数字→字符串显示"边界）
// + GetTickCount 模拟 CPU/TEMP 值跳动 + 占用色条
// 退出：右键（WM_RBUTTONDOWN 0x204）或 WM_CLOSE；窗口常驻（浮窗本性），不入自动回归
api kernel32 ptr GetModuleHandleA(int);
api kernel32 int GetTickCount();
api kernel32 void Sleep(int);
api user32 int RegisterClassA(int);
api user32 ptr CreateWindowExA(int, int, int, int, int, int, int, int, int, int, int, int);
api user32 int ShowWindow(int, int);
api user32 int PeekMessageA(int, int, int, int, int);
api user32 int DispatchMessageA(int);
api user32 int DefWindowProcA(int, int, int, int);
api user32 int ValidateRect(int, int);
api user32 ptr GetDC(int);
api user32 int ReleaseDC(int, int);
api user32 int FillRect(int, int, int);
api user32 int SetLayeredWindowAttributes(int, int, int, int);
api user32 int GetCursorPos(int);
api user32 int GetWindowRect(int, int);
api user32 int MoveWindow(int, int, int, int, int, int);
api gdi32 ptr GetStockObject(int);
api gdi32 int TextOutA(int, int, int, int, int);

struct WNDCLASS { int style; int *fn; int cb1; int cb2; int *inst; int *icon; int *cur; int *brush; int *menu; int *cls; }
struct MSG { int *hwnd; int message; int *wparam; int *lparam; int time; int px; int py; }
struct RECT { int l; int t; int r; int b; }
struct C { int ch; }   // 单字符承载：int 低字节 = ASCII，高 3 字节 0 → &c 可当 "x\0" 单字符串
struct P { int x; int y; }   // POINT（屏幕/客户坐标）

int wndproc(int *hwnd, int msg, int *wp, int *lp) {
  if (msg == 0x0F) { ValidateRect(hwnd, 0); return 0; }       // WM_PAINT：吞掉防合成洪泛
  return DefWindowProcA(hwnd, msg, wp, lp);
  // ⚠️ 不做 WM_NCHITTEST→HTCAPTION 假标题栏：系统会吞掉鼠标按下（当拖动/菜单），
  // 右键等客户区消息收不到——拖动改主循环手动 MoveWindow（有状态）
}

// putnum：在 (x,y) 画十进制整数 n（0..999，跳过前导 0；字符步进 8px）
int putnum(int *dc, int x, int y, int n) {
  struct C c;
  int h = n / 100;
  int t = (n / 10) % 10;
  int o = n % 10;
  int px = x;
  if (h != 0) { c.ch = '0' + h; TextOutA(dc, px, y, &c, 1); px = px + 8; }
  if (h != 0 || t != 0) { c.ch = '0' + t; TextOutA(dc, px, y, &c, 1); px = px + 8; }
  c.ch = '0' + o; TextOutA(dc, px, y, &c, 1);
  return 0;
}

int main() {
  struct WNDCLASS wc;
  wc.style = 0;
  wc.fn = &wndproc;
  wc.cb1 = 0; wc.cb2 = 0;
  wc.inst = GetModuleHandleA(0);
  wc.icon = 0; wc.cur = 0; wc.brush = 0; wc.menu = 0;
  wc.cls = "FLINTFLOAT";
  if (RegisterClassA(&wc) == 0) return 90;
  // exStyle = WS_EX_TOPMOST(0x8) | WS_EX_LAYERED(0x80000)；style = WS_POPUP(0x80000000)
  int *h = CreateWindowExA(0x00080008, "FLINTFLOAT", "", 0x80000000, 300, 200, 240, 92, 0, 0, 0, 0);
  if (h == 0) return 91;
  SetLayeredWindowAttributes(h, 0, 195, 2);   // alpha=195（0-255），LWA_ALPHA=2 → 半透明
  ShowWindow(h, 1);
  struct MSG m;
  struct C c;
  int running = 1;
  // 手动拖动状态（替代 NCHITTEST 假标题栏）
  int dragging = 0;
  int sx0 = 0; int sy0 = 0;   // 按下时光标屏幕坐标
  int wx0 = 0; int wy0 = 0;   // 按下时窗口左上屏幕坐标
  struct P pt;
  struct RECT wr;
  struct RECT client; client.l = 0; client.t = 0; client.r = 240; client.b = 92;
  struct RECT bar;    bar.l = 0; bar.t = 0; bar.r = 0; bar.b = 0;
  while (running) {
    while (PeekMessageA(&m, 0, 0, 0, 1) > 0) {
      if (m.message == 0x10) running = 0;         // WM_CLOSE
      if (m.message == 0x204) running = 0;        // WM_RBUTTONDOWN：右键退出
      if (m.message == 0x201) {                   // WM_LBUTTONDOWN：开始拖
        dragging = 1;
        GetCursorPos(&pt); sx0 = pt.x; sy0 = pt.y;
        GetWindowRect(h, &wr); wx0 = wr.l; wy0 = wr.t;
      }
      if (m.message == 0x200 && dragging) {       // WM_MOUSEMOVE：拖
        GetCursorPos(&pt);
        MoveWindow(h, wx0 + pt.x - sx0, wy0 + pt.y - sy0, 240, 92, 1);
      }
      if (m.message == 0x202) dragging = 0;       // WM_LBUTTONUP：停拖
      if (running) DispatchMessageA(&m);
    }
    if (running) {
      int t = GetTickCount();
      int cpu = (t / 120) % 101;                  // 0..100 循环跳动（~12s 一圈）
      int temp = 40 + (t / 400) % 15;             // 40..54 慢跳
      int *dc = GetDC(h);
      FillRect(dc, &client, GetStockObject(0));   // 白底（alpha 生效 → 半透明白）
      TextOutA(dc, 10, 8, "FLINT v1.0 float", 16);
      TextOutA(dc, 10, 30, "CPU", 3);
      putnum(dc, 50, 30, cpu);
      struct C pc; pc.ch = '%'; TextOutA(dc, 50 + 24, 30, &pc, 1);
      TextOutA(dc, 10, 52, "TEMP", 4);
      putnum(dc, 50, 52, temp);
      struct C dc2; dc2.ch = 'C'; TextOutA(dc, 50 + 24, 52, &dc2, 1);
      // 占用色条：宽 = cpu*1.2（0..120）
      bar.l = 100; bar.t = 32; bar.r = 100 + cpu + cpu / 5; bar.b = 44;
      if (bar.r > 220) bar.r = 220;
      FillRect(dc, &bar, GetStockObject(4));      // 黑条
      ReleaseDC(h, dc);
      Sleep(16);
    }
  }
  return 0;
}
