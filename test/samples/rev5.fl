// rev5.fl — v1.0.13 评审清单之外新发现的真 bug：地址链解引用的**读写宽度**（位掩码 = 255）
// 病根：parse 的 `*` 只对「裸变量 / 函数调用」推断 char 指向，地址链（q+1、q+i-1）落到默认 TY_INT
// → 解引用**读 4 字节**（值带出后面的字节）、**写 4 字节**（踩坏邻居字节）。旧/新编译器都错，
// 由新样本 rev4 暴露（"AB\0CD" 紧邻布局里 *(q+1) 读回 0x44430042 而不是 'B'）。
// 正确语义：解引用读/写宽 = 指针的指向类型（char* → 1 字节；int* → 4 字节）。
int main() {
  int r = 0;
  char *q = "AB";
  if (*(q + 0) == 'A') r = r | 1;              // bit0 基址
  if (*(q + 1) == 'B') r = r | 2;              // bit1 链 + 常量（修前 4 字节读 → 带出 "CD" byte）
  if (q[1] == 'B') r = r | 4;                  // bit2 下标形式（一直正确，作对照）
  int i = 1;
  if (*(q + i) == 'B') r = r | 8;              // bit3 链 + 变量偏移
  if (*(q + i - 1) == 'A') r = r | 16;         // bit4 链式偏移 ((q+i)-1)
  char b[4];
  b[0] = 'X'; b[1] = 'Y'; b[2] = 'Z'; b[3] = 0;
  *(b + 1) = 'W';                              // bit5 经链写 1 字节：邻居 X/Z 必须完好
  if (b[0] == 'X' && b[1] == 'W' && b[2] == 'Z') r = r | 32;
  char *z = "CD";
  if (*(z + 1) == 'D') r = r | 64;             // bit6 另一串（排除"后面恰好是 0"的假通过）
  if (*(b + 2) == 'Z') r = r | 128;            // bit7 数组名链（栈上）
  return r;
}
