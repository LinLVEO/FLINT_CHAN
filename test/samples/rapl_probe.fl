// rapl_probe.fl — 整机功耗验证：RAPL MSR（E5 v2 支持）
// MSR 0x606 (RAPL_POWER_UNIT)：bits 8:12 = 能量单位 ESU → 每计数 = 1/2^ESU 焦耳
// MSR 0x611 (PKG_ENERGY_STATUS)：64 位能量计数（只增）
// 功耗 W = Δcounts × 2^-ESU / Δt（1s 采样 → W = Δc / 2^ESU）
// 退出码 = W（期望空闲 20-80W）；1=设备 2=ioctl 3=单位无效 4=差无效
api kernel32 ptr CreateFileA(int, int, int, int, int, int, int);
api kernel32 int DeviceIoControl(int, int, int, int, int, int, int, int);
api kernel32 void Sleep(int);
struct IN4 { int idx; }
struct OUT { int lo; int hi; }
int main() {
  int *h = CreateFileA("\\\\.\\WinRing0_1_2_0", 0xC0000000, 0, 0, 3, 0, 0);
  if (h == 0) return 1;
  struct IN4 in;
  struct OUT o1;
  struct OUT o2;
  int ret = 0;
  in.idx = 0x606;
  if (DeviceIoControl(h, 0x9C402084, &in, 4, &o1, 8, &ret, 0) == 0) return 2;
  int esu = (o1.lo >> 8) & 0x1F;     // 能量单位（Ivy Bridge 通常 14）
  if (esu == 0 || esu > 20) return 3;
  int div = 1 << esu;                // 2^esu
  in.idx = 0x611;
  if (DeviceIoControl(h, 0x9C402084, &in, 4, &o1, 8, &ret, 0) == 0) return 2;
  Sleep(1000);
  in.idx = 0x611;
  if (DeviceIoControl(h, 0x9C402084, &in, 4, &o2, 8, &ret, 0) == 0) return 2;
  int dc = o2.lo - o1.lo;            // 1s 能量计数差（低 32 位够：~1e6/s << 2^32）
  if (dc <= 0) return 4;
  return dc / div;                   // W（esu=14 → /16384）
}
