// v1.2.1 回归：**同一个 double 常量出现多次**（位掩码，期望退出码 63）
//
// 为什么单独立这个样本：发现期（2026-09-13）实证的真 bug —— DblRef 一条记录只有一个「出现位置」
// 字段，同一常量用第二次会把第一次的位置**覆盖**掉 → 前一处 movsd 的 disp32 永不回填（disp=0，
// 运行时 [rip+0] 读成 0.0）。症状是**静默错值**：`double a = 2.0; if (a * 2.0 == 4.0)` 判假。
// 修法是「一条记录挂一张出现位置表」，本样本专门钉住它：**每个常量都出现两次以上**。
int main() {
  int r = 0;

  // ① 2.0 出现 3 次（初始化 / 乘法 / 比较常量）→ 全部必须生效
  double a = 2.0;
  if (a * 2.0 == 4.0) r |= 1;

  // ② 同一常量在比较两侧都用（== 两侧都是 1.5）
  double b = 1.5;
  if (b == 1.5) r |= 2;

  // ③ 常量在函数内多处使用：3.5 用两次（比较 + 参与运算）
  double c = 3.5;
  if (c == 3.5 && c * 2.0 == 7.0) r |= 4;

  // ④ 常量出现在不同语句类型里：return 值 / if 条件 / 赋值右值（0.25 出现 3 次）
  double d = 0.25;
  if (d * 4.0 == 1.0) r |= 8;
  d = 0.25;
  if (d + 0.75 == 1.0) r |= 16;

  // ⑤ 跨函数：两个函数各自用同一个常量 2.0（常量区去重后仍要各自回填）
  r |= fromhalf();

  // ⑥ 循环里重复用同一常量（同一处 movsd 反复执行，位移必须对）
  int i = 0;
  int hits = 0;
  while (i < 4) {
    if (i * 0.5 == 1.0) hits = hits + 1;   // i=2 那轮命中
    i = i + 1;
  }
  if (hits == 1) r |= 32;

  print(["dblconst 位掩码 = ", r, "\n"]);
  return r;
}

double half() { return 0.5; }
double usehalf() { return half() * 2.0; }
int fromhalf() {
  if (usehalf() == 1.0) return 64;   // 2.0 与 1.0 在此函数再次出现
  return 0;
}
