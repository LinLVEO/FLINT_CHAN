// global1.fl — v1.3.0 全局变量：核心通路（int 标量 / 数组 / 复合赋值 / 自增减 / 函数访问 / 遮蔽）
//
// 判据：退出码 = 位掩码成绩单（期望 255 = 8 位全亮）。
//   错误实现会留下「哪一位没进去」，比 return 0 强得多（见 记忆「位掩码样本」纪律）。
// 设计要点：每个断言都挑「错误实现必然取到别的值」的算例——不是「碰巧也能过」的位置。
//
// ⚠️ 前置说明（本条样本专测什么）：全局变量在 .data 里，代码用 [rip+disp32] 指过去。
//   最容易错的不是「读写」，而是「把全局当成本地帧槽」——那会读到栈上随机值：
//   本样本用**互不相同的初值**保证错读必现（若全初值都是 0，读错也读成 0 = 假绿）。

int gzero;                 // 未初始化全局 → 必须为 0（.data 全零铺底）
int ginit = 11;            // 常量初值
int garr[4];               // 全局数组
int gsum = 0;

// 函数里读写全局（跨函数可见性）；前向调用（main 在其之前引用 gsum）
int bump(int n) { gsum += n; return gsum; }

int main() {
  int r = 0;

  // ① 未初始化全局 = 0（不是栈垃圾）
  if (gzero == 0) r |= 1;

  // ② 常量初值真的落到 .data
  if (ginit == 11) r |= 2;

  // ③ 写全局后读回（写→读闭环；写错地址会读到初值 11）
  ginit = 42;
  if (ginit == 42) r |= 4;

  // ④ 数组元素下标读写（元素缩放/寻址全在 .data 内）
  garr[0] = 5; garr[1] = 6; garr[2] = 7; garr[3] = 8;
  if (garr[0] + garr[3] == 13) r |= 8;

  // ⑤ 复合赋值（走间接通路：地址算出 → [rdx] 读-改-写）
  int s = 100;
  s += 5; s -= 3; s *= 2; s /= 4;   // 100→105→102→204→51
  if (s == 51) r |= 16;

  // ⑥ 自增/自减语义：前缀值=新、后缀值=旧
  int t = 7;
  int old = t++;      // old=7, t=8
  int nw = ++t;       // t=9, nw=9
  if (old == 7 && t == 9 && nw == 9) r |= 32;

  // ⑦ 全局被函数修改、结果跨函数可见（bump 累加 3+4=7）
  bump(3);
  bump(4);
  if (gsum == 7) r |= 64;

  // ⑧ 局部变量遮蔽同名全局（内层 ginit 是局部，全局 ginit 保持 42 不动）
  {
    int ginit = 1;
    ginit += 10;                     // 只动局部 → 11
    if (ginit == 11) r |= 128;
  }
  if (ginit != 42) r &= ~128;        // 局部那次操作若污染了全局 → 撤销这一位（鉴别力加固）

  return r;                          // 期望 255
}
