// s2_probe.fl — v0.9.2 S2 关闭 + 类型层实证：指针字段 64 位读写 + 真实 C 布局
// 字段类型：int 4B/对齐 4、int * 8B/对齐 8（旧版字段全 8 字节槽、offset=字段序×8，无法承载指针）
// 判据：
//   91 = 指针字段写/读截断（S2 bug：旧实现间接写恒 32 位 + 读恒 32 位）
//   93 = 读回的指针地址不完整（>4GB 数据段地址截断后无法解引用）
//   94 = 布局不是 C 排布（a@0 b@4 c@8 p@16，差 16；8 字节槽排布差 24）
struct Mix { int a; int b; int c; int *p; }
int main() {
  int *t = "ABCDEF";                 // 数据段地址 >4GB（确定性）
  struct Mix s;
  s.a = 3;
  s.b = 4;
  s.c = 5;
  s.p = t;                            // 指针字段 64 位写（S2）
  if (s.p != t) return 91;            // 指针字段 64 位读 + 64 位比较（S2）
  if (s.a != 3) return 92;            // int 字段（4B 布局）读写正常
  int *q = s.p;                       // 字段读回可作指针直接用
  if ((*q & 0xFF) != 65) return 93;   // 解引用读首字节 'A'（地址完整 → 数据段可解引用）
  int d = &s.p - &s.a;                // C 布局：p@16 - a@0 = 16（旧 8 槽排布 = 24）
  if (d != 16) return 94;
  if (s.b != 4 || s.c != 5) return 95;
  return 0;
}
