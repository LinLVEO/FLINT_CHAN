// uint1.fl -- v1.9.0 三种无符号整数（uint_8 / uint_32 / uint_64）的端到端样本。
// 只跑真 flint（boot 的类型宇宙没有 uint_*，属既有类型缺口，同 double / int_64）。
//
// 判据：每一位一个检查，退出码 42 只在掩码 == 255 时给出；期望值由
//   node test\facts\uint-exp.js 现算（f048/f049/f050/f051/f052 五节），不手写。
// ASCII only, no BOM.
int main() {
  uint_32 a = 0;
  a = a - 1;                     // 2^32-1
  uint_64 b = 0;
  b = b - 1;                     // 2^64-1
  uint_8 c = 255;
  c = c + 1;                     // 存储截断：256 -> 0
  uint_32 q = 0;
  q = q - 1;
  int i = 0 - 1;

  int m = 0;
  if (a / 2 == 2147483647) { m = m + 1; }                  // uint_32 无符号除法
  if (b / 10 == 1844674407370955161) { m = m + 2; }        // uint_64 无符号除法
  if (a >> 1 == 2147483647) { m = m + 4; }                 // 逻辑右移
  if (b >> 1 == 9223372036854775807) { m = m + 8; }        // 64 位逻辑右移
  if (a > 1) { m = m + 16; }                               // 无符号比较
  if (c == 0) { m = m + 32; }                              // uint_8 回绕
  if (q + i == 4294967294) { m = m + 64; }                 // uint_32 + int -> uint_32
  if (i * 1 + b == (uint_64)0 - 2) { m = m + 128; }        // int_64 + uint_64 -> uint_64
  print(["mask=", m, " expect=255\n"]);
  if (m == 255) { return 42; }
  return 7;
}
