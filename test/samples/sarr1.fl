// sarr1.fl — v1.4.4：结构体「固定长度数组字段」位掩码成绩单（7 项，全对 = 127）
// 语言语义（与 FLINT 既有数组一致）：**int/double 元素占 8 字节槽、char 元素 1 字节**
// 覆盖：
//   ① `int buf[4]` 字段写
//   ② 读回
//   ③ 数组字段直接当实参传给 `int *p` 形参（形参写入调用方可见）
//   ④ `char cbuf[6]` 字段（char = 1 字节元素）
//   ⑤ `&b.buf[1]` 取元素地址 + 指针写穿透
//   ⑥ 与标量字段混排后标量字段仍正常
//   ⑦ 元素步长 = 8 字节（&buf[1] - &buf[0] == 8，语言语义钉死）
struct Box { int x; int buf[4]; char cbuf[6]; int y; }

int put4(int *p) {
  p[0] = 7;
  p[1] = 8;
  p[2] = 9;
  p[3] = 10;
  return 0;
}

int fillc(int *c) {
  c[0] = 11;
  c[1] = 12;
  c[2] = 13;
  return 0;
}

int main() {
  struct Box b;
  int *q;
  int *q0;
  int *q1;
  int r = 0;

  // ① 写数组元素
  b.buf[0] = 1;
  b.buf[1] = 2;
  b.buf[2] = 3;
  b.buf[3] = 4;

  // ② 读回
  if (b.buf[0] == 1 && b.buf[1] == 2 && b.buf[2] == 3 && b.buf[3] == 4) r = r | 1;

  // ③ 数组字段当实参（形参写 4 个值，调用方全部可见）
  put4(b.buf);
  if (b.buf[0] == 7 && b.buf[1] == 8 && b.buf[2] == 9 && b.buf[3] == 10) r = r | 2;

  // ④ char 数组字段（1 字节元素）
  fillc(b.cbuf);
  if (b.cbuf[0] == 11 && b.cbuf[1] == 12 && b.cbuf[2] == 13) r = r | 4;

  // ⑤ 元素地址 + 指针写穿透
  q = &b.buf[1];
  q[0] = 40;
  q[1] = 50;
  if (b.buf[1] == 40 && b.buf[2] == 50) r = r | 8;

  // ⑥ 混排的标量字段未被写坏
  b.x = 21;
  b.y = 22;
  if (b.x == 21 && b.y == 22) r = r | 16;

  // ⑦ 相邻元素互不覆盖（真实内存独立）＋ 最后一个元素不越界碰标量字段
  //   ⚠️ 不用指针减法/比较断言步长：实测 `q1 - q0` 与 `q1 == q0 + 8` 在 FLINT 里都不可靠
  //      （指针算术语义另有坑），改用「写一个读另一个」这种**行为可观测**的判据。
  b.buf[0] = 61;
  b.buf[1] = 62;
  if (b.buf[0] == 61 && b.buf[1] == 62) r = r | 32;
  b.buf[3] = 99;
  if (b.buf[3] == 99 && b.buf[2] == 9 && b.x == 21 && b.y == 22) r = r | 64;

  return r % 256;
}
