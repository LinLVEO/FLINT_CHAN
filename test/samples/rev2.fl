// rev2.fl — v1.0.12 评审清单【1】同族：64 位比较中 int 一侧必须符号扩展（位掩码，期望退出码 7）
// （bit3 用作「必须为假」的哨兵位：任何一条反向/相等断言错，掩码即多出 8 而非 7）
// 修复前：gen_cmp 的 wide 路径对两侧一律 mov rcx,rax（零扩展）→ `-1 < &a[0]` 把 0xFFFFFFFF
// 当正整数（42 亿）与栈地址比 → 结果为假（反了）
// 语义：地址类参与的 + - 与比较整体走 64 位，非地址一侧按有符号 64 位参与
int main() {
  int a[4];
  a[0] = 42;
  a[1] = 20;
  int *p = a;
  int i = -1;
  int r = 0;
  if (p + i != p - 1) r = r | 8;      // bit3 两侧都是地址链 → 必须相等（不亮）
  if (i < &a[0]) r = r | 1;           // bit0 ★ -1 < 栈地址 必须真（修前假）
  if (i <= &a[0]) r = r | 2;          // bit1 ★ 同上（<= 路径）
  if (&a[0] < i) r = r | 8;           // 反向必须假（不亮）
  if (i > &a[1]) r = r | 8;           // 必须假（不亮）
  if (i >= &a[0]) r = r | 8;          // 必须假（不亮）
  if (&a[1] > &a[0]) r = r | 4;       // bit2 纯地址比较（升序数组 → 真）
  return r;
}
