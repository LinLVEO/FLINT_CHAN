// v1.2.0 break / continue 专项（位掩码 = 一眼看出哪一位没进去；期望退出码 255）
// 每项命中置 1<<k；最后 return r（0..255 全中 = 255）
int main() {
  int r = 0;

  // ① break 跳出：i 到 5 就停，累加 0+1+2+3+4 = 10
  int s = 0;
  int i = 0;
  while (1) {
    if (i == 5) break;
    s = s + i;
    i = i + 1;
  }
  if (s == 10) r |= 1;

  // ② continue 跳过：while 里跳过奇数（i 必须照样自增，否则死循环）
  s = 0;
  i = 0;
  while (i < 10) {
    i = i + 1;
    if (i % 2 == 1) continue;
    s = s + i;                  // 只累加 2+4+6+8+10 = 30
  }
  if (s == 30) r |= 2;

  // ③ for 里 continue 必须先执行增量（否则 i 不动 = 死循环 → 超时哨兵）
  s = 0;
  for (i = 0; i < 6; i = i + 1) {
    if (i % 2 == 1) continue;
    s = s + i;                  // 0+2+4 = 6
  }
  if (s == 6) r |= 4;

  // ④ for 里 break（跳出后 i 的值应停在 4）
  i = 0;
  for (i = 0; i < 100; i = i + 1) {
    if (i == 4) break;
  }
  if (i == 4) r |= 8;

  // ⑤ 嵌套循环：break/continue 只管最内层（C 语义）
  int outer = 0;
  int hit = 0;
  for (outer = 0; outer < 4; outer = outer + 1) {
    int j = 0;
    while (j < 10) {
      j = j + 1;
      if (j == 3) break;        // 只跳内层
      if (j == 1) continue;
      hit = hit + 1;            // 每轮外层只加 1 次（j=2 那次）
    }
  }
  if (hit == 4) r |= 16;

  // ⑥ break 之后同一块内语句不执行（跳出语义）
  int after = 0;
  while (1) {
    break;
    after = 99;                 // 不可达
  }
  if (after == 0) r |= 32;

  // ⑦ 双层循环里 continue 不影响外层（外层计数照走完 6 次）
  int cnt = 0;
  for (i = 0; i < 6; i = i + 1) {
    if (i == 2) continue;
    cnt = cnt + 1;
  }
  if (cnt == 5) r |= 64;

  // ⑧ break 在最内层 while，外层 for 继续（外层跑满 3 轮）
  int rounds = 0;
  for (i = 0; i < 3; i = i + 1) {
    int k = 0;
    while (k < 100) {
      k = k + 1;
      break;
    }
    rounds = rounds + 1;
  }
  if (rounds == 3) r |= 128;

  print(["break/continue 位掩码 = ", r, "\n"]);
  return r;
}
