// bitop_probe.fl — 位运算 `&` `|` `>>` `<<` 全值域实证（2026-09-16）
// 用途：hw.fl 注释里写着「FLINT 的 & 已确认算错」——本探针把 8 组用例枚举出来，
//       用位掩码退出码一次定位（每项 = 1<<i，全对 = (1<<8)-1 = 255）。
// 退出码：位 i 置 1 = 第 i 项通过。全对 = 255。
//
// 期望值（C 语义，人手算）：
//   A 3 & 1      = 1
//   B 6 & 3      = 2
//   C 12 | 3     = 15
//   D 16 >> 2    = 4
//   E 5 << 3     = 40
//   F 0xFF & 0x0F = 15
//   G 0x1000 & 0x1000 = 4096      （第 12 位：验证高位单 bit）
//   H 0x140 >> 6 = 5              （组合：右移 + 掩码位）

int main() {
  int r = 0;

  if ((3 & 1) == 1) r = r | 1;             // A → 1
  if ((6 & 3) == 2) r = r | 2;             // B → 2
  if ((12 | 3) == 15) r = r | 4;           // C → 4
  if ((16 >> 2) == 4) r = r | 8;           // D → 8
  if ((5 << 3) == 40) r = r | 16;          // E → 16
  if ((255 & 15) == 15) r = r | 32;        // F → 32
  if ((4096 & 4096) == 4096) r = r | 64;   // G → 64
  if ((320 >> 6) == 5) r = r | 128;        // H → 128

  return r;
}
