// global2.fl — v1.3.0 全局变量：类型分支（char / double）＋ 前向引用 ＋ 逗号声明表
//
// 判据：退出码 = 位掩码成绩单（期望 255）。
// 本样本专钉**按类型选宽度**这件事：全局变量有 char（1 字节）/ double（xmm0）/
//   int（8 字节槽按 64 位读写）三套不同发射器，选错宽度就是「编译过、静默错值」。
//
// ⚠️ 关键设计（来自记忆「值恰好落在约定寄存器里」那条纪律）：
//   double 断言前**先算一个别的 double** 占住 xmm0，否则即使实现走错通道，
//   xmm0 里恰好留着上一次的结果 → 凑巧读对 = 假绿。

char gc = 65;              // 'A'
char gbuf[4];

double gd = 1.5;
double gd2 = 2.25;

int gi = 3, gj = 4;        // v1.3.0：逗号声明表（与函数内 int a = 1, b = 2; 对齐）
int gzero2;                // 未初始化 → 0

// 前向引用：main 在其之前使用 gd2（全局变量的偏移在预扫描阶段已定死，与声明位置无关）
double fwd() { return gd2; }

int main() {
  int r = 0;

  // ① char 全局：读 = movzx 字节（初值 65）
  if (gc == 65) r |= 1;

  // ② char 全局：写只动 1 字节 + 自增按字节回绕（250+10 → 4，若按 4 字节写会污染邻变量）
  char wrap = 250;
  gbuf[0] = wrap;
  gbuf[0] += 10;                   // 260 截断到字节 = 4
  if (gbuf[0] == 4) r |= 2;

  // ③ char 全局的 ++ 语义（前缀/后缀）
  char c2 = 1;
  gbuf[1] = c2;
  int c_old = gbuf[1]++;           // old=1, gbuf[1]=2
  if (c_old == 1 && gbuf[1] == 2) r |= 4;

  // ④ double 全局读（先造一个「别的 double」占住 xmm0，防残值假绿）
  double fresh = 8.75;
  if (gd == 1.5) r |= 8;
  if (fresh == 8.75) r |= 16;      // 顺手验证「占位值」本身没被 gd 的读取破坏

  // ⑤ double 全局复合赋值（走 [rdx] 间接 SSE 读-改-写，绝不走整数 32 位路径）
  gd += 0.5;                       // 1.5 → 2.0
  if (gd == 2.0) r |= 32;

  // ⑥ double 全局赋值 + 乘算（gd2 = 2.25 未被污染）
  gd = gd2 * 2.0;                  // 4.5
  if (gd == 4.5) r |= 64;

  // ⑦ 逗号声明表的两个全局都真的存在且各自独立
  gi = 30;
  gj = 12;
  if (gi == 30 && gj == 12) r |= 128;

  // ⑧ 前向引用 + 未初始化全局（同一轮里两件事，任一错则这一位不亮——不让它影响其余位）
  if (fwd() == 2.25 && gzero2 == 0) r |= 128;

  return r;                        // 期望 255
}
