// rev4.fl — v1.0.13 T1：int 装地址的自动适配（编译器自己判断存取宽度；位掩码 = 127）
// 修复前：`int s = "AB";` 只往 4 字节槽里存低 32 位 → 再当指针用即 0xC0000005（静默截断）
// T1 规则：直接 int 变量 ← 地址值 → 槽按 8 字节存并标记该变量；标记变量的读一律 8 字节（转手不丢）；
//          算术仍按 32 位（语义未改）→ 地址经算术中转再当指针用会被编译期拦下（见 run-tests 负例）
int main() {
  int r = 0;
  int s = "AB";             // ① 地址值存进 int 槽 → 8 字节写满 + 标记
  char *q = s;              // ② 标记变量 → 8 字节读 → 完整地址
  if (*q == 'A') r = r | 1;
  if (q[1] == 'B') r = r | 2;   // 下标形式（*(q+1) 的读宽是另一个 bug，见 rev5.fl）

  int t = s;                // 函数内转手：标记定点传递（t 也成为「装地址的 int」）
  char *w = t;
  if (*w == 'A') r = r | 4;

  char *p = "CD";
  int u = p;                // 反向：int ← 指针变量（值是完整 64 位）
  char *v = u;
  if (*v == 'C') r = r | 8;

  s = 7;                    // 标记变量改存普通 int → 仍 8 字节写满（符号扩展，高半确定不留残渣）
  if (s == 7) r = r | 16;

  char *z = "AB";
  int y = z + 1;            // 指针算术结果（64 位地址链）也是地址值 → y 被标记
  char *y2 = y;
  if (*y2 == 'B') r = r | 32;

  int d = (z + 1) - z;      // 地址 − 地址 = 差值（标量，不是地址）→ d 不标记，按普通 int
  if (d == 1) r = r | 64;

  return r;
}
