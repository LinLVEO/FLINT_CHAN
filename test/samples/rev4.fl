// rev4.fl — 地址值一律用指针接（slot4 后：本地标量 int 只有 4 字节，装不下 64 位地址）
// v1.0.13 T1 时代的「int 自动扩成 8 字节槽」已经取消：`int t = &x;` 现在编译期硬错。
// 本样本改写成新语义下的正例，位掩码 = 127。
int main() {
  int r = 0;
  char *s = "AB";
  char *q = s;                  // 指针转手
  if (*q == 'A') r = r | 1;
  if (q[1] == 'B') r = r | 2;

  char *t = s;                  // 函数内转手仍是指针
  char *w = t;
  if (*w == 'A') r = r | 4;

  char *p = "CD";
  char *v = p;
  if (*v == 'C') r = r | 8;

  s = "XY";                     // 指针改指
  if (*s == 'X') r = r | 16;

  char *z = "AB";
  char *y = z + 1;              // 裸指针 +n = 字节步进
  if (*y == 'B') r = r | 32;

  int d = (z + 1) - z;          // 地址 − 地址 = 标量差值（可以进 int）
  if (d == 1) r = r | 64;

  return r;
}
