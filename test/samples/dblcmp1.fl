// v1.2.3 浮点比较修正：`!=` 曾与 `==` 同义（v1.1.0 起就错，本轮写浮点打印时撞出）
// 16 项位掩码 = 65535（每项命中置 1<<k）——退出码即二进制成绩单；末两行再各加 0/1 → 期望 **65536**。
//
// 病灶（旧实现）：`!=` 分支 = setnp(有序) + setne → `xor eax,1` → `and`
//   → 算出来是「有序且 ZF」＝ **等于**！后果：`a != b` 在 a≠b 时为**假**、`a != a` 为**真**。
//   同批 `<` / `<=` 也漏了 NaN 修正：ucomisd 无序时 CF=1，setb/setbe 把 NaN 判成"小于"。
// 鉴别力实证（用去掉 double 形参的等价版本各跑一次，因为旧编译器还没有 double 形参）：
//   旧编译器退出码 53211（缺 12324 = bit 2 + bit 5 + bit 12 + bit 13，恰好是
//   `a != b` / `n != n` / `!(n < a)` / `!(n <= a)` 四项）；修好后 65535（那一版样本里无末两行）。
double half(double x) { return x / 2.0; }

int main() {
  double a = 1.5;
  double b = 2.5;
  double n = 0.0 / 0.0;      // NaN（IEEE：与任何值比较都为假，唯独 != 为真）
  int r = 0;

  // —— 正常值 10 项（真 / 假两侧都要钉：只测"真"那一侧抓不到"恒真/恒假"的实现）——
  if (a < b) { r |= 1; }              // 严格小于
  if (a <= b) { r |= 2; }             // 小于等于
  if (a != b) { r |= 4; }             // ★ 旧实现错：算成"相等" → 假
  if (b > a) { r |= 8; }              // 严格大于
  if (b >= a) { r |= 16; }            // 大于等于
  if (!(a > b)) { r |= 64; }
  if (!(a >= b)) { r |= 128; }
  if (!(a == b)) { r |= 256; }
  if (!(b < a)) { r |= 512; }
  if (!(b <= a)) { r |= 1024; }

  // —— NaN 6 项（IEEE 754：任何大小比较与 == 都为假，!= 为真）——
  if (n != n) { r |= 32; }            // ★ 旧实现错（跟着 != 一起坏）
  if (!(n == n)) { r |= 2048; }
  if (!(n < a)) { r |= 4096; }        // ★ 旧实现错：无序 CF=1 → 判成"小于"
  if (!(n <= a)) { r |= 8192; }       // ★ 旧实现错（同上）
  if (!(n > a)) { r |= 16384; }
  if (!(n >= a)) { r |= 32768; }

  // —— 顺带钉住"比较结果能当值用"：返回 0/1 参与算术 ——
  //  half(5.0)==2.5 为真 → +1；half(5.0)!=2.5 为假 → +0（两者都为 1 才说明 `!=` 又退化成 `==`）
  r = r + (half(5.0) == 2.5) + (half(5.0) != 2.5);
  return r;   // 65535 + 1 + 0 = 65536
}
