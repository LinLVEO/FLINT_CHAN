// mathlib1.fl — math_lib 验证：abs / min / max / clamp / percent
include "../../lib/math_lib.fl"

int main() {
  int r = 0;

  if (std::abs(-5) == 5) r |= 1;
  if (std::abs(7) == 7) r |= 2;
  if (std::abs(0) == 0) r |= 4;

  if (std::min(3, 9) == 3) r |= 8;
  if (std::min(-1, -5) == -5) r |= 16;
  if (std::max(3, 9) == 9) r |= 32;
  if (std::max(-1, -5) == -1) r |= 64;

  if (std::clamp(5, 1, 10) == 5) r |= 128;
  if (std::clamp(-3, 1, 10) == 1) r |= 256;
  if (std::clamp(99, 1, 10) == 10) r |= 512;

  if (std::percent(50, 100) == 50) r |= 1024;
  if (std::percent(1, 3) == 33) r |= 2048;
  if (std::percent(5, 0) == 0) r |= 4096;
  if (std::percent(3, 4) == 75) r |= 8192;

  if (r == 16383) return 42;
  return r;
}
