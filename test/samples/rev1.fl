// rev1.fl — v1.0.12 评审清单【1】：地址链「int 在左」也要符号扩展（位掩码，期望退出码 63）
// 修复前：`i + p` 的 lhs（int -8）零扩展成 0xFFFFFFF8（约 42 亿）→ 地址变野指针 → 0xC0000005
// 语义：地址类 ± int 偏移走 64 位，其中 int 一侧按有符号 64 位（movsxd）参与
int main() {
  int a[4];
  a[0] = 42;
  a[1] = 20;
  a[2] = 7;
  int *p = a + 8;              // 字节步进：a+8 = &a[1]
  int i = -8;
  int r = 0;
  if (*(p + i) == 42) r = r | 1;      // bit0 地址在左（旧实现已正确）
  if (*(i + p) == 42) r = r | 2;      // bit1 ★ int 在左（修前崩）
  if (*(p + i + 8) == 20) r = r | 4;  // bit2 链式：负偏移后接正偏移（a+8 = &a[1]）
  if (*(i + p + 16) == 7) r = r | 8;  // bit3 ★ 修前崩
  int *q = a + 16;
  int j = -16;
  if (*(j + q) == 42) r = r | 16;     // bit4 ★ 多字节负偏移
  if (*(q + j) == 42) r = r | 32;     // bit5 对称写法
  return r;
}
