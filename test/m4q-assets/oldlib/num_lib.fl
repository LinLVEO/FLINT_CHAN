// num_lib.fl — FLINT 标准库（第一批）：数字 ↔ 文本
// 用法：include "../../lib/num_lib.fl"（路径相对本文件目录解析）
// 命名：2026-09-09 用户定（原则 7 便利性第一）——惯用短名，见 SPEC「标准库」节

// 十进制（含负号）写入 buf 并补结尾 0，返回写入的字符数（不含结尾 0）；buf 至少 12 字节
int std::itoa(int n, char *buf) {
  char tmp[12];
  int i = 0;
  int neg = 0;
  if (n < 0) { neg = 1; n = -n; }
  if (n == 0) { tmp[0] = '0'; i = 1; }
  while (n != 0) {
    tmp[i] = '0' + n % 10;
    n = n / 10;
    i = i + 1;
  }
  int j = 0;
  if (neg != 0) { buf[0] = '-'; j = 1; }
  while (i > 0) {
    i = i - 1;
    buf[j] = tmp[i];
    j = j + 1;
  }
  buf[j] = 0;
  return j;
}

// 文本 → 十进制整数：跳过前导空白，识别 + / -，遇非数字停止
int std::atoi(char *s) {
  int i = 0;
  while (s[i] == ' ' || s[i] == 9) { i = i + 1; }
  int neg = 0;
  if (s[i] == '-') { neg = 1; i = i + 1; }
  else if (s[i] == '+') { i = i + 1; }
  int v = 0;
  while (s[i] >= '0' && s[i] <= '9') {
    v = v * 10 + (s[i] - '0');
    i = i + 1;
  }
  if (neg != 0) { return -v; }
  return v;
}

// 无符号 32 位十六进制小写（无 0x 前缀）写入 buf 并补结尾 0，返回字符数；buf 至少 9 字节
int std::itohex(int n, char *buf) {
  char digits[16];
  digits[0] = '0'; digits[1] = '1'; digits[2] = '2'; digits[3] = '3';
  digits[4] = '4'; digits[5] = '5'; digits[6] = '6'; digits[7] = '7';
  digits[8] = '8'; digits[9] = '9'; digits[10] = 'a'; digits[11] = 'b';
  digits[12] = 'c'; digits[13] = 'd'; digits[14] = 'e'; digits[15] = 'f';
  char tmp[8];
  int i = 0;
  int v = n;
  if (v == 0) { tmp[0] = '0'; i = 1; }
  while (v != 0 && i < 8) {
    tmp[i] = digits[v & 15];
    v = v >> 4;
    i = i + 1;
  }
  int j = 0;
  while (i > 0) {
    i = i - 1;
    buf[j] = tmp[i];
    j = j + 1;
  }
  buf[j] = 0;
  return j;
}

// 十进制字符数（含负号；0 → 1）
int std::numlen(int n) {
  char tmp[12];
  return std::itoa(n, tmp);
}
