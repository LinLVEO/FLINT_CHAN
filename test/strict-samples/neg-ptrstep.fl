// neg-ptrstep.fl -- v1.6.4 `-strict` 第五类（E-STRICT-PTRSTEP）负例。
// 病：FLINT 的裸指针 ± 整数是**字节**步进（决策 40），在非 1 字节元素指针上就是静默错值：
//   `p + 3` 只走 3 个字节（落进 a[0] 中间），要第 3 个元素得写 p[3]（偏移 24 字节）。
// 要求：默认档必须**静默编过**（决策 40 的既有语义，一个字都不改），-strict 才拦下。
// 本样本故意把四种命中形态各写一行（常量在右 / 常量在左 / 裸减 / 变量偏移）——
// 报错只报第一处（编译器 error_at 即 exit），第一条命中就是 `p + 8`。
int main() {
  int a[8];
  int i = 0;
  while (i < 8) { a[i] = 100 + i; i = i + 1; }
  int *p = a;
  int *q = p + 8;      // 命中①：+ 常量（8 个**字节**；那正好是 &p[1]，不是 &p[8]）
  int *r = 3 + p;      // 命中②：常量在左（3 个字节，落在 a[0] 中间）
  int *s = p - 1;      // 命中③：- 常量（-1 个字节）
  int *t = p + i;      // 命中④：+ 变量（i 个字节，不是第 i 个元素）
  return q[0] + r[0] + s[0] + t[0];
}
