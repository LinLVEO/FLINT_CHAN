// http_lib.fl — FLINT 标准库（第八批）：本地 HTTP GET + 极简 JSON 取值
// 立项背景（2026-09-16，浮窗还原第 5 步）：C# 版硬件监测浮窗在 8080 提供 /api/data（JSON 快照），
//   浮窗要「与 C# 同源读数」就得自己会发 HTTP —— 本库用 ws2_32 原生 socket 实现，不借任何外部 exe/库。
//
// 用法：
//   char b[4096];
//   struct HttpBuf hb;
//   hb.b = b; hb.cap = 4096; hb.n = 0;                              // b 是 char 数组，赋给 int* 字段（FLINT 允许）
//   int rc = std::http_get("127.0.0.1", 8080, "/api/data", &hb);     // rc: 0=成功 1=WSA/socket 失败 2=连不上 3=无响应体
//   int ok = 0;
//   int v = std::json_num(hb.b, hb.n, cs, ce, "\"temp\"", &ok);      // v = 数值×1000（定点）
//
// ⚠️ struct HttpBuf 只能在函数里当局部量（FLINT v1.4.4 不支持 struct 全局变量）。
//
// 边界（第一版，够用即止）：
//   - 只支持 IPv4 字面地址（不做 DNS；本地服务够用）
//   - 只支持 HTTP/1.0 + Connection: close 的「读到对端关闭为止」；不解析 Content-Length / chunked
//   - 无 TLS、无 POST、无重定向（都是本地只读接口不需要的）
//   - JSON 侧：只做「取数」不做「建树」——对象内查找键 → 读数值（×1000 定标成整数）
//
// ⚠️ 写用本库的代码前必看两条坑（本轮实测）：
//   ① 别把「写 out 参数的函数」和「读该 out 参数的变量」放进同一次调用
//      （`dump(name, jnum(...,&ok), ok)` 里 ok 会被读成旧值 → 成绩单整体错位一格）；一律两段式。
//   ② FLINT 函数参数上限 4 个 → 复杂接口一律「结构体 in/out」，别堆参数。
api ws2_32 int WSAStartup(int, int);
api ws2_32 int WSACleanup();
// socket 返回 SOCKET（64 位句柄）→ 按 ptr 返回、用 int * 承接；与 net_lib.fl 文件头 ① 同口径
api ws2_32 ptr socket(int, int, int);
api ws2_32 int connect(int, int, int);
api ws2_32 int send(int, int, int, int);
api ws2_32 int recv(int, int, int, int);
api ws2_32 int closesocket(int);

// —— §4 HTTPS 用（WinHTTP；2026-11-03 追加）——
// ⚠️ 句柄一律用 `ptr`：WinHTTP 的 HINTERNET 在 x64 上是 64 位值，声明成 int 会被截断（32 位装载）。
//    参数里传 0（NULL）与 wide 串（char 缓冲地址）都实测可用。
api winhttp ptr WinHttpOpen(ptr, int, ptr, ptr, int);
api winhttp ptr WinHttpConnect(ptr, ptr, int, int);
api winhttp ptr WinHttpOpenRequest(ptr, ptr, ptr, ptr, ptr, ptr, int);
api winhttp int WinHttpSendRequest(ptr, ptr, int, ptr, int, int, ptr);
api winhttp int WinHttpReceiveResponse(ptr, ptr);
api winhttp int WinHttpReadData(ptr, ptr, int, ptr);
api winhttp int WinHttpCloseHandle(ptr);
api kernel32 int MultiByteToWideChar(int, int, ptr, int, ptr, int);

// 接收缓冲（调用方管内存：b + cap；n = 实际收到的「响应体」字节数）
// ⚠️ FLINT v1.4.4 边界：**struct 字段不支持 char \***（只开 int*/double*/结构体指针）
//    → 缓冲地址用 `int *` 字段装（指针字段是真 64 位槽），取字节用下面的 http_pb 辅助。
struct HttpBuf { int *b; int cap; int n; }

// 把 p（int*，实为字节缓冲地址）当字节数组用：读/写第 i 字节
int http_pb(int *p, int i) {
  char *cp = p;
  return cp[i];
}

int http_sb(int *p, int i, int v) {
  char *cp = p;
  cp[i] = v;
  return 0;
}

// —— 小工具（库内私有，前缀 json_/http_）——
// 千分位整数除法（FLINT 的 '/' 是整数除，这里显式写成函数方便复核）
int jdiv1000(int v) { return v / 1000; }
int jmod1000(int v) { return v - (v / 1000) * 1000; }

// —— 发一次 HTTP GET：host（IPv4 字面串）、port、path（如 "/api/data"）
// 返回：0=成功（响应体在 hb->b，长度 hb->n）1=socket 失败 2=connect 失败 3=无响应体
int std::http_get(char *host, int port, char *path, struct HttpBuf *hb) {
  char wsa[400];
  char sa[16];
  char rq[512];
  int i = 0;
  int n = 0;
  int *sk = 0;
  int r = 0;
  int nn = 0;
  int got = 0;
  int he = 0;
  int hip = 0;
  char *pp = 0;
  char *qq = 0;

  // 参数校验（2026-11-04 补：此前 host 传 0 会直接解引用崩成 0xC0000005；与 http_post 同口径）
  if (hb == 0) return 1;
  if (hb->b == 0) return 1;
  if (host == 0) return 1;
  if (path == 0) return 1;
  if (port < 1) return 1;
  if (port > 65535) return 1;

  hb->n = 0;
  i = 0;
  while (i < 400) { wsa[i] = 0; i = i + 1; }
  r = WSAStartup(0x0202, wsa);
  if (r != 0) return 1;
  sk = socket(2, 1, 6);                         // AF_INET / SOCK_STREAM / IPPROTO_TCP
  if (sk == 0 - 1) { WSACleanup(); return 1; }
  i = 0;
  while (i < 16) { sa[i] = 0; i = i + 1; }
  sa[0] = 2; sa[1] = 0;                          // sin_family = AF_INET
  sa[2] = port / 256; sa[3] = port - (port / 256) * 256;   // 网络序（大端）
  // host = "127.0.0.1" 这类字面地址 → 自己解析成 4 字节（不做 DNS）
  hip = 0;
  i = 0;
  n = 0;
  while (host[i] != 0) {
    if (host[i] == 46) { sa[4 + n] = hip; hip = 0; n = n + 1; }
    else { if (host[i] >= 48 && host[i] <= 57) hip = hip * 10 + (host[i] - 48); }
    i = i + 1;
  }
  if (n < 4) sa[4 + n] = hip;
  r = connect(sk, sa, 16);
  if (r != 0) { closesocket(sk); WSACleanup(); return 2; }
  // 组请求：GET <path> HTTP/1.0 + Host + Connection: close
  i = 0;
  while (i < 512) { rq[i] = 0; i = i + 1; }
  rq[0] = 'G'; rq[1] = 'E'; rq[2] = 'T'; rq[3] = ' ';
  n = 4;
  pp = path;
  i = 0;
  while (pp[i] != 0) { rq[n] = pp[i]; n = n + 1; i = i + 1; }
  qq = " HTTP/1.0\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n";
  i = 0;
  while (qq[i] != 0) { rq[n] = qq[i]; n = n + 1; i = i + 1; }
  r = send(sk, rq, n, 0);
  if (r == 0 - 1) { closesocket(sk); WSACleanup(); return 2; }
  // 收到对端关闭为止（缓冲是 int* 字段装的字节缓冲 → 用 hb->b + got 算地址，recv 按字节写）
  got = 0;
  while (got < hb->cap) {
    nn = recv(sk, hb->b + got, hb->cap - got, 0);
    if (nn <= 0) break;
    got = got + nn;
  }
  closesocket(sk);
  WSACleanup();
  if (got <= 0) return 3;
  // 剥 HTTP 头（找 \r\n\r\n）；命中后把响应体搬到缓冲开头（逐字节，避免 int* 下标按 4 字节跨）
  he = 0 - 1;
  i = 0;
  while (i + 3 < got) {
    if (http_pb(hb->b, i) == 13 && http_pb(hb->b, i + 1) == 10 && http_pb(hb->b, i + 2) == 13 && http_pb(hb->b, i + 3) == 10) {
      he = i + 4;
      break;
    }
    i = i + 1;
  }
  if (he < 0) { hb->n = got; return 0; }        // 没找到头结束：按原样返回，让上层自己判断
  nn = got - he;
  i = 0;
  while (i < nn) { http_sb(hb->b, i, http_pb(hb->b, he + i)); i = i + 1; }
  if (nn < hb->cap) http_sb(hb->b, nn, 0);
  hb->n = nn;
  return 0;
}

// —— JSON：从 from 起找 key 子串，返回下标；-1 = 没找到 ——
int std::json_find(char *b, int n, int from, char *key) {
  int i = from;
  int j = 0;
  char c = 0;
  if (from < 0) return 0 - 1;
  while (i < n) {
    j = 0;
    while (key[j] != 0) {
      if (i + j >= n) return 0 - 1;
      if (b[i + j] != key[j]) break;
      j = j + 1;
    }
    if (key[j] == 0) return i;
    i = i + 1;
  }
  return 0 - 1;
}

// —— JSON：marker（如 "\"gpu\":{"）所在对象的 '{' 下标；-1 = 没找到 ——
int std::json_obj(char *b, int n, char *marker) {
  int i = std::json_find(b, n, 0, marker);
  int j = 0;
  if (i < 0) return 0 - 1;
  j = i;
  while (j < n) {
    if (b[j] == 123) return j;
    j = j + 1;
  }
  return 0 - 1;
}

// —— JSON：与 start 处 '{' 配对的 '}' 下标（串值内的括号跳过）——
int std::json_obj_end(char *b, int n, int start) {
  int d = 0;
  int i = 0;
  int instr = 0;
  if (start < 0) return 0 - 1;
  i = start;
  while (i < n) {
    if (instr == 1) {
      if (b[i] == 92) { i = i + 2; }
      else {
        if (b[i] == 34) instr = 0;
        i = i + 1;
      }
    } else {
      if (b[i] == 34) { instr = 1; i = i + 1; }
      else if (b[i] == 123) { d = d + 1; i = i + 1; }
      else if (b[i] == 125) {
        d = d - 1;
        i = i + 1;
        if (d == 0) return i - 1;
      } else { i = i + 1; }
    }
  }
  return 0 - 1;
}

// —— JSON 取值：段 [from,to) 内 "<key>": 后的数值 ——
// ⚠️ FLINT 函数参数上限 4 个（实测撞过）→ 参数化的（文档指针/长度/段界）一律打包进本结构体：
//    jseg.b = 文档首地址，jseg.n = 文档长度，jseg.from / jseg.to = 段界（json_obj/json_obj_end 给）。
struct JSeg { int *b; int n; int from; int to; }

// ra = 数值×1000（整数定点，程序内统一口径）；rv = 1 有值 / 0 = null 或键缺失
struct JOut { int a; int v; }

// 取段内某键的数值（key 为字面串，如 "\"temp\""；同名键跨对象的情况必须先切好段）
int std::json_num(struct JSeg *s, char *key, struct JOut *o) {
  int ki = 0;
  int i = 0;
  int j = 0;
  int neg = 0;
  int ip = 0;
  int fr = 0;
  int fd = 0;
  char *b = 0;
  int n = 0;
  int to = 0;
  o->a = 0;
  o->v = 0;
  b = s->b;
  n = s->n;
  to = s->to;
  if (s->from < 0 || to < 0 || to > n) return 0;
  // 段内查找 key（不用 std::json_find 以免再吃一个参数：直接内联查找）
  i = s->from;
  while (i < to) {
    j = 0;
    while (key[j] != 0) {
      if (i + j >= n) { i = to; break; }
      if (b[i + j] != key[j]) break;
      j = j + 1;
    }
    if (key[j] == 0) { ki = i; break; }
    i = i + 1;
  }
  if (ki < s->from) return 0;
  i = ki;
  while (i < to && b[i] != 58) i = i + 1;                  // 找 ':'
  if (i >= to) return 0;
  i = i + 1;
  while (i < to && (b[i] == 32 || b[i] == 9)) i = i + 1;
  if (i >= to) return 0;
  if (b[i] == 110) return 0;                               // null
  if (b[i] == 45) { neg = 1; i = i + 1; }
  while (i < to && b[i] >= 48 && b[i] <= 57) { ip = ip * 10 + (b[i] - 48); i = i + 1; }
  if (i < to && b[i] == 46) {
    i = i + 1;
    while (i < to && b[i] >= 48 && b[i] <= 57) {
      if (fd < 3) { fr = fr * 10 + (b[i] - 48); fd = fd + 1; }
      i = i + 1;
    }
  }
  while (fd < 3) { fr = fr * 10; fd = fd + 1; }
  o->a = ip * 1000 + fr;
  if (neg == 1) o->a = 0 - o->a;
  o->v = 1;
  return 0;
}

// —— 便捷：把 8080 /api/data 的关键字段一次性读进结构体（浮窗第 5 步专用）——
// 约定：全部 ×1000 定点；v_xxx = 1 表示该字段有值。cpu 的 temp/clock 由 C# 侧已做偏移/换算，直接用。
struct ApiSnap {
  int v_cpu_temp; int cpu_temp;
  int v_cpu_load; int cpu_load;
  int v_cpu_clock; int cpu_clock;
  int v_cpu_pwr; int cpu_pwr;
  int v_gpu_temp; int gpu_temp;
  int v_gpu_load; int gpu_load;
  int v_gpu_memu; int gpu_memu;
  int v_gpu_memt; int gpu_memt;
  int v_gpu_pwr; int gpu_pwr;
  int v_ram_used; int ram_used;
  int v_ram_total; int ram_total;
  int v_ram_load; int ram_load;
  int v_disk_used; int disk_used;
  int v_disk_total; int disk_total;
  int v_disk_load; int disk_load;
  int v_net_down; int net_down;
  int v_net_up; int net_up;
  int v_fps; int fps;
  int v_fps_low; int fps_low;
  int v_fan; int fan;
  int v_sys_pwr; int sys_pwr;
  // v1.4.7（2026-09-17）/ 缝合路径专用：帧率来源进程名（**8080 JSON 里没有这个字段**，
  // 只有桥的 PresentMon 通道能给 —— C# 参考版的 FPS 行末尾 `·msedge` 就是这个）。
  // 追加在**结构体末尾**（不改已有字段偏移；json_to_snap 的赋值也不受影响，照常留 0）。
  int have_src; int fps_src_len;
}

// 从已收到的 JSON 文档 [b, n) 填 ApiSnap；返回 0 = 成功，1 = 文档异常（连 cpu 段都找不到）
int std::json_to_snap(int *b, int n, struct ApiSnap *s) {
  struct JSeg seg;
  struct JOut o;
  int cs = 0; int ce = 0;
  int gs = 0; int ge = 0;
  int rs = 0; int re = 0;
  int ds = 0; int de = 0;
  int ns = 0; int ne = 0;
  int fs = 0; int fe = 0;
  int fns = 0; int fne = 0;
  int ps = 0; int pe = 0;

  seg.b = b;
  seg.n = n;
  cs = std::json_obj(b, n, "\"cpu\":{");   ce = std::json_obj_end(b, n, cs);
  gs = std::json_obj(b, n, "\"gpu\":{");   ge = std::json_obj_end(b, n, gs);
  rs = std::json_obj(b, n, "\"ram\":{");   re = std::json_obj_end(b, n, rs);
  ds = std::json_obj(b, n, "\"disk\":{");  de = std::json_obj_end(b, n, ds);
  ns = std::json_obj(b, n, "\"net\":{");   ne = std::json_obj_end(b, n, ns);
  fs = std::json_obj(b, n, "\"fps\":{");   fe = std::json_obj_end(b, n, fs);
  fns = std::json_obj(b, n, "\"fan\":{");  fne = std::json_obj_end(b, n, fns);
  ps = std::json_obj(b, n, "\"power\":{"); pe = std::json_obj_end(b, n, ps);
  if (cs < 0 || ce < 0) return 1;

  s->v_cpu_temp = 0; s->cpu_temp = 0;
  s->v_cpu_load = 0; s->cpu_load = 0;
  s->v_cpu_clock = 0; s->cpu_clock = 0;
  s->v_cpu_pwr = 0; s->cpu_pwr = 0;
  s->v_gpu_temp = 0; s->gpu_temp = 0;
  s->v_gpu_load = 0; s->gpu_load = 0;
  s->v_gpu_memu = 0; s->gpu_memu = 0;
  s->v_gpu_memt = 0; s->gpu_memt = 0;
  s->v_gpu_pwr = 0; s->gpu_pwr = 0;
  s->v_ram_used = 0; s->ram_used = 0;
  s->v_ram_total = 0; s->ram_total = 0;
  s->v_ram_load = 0; s->ram_load = 0;
  s->v_disk_used = 0; s->disk_used = 0;
  s->v_disk_total = 0; s->disk_total = 0;
  s->v_disk_load = 0; s->disk_load = 0;
  s->v_net_down = 0; s->net_down = 0;
  s->v_net_up = 0; s->net_up = 0;
  s->v_fps = 0; s->fps = 0;
  s->v_fps_low = 0; s->fps_low = 0;
  s->v_fan = 0; s->fan = 0;
  s->v_sys_pwr = 0; s->sys_pwr = 0;

  // ⚠️ 一律「先取值再落结构体」两段式：同一次调用里既写 JOut 又读 JOut 会拿到旧值（实测踩过）
  seg.from = cs; seg.to = ce;
  std::json_num(&seg, "\"temp\"", &o);       s->cpu_temp = o.a;  s->v_cpu_temp = o.v;
  std::json_num(&seg, "\"load\"", &o);       s->cpu_load = o.a;  s->v_cpu_load = o.v;
  std::json_num(&seg, "\"clockMhz\"", &o);   s->cpu_clock = o.a; s->v_cpu_clock = o.v;
  std::json_num(&seg, "\"power\"", &o);      s->cpu_pwr = o.a;   s->v_cpu_pwr = o.v;
  seg.from = gs; seg.to = ge;
  std::json_num(&seg, "\"temp\"", &o);       s->gpu_temp = o.a;  s->v_gpu_temp = o.v;
  std::json_num(&seg, "\"load\"", &o);       s->gpu_load = o.a;  s->v_gpu_load = o.v;
  std::json_num(&seg, "\"memUsedGb\"", &o);  s->gpu_memu = o.a;  s->v_gpu_memu = o.v;
  std::json_num(&seg, "\"memTotalGb\"", &o); s->gpu_memt = o.a;  s->v_gpu_memt = o.v;
  std::json_num(&seg, "\"power\"", &o);      s->gpu_pwr = o.a;   s->v_gpu_pwr = o.v;
  seg.from = rs; seg.to = re;
  std::json_num(&seg, "\"usedGb\"", &o);     s->ram_used = o.a;  s->v_ram_used = o.v;
  std::json_num(&seg, "\"totalGb\"", &o);    s->ram_total = o.a; s->v_ram_total = o.v;
  std::json_num(&seg, "\"load\"", &o);       s->ram_load = o.a;  s->v_ram_load = o.v;
  seg.from = ds; seg.to = de;
  std::json_num(&seg, "\"usedGb\"", &o);     s->disk_used = o.a; s->v_disk_used = o.v;
  std::json_num(&seg, "\"totalGb\"", &o);    s->disk_total = o.a; s->v_disk_total = o.v;
  std::json_num(&seg, "\"load\"", &o);       s->disk_load = o.a; s->v_disk_load = o.v;
  seg.from = ns; seg.to = ne;
  std::json_num(&seg, "\"downKBs\"", &o);    s->net_down = o.a;  s->v_net_down = o.v;
  std::json_num(&seg, "\"upKBs\"", &o);      s->net_up = o.a;    s->v_net_up = o.v;
  seg.from = fs; seg.to = fe;
  std::json_num(&seg, "\"current\"", &o);    s->fps = o.a;       s->v_fps = o.v;
  std::json_num(&seg, "\"onePercentLow\"", &o); s->fps_low = o.a; s->v_fps_low = o.v;
  seg.from = fns; seg.to = fne;
  std::json_num(&seg, "\"rpm\"", &o);        s->fan = o.a;       s->v_fan = o.v;
  seg.from = ps; seg.to = pe;
  std::json_num(&seg, "\"system\"", &o);     s->sys_pwr = o.a;   s->v_sys_pwr = o.v;
  return 0;
}

// ============================================================================
// §2 HTTP POST（2026-11-03 追加；上面 GET/JSON 部分一个字节都没动）
//   发一次 HTTP/1.0 POST：Content-Type: application/octet-stream，Content-Length: blen
//   返回：0=成功（响应体在 hb->b/hb->n，HTTP 头已剥掉）1=socket/参数失败 2=connect/send 失败 3=无响应体
//   请求头：POST <path> HTTP/1.0 / Host / Content-Type / Content-Length / Connection: close
//   body=0 且 blen=0 → 空 body（合法）；body=0 且 blen>0 → 参数错返回 1
//   请求串放局部 char 缓冲（固定 8192 上限，超长返回 1，不截断）
// ============================================================================

// 把 s 逐字节抄到 d[at..]，返回下一个空位（边界由调用方先算好，内部不查）
int http_put(char *d, int at, char *s) {
  int i = 0;
  while (s[i] != 0) { d[at] = s[i]; at = at + 1; i = i + 1; }
  return at;
}

// 十进制非负整数写入 d[at..]，返回下一个空位
int http_putn(char *d, int at, int v) {
  char t[12];
  int i = 0;
  int j = 0;
  if (v <= 0) { d[at] = 48; return at + 1; }
  while (v > 0) { t[i] = v % 10 + 48; i = i + 1; v = v / 10; }
  j = i - 1;
  while (j >= 0) { d[at] = t[j]; at = at + 1; j = j - 1; }
  return at;
}

int std::http_post(char *host, int port, char *path, char *body, int blen, struct HttpBuf *hb) {
  char wsa[400];
  char sa[16];
  char rq[8192];
  int i = 0;
  int n = 0;
  int *sk = 0;
  int r = 0;
  int nn = 0;
  int got = 0;
  int he = 0;
  int hip = 0;
  int hlen = 0;
  int plen = 0;
  int digits = 0;
  int need = 0;

  // —— 参数校验（在碰 socket 之前，失败路径不打网络）——
  if (hb == 0) return 1;
  if (host == 0) return 1;
  if (path == 0) return 1;
  if (blen < 0) return 1;
  if (body == 0) { if (blen > 0) return 1; }
  hb->n = 0;
  hlen = 0;
  while (host[hlen] != 0) hlen = hlen + 1;
  plen = 0;
  while (path[plen] != 0) plen = plen + 1;
  // 固定部分 103 字节（"POST " 5 + " HTTP/1.0\r\nHost: " 17 +
  //   "\r\nContent-Type: application/octet-stream\r\nContent-Length: " 58 +
  //   "\r\nConnection: close\r\n\r\n" 23）
  digits = 1;
  i = blen;
  while (i >= 10) { digits = digits + 1; i = i / 10; }
  need = 103 + hlen + plen + digits + blen;
  if (need > 8191) return 1;                     // 超固定缓冲上限：响亮失败，不截断

  // —— 组请求：头 + body 原始字节（局部缓冲，逐字节写）——
  i = 0;
  while (i < need) { rq[i] = 0; i = i + 1; }
  n = 0;
  n = http_put(rq, n, "POST ");
  n = http_put(rq, n, path);
  n = http_put(rq, n, " HTTP/1.0\r\nHost: ");
  n = http_put(rq, n, host);
  n = http_put(rq, n, "\r\nContent-Type: application/octet-stream\r\nContent-Length: ");
  n = http_putn(rq, n, blen);
  n = http_put(rq, n, "\r\nConnection: close\r\n\r\n");
  i = 0;
  while (i < blen) { rq[n] = body[i]; n = n + 1; i = i + 1; }
  if (n != need) return 1;                        // 自检：长度公式与实写对不上就不发

  // —— socket 流程与 http_get 同口径 ——
  i = 0;
  while (i < 400) { wsa[i] = 0; i = i + 1; }
  r = WSAStartup(0x0202, wsa);
  if (r != 0) return 1;
  sk = socket(2, 1, 6);                          // AF_INET / SOCK_STREAM / IPPROTO_TCP
  if (sk == 0 - 1) { WSACleanup(); return 1; }
  i = 0;
  while (i < 16) { sa[i] = 0; i = i + 1; }
  sa[0] = 2; sa[1] = 0;                          // sin_family = AF_INET
  sa[2] = port / 256; sa[3] = port - (port / 256) * 256;   // 网络序（大端）
  hip = 0;
  i = 0;
  n = 0;
  while (host[i] != 0) {
    if (host[i] == 46) { sa[4 + n] = hip; hip = 0; n = n + 1; }
    else { if (host[i] >= 48 && host[i] <= 57) hip = hip * 10 + (host[i] - 48); }
    i = i + 1;
  }
  if (n < 4) sa[4 + n] = hip;
  r = connect(sk, sa, 16);
  if (r != 0) { closesocket(sk); WSACleanup(); return 2; }
  r = send(sk, rq, need, 0);
  if (r == 0 - 1) { closesocket(sk); WSACleanup(); return 2; }
  // 收到对端关闭为止（同 http_get：缓冲是 int* 字段装的字节缓冲）
  got = 0;
  while (got < hb->cap) {
    nn = recv(sk, hb->b + got, hb->cap - got, 0);
    if (nn <= 0) break;
    got = got + nn;
  }
  closesocket(sk);
  WSACleanup();
  if (got <= 0) return 3;
  // 剥 HTTP 头（找 \r\n\r\n）；命中后把响应体搬到缓冲开头
  he = 0 - 1;
  i = 0;
  while (i + 3 < got) {
    if (http_pb(hb->b, i) == 13 && http_pb(hb->b, i + 1) == 10 && http_pb(hb->b, i + 2) == 13 && http_pb(hb->b, i + 3) == 10) {
      he = i + 4;
      break;
    }
    i = i + 1;
  }
  if (he < 0) { hb->n = got; return 0; }
  nn = got - he;
  i = 0;
  while (i < nn) { http_sb(hb->b, i, http_pb(hb->b, he + i)); i = i + 1; }
  if (nn < hb->cap) http_sb(hb->b, nn, 0);
  hb->n = nn;
  return 0;
}

// ============================================================================
// §3 响应状态码 / 头字段解析（纯解析函数，不碰 socket）
// ============================================================================

// 解析第一行 "HTTP/1.x <code> ..."：跳过 "HTTP/" 后的版本号，找第一个空格，
// 取其后 3 位十进制数字；返回 code（如 200），-1 = 解析失败（不校验范围）
int std::http_status(char *resp, int n) {
  int i = 5;
  int code = 0;
  if (resp == 0) return 0 - 1;
  if (n < 12) return 0 - 1;
  if (resp[0] != 72 || resp[1] != 84 || resp[2] != 84 || resp[3] != 80 || resp[4] != 47) return 0 - 1;   // "HTTP/"
  while (i < n && resp[i] != 32) i = i + 1;     // 版本号到第一个空格
  if (i + 3 >= n) return 0 - 1;
  if (resp[i + 1] < 48 || resp[i + 1] > 57) return 0 - 1;
  if (resp[i + 2] < 48 || resp[i + 2] > 57) return 0 - 1;
  if (resp[i + 3] < 48 || resp[i + 3] > 57) return 0 - 1;
  code = (resp[i + 1] - 48) * 100 + (resp[i + 2] - 48) * 10 + (resp[i + 3] - 48);
  return code;
}

// 取响应头字段值（行首 "name:" 匹配，大小写不敏感），跳到行尾 \r\n 前，
// 把值拷到 out 并补 0；返回长度；-1 = 没有该头 / cap 不够（此时不写 out）
int std::http_header(char *resp, int n, char *name, char *out, int cap) {
  int i = 0;
  int j = 0;
  int k = 0;
  int len = 0;
  int a = 0;
  int b = 0;
  int ok = 1;
  if (resp == 0 || name == 0 || out == 0 || cap < 1) return 0 - 1;
  i = 0;
  while (i < n) {
    // 空行 = 头部结束（只在行首判）
    if (resp[i] == 13 && i + 1 < n && resp[i + 1] == 10) return 0 - 1;
    // 行首与 name 逐字节比（ASCII 大小写不敏感）
    j = 0;
    ok = 1;
    while (name[j] != 0) {
      if (i + j >= n) { ok = 0; break; }
      a = resp[i + j];
      b = name[j];
      if (a >= 65 && a <= 90) a = a + 32;
      if (b >= 65 && b <= 90) b = b + 32;
      if (a != b) { ok = 0; break; }
      j = j + 1;
    }
    if (ok == 1 && i + j < n && resp[i + j] == 58) {      // ':'
      k = i + j + 1;
      while (k < n && (resp[k] == 32 || resp[k] == 9)) k = k + 1;
      len = 0;
      while (k + len < n && resp[k + len] != 13 && resp[k + len] != 10) len = len + 1;
      if (len + 1 > cap) return 0 - 1;                     // cap 不够：不写 out
      j = 0;
      while (j < len) { out[j] = resp[k + j]; j = j + 1; }
      out[len] = 0;
      return len;
    }
    while (i < n && resp[i] != 10) i = i + 1;              // 跳到下一行行首
    i = i + 1;
  }
  return 0 - 1;
}

// ============================================================================
// §4 HTTPS（WinHTTP；2026-11-03 追加）
//   上面 §1~§3 一个字节都没动；本节的 api 声明补在文件顶部 api 区末尾。
//
//   为什么用 WinHTTP 而不是自己套 TLS：
//     本库定位是「中低频」取一次数据（浮窗 / 工具 / 自测），TLS 版本、SNI、证书链
//     全交给系统 winhttp.dll（系统证书库 / TLS1.2·1.3 自动协商），不自己实现。
//   ⚠️ 本库显式 NO_PROXY（accessType=1）：**不走系统代理**。要代理的机器以后再加
//      accessType=3 + proxy 串。
//
//   与 §1 http_get 的三处不同（别混用）：
//     ① host 可以是**域名**（WinHTTP 自己做 DNS）；http_get 只吃 IPv4 字面串；
//     ② 强制 TLS：WINHTTP_FLAG_SECURE = 0x00800000（用户原稿写的 0x02000000 不在
//        winhttp.h 的任何 flag 里，真值以 0x00800000 为准）；
//     ③ WinHTTP 自己剥状态行/头，ReadData 只回**响应体**；下面仍保留一次
//        「以 "HTTP/" 开头才找 \r\n\r\n 剥」的保底（对端异常/中间层塞头时兜住）。
//
//   用法：
//     char b[8192];  struct HttpBuf hb;
//     hb.b = b; hb.cap = 8192; hb.n = 0;
//     int rc = std::https_get("example.com", 443, "/", &hb);
//     // rc: 0=成功 1=打开/连接/请求失败 2=发送失败 3=无响应体
//
//   ⚠️ 三个句柄（request / connect / session）必须反序关：本函数全程负责，
//      失败分支也不漏关（用嵌套 if 而非 goto —— FLINT 没有 goto）。
// ============================================================================

// WinHTTP 会话可用性缓存：0=还没试过 1=WinHttpOpen 成功 2=WinHttpOpen 失败
// （给自测/上层区分「网络不通」与「WinHTTP 根本起不来」；不含任何句柄）
int http_ready_state = 0;

// —— 内部件：ANSI（本库口径 = CP_ACP=0 系统代码页）→ UTF-16LE ——
// 写进调用方给的字节缓冲 wide（capbytes = 该缓冲的**字节数**，必须 ≥2）。
// 返回：写入的字节数（**含结尾两字节 0**，所以 "abc" → 8）；0 = 失败（此时不保证缓冲内容）。
// ⚠️ 产出的 wide 缓冲只能当 LPCWSTR 喂 API，别按 char 下标当可见字符读；判对错看字节。
int http_wide(char *ansi, char *wide, int capbytes) {
  int units = 0;
  int got = 0;
  if (ansi == 0) return 0;
  if (wide == 0) return 0;
  if (capbytes < 2) return 0;
  units = capbytes / 2;
  // cbMultiByte = -1：连结尾 0 一起转；返回值 = 写入的 UTF-16 码元数（含结尾 0）
  got = MultiByteToWideChar(0, 0, ansi, 0 - 1, wide, units);
  if (got <= 0) return 0;
  return got * 2;
}

// —— HTTPS GET（TLS 走系统 winhttp.dll；适合中低频，高频轮询请自己维持长连接）——
// 返回：0=成功（响应体在 hb->b / hb->n，HTTP 头已剥掉）
//       1=打开会话/连接/建请求失败（含参数非法）
//       2=发送失败（含 TLS 握手失败）
//       3=无响应体（一个字节都没读到，或读到 0 字节）
// 失败时 hb->n 一律 0；hb/hb->b/host/path 为空 或 port ∉ [1,65535] → 直接 1（不碰网络）
int std::https_get(char *host, int port, char *path, struct HttpBuf *hb) {
  char whost[256];
  char wpath[1024];
  char wverb[16];
  int i = 0;
  int rc = 0;
  int got = 0;
  int rd = 0;
  int r = 0;
  int he = 0;
  int nn = 0;
  int *sess = 0;
  int *con = 0;
  int *req = 0;

  // —— 参数校验（先判，失败路径不碰 WinHTTP）——
  if (hb == 0) return 1;
  hb->n = 0;
  if (hb->b == 0) return 1;
  if (host == 0) return 1;
  if (path == 0) return 1;
  if (port < 1) return 1;
  if (port > 65535) return 1;
  if (http_wide(host, whost, 256) == 0) return 1;
  if (http_wide(path, wpath, 1024) == 0) return 1;
  if (http_wide("GET", wverb, 16) == 0) return 1;

  sess = WinHttpOpen(0, 1, 0, 0, 0);          // (agent=0, NO_PROXY, proxy=0, bypass=0, flags=0)
  if (sess == 0) { http_ready_state = 2; return 1; }
  http_ready_state = 1;
  // rc 一路「预置下一段会失败的码」：1 → 2 → 3，任何一段失败都天然对上返回值口径
  rc = 1;                                      // 打开会话 / 连接 / 建请求
  con = WinHttpConnect(sess, whost, port, 0);
  if (con != 0) {
    req = WinHttpOpenRequest(con, wverb, wpath, 0, 0, 0, 0x00800000);   // WINHTTP_FLAG_SECURE
    if (req != 0) {
      rc = 2;                                  // 发送（含 TLS 握手）
      r = WinHttpSendRequest(req, 0, 0 - 1, 0, 0, 0, 0);
      if (r != 0) {
        rc = 3;                                // 等响应
        r = WinHttpReceiveResponse(req, 0);
        if (r != 0) {
          // —— 读响应体：ReadData 只回 body；rd<=0 或返回失败即停 ——
          got = 0;
          while (got < hb->cap) {
            rd = 0;
            // 先转 char*：字节步进在 char* 上是本义，不触发 -strict 的「裸指针按字节步进」告警
            // （§1/§2 里的 `hb->b + got` 是既有写法，本库不改；新代码走 char*）
            r = WinHttpReadData(req, (char *)hb->b + got, hb->cap - got, &rd);
            if (r == 0) break;
            if (rd <= 0) break;
            got = got + rd;
          }
          if (got <= 0) { rc = 3; }
          else {
            // 保底剥头：只有数据以 "HTTP/" 开头（= 真带着状态行）才找 \r\n\r\n；
            // 否则是纯 body（二进制里恰好有 \r\n\r\n 也不会被切坏）
            he = 0 - 1;
            if (got >= 5) {
              if (http_pb(hb->b, 0) == 72 && http_pb(hb->b, 1) == 84 && http_pb(hb->b, 2) == 84 && http_pb(hb->b, 3) == 80 && http_pb(hb->b, 4) == 47) {
                i = 0;
                while (i + 3 < got) {
                  if (http_pb(hb->b, i) == 13 && http_pb(hb->b, i + 1) == 10 && http_pb(hb->b, i + 2) == 13 && http_pb(hb->b, i + 3) == 10) {
                    he = i + 4;
                    break;
                  }
                  i = i + 1;
                }
              }
            }
            if (he >= 0) {
              nn = got - he;
              i = 0;
              while (i < nn) { http_sb(hb->b, i, http_pb(hb->b, he + i)); i = i + 1; }
              if (nn < hb->cap) http_sb(hb->b, nn, 0);
              if (nn <= 0) { hb->n = 0; rc = 3; }
              else { hb->n = nn; rc = 0; }
            } else {
              hb->n = got;
              rc = 0;
            }
          }
        }
      }
      WinHttpCloseHandle(req);
    }
    WinHttpCloseHandle(con);
  }
  WinHttpCloseHandle(sess);
  if (rc != 0) hb->n = 0;
  return rc;
}

// —— 上一节缓存的可读版本：0=还没试过 1=WinHTTP 可用 2=WinHttpOpen 打不开 ——
int std::https_ready() {
  return http_ready_state;
}
