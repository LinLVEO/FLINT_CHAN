// str_lib.fl — FLINT 标准库（第一批）：字符串
// 用法：include "../../lib/str_lib.fl"（路径相对本文件目录解析）
// 约定：char* 指向以 0 结尾的字节串（字符串字面量自带 \0，见 SPEC 语法节）
// 命名：2026-09-09 用户定（原则 7 便利性第一）——惯用短名，见 SPEC「标准库」节

// 长度（不含结尾 0）
int std::strlen(char *s) {
  int i = 0;
  while (s[i] != 0) { i = i + 1; }
  return i;
}

// 相等 → 1；否则 0
int std::streq(char *a, char *b) {
  int i = 0;
  int r = 0;
  while (r == 0) {
    if (a[i] != b[i]) { r = 1; }
    else if (a[i] == 0) { r = 2; }
    else { i = i + 1; }
  }
  if (r == 2) { return 1; }
  return 0;
}

// 字典序比较：a < b → -1；相等 → 0；a > b → 1
int std::strcmp(char *a, char *b) {
  int i = 0;
  int r = 0;
  while (r == 0) {
    if (a[i] != b[i]) {
      if (a[i] < b[i]) { r = -1; }
      else { r = 1; }
    } else if (a[i] == 0) { r = 2; }
    else { i = i + 1; }
  }
  if (r == 2) { return 0; }
  return r;
}

// 复制（含结尾 0）到 dst，返回写入的字符数（不含结尾 0）
int std::strcpy(char *dst, char *src) {
  int i = 0;
  while (src[i] != 0) { dst[i] = src[i]; i = i + 1; }
  dst[i] = 0;
  return i;
}

// 追加到 dst 末尾（含结尾 0），返回追加后的总长度
int std::strcat(char *dst, char *src) {
  int d = std::strlen(dst);
  int i = 0;
  while (src[i] != 0) { dst[d + i] = src[i]; i = i + 1; }
  dst[d + i] = 0;
  return d + i;
}

// 查找子串：返回首次出现的下标；未找到 → -1；空 needle → 0
int std::strstr(char *s, char *needle) {
  int n = std::strlen(needle);
  if (n == 0) { return 0; }
  int i = 0;
  int found = -1;
  while (s[i] != 0 && found < 0) {
    int j = 0;
    int ok = 1;
    while (j < n && ok == 1) {
      if (s[i + j] != needle[j]) { ok = 0; }
      else { j = j + 1; }
    }
    if (ok == 1) { found = i; }
    else { i = i + 1; }
  }
  return found;
}

// 以 prefix 开头 → 1；否则 0（空 prefix → 1）
int std::strpre(char *s, char *prefix) {
  int i = 0;
  int r = 1;
  while (prefix[i] != 0 && r == 1) {
    if (s[i] != prefix[i]) { r = 0; }
    else { i = i + 1; }
  }
  return r;
}
