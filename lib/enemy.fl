// enemy.fl -- 敌人 AI 状态机（M5 第二刀）
//
// 用法：include "enemy.fl"
// 状态：0=巡逻 1=追击 2=攻击 3=死亡
// 转移只看与玩家的距离（简单、可测、无随机）：
//   dist < 16  -> 攻击；dist < 48 -> 追击；否则巡逻；死亡不可逆。
// 为什么不做"视野/寻路"：M5 第一版只要"会动、会追、会打"，复杂 AI 留给内容层。
// v2.15.0：状态枚举——给 switch 的 case 标签用（值与上面的 0/1/2/3 一字不差）。
enum ESt { ST_PATROL, ST_CHASE, ST_ATK, ST_DEAD }

int enemy_next_state(int state, int dist) {
  if (state == 3) { return 3; }
  if (dist < 16) { return 2; }
  if (dist < 48) { return 1; }
  return 0;
}

// 巡逻方向：每 span tick 折返。返回 +1 或 -1。
int enemy_patrol_dir(int tick, int span) {
  if (span <= 0) { return 1; }
  if ((tick / span) % 2 == 0) { return 1; }
  return -1;
}
