// codec_lib.fl — FLINT 标准库（编解码 / 校验批）：Base64 + CRC-32 + MD5/SHA1/SHA256
// 用法：include "../../lib/codec_lib.fl"（路径相对本文件目录解析）
// 整合：2026-11-03 由 base64_lib.fl / crc32_lib.fl / hash_lib.fl 合并 —— 三者同属
//       "数据编码 / 校验 / 摘要"，函数名与语义一字未改，旧 include 改指本文件即可。
// 自包含：不 include 其它库；api 声明集中在文件顶部（collect_apis 只认最开头连续的那批）。
//
// 分区：
//   §1 Base64   std::b64_len / std::b64_encode / std::b64_decode
//   §2 CRC-32   std::crc32 / std::crc32_update
//   §3 摘要     std::md5 / std::sha1 / std::sha256
//
// 共同约定：
//   * 显式长度：全部按 buf[0..n) 处理，不查 strlen、不看 NUL（二进制安全）。
//   * 输出写原始字节，长度由返回值给出；失败响亮返回 -1（CRC 除外：任何 32 位值都可能是
//     合法 CRC，没有独立错误通道，见 §2）。
//   * 不分配内存、不持有指针；缓冲由调用方给，容量由调用方保证。
api advapi32 int CryptAcquireContextA(int, int, int, int, int);
api advapi32 int CryptCreateHash(int, int, int, int, int);
api advapi32 int CryptHashData(int, int, int, int);
api advapi32 int CryptGetHashParam(int, int, int, int, int);
api advapi32 int CryptDestroyHash(int);
api advapi32 int CryptReleaseContext(int, int);
api kernel32 int MultiByteToWideChar(int, int, int, int, int, int);
api kernel32 int WideCharToMultiByte(int, int, int, int, int, int, int, int);

// ==================== §1 Base64 ====================
// 标准字母表 A-Z a-z 0-9 + /，'=' 填充（RFC 4648 §4）。
// b64_encode：cap = dst 总字节数（含结尾 NUL）；永远补 NUL；cap 不够 → -1 且一个字节都不写。
// b64_decode：cap = 可写字节数（不含 NUL）；成功返回字节数；非法字符/非法 '='/长度 % 4 != 0/cap 不够 → -1。
// 不校验"非规范位"（TQ== 与 TR== 都收），只把结构非法当错。

// 内部件：编码字母表第 i 个字符（0..63）；越界 → 0
int b64_ichr(int i) {
  if (i < 0) { return 0; }
  if (i < 26) { return 'A' + i; }
  if (i < 52) { return 'a' + (i - 26); }
  if (i < 62) { return '0' + (i - 52); }
  if (i == 62) { return '+'; }
  if (i == 63) { return '/'; }
  return 0;
}

// 内部件：字符 → 6 位值（0..63）；非法 → -1
int b64_ival(int c) {
  if (c >= 'A' && c <= 'Z') { return c - 'A'; }
  if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
  if (c >= '0' && c <= '9') { return c - '0' + 52; }
  if (c == '+') { return 62; }
  if (c == '/') { return 63; }
  return -1;
}

// 编码 n 字节需要多少字符（不含 NUL）；n < 0 → -1
int std::b64_len(int n) {
  if (n < 0) { return -1; }
  int q = n / 3;
  int r = n % 3;
  int len = q * 4;
  if (r != 0) { len = len + 4; }
  return len;
}

// 编码 src[0..n) → dst；返回字符数（不含 NUL）；失败 -1
int std::b64_encode(char *src, int n, char *dst, int cap) {
  if (dst == 0) { return -1; }
  if (n < 0) { return -1; }
  if (cap < 0) { return -1; }
  if (src == 0 && n > 0) { return -1; }
  int len = std::b64_len(n);
  if (cap < len + 1) { return -1; }
  int i = 0;
  int o = 0;
  while (i + 3 <= n) {
    int b0 = src[i] & 255;
    int b1 = src[i + 1] & 255;
    int b2 = src[i + 2] & 255;
    dst[o] = b64_ichr(b0 >> 2);
    dst[o + 1] = b64_ichr(((b0 & 3) << 4) | (b1 >> 4));
    dst[o + 2] = b64_ichr(((b1 & 15) << 2) | (b2 >> 6));
    dst[o + 3] = b64_ichr(b2 & 63);
    i = i + 3;
    o = o + 4;
  }
  if (n - i == 1) {
    int b0 = src[i] & 255;
    dst[o] = b64_ichr(b0 >> 2);
    dst[o + 1] = b64_ichr((b0 & 3) << 4);
    dst[o + 2] = '=';
    dst[o + 3] = '=';
    o = o + 4;
  } else if (n - i == 2) {
    int b0 = src[i] & 255;
    int b1 = src[i + 1] & 255;
    dst[o] = b64_ichr(b0 >> 2);
    dst[o + 1] = b64_ichr(((b0 & 3) << 4) | (b1 >> 4));
    dst[o + 2] = b64_ichr((b1 & 15) << 2);
    dst[o + 3] = '=';
    o = o + 4;
  }
  dst[o] = 0;
  return o;
}

// 解码 src[0..n) → dst；返回字节数；失败 -1（不补 NUL）
int std::b64_decode(char *src, int n, char *dst, int cap) {
  if (n < 0) { return -1; }
  if (cap < 0) { return -1; }
  if (n == 0) { return 0; }
  if (src == 0) { return -1; }
  if (dst == 0) { return -1; }
  if (n % 4 != 0) { return -1; }
  int pad = 0;
  int k = n - 1;
  while (k >= 0 && (src[k] & 255) == '=') {
    pad = pad + 1;
    k = k - 1;
  }
  if (pad > 2) { return -1; }
  int i = 0;
  while (i < n - pad) {
    if (b64_ival(src[i] & 255) < 0) { return -1; }
    i = i + 1;
  }
  int groups = n / 4;
  int out = groups * 3 - pad;
  if (cap < out) { return -1; }
  int o = 0;
  int g = 0;
  int last = groups - 1;
  while (g < groups) {
    int base = g * 4;
    int c0 = b64_ival(src[base] & 255);
    int c1 = b64_ival(src[base + 1] & 255);
    if (g == last && pad == 2) {
      dst[o] = (c0 << 2) | (c1 >> 4);
      o = o + 1;
    } else if (g == last && pad == 1) {
      int c2 = b64_ival(src[base + 2] & 255);
      dst[o] = (c0 << 2) | (c1 >> 4);
      dst[o + 1] = ((c1 & 15) << 4) | (c2 >> 2);
      o = o + 2;
    } else {
      int c2 = b64_ival(src[base + 2] & 255);
      int c3 = b64_ival(src[base + 3] & 255);
      dst[o] = (c0 << 2) | (c1 >> 4);
      dst[o + 1] = ((c1 & 15) << 4) | (c2 >> 2);
      dst[o + 2] = ((c2 & 3) << 6) | c3;
      o = o + 3;
    }
    g = g + 1;
  }
  return o;
}

// ==================== §2 CRC-32 ====================
// 多项式 0xEDB88320（标准 0x04C11DB7 的反射写法），初值 0xFFFFFFFF，末尾异或 0xFFFFFFFF。
// 与 zlib.crc32 / PKZIP 逐位一致；逐位算、不建表、无全局、O(8n)/O(1)。
// 返回 32 位位型（按有符号 int 解释）；n <= 0 或 buf == 0 原样返回 crc。
// ⚠️ FLINT 的 >> 是算术右移，这里每次移位后 & 0x7FFFFFFF 清掉符号扩展（等价逻辑右移）。

// 内部件：喂一个字节（state = 未做末尾异或的原始状态）→ 新原始状态
int crc32_step(int state, int b) {
  int c = state ^ (b & 255);
  int k = 0;
  while (k < 8) {
    if ((c & 1) != 0) {
      c = ((c >> 1) & 0x7FFFFFFF) ^ 0xEDB88320;
    } else {
      c = (c >> 1) & 0x7FFFFFFF;
    }
    k = k + 1;
  }
  return c;
}

// 增量：从 crc（上一次返回的 CRC；0 = 从头开始）继续喂 buf[0..n)
int std::crc32_update(int crc, char *buf, int n) {
  if (n <= 0) { return crc; }
  if (buf == 0) { return crc; }
  int state = crc ^ 0xFFFFFFFF;
  int i = 0;
  while (i < n) {
    state = crc32_step(state, buf[i]);
    i = i + 1;
  }
  return state ^ 0xFFFFFFFF;
}

// 标准 CRC-32：等价于 crc32_update(0, buf, n)
int std::crc32(char *buf, int n) {
  return std::crc32_update(0, buf, n);
}

// ==================== §3 摘要（MD5 / SHA1 / SHA256）====================
// 走 Windows CryptoAPI（advapi32）；算法 ID = CALG_MD5 0x8003 / CALG_SHA1 0x8004 / CALG_SHA_256 0x800C。
// 每个函数内部自己 acquire -> create -> hash -> get -> destroy -> release，不依赖全局状态。
// 摘要写原始字节；失败（任何一步返回 0）→ -1 并清理句柄。

// MD5 摘要。out 至少 16 字节；返回 16；失败 -1。
int std::md5(char *buf, int n, char *out) {
  int *hProv = 0;
  int *hHash = 0;
  int len = 0;
  int rv = -1;
  if (buf == 0) { return -1; }
  if (out == 0) { return -1; }
  if (n < 0) { return -1; }
  if (CryptAcquireContextA(&hProv, 0, 0, 24, 0xF0000000) != 0) {
    if (CryptCreateHash(hProv, 0x8003, 0, 0, &hHash) != 0) {
      if (CryptHashData(hHash, buf, n, 0) != 0) {
        len = 16;
        if (CryptGetHashParam(hHash, 2, out, &len, 0) != 0) {
          if (len == 16) { rv = 16; }
        }
      }
    }
  }
  if (hHash != 0) { CryptDestroyHash(hHash); }
  if (hProv != 0) { CryptReleaseContext(hProv, 0); }
  return rv;
}

// SHA1 摘要。out 至少 20 字节；返回 20；失败 -1。
int std::sha1(char *buf, int n, char *out) {
  int *hProv = 0;
  int *hHash = 0;
  int len = 0;
  int rv = -1;
  if (buf == 0) { return -1; }
  if (out == 0) { return -1; }
  if (n < 0) { return -1; }
  if (CryptAcquireContextA(&hProv, 0, 0, 24, 0xF0000000) != 0) {
    if (CryptCreateHash(hProv, 0x8004, 0, 0, &hHash) != 0) {
      if (CryptHashData(hHash, buf, n, 0) != 0) {
        len = 20;
        if (CryptGetHashParam(hHash, 2, out, &len, 0) != 0) {
          if (len == 20) { rv = 20; }
        }
      }
    }
  }
  if (hHash != 0) { CryptDestroyHash(hHash); }
  if (hProv != 0) { CryptReleaseContext(hProv, 0); }
  return rv;
}

// SHA256 摘要。out 至少 32 字节；返回 32；失败 -1。
int std::sha256(char *buf, int n, char *out) {
  int *hProv = 0;
  int *hHash = 0;
  int len = 0;
  int rv = -1;
  if (buf == 0) { return -1; }
  if (out == 0) { return -1; }
  if (n < 0) { return -1; }
  if (CryptAcquireContextA(&hProv, 0, 0, 24, 0xF0000000) != 0) {
    if (CryptCreateHash(hProv, 0x800C, 0, 0, &hHash) != 0) {
      if (CryptHashData(hHash, buf, n, 0) != 0) {
        len = 32;
        if (CryptGetHashParam(hHash, 2, out, &len, 0) != 0) {
          if (len == 32) { rv = 32; }
        }
      }
    }
  }
  if (hHash != 0) { CryptDestroyHash(hHash); }
  if (hProv != 0) { CryptReleaseContext(hProv, 0); }
  return rv;
}

// ==================== §4 UTF-8 ↔ UTF-16 ====================
// 代码页 CP_UTF8 = 65001；UTF-16 按 Windows x86 口径 = 小端，每单位 2 字节。
// 与 §1~§3 同约定：显式长度、不查 strlen、缓冲由调用方给、失败响亮 -1。
//
// 三条容易记错的口径：
//   * MultiByteToWideChar 返回的是**宽字符数（UTF-16 码元数）**，不是字节数；
//     UTF-16 字节数 = 码元数 * 2。
//   * 探测所需大小时 dst 传 0、cap 传 0（只算长度、不写内存），确认容量够才真写。
//     ⇒ cap 不够时 out 一个字节都不会被碰。
//   * 非法 UTF-8 必须 -1：MultiByteToWideChar 的 dwFlags 用 MB_ERR_INVALID_CHARS(8)。
//     若传 0，Windows 会把非法序列**静默替换成 U+FFFD** 并返回正数，永远等不到 -1。
//     （本库取「响亮失败」口径，故 8 而不是 0。）
//   * 反方向 WideCharToMultiByte 用 flags = 0：非法 UTF-16（孤立代理项）会被替换成 '?'，
//     不报 -1 —— 本库只对非法 UTF-8 响亮失败（与 §4 判据一致）。
//
// utf16_len      ：UTF-8 n 字节 → 需要多少**字节**（含结尾 0 的 2 字节）；失败 -1。
// utf8_to_utf16  ：cap = out 总字节数（含结尾 0）；返回写入字节数（不含结尾 0）；失败 -1。
// utf16_to_utf8  ：nbytes = u16 的字节数（含/不含结尾 0 两种都给处理，见实现）；
//                  cap = out 总字节数（含结尾 0）；返回写入字节数（不含结尾 0）；失败 -1。
// 三个函数都补结尾 0；空串 = 返回 0（utf16_len 返回 2）。

// 内部件：UTF-8 n 字节 → UTF-16 码元数；0 = 空串；-1 = 非法 UTF-8 / 参数非法
int utf16_units(char *utf8, int n) {
  int u = 0;
  if (n < 0) { return -1; }
  if (n == 0) { return 0; }
  if (utf8 == 0) { return -1; }
  u = MultiByteToWideChar(65001, 8, utf8, n, 0, 0);
  if (u <= 0) { return -1; }
  return u;
}

// UTF-8 n 字节转成 UTF-16 需要多少字节（含结尾 0）；失败 -1
int std::utf16_len(char *utf8, int n) {
  int u = 0;
  u = utf16_units(utf8, n);
  if (u < 0) { return -1; }
  return (u + 1) * 2;
}

// UTF-8 n 字节 → out（UTF-16LE，2 字节/单位，补结尾 0）；返回字节数（不含结尾 0）
int std::utf8_to_utf16(char *utf8, int n, char *out, int cap) {
  int u = 0;
  int need = 0;
  if (n < 0) { return -1; }
  if (cap < 0) { return -1; }
  u = utf16_units(utf8, n);
  if (u < 0) { return -1; }
  need = (u + 1) * 2;
  if (cap < need) { return -1; }
  if (out == 0) { return -1; }
  if (u == 0) {
    out[0] = 0;
    out[1] = 0;
    return 0;
  }
  if (MultiByteToWideChar(65001, 8, utf8, n, out, u) != u) { return -1; }
  out[u * 2] = 0;
  out[u * 2 + 1] = 0;
  return u * 2;
}

// UTF-16 nbytes 字节 → out（UTF-8，补结尾 0）；返回字节数（不含结尾 0）
int std::utf16_to_utf8(char *u16, int nbytes, char *out, int cap) {
  int units = 0;
  int need = 0;
  int got = 0;
  if (nbytes < 0) { return -1; }
  if (cap < 0) { return -1; }
  if (cap < 1) { return -1; }
  if (out == 0) { return -1; }
  if (nbytes > 0) {
    if (u16 == 0) { return -1; }
    units = nbytes / 2;
    // 调用方可能把结尾 0 的 2 字节也算进 nbytes：剥掉末尾一个全零码元
    if (units > 0 && (u16[(units - 1) * 2] & 255) == 0 && (u16[(units - 1) * 2 + 1] & 255) == 0) {
      units = units - 1;
    }
  }
  if (units == 0) {
    out[0] = 0;
    return 0;
  }
  need = WideCharToMultiByte(65001, 0, u16, units, 0, 0, 0, 0);
  if (need <= 0) { return -1; }
  if (cap < need + 1) { return -1; }
  got = WideCharToMultiByte(65001, 0, u16, units, out, cap, 0, 0);
  if (got != need) { return -1; }
  out[got] = 0;
  return got;
}
