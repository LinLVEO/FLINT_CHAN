// image_lib.fl — FLINT 标准库：BMP 读写（24/32 位未压缩）
// 用法：include "../../lib/image_lib.fl"（路径相对本文件目录解析）
// 命名：2026-11-03 用户拍板（std::bmp_info / bmp_load / bmp_save）
// 自包含：不 include 其它库；CreateFileA 等 api 在此声明（与 io_lib 同口径，
//         所以调用方不要再 include io_lib，否则 CreateFileA 等会重复声明）
// 边界：只认未压缩 24/32 位、BITMAPINFOHEADER(40) 及以上的 BMP；
//       不支持 RLE/调色板/OS2 头；不分配内存（像素缓冲由调用方给，行缓冲是局部定长数组）；
//       不支持 >2GB 文件（SetFilePointer 低 32 位 / GetFileSize 同）。
api kernel32 ptr CreateFileA(int, int, int, int, int, int, int);
api kernel32 int ReadFile(int, int, int, int, int);
api kernel32 int WriteFile(int, int, int, int, int);
api kernel32 int CloseHandle(int);
api kernel32 int SetFilePointer(int, int, int, int);

// ---------------- 小端读写（BMP 全小端） ----------------

// 读 16 位小端
int std::bmp_get_u16(char *p, int off) {
  return p[off] | (p[off + 1] << 8);
}

// 读 32 位小端（按位型，不按符号；最高字节 >= 0x80 时为负，位型不变）
int std::bmp_get_u32(char *p, int off) {
  return p[off] | (p[off + 1] << 8) | (p[off + 2] << 16) | (p[off + 3] << 24);
}

// 写 16 位小端
int std::bmp_put_u16(char *p, int off, int v) {
  p[off] = v & 255;
  p[off + 1] = (v >> 8) & 255;
  return 1;
}

// 写 32 位小端
int std::bmp_put_u32(char *p, int off, int v) {
  p[off] = v & 255;
  p[off + 1] = (v >> 8) & 255;
  p[off + 2] = (v >> 16) & 255;
  p[off + 3] = (v >> 24) & 255;
  return 1;
}

// 读 54 字节文件头（14 字节 BITMAPFILEHEADER + 40 字节 BITMAPINFOHEADER）到 hdr。
// 1 = 读满 54 字节；-1 = 打不开/读失败/文件不足 54 字节。
int std::bmp_hdr(char *path, char *hdr) {
  int got = 0;
  int *h = CreateFileA(path, 0x80000000, 0, 0, 3, 0x80, 0);   // GENERIC_READ / OPEN_EXISTING
  if (h == 0) { return -1; }
  int r = ReadFile(h, hdr, 54, &got, 0);
  CloseHandle(h);
  if (r == 0) { return -1; }
  if (got != 54) { return -1; }
  return 1;
}

// 解 54 字节头；w/h/bpp/像素偏移写回（h < 0 = 自顶向下位图）。1 = 合法，-1 = 不认。
int std::bmp_parse(char *hdr, int *w, int *h, int *bpp, int *off) {
  int isz = 0;
  int ww = 0;
  int hh = 0;
  int planes = 0;
  int bb = 0;
  int comp = 0;
  int dataoff = 0;

  if (hdr[0] != 66) { return -1; }          // 'B'
  if (hdr[1] != 77) { return -1; }          // 'M'
  isz = std::bmp_get_u32(hdr, 14);          // 结构大小
  ww = std::bmp_get_u32(hdr, 18);           // 宽
  hh = std::bmp_get_u32(hdr, 22);           // 高（负 = 自顶向下）
  planes = std::bmp_get_u16(hdr, 26);       // planes
  bb = std::bmp_get_u16(hdr, 28);           // bpp
  comp = std::bmp_get_u32(hdr, 30);         // 压缩方式
  dataoff = std::bmp_get_u32(hdr, 10);      // 像素数据偏移（读头，不写死 54）
  if (isz < 40) { return -1; }              // 只认 BITMAPINFOHEADER 及以上
  if (planes != 1) { return -1; }
  if (bb != 24 && bb != 32) { return -1; }  // 只认 24/32 位
  if (comp != 0) { return -1; }             // 只认未压缩
  if (ww <= 0) { return -1; }
  if (hh == 0) { return -1; }
  if (dataoff < 54) { return -1; }
  *w = ww;
  *h = hh;
  *bpp = bb;
  *off = dataoff;
  return 1;
}

// 读文件头：写回 w/h/bpp；1 = 成功，-1 = 打不开/不是支持的 BMP。
int std::bmp_info(char *path, int *w, int *h, int *bpp) {
  char hdr[54];
  int off = 0;
  if (path == 0) { return -1; }
  if (w == 0 || h == 0 || bpp == 0) { return -1; }
  if (std::bmp_hdr(path, hdr) != 1) { return -1; }
  if (std::bmp_parse(hdr, w, h, bpp, &off) != 1) { return -1; }
  return 1;
}

// 读像素到 rgba（R,G,B,A 每像素 4 字节，自顶向下）；返回像素字节数，-1 = 失败。
// 24 位补 A=255；32 位原样保留 A。文件里自底向上（h>0）会翻转成自顶向下。
int std::bmp_load(char *path, char *rgba, int cap) {
  char hdr[54];
  char buf[960];              // 960 = 12 的倍数：24/32 位像素都不会跨块
  int w = 0;
  int h = 0;
  int bpp = 0;
  int off = 0;
  int rows = 0;
  int topdown = 0;
  int pb = 0;
  int need = 0;
  int rowbytes = 0;
  int y = 0;
  int px = 0;
  int i = 0;
  int n = 0;
  int got = 0;
  int r = 0;
  int remaining = 0;
  int dst = 0;
  int srcrow = 0;
  int *fh = 0;

  if (path == 0) { return -1; }
  if (rgba == 0) { return -1; }
  if (std::bmp_hdr(path, hdr) != 1) { return -1; }
  if (std::bmp_parse(hdr, &w, &h, &bpp, &off) != 1) { return -1; }

  rows = h;
  if (h < 0) {
    rows = 0 - h;
    topdown = 1;
  }
  // 溢出保护：need = w*rows*4 必须在 int 内
  if (rows > 0x7FFFFFFF / 4 / w) { return -1; }
  need = w * rows * 4;
  if (cap < need) { return -1; }

  pb = bpp / 8;
  rowbytes = ((w * bpp + 31) / 32) * 4;     // 行按 4 字节对齐
  if (rowbytes <= 0) { return -1; }
  if (rows > 0x7FFFFFFF / rowbytes) { return -1; }

  fh = CreateFileA(path, 0x80000000, 0, 0, 3, 0x80, 0);   // GENERIC_READ / OPEN_EXISTING
  if (fh == 0) { return -1; }

  y = 0;
  while (y < rows) {
    srcrow = off + y * rowbytes;
    if (SetFilePointer(fh, srcrow, 0, 0) == -1) { CloseHandle(fh); return -1; }
    remaining = w * pb;
    px = 0;
    while (remaining > 0) {
      n = remaining;
      if (n > 960) { n = 960; }
      got = 0;
      r = ReadFile(fh, buf, n, &got, 0);
      if (r == 0) { CloseHandle(fh); return -1; }
      if (got != n) { CloseHandle(fh); return -1; }
      i = 0;
      while (i < n) {
        if (topdown == 1) {
          dst = (y * w + px) * 4;
        } else {
          dst = ((rows - 1 - y) * w + px) * 4;   // 自底向上 -> 自顶向下
        }
        rgba[dst] = buf[i + 2];                  // B -> R
        rgba[dst + 1] = buf[i + 1];              // G -> G
        rgba[dst + 2] = buf[i];                  // R -> B
        if (pb == 4) {
          rgba[dst + 3] = buf[i + 3];
        } else {
          rgba[dst + 3] = 255;                   // 24 位没有 alpha
        }
        i = i + pb;
        px = px + 1;
      }
      remaining = remaining - n;
    }
    y = y + 1;
  }
  CloseHandle(fh);
  return need;
}

// 写 24 位 BMP（自顶向下 rgba -> 自底向上 BGR，行 4 字节对齐）；1 = 成功，0 = 失败。
int std::bmp_save(char *path, char *rgba, int w, int h) {
  char hdr[54];
  char buf[960];             // 960 = 320 像素 * 3 字节
  int rowbytes = 0;
  int size = 0;
  int y = 0;
  int px = 0;
  int cnt = 0;
  int i = 0;
  int s = 0;
  int pad = 0;
  int wrote = 0;
  int r = 0;
  int *fh = 0;

  if (path == 0) { return 0; }
  if (rgba == 0) { return 0; }
  if (w <= 0 || h <= 0) { return 0; }
  if (w > 0x7FFFFFFF / 3) { return 0; }
  rowbytes = ((w * 3 + 3) / 4) * 4;          // = ((w*24+31)/32)*4，行按 4 字节对齐
  if (rowbytes <= 0) { return 0; }
  if (h > (0x7FFFFFFF - 54) / rowbytes) { return 0; }
  size = 54 + rowbytes * h;

  // BITMAPFILEHEADER（14 字节）
  hdr[0] = 66;                               // 'B'
  hdr[1] = 77;                               // 'M'
  std::bmp_put_u32(hdr, 2, size);            // 文件大小
  std::bmp_put_u32(hdr, 6, 0);               // 保留
  std::bmp_put_u32(hdr, 10, 54);             // 像素数据偏移
  // BITMAPINFOHEADER（40 字节）
  std::bmp_put_u32(hdr, 14, 40);             // 结构大小
  std::bmp_put_u32(hdr, 18, w);              // 宽
  std::bmp_put_u32(hdr, 22, h);              // 高（正数 = 自底向上）
  std::bmp_put_u16(hdr, 26, 1);              // planes
  std::bmp_put_u16(hdr, 28, 24);             // bpp
  std::bmp_put_u32(hdr, 30, 0);              // 压缩：0 = 未压缩
  std::bmp_put_u32(hdr, 34, rowbytes * h);   // 图像大小
  std::bmp_put_u32(hdr, 38, 2835);           // xppm（72 dpi）
  std::bmp_put_u32(hdr, 42, 2835);           // yppm
  std::bmp_put_u32(hdr, 46, 0);              // 色数
  std::bmp_put_u32(hdr, 50, 0);              // 重要色数

  fh = CreateFileA(path, 0x40000000, 0, 0, 2, 0x80, 0);   // GENERIC_WRITE / CREATE_ALWAYS
  if (fh == 0) { return 0; }
  wrote = 0;
  r = WriteFile(fh, hdr, 54, &wrote, 0);
  if (r == 0 || wrote != 54) { CloseHandle(fh); return 0; }

  y = 0;
  while (y < h) {
    px = 0;
    while (px < w) {
      cnt = w - px;
      if (cnt > 320) { cnt = 320; }           // 320*3 = 960
      i = 0;
      while (i < cnt) {
        s = ((h - 1 - y) * w + px + i) * 4;   // 自顶向下 rgba -> 自底向上行
        buf[i * 3] = rgba[s + 2];             // R,G,B -> B,G,R
        buf[i * 3 + 1] = rgba[s + 1];
        buf[i * 3 + 2] = rgba[s];
        i = i + 1;
      }
      wrote = 0;
      r = WriteFile(fh, buf, cnt * 3, &wrote, 0);
      if (r == 0 || wrote != cnt * 3) { CloseHandle(fh); return 0; }
      px = px + cnt;
    }
    pad = rowbytes - w * 3;                    // 行尾补 0 到 4 字节
    if (pad > 0) {
      buf[0] = 0;
      buf[1] = 0;
      buf[2] = 0;
      buf[3] = 0;
      wrote = 0;
      r = WriteFile(fh, buf, pad, &wrote, 0);
      if (r == 0 || wrote != pad) { CloseHandle(fh); return 0; }
    }
    y = y + 1;
  }
  CloseHandle(fh);
  return 1;
}

// ==================== §2 PNG 解码（GDI+，2026-11-03 追加）====================
// 为什么走 gdiplus.dll：PNG 要 inflate + 逐行滤波，自己写 zlib 太大；GDI+ 是系统组件，
// 中低频「读一张图」够用。本区只做解码读像素，不做编码。
// ⚠️ GDI+ 的文件名参数是 LPCWSTR（UTF-16）：先用 MultiByteToWideChar(CP_ACP=0) 转。
// ⚠️ GDI+ 的 BitmapData / RECT 全部手工镜像（FLINT 没有 sizeof，字段自己数）：
//    RECT  16 字节：left@0 top@4 right@8 bottom@12
//    BitmapData 32 字节：width@0 height@4 stride@8 pixelformat@12 scan0@16(8) reserved@24(8)
// 支持 PNG/BMP/JPEG 等 GDI+ 认识的格式（与扩展名无关，靠文件头）。
// 返回口径：png_info 1/-1；png_load 像素字节数 / -1。

api gdiplus int GdiplusStartup(int, int, int);
api gdiplus int GdiplusShutdown(int);
api gdiplus int GdipCreateBitmapFromFile(int, int);
api gdiplus int GdipGetImageWidth(int, int);
api gdiplus int GdipGetImageHeight(int, int);
api gdiplus int GdipBitmapLockBits(int, int, int, int, int);
api gdiplus int GdipBitmapUnlockBits(int, int);
api gdiplus int GdipDisposeImage(int);
api kernel32 int MultiByteToWideChar(int, int, int, int, int, int);

// GDI+ 的 BitmapData 镜像（32 字节）
struct BData { int w; int h; int stride; int fmt; int *scan0; int *reserved; }

// 取图片宽高（GDI+ 认识的所有格式）：1 = 成功；-1 = 失败
int std::png_info(char *path, int *w, int *h) {
  char wname[1024];
  char sin[24];
  int *token = 0;
  int *bmp = 0;
  int i = 0;
  int rc = 0;
  if (path == 0) { return -1; }
  if (w == 0) { return -1; }
  if (h == 0) { return -1; }
  i = 0;
  while (i < 24) { sin[i] = 0; i = i + 1; }
  sin[0] = 1;                                       // GdiplusVersion
  if (MultiByteToWideChar(0, 0, path, 0 - 1, &wname[0], 512) <= 0) { return -1; }
  if (GdiplusStartup(&token, &sin[0], 0) != 0) { return -1; }
  rc = GdipCreateBitmapFromFile(&wname[0], &bmp);
  if (rc != 0) { GdiplusShutdown(token); return -1; }
  rc = GdipGetImageWidth(bmp, w);
  if (rc == 0) { rc = GdipGetImageHeight(bmp, h); }
  GdipDisposeImage(bmp);
  GdiplusShutdown(token);
  if (rc != 0) { return -1; }
  return 1;
}

// 解码任意 GDI+ 支持的图片到 RGBA（每像素 4 字节、自顶向下、A 通道原样）：
// 返回像素字节数（w*h*4）；-1 = 打开/解码失败、cap 不够、参数非法
int std::png_load(char *path, char *rgba, int cap) {
  char wname[1024];
  char sin[24];
  char rect[16];
  struct BData bd;
  int *token = 0;
  int *bmp = 0;
  int w = 0;
  int h = 0;
  int i = 0;
  int y = 0;
  int x = 0;
  int rc = 0;
  int need = 0;
  int stride = 0;
  int base = 0;
  int *pscan = 0;
  char *cs = 0;
  int a = 0;
  int b = 0;
  int g = 0;
  int r2 = 0;
  int o = 0;

  if (path == 0) { return -1; }
  if (rgba == 0) { return -1; }
  if (cap < 1) { return -1; }
  i = 0;
  while (i < 24) { sin[i] = 0; i = i + 1; }
  sin[0] = 1;
  if (MultiByteToWideChar(0, 0, path, 0 - 1, &wname[0], 512) <= 0) { return -1; }
  if (GdiplusStartup(&token, &sin[0], 0) != 0) { return -1; }
  rc = GdipCreateBitmapFromFile(&wname[0], &bmp);
  if (rc != 0) { GdiplusShutdown(token); return -1; }
  if (GdipGetImageWidth(bmp, &w) != 0) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }
  if (GdipGetImageHeight(bmp, &h) != 0) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }
  if (w <= 0 || h <= 0) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }
  if (w > 0x7FFFFFFF / 4 / h) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }
  need = w * h * 4;
  if (cap < need) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }

  // RECT = left, top, right, bottom
  i = 0;
  while (i < 16) { rect[i] = 0; i = i + 1; }
  rect[8] = w & 255; rect[9] = (w >> 8) & 255; rect[10] = (w >> 16) & 255; rect[11] = (w >> 24) & 255;
  rect[12] = h & 255; rect[13] = (h >> 8) & 255; rect[14] = (h >> 16) & 255; rect[15] = (h >> 24) & 255;
  bd.w = 0; bd.h = 0; bd.stride = 0; bd.fmt = 0; bd.scan0 = 0; bd.reserved = 0;
  // ImageLockModeRead=1；PixelFormat32bppARGB=0x26200A
  rc = GdipBitmapLockBits(bmp, &rect[0], 1, 0x26200A, &bd);
  if (rc != 0) { GdipDisposeImage(bmp); GdiplusShutdown(token); return -1; }
  stride = bd.stride;
  if (stride < 0) { stride = 0 - stride; }
  pscan = bd.scan0;
  cs = pscan;
  y = 0;
  while (y < h) {
    x = 0;
    while (x < w) {
      o = (y * w + x) * 4;
      base = y * stride + x * 4;
      b = cs[base] & 255;
      g = cs[base + 1] & 255;
      r2 = cs[base + 2] & 255;
      a = cs[base + 3] & 255;
      rgba[o] = r2;
      rgba[o + 1] = g;
      rgba[o + 2] = b;
      rgba[o + 3] = a;
      x = x + 1;
    }
    y = y + 1;
  }
  GdipBitmapUnlockBits(bmp, &bd);
  GdipDisposeImage(bmp);
  GdiplusShutdown(token);
  return need;
}
