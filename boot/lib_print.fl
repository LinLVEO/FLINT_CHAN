// lib_print.fl — boot 内建 print 的支撑库（B2g：用到 print 时 boot 自动前置注入）
// 语言内建 print([段, ...] [, 换行]) 由 boot 展开为对下面三个隐藏函数的调用
// 段类型分派：字符串字面量/char* → _flint_out_str ｜ char 标量 → _flint_out_char ｜ int → _flint_out_int
// 约束：函数 ≤4 参、无全局变量（stdout 句柄每次现取）、char 数组占 8 字节/元素（沿用 FLINT 布局）
api kernel32 ptr GetStdHandle(int);
api kernel32 int WriteFile(int, int, int, int, int);

int _flint_out_str(char *s) {
  int n = 0;
  while (s[n] != 0) { n = n + 1; }
  int w = 0;
  int *h = GetStdHandle(-11);
  return WriteFile(h, s, n, &w, 0);
}

int _flint_out_char(int c) {
  char buf[2];
  buf[0] = c;
  buf[1] = 0;
  return _flint_out_str(buf);
}

int _flint_out_int(int v) {
  char buf[12];
  char out[12];
  int n = 0;
  int neg = 0;
  if (v < 0) { neg = 1; v = 0 - v; }
  if (v == 0) { buf[0] = '0'; n = 1; }
  while (v > 0) {
    buf[n] = '0' + v - v / 10 * 10;
    n = n + 1;
    v = v / 10;
  }
  if (neg == 1) { buf[n] = '-'; n = n + 1; }
  int i = 0;
  while (i < n) {
    out[i] = buf[n - 1 - i];
    i = i + 1;
  }
  out[n] = 0;
  return _flint_out_str(out);
}
