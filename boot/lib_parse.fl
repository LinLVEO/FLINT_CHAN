// lib_parse.fl — FLINT 自举共享库：递归下降 parser（B2m：指针字段直接下标）
// 任务卡 T-20260908-020937（B1）/ 184922（B2a）/ 200831（B2c）/ 202511（B2d）/ 204628（B2e）/ 205631（B2f）
//        / 213613（B2h）/ 215048（B2i）/ 220920（B2j）/ 225144（B2k）/ B2l / B2m / B3a / B3b / B4a
// B4a：for 语句（对齐真 flint ND_FOR）——init 一次 → cond 判（空 = 恒真）→ body → inc → 回判；
//      for 头单独作用域（init 声明的变量只在该 for 内可见）；新 AST 种类 65（不复用块表）
// B2m：指针字段直接下标 `s.arr[i]` / `p->arr[i]`（= *(字段指针 + 下标×元素宽)；int* 8 字节槽 / char* 1 字节）
//      —— 展开复用现有节点 1(add 地址链) 3(mul) 53(解引用读) 54(解引用写) 60(复合)，不新增 AST 种类
// B2l：二元 `%`（节点 61，C 语义余数符号随被除数）+ `%=` 复合赋值（复用节点 60 的 op 4）
// B2k：① 复合赋值 op= ∈ {+= -= *= /= %= &= |= ^= <<= >>=}——统一节点 60「地址只算一次 → 读-改-写」
//      ② ++/-- 前缀/后缀（表达式值：前缀/复合 = 存储值、后缀 = 旧值；char 目标按字节截断）
//      ③ struct char 标量字段（1 字节 / 对齐 1，读 movzx、写字节，节点 55-58）
//      ⚠️ 裸指针 ± 仍是**字节**步进：`*(p->f + i)` ≠ `p->f[i]`（要元素下标得 `*(p->f + i * 8)`）
//      → B2m 起可直接写 `p->f[i]`（编译器按元素宽展开，等价于先局部化再下标）
// B2j：① 地址链 p±n 结果标地址类（addr_ty，机器走 64 位）
//      ② `*q` 解引用读/写（ty 细分 1/2/3 → 宽度随被指对象：int 4B / char 1B / 指针 8B）
//      ③ struct 字段真实 C 布局（升序 + 类型对齐）+ 本地 struct 基址 = 保留区最低槽
// 语法（B2j 子集）：
//   program := structdef* funcdef+
//   structdef := struct 名 { <类型> 名 ; ... }
//   类型    := int | int '*' | char '*' | struct 名 '*'
//   funcdef := int 名 ( [形参 (, 形参)*] ) block
//   形参    := int 名 | int '*' 名 | int 名 '[' ']' | char '*' 名 | struct 名 '*' 名
//   block   := { stmt* }
//   stmt    := 声明 | 赋值 | 复合赋值 | ++/-- | return | if | while | for | block | print | try | 调用语句 | *q = expr ;
//   B2k：复合赋值 op= ∈ {+= -= *= /= %= &= |= ^= <<= >>=}；++/-- 前缀/后缀；
//     目标宽度随地址类型（int 4B / char 1B / 指针 8B）；表达式值 = 存储值（char 截断）、后缀 = 旧值
//   if      := if ( expr ) stmt [else stmt]
//   while   := while ( expr ) stmt
//   for     := for ( [声明|表达式] ; [expr] ; [expr] ) stmt（B4a；三段皆可空，空 cond = 恒真）
//  声明    := <类型> 名 [ = expr ] ; | int 名 [ num ] ; | char 名 [ num ] ;
//  赋值    := 左值 = expr ;      左值 := 名 | 名 [ expr ] | 名 . 字段 | 名 -> 字段
//  return  := return expr ;
//   try     := try 名 = expr ;（v2.4.x 补缺口 -220；展开 = `名 = expr ;` + `if (名 != 0) { return 名 ; }`）
//   expr   := orx
//   orx    := andx (|| andx)*            左结合
//   andx   := rel (&& rel)*
//   rel    := add ((==|!=|<|<=|>|>=) add)*
//   add    := term (('+'|'-') term)*
//   term   := factor (('*'|'/'|'%') factor)*
//   factor := num | '(' expr ')' | '-' factor | '!' factor | '~' factor | '*' factor | '&' 名
//           | 名 | 名 '[' expr ']' | 名 '.' 字段 | 名 '->' 字段 | 名 '(' [expr (, expr)*] ')'
//           | '++' factor | '--' factor | factor '++' | factor '--'（B2k）
// AST（数组式）：0=num 1=add 2=sub 3=mul 4=div 5=neg 6=变量读(val=相对槽)
//   7=赋值(l=槽,r=expr) 8=声明+初始化(l=槽,r=expr) 9=return(l=expr) 10=调用(val=函数号,l=实参基址,r=个数)
//   11=eq 12=ne 13=lt 14=le 15=gt 16=ge（l,r 操作数）
//   17=if(l=cond, r=then 块, val=else 块|-1) 18=while(l=cond, r=body 块)
//   19=块(l=blk 基址, r=语句数) 20=not(l) 21=land(l,r) 22=lor(l,r)
//   23=本地数组下标读(l=槽, r=下标) 24=本地数组下标写(l=槽, r=下标, val=值)
//   25=取址(val=槽) 26=指针变量读(val=槽)
//   28=指针下标读(l=槽, r=下标) 29=指针下标写(l=槽, r=下标, val=值)
//   30=本地 struct 字段读(l=槽, val=字段偏移) 31=本地 struct 字段写(l=槽, val=偏移, r=值)
//   32=指针字段读(l=槽, val=偏移) 33=指针字段写(l=槽, val=偏移, r=值)
//   35=指针变量赋值(l=槽, r=值) 36=指针声明+初始化(l=槽, r=值)
//   37=char* 下标读(l=槽, r=下标) 38=char* 下标写(l=槽, r=下标, val=值)
//   39=char 数组下标读(l=槽, r=下标) 40=char 数组下标写(l=槽, r=下标, val=值)
//   44=shl(l,r) 45=sar(l,r) 46=and(l,r) 47=xor(l,r) 48=or(l,r) 49=bitnot(l)（B2h 位运算）
//   50=调用语句(l=调用节点)（B2h 表达式语句）
//   51=&p->f(l=槽, val=字段编码) 52=&v.f(l=基址槽, val=字段编码)（B2h 字段取址）
//   53=*q 解引用读(l=地址表达式) 54=*q 解引用写(l=地址表达式, r=值)（B2j）
//   55=本地 struct char 字段读(l=基址槽, val=编码) 56=写(l=槽, val=编码, r=值)（B2k）
//   57=指针 -> char 字段读(l=槽, val=编码) 58=写(l=槽, val=编码, r=值)（B2k）
//   60=复合赋值/++/--(l=地址表达式, r=右值, val=op*1000+宽度*100+后缀)（B2k；地址只算一次）
//   61=取模 lv % rv（B2l；机器 cdq+idiv → edx；%= 复用节点 60 的 op 4）
//   65=for(l=init|-1, r=cond|-1, val=body 块节点, ty=inc 语句节点)（B4a；-1 = 该段为空；不复用块表，四段各自发射）
//      ⚠️ v1.6.1（2026-10-15）起**不再打包**：本体与自增各占一个普通节点下标（无算术 ⇒ 无溢出）。
//      旧编码 `val=(inc+1)*100000+body` 是 int32 打包算术，inc 下标 ≥ 21475 时溢出成负值 ⇒ 解码端拿负下标，
//      for 体与自增被**静默丢弃**（并越界读 AST 表 → 偶发 0xC0000005）。改编码必须同步**两个**读点：
//      b1_emit.fl `emit_stmt` k==65（发射）＋ b1_parse.fl `ex_stmt` k==65（解释器自测）——只改前者会死循环。
//   68/69=break/continue（语句节点，emit_stmt 用；⚠️ 新增表达式节点别复用这两个号）
//   70=C 风格转型（v1.8.0；l=操作数, val=0(int)/3(char)/1(int*)/2(char*)；ty 0=值 / 1=int 地址 / 2=char 地址）
//   30/31/32/33 的 ty = 字段类型（0=int 1=int* 2=char* 3=struct* → 见 fld_ty/fld_addr_ty）
//   字段节点 val = 字段序号*1000 + 字节偏移（fld_code）：机器取偏移做 disp、解释器取序号做槽映射
//   数组/struct 声明 = 空块（kind 19, cnt=0）：只登记槽位，不产码
//   try（v2.4.x）**不新增节点**：展开复用 7/43 写 + 17(if；then = 19 块) + 12(ne) + 0(num 0) + 6/42 读 + 9(return)
// 类型规格 vsp[k] = ty*100000000 + aux*1000000 + sid*1000 + n：
//   ty 0=int(n=1) 1=int 数组(n=元素数) 2=指针(aux 0=int* 1=char* 2=struct*；sid=struct) 3=本地 struct(n=字段数) 4=char 数组(n=字节数)
//      6=本地 struct 数组(T=总槽数 占低 5 位, sid 在 10^5 格) 8=本地二维 int 数组(T=元素总数, 列数在 10^6 格；v2.2.0)
// Ast.ty（B2j 细分）：0=int 值｜1=地址·elem int(4B 读)｜2=地址·elem char(1B 读)｜3=地址·elem 指针/struct(8B 读)
//   —— >=1 一律是地址类（64 位加减/比较）；`*q` 的读写宽度按操作数 ty 分派
// 语句索引：块内**直接子语句**存 p->blk（嵌套块的子语句不进父块，base=nblk-cnt 取尾段）
// 变量槽 = 函数内相对槽；数组/struct 占连续槽（升序：基址 = 最低槽 = slot+n-1，元素 i/字段 j 向上）；
//   struct 字段偏移 = 真实 C 布局（B2j：int 4B/对齐4、指针 8B/对齐8，st_layout_cur 累加）；
//   实参表基址解析完实参再算（B2c 教训）
// FLINT 约束应对：函数 ≤4 参；输出平行数组由调用方分配；无 break/continue；
//   ⚠️ 字段数组仍须先局部化再下标（裸指针 ± 是字节步进，`*(p->f + i)` ≠ `p->f[i]`，B2k 实测）
// v1.4.31（卡 T-20260918-014653）：**指针目标值门槛** —— 口径对齐真 flint 的 check_ptr_target
//   （src\codegen.c）：白名单 = 地址类值 / 显式常量 / API 或指针返回的调用 / new / 「装过地址的 int」变量；
//   其余（纯 int 变量、int 算术结果、int 返回调用）→ 返回 -198（不再静默产出截断指针）。
//   落地 = 解析期**粘性标记** vad[]（与变量表同下标，1 = 该变量装过地址）近似真 flint 的 T1 定点标记：
//   于是 `int s = "AB"; char *q = s;`（rev4.fl 那类正例）照旧放行；判不了的一律**放行**
//   （boot 更宽不算缺口 —— 自举只要求「真 flint 收的 boot 必收」）。
include "lib_token.fl"

// ===== 2026-10-24（容量刀·单点）：boot 侧容量上限只写在这里 =====
// 为什么要有这几个函数：boot 的「512 函数」曾在 **3 处**手抄 —— 本文件两处守卫 +
//   b1_emit.fl 的 `VirtualAlloc(0, 4096)` 和栈数组 `int aord[512]`。改一处漏两处
//   = **静默越界写**（不报错、坏在别处；本项目已栽过同族坑）。
// 为什么用函数、不用全局常量：boot 侧没有全局变量（自举时全局路径未被验证过），
//   函数是唯一能跨文件"一份数字"的机制；代价只是多几条指令，容量表初始化时才调。
// 口径：boot 的上限只允许「比真 flint 宽」，宽度取远大于真实用量（真 flint 侧这些表
//   是 malloc/realloc 动态的 ⇒ 无固定上限，见 src\pe.c）。
//   · funcs  = 函数项 + API 声明项 总数（build_pe 的 aord/ahint/aslot/agrp 按**函数下标**开）
//   · imps   = 导入函数总数（含合成的 ExitProcess 槽 0）
//   · groups = 导入模块数（含无 kernel32 时合成的那一组）
int cap_funcs() { return 8192; }
int cap_imps() { return 2048; }
int cap_groups() { return 64; }
// v2.1.0（2026-11-01）：enum 常量表上限 —— **表体**由 parse_program 的局部数组提供（见那里的注释），
//   容量单点写在这里。真 flint 侧是 malloc/realloc 动态表（无固定上限），boot 只能给足。
int enum_cap() { return 512; }

struct Ast {
  int *kind;
  int *l;
  int *r;
  int *val;
  int *args;
  int *ty;         // B2f：节点类型 0=int 1=指针（决定 64 位读写）
  int cap;
  int cnt;
}

struct Parse {
  int *src;
  int *ks;
  int *ps;
  int *ls;
  int *vs;
  int n;
  int i;
  int *vps;
  int *vls;
  int *vsp;        // B2e：变量规格 = 类型*100000 + 槽数（类型 0=int 1=数组 2=指针形参）
  int *vslots;     // B2e：绝对槽号（相对槽 = vslots[k] - sbase）
  int *vad;        // v1.4.31：装地址的 int 标记表（与变量表同下标；1 = 装过地址，可当指针目标）
  int nvars;
  int vbase;
  int nslots;      // B2e：全局累计槽数（含数组元素）
  int maxslots;    // B2g：本函数槽数峰值（块作用域退出会回退 nslots）
  int sbase;       // B2e：当前函数槽基址
  int *blk;
  int nblk;
  int *fpos;
  int *flen;
  int *fnargs;
  int *fpty;       // B2g：函数表打包项（dll*10000 + api*1000 + retptr*100 + **前 4 个形参的指针位**）
                   //   v1.4.26：低两位十进制**只留前 4 个形参的掩码位**（写入侧 `pr % 16`）—— 原先是全掩码，
                   //   形参上限从 4 抬到 32 后 `1<<cnt` 会溢进 retptr/api/dll 的十进制位（**7 个形参就爆**：
                   //   pr = 128 ⇒ fn_retptr 把"指针参数多"读成"返回类型 +1"）。第 5 个起在**栈**上、
                   //   装载一律 64 位（见 b1_emit 形参装载）⇒ 收窄到前 4 位是安全的。
  int *fvar_cnt;
  int *fbody;
  // ===== 2026-09-21（卡 T-20260921-232138 第四刀 A1）：每函数「提升进寄存器」计划 =====
  //   发射端只**查表**（b1_emit.fl 的 preg_of），计划本身在解析末尾定死 —— 见 plan_regs 的注释。
  int *preg_n;         // 每函数提升个数（0 = 本函数全走老路，产物逐字节不变）
  int *preg_slot;      // 提升的**相对槽号**（扁平表：fi*4 + j；池 = rbx/r12/r13/r14）
  int pn0;             // 本函数节点区间起点（含形参节点；parse_program 里记）
  int pnend;           // 本函数节点区间终点（= 函数体块节点，最后建的）
  int *pmark;          // 第四刀：节点"被引用"过近似标记（配合活/死判别 —— 解析器回退会留孤儿节点）
  int nfuncs;
  int main_idx;
  int *args;
  int nargs;
  int *sflat;      // B2f：struct 表（扁平数组：0=个数 1=游标；表头 4 项、字段项 5 项）
  int *aflat;      // B2g：api 表（0=个数；每项 4 项 [dllpos,dlllen,namepos,namelen]）
  int *spool;      // B2g：字符串池（字节缓冲，NUL 结尾）
  int spcur;       // B2g：字符串池游标（已用字节数）
  int ret_void;    // 2026-09-20：当前解析函数的返回类型是 void（`return;` / `return e;` 的语义检查用）
  int ret_ptr;     // v1.5.0：当前解析函数返回的是指针（`return str([...]);` 的许可判据；与 ret_void 同处赋值）
  int loopdepth;   // 2026-09-21（卡 T-20260921-194703）：当前循环嵌套深度（`break`/`continue` 只能出现在循环里）
  // ===== 2026-09-21（卡 T-20260921-194703）：**顶层全局变量**表（口径见下方 g_* 一节）=====
  int *gpos;       // 名字 token 位置（源码缓冲）
  int *glen;       // 名字长度
  int *gty;        // 类型：0=int 标量 1=char 标量 2=int 数组 3=char 数组
  int *gn;         // 数组元素数 / 字节数（标量 = 1）
  int *gval;       // 常量初值（只看 ghas：0 也是合法初值）
  int *ghas;       // 1 = 有常量初值
  int *gdoff;      // 产物 `.data` 内字节偏移（解析期顺序分配）
  int nglobals;
  int gcur;        // `.data` 游标（已用字节数）
  int data_size;   // `.data` 总字节数（**0 = 无全局 ⇒ 产物形态不变**，真 flint 的 TWO_SEC 同口径）
  // ===== v2.1.0（2026-11-01）：enum 具名整数常量表（口径 = src\parse.c 的 EnumConst）=====
  //   ⚠️ FLINT 的全局不能是 struct/指针、struct 里也不能嵌数组 ⇒ **表体**放 parse_program 的
  //   局部 int 数组（它自己接好这两根指针），调用方 b1_emit / b1_parse **不用分配**新缓冲；
  //   代价 = 只需要在 struct 里加指针与计数（字段数 51 → 54，离 128 上限还很远）。
  //   ⚠️ 存的是**声明处的 token 下标**（不是源码字节偏移）：名字比较走 ps[]/ls[]（与 g_find 同纪律、
  //   名字不拷贝），同一个下标还兼作「声明在源码里的先后」—— 真 flint 是按源码序登记常量的，
  //   这条判据要在 parse_primary 里补回来（见那里的 -276）。
  int *etok;       // 常量名的 token 下标（名字在 ps[etok[k]]..+ls[etok[k]]）
  int *eval;       // 常量整数值（parse 期就折成字面量 ⇒ 发射端零改动）
  int necons;      // 已登记常量个数（声明序）
}

int new_node(struct Ast *a, int kind, int l, int r) {
  int *kd = a->kind;
  int *ll = a->l;
  int *rr = a->r;
  int *ty = a->ty;
  int idx = a->cnt;
  kd[idx] = kind;
  ll[idx] = l;
  rr[idx] = r;
  ty[idx] = 0;
  a->cnt = a->cnt + 1;
  return idx;
}

// 标记节点为指针值（64 位读写）
int set_ptr(struct Ast *a, int idx) {
  int *ty = a->ty;
  ty[idx] = 1;
  return idx;
}

// —— B2j：节点类型细分（ty 0=int 1=地址·elem int(4B) 2=地址·elem char(1B) 3=地址·elem 指针/struct(8B)）——
// 目的：`*q` 解引用要按「被指对象的宽度」读写；>=1 一律是地址类（64 位语义）
int set_ty(struct Ast *a, int idx, int t) {
  int *ty = a->ty;
  ty[idx] = t;
  return idx;
}
// 地址链结果类型：取地址操作数的 elem 类型（两侧都地址 → 通用 1）
int addr_ty(int tl, int tr) {
  if (tl >= 1 && tr >= 1) { return 1; }
  if (tl >= 1) { return tl; }
  if (tr >= 1) { return tr; }
  return 0;
}
// 字段类型（0=int 1=int* 2=char* 3=struct* 4=char 标量）→ 该字段值作表达式时的节点类型
int fld_ty(int fty) {
  if (fty == 2) { return 2; }        // char* 字段读回 = char 地址
  if (fty == 3) { return 3; }        // struct* 字段 = 指针/struct 地址
  if (fty == 5) { return 3; }        // v2.4：嵌套 struct 值字段 = struct 地址（8 字节地址类；读值请走链）
  if (fty == 4) { return 0; }        // B2k：char 标量字段读回 = int 值（走专用节点 55/57）
  return 1;                          // int* 字段 = 通用地址
}
// 字段类型 → 取该字段地址时的节点类型（&字段 指向该字段本身）
int fld_addr_ty(int fty) {
  if (fty == 0) { return 1; }        // &int 字段 → int*
  if (fty == 4) { return 2; }        // B2k：&char 字段 → char*（1 字节）
  return 3;                          // &指针字段 → 指向指针槽（8 字节）
}
// B2j：字段节点 val 编码 = 字段序号*1000 + 字节偏移
//   机器（codegen）要字节偏移做 disp；解释器（b1_parse 自测）要字段序号做「一字段一槽」映射
int fld_code(struct Parse *p, int sid, int f) {
  int j = (f - st_fbase(p, sid)) / 5;
  return j * 1000 + st_fld(p, f, 3);
}
// 变量类型规格 → 取址节点类型（&x）
int var_addr_ty(int vty) {
  if (vty == 4) { return 2; }        // char 数组 → char*
  if (vty == 5) { return 2; }        // char 标量 → char*
  if (vty == 2) { return 3; }        // 指针变量 → 指向指针槽
  if (vty == 3) { return 3; }        // struct 变量 → struct*
  return 1;                          // int / int 数组
}

// —— B2g：函数表打包辅助（fpty = dll*10000 + api*1000 + retptr*100 + 形参指针掩码）——
// v1.4.27（卡 T-20261012-210751）：低两位现在是 **16（形参已知标志）+ 前 4 个形参指针位**（见
//   parse_program 的写入点）⇒ `fn_mask` 只取**指针位**（低 4 位），旧语义（≤15 时的低两位）逐字不变。
//   ⚠️ 必须这样定义：`fn_mask` 还有第二个消费者 —— try_inline_call 的资格门
//   `if (fn_mask(fpt[fi]) != 0) { return 0; }`（形参里有指针就不内联）。若让标志位漏进 fn_mask，
//   那个门会**恒真** ⇒ boot 的单实参内联整条被关掉、产物全变（本轮实测差点踩中）。
int fn_mask(int x) { return x % 16; }
int fn_retptr(int x) { return x / 100 - x / 1000 * 10; }
int fn_api(int x) { return x / 1000 - x / 10000 * 10; }
int fn_dll(int x) { return x / 10000; }
// 2026-09-20（卡 T-20260920-001345）：返回类型码 5 = void（parse_rettype 认 `void`）。
//   ⚠️ FLINT **没有函数前向引用**（`使用了未声明的变量`），所有 helper 必须定义在第一个调用点之前。
int fn_is_void(struct Parse *p, int fi) { return fn_retptr(p->fpty[fi]) == 5; }
int void_call_at(struct Parse *p, struct Ast *a, int e) {
  int *kd = a->kind;
  if (e < 0) { return 0; }
  if (kd[e] != 10) { return 0; }                    // 10 = 调用
  return fn_is_void(p, a->val[e]);
}
// —— 递归走表达式树找「当值用的 void 调用」——
// ⚠️⚠️ 2026-09-20 实测踩坑（这里的坑最多，改之前务必读完）：
//   ① FLINT 里**没被赋值的子节点下标是 0，不是 -1**（`new_node` 只写调用方传入的 l/r，
//      而字面量节点传的就是 0）⇒ 「叶子 → l[0] = 0 → 又是自己」构成**自环**。
//   ② 自环 + 「左右都走」的朴素递归 = **指数级**遍历：实测 100% CPU 空转 14+ 分钟、无任何输出、
//      无产物（差分门被它整道卡死）。**深度上限挡不住它**（宽度爆炸，不是深度爆炸）。
//   ③ 第一版对策用了「全局访问预算 cv_budget」——**错的**：FLINT **没有全局变量**，
//      `int cv_budget = 0;` 这种顶层变量会被当"函数定义起点"，直接让 boot **编不了自身**
//      （实测自举不动点破裂：解析到那一行报 -82）。⇒ 预算只能靠**参数**在调用链上传。
//   ④ 最终形态 = **(a) 深度上限 24**（真实表达式深度个位数）+ **(b) 自环剪枝**（子 == 自己就跳过）
//      + **(c) 访问计数用参数往下传**（budget 递减，≤0 就停）。三者缺一都会重现挂死或爆栈。
// 返回 0 = 没问题；-200 = 找到「当值用的 void 调用」（新码）
int check_void_value_rec(struct Parse *p, struct Ast *a, int e, int db) {
  // FLINT 函数参数上限 4 ⇒ depth 与 budget 挤进一个 int：db = depth * 100000 + budget
  int depth = db / 100000;
  int budget = db - depth * 100000;
  if (e < 0) { return 0; }
  // ⚠️ 2026-10-17（int=4 字节 ABI 同步）：**必须挡掉「不是节点下标」的字段**。
  //   kind 23/39（本地数组元素）的 l = **基址槽号**、kind 28/37（指针元素）的 l = **指针槽号**、
  //   kind 30/32/55/57（字段）的 l = **struct 基址槽号** —— 这些数字是槽，不是节点下标。
  //   旧代码「左右都走」⇒ 槽号被当节点下标递归（`int a[100]` 的槽号 99 → kd[99] 是栈上残留）
  //   ⇒ 读到野 kind/l/r 链 ⇒ 0xC0000005（实测 b1_parse 自测第 38 项：int a[100] + 读 a[i] 必崩）。
  //   节点下标的合法域恒为 [0, cnt)（new_node 是单调追加）⇒ 越界一律当叶子，不深挖。
  if (e >= a->cnt) { return 0; }
  if (depth > 24) { return 0; }                     // 深度上限
  if (budget <= 0) { return 0; }                    // 访问量上限（宽度爆炸兜底）
  budget = budget - 1;
  int *kd = a->kind;
  int *ll = a->l;
  int *rr = a->r;
  int k = kd[e];
  // 自环剪枝：字面量节点的 l/r 是 0（不是 -1），而节点 0 常常就是它自己 ⇒ 必须显式跳过
  int cl = ll[e];
  int cr = rr[e];
  int go_l = 1;
  int go_r = 1;
  if (cl < 0 || cl == e) { go_l = 0; }
  if (cr < 0 || cr == e) { go_r = 0; }
  if (k == 10) {
    if (fn_is_void(p, a->val[e]) != 0) { return -200; }
    int b = ll[e];
    int n = rr[e];
    int j = 0;
    while (j < n) {
      int v = check_void_value_rec(p, a, a->args[b + j], (depth + 1) * 100000 + budget);
      if (v < 0) { return v; }
      j = j + 1;
    }
    return 0;
  }
  if (k == 60) { return 0; }       // 复合赋值：右值只是运算数，不是独立值位（不深挖）
  if (k == 66) { return 0; }       // 简单赋值表达式：同上
  if (go_l != 0) {
    int v1 = check_void_value_rec(p, a, cl, (depth + 1) * 100000 + budget);
    if (v1 < 0) { return v1; }
  }
  if (go_r != 0) {
    return check_void_value_rec(p, a, cr, (depth + 1) * 100000 + budget);
  }
  return 0;
}
// 值位入口：`v();` 这种「表达式语句的根就是 void 调用」放行（实参仍要查）
int check_void_value(struct Parse *p, struct Ast *a, int e) {
  if (e < 0) { return 0; }
  if (void_call_at(p, a, e) != 0) {
    int b = a->l[e];
    int n = a->r[e];
    int j = 0;
    while (j < n) {
      int v = check_void_value_rec(p, a, a->args[b + j], 100000 + 4096);
      if (v < 0) { return v; }
      j = j + 1;
    }
    return 0;
  }
  return check_void_value_rec(p, a, e, 100000 + 4096);
}

// —— B2l：own/share 托管标注（指针 aux 编码：+10 = own，+20 = share；基值 = 元素类型）——
int mg_kind(int aux) { if (aux >= 20) { return 2; } if (aux >= 10) { return 1; } return 0; }
int mg_base(int aux) { if (aux >= 20) { return aux - 20; } if (aux >= 10) { return aux - 10; } return aux; }

// —— B2f：类型规格（vsp[k] = ty*100000000 + aux*1000000 + sid*1000 + n）——
// ⚠️ 2026-09-21（卡 T-20260921-194703，真实应用第三处硬缺口）：**数组长度只占低 3 位 ⇒ n ≥ 1000 的数组被静默少分配**
//   旧实现 `spec_n = s - s/1000*1000` 只取低 3 位十进制：`char out[4096]` 得到 **96**、
//   `char big[2048]` 得到 **48** ⇒ **帧只按 n mod 1000 个槽算**，而数组元素的地址仍按真实下标算
//   ⇒ 越界写到帧外（实测 `fr_2048.exe`：帧 `sub $0x190,%rsp` 而 `big[2047]` 落在 `rbp+0x67F`）⇒
//   产物 `0xC0000005`，且**编译期毫无提示**。真实应用 `apps\m2_float` 里 `char hbuf[4096]` /
//   `char cfgbuf[2048]` / `char out[4096]` 全是这个坑（表现 = `std::file_read` 上层 `ERROR_NOACCESS(998)`
//   / 配置读不出来 / 静默栈破坏）。⇒ 判据：**"低位挪作他用"的打包编码，必须问一句"这一位真的够放吗"**；
//   数组没有 sid/aux（都恒为 0）⇒ 低位整段归 n（可放 n < 10^8），标量/struct/指针走原路径。
int spec_ty(int s) { return s / 100000000; }
int spec_aux(int s) { int t = s / 100000000; if (t == 6 || t == 8) { return 0; } return s / 1000000 - s / 100000000 * 100; }
//   ⚠️ 2026-11-01：ty=6 的位宽改了（sid 从 10^6 格挪到 **10^5** 格，T 占低 5 位）——
//      见下方「本地 struct 数组 = ty 6」注释里那段「旧编码撞进 ty=7」的记录。ty=8 不变。
int spec_sid(int s) { int t = s / 100000000; if (t == 1 || t == 4 || t == 8) { return 0; } if (t == 6) { return s / 100000 - 6000; } return s / 1000 - s / 1000000 * 1000; }
int spec_n(int s) { int t = s / 100000000; if (t == 1 || t == 4) { return s - s / 100000000 * 100000000; } if (t == 6) { return s - s / 100000 * 100000; } if (t == 8) { return s - s / 1000000 * 1000000; } return s - s / 1000 * 1000; }

// ===== v2.2.0（2026-11-01）：本地二维 int 数组 = ty 8 =====
//   编码 spec = 800000000 + cols*1000000 + T
//     T    = **元素总数** = 行 × 列（落在低 6 位十进制；ty 6 的 T 占低 5 位，见下）
//     cols = 列数（第二维 / stride），占 10^6 那一格 ⇒ **只能两位十进制（1..99）**。
//   ⚠️ 为什么用 ty **8** 而不是 7：ty 6（struct 数组）**旧**编码是 `600000000 + sid*10^6 + T`，
//      sid 上限 128（st_add 的守卫）⇒ **sid ≥ 100 时 spec 就进到 7*10^8..**，
//      用 7 会与「struct 数 ≥ 100 的 struct 数组」正面撞车（那是旧编码的算术事实，不是本轮引入的；
//      见下方 ty 6 注释：2026-11-01 已把 sid 段挪到 10^5，旧编码实测在 sid=100 时把 ty 读成 7）。
//      8*10^8 在 ty 6 的最大值（612,899,999）之上 ⇒ 两边不可能互踩。
//   `m[i][j]` 在解析期折成 `m[i*cols + j]`（节点 3 乘 + 节点 1 加 + 既有节点 23/24 下标读/写）
//   ⇒ **发射侧一个分支都不加**（D11 摊平）。行数不进编码：由 T/cols 反算。
//   ⚠️ 容量断点（boot 比真 flint 窄的两条，都不是语法断点）：
//      · T ≤ 99999（与 struct 数组同一条理由：帧槽偏移编码 `2000000+off` 要求槽数 ≤ 124999，
//        取 99999 留余量）⇒ 超限报 -241；
//      · cols ≤ 99（编码格只有两位）⇒ 超限同样报 -241（绝不静默换出别的 ty）。
//      真 flint 只受 2GB 帧上限约束；32×17 = 544 远在门内。

// ===== v2.1.0（2026-10-24，最后一个自举缺口 -240 收口）：本地 struct 数组 = ty 6 =====
//   编码 spec = 600000000 + sid*100000 + T
//     T = **总槽数** = st_nslots(sid) * N —— 落在低 **5** 位十进制（0..99999，见下方上限）。
//     sid = 结构体下标（st_add 守卫 ≤ 127），占 10^5 那一格。
//     最大值 = 600000000 + 127*100000 + 99999 = **612,899,999 < 7*10^8** ⇒ 永不漂进 ty=7 区段。
//   ⚠️ 2026-11-01（本刀）：**旧编码 `600000000 + sid*1000000 + T` 会撞进 ty=7**，旧注释「sid ≤ 127
//      ⇒ 127*10^6 + T < 7.3*10^8，撞不到 ty=7」**算错了两次**：① ty 判定是 `s / 10^8`（只取最高位），
//      7.3*10^8 早就 ≥ 7*10^8；② sid ≥ 100 时 `600000000 + 100*10^6 = 7*10^8` 把最高位顶成 7。
//      实测（boot\samples\spec6_sid100.fl，101 个 struct、`struct S100 arr[4];`）：
//      旧 boot 报 `parse err=-54 ... arr[i].a`（spec 被当 ty=7，落不进 ty==3 的 struct 数组分支），
//      而同一份源在 sid=99（spec 699,000,008，仍是 ty=6）下双端都跑 42 ⇒ 断点正是 10^8 进位。
//      改法 = sid 段 `*10^6` → `*10^5`（T 上限 99999 恰好占满低 5 位，两段不重叠）；
//      三个解码器 spec_sid / spec_n / spec_aux 对 ty=6 用新位宽（spec_aux 恒 0 不变）。
//      **不许**动 ty=7 / ty=8 的段位（8 = 二维数组，见上一节；7 不是任何 spec）。
//   历史（2026-10-24 容量第三刀）：**T 的上限 999 → 99999**。原来 T 挤在低 3 位（与 spec_n 共用「低 3 位」
//      这套旧口径），于是 `struct P a[100]`（P 有 10 个槽）就 1000 槽爆 -241 —— 真实用量轻松超过。
//      改法 = ty=6 **自己一段十进制位**，三个解码器对 ty=6 各自特判（见上面三行），
//      不再借「低 3 位」的旧假设。sid 同步从 10^3 挪到 10^6（2026-11-01 再挪到 10^5），两者互不踩。
//   ⚠️ 为什么上限是 **99999** 而不是 999999：帧槽偏移的编码是 `2000000 + off`（off = (槽+1)*8，
//      见 b1_emit.fl 的值带说明），off 必须 < 10^6 ⇒ 槽数 ≤ 124999。取 99999 留足余量，
//      再往上要先改帧槽偏移的编码带（那是另一刀）。真 flint 只受 2GB 帧上限约束。超限报 -241
//      （见 declare_sarr）—— 绝不静默少分配（那会写穿帧，见 2026-09-22 的 sarp1 事故）。
//   ⚠️ 元素个数 N **不进编码**：N = T / st_nslots(sid) 可反算，而所有使用方要的都是 T（帧槽数）或
//      步长（= nslots*8），没有一处需要 N。这是刻意的：编码里多塞一个 N 就会与 sid/T 的十进制位互踩
//      —— 本轮实测踩过：曾按 `sid*100000 + N*1000 + T` 编，N ≥ 100（如 struct P a[600]）时
//      N*1000 进位到 10^5 位，把 sid 读成 6 ⇒ `a[599].n` 报 -152「无此字段」。

// ===== v1.4.31（卡 T-20260918-014653）：指针目标值门槛（口径见文件头注释）=====
// 按相对槽回查「装地址的 int」标记；作用域标记（vls==0 的空名项）跳过，只扫当前函数段。
int slot_addr_mark(struct Parse *p, int slot) {
  int *vad = p->vad;
  int *vls = p->vls;
  int *vslots = p->vslots;
  int k = p->nvars - 1;
  int found = 0;
  int done = 0;
  while (k >= p->vbase && done == 0) {
    if (vls[k] != 0 && vslots[k] - p->sbase == slot) { found = vad[k]; done = 1; }
    k = k - 1;
  }
  return found;
}
int set_addr_mark(struct Parse *p, int slot) {
  int *vad = p->vad;
  int *vls = p->vls;
  int *vslots = p->vslots;
  int k = p->nvars - 1;
  int done = 0;
  while (k >= p->vbase && done == 0) {
    if (vls[k] != 0 && vslots[k] - p->sbase == slot) { vad[k] = 1; done = 1; }
    k = k - 1;
  }
  return 1;
}
// ===== 2026-10-18（task 2b / rev4）：T1「装地址的 int」→ **节点**标记 =====
//   真 flint 侧：codegen 的 ai_pass 定点算出「装过地址的 int 槽」（slot_marked），随后
//     ① 这种槽的**读**一律 8 字节读；② 存一律 8 字节写（普通 int 值先 movsxd 再写满）。
//   boot 侧解析期已有同一份粘性标记 vad[]（set_addr_mark 落的）⇒ 解析时顺手把标记落到**节点**上：
//     · 变量读节点（k==6）+ 该槽已标记 → 8 字节读
//     · 赋值/声明+初始化节点（k==7/8）+ 目标槽已标记 → 8 字节写
//   发射端只查表（与第四刀提升计划同一分工：解析层算、发射层认）。
//   ⚠️ 标记怎么活过 plan_regs：pmark 是「节点被引用」表（0/1），plan_regs 会**清一遍自己的区间**；
//      T1 用**值 2**，plan_regs 的清区间循环与 mark_field 都**不动 2**（见那两处注释）⇒ 与提升计划零交叉。
//   为什么要落在节点上而不是留在变量表：**函数体退出时 p->nvars 会被回退到 vbase**
//      （见 parse_stmt_block 的 `p->nvars = fmark`）⇒ 解析末尾按变量表扫是**扫不到任何局部量**的。
int t1_mark_store(struct Parse *p, int idx, int slot) {
  if (slot_addr_mark(p, slot) == 1) { p->pmark[idx] = 2; }
  return idx;
}
// 10=调用算不算「地址值」——自产函数与 API 调用**两套口径**（v1.4.28 第三刀；根因见下）：
//   · 自产函数：`rt ∈ {1,2,3}`（int*/char*/struct* 返回）才算地址 —— 与真 flint 的
//     `is_addr_value/is_addr_expr` 的 `ND_CALL: n->ty == TY_PTR` 逐条对应。
//     ⚠️ **不能写成 `fn_retptr != 0`**：retptr 位还有 **4 = char 值返回**、**5 = void**（见 parse_rettype 的口径），
//        4/5 都不是地址（真 flint 的 `char f()` 调用 ty=TY_CHAR）。（走到本函数时 `ty[e]` 必为 0 ——
//        地址类返回的调用在 `rhs_addr_like` 的 `ty[e] != 0` 那一行就被吃掉了 ⇒ 这里只是**明写**这条不变量。）
//   · API 调用：真 flint 在**两处**用了**两种宽严**，必须分开（这是本函数 `allow_api` 的唯一理由）：
//       ① `is_addr_value/is_addr_expr`：`ND_APICALL: n->ty == TY_PTR` ⇒ **只有声明成 `ptr` 的 API**
//          才算地址类（回答"这个值是不是 64 位地址"）；
//       ② `check_ptr_target`（指针目标值门槛）：`if (rhs->kind == ND_APICALL) return;` ⇒ **任何 API
//          返回值**都放行（句柄兼容路径，SPEC 决策 17）。
//   ⇒ `allow_api` 是这两套口径的开关，**由调用方的 `allow_num` 决定**（见 rhs_addr_like 的注释：
//      8 个调用点构成一个精确划分 —— allow_num=1 的 5 个全是指针目标门槛（要 ②），
//      allow_num=0 的 3 个全是「打装过地址标记」（要 ①））。
//   ⚠️ 2026-10-12 第三刀根因（卡 T-20261012-210751，`test\verify-all.ps1` 的 `loop` 红）：
//      旧版这里**不区分两套口径**、一律 `if (fn_api(...) == 1) { return 1; }` ⇒ `nn = recv(...)`
//      （`api ws2_32 int recv`，**int 返回**，lib\http_lib.fl:111）被当成「地址进了 int 槽」记进
//      粘性标记表 `vad`（写入点 L2405/L2915/L3505）⇒ 后面 `http_sb(hb->b, nn, 0)`
//      （第 2 形参是 int，lib\http_lib.fl:132）被 `-212` **误报**；真 flint 同一条判据不报
//      （它按 `n->ty == TY_PTR` 看 API 返回值）⇒ 双端分叉、boot 编不过 app。**不是放宽判据**：
//      标记的宽严回到真 flint 的 ①，而指针目标门槛照旧吃 ②（`f(0)` / `int *p = SomeApi();` 仍放行）。
int call_addr_like(struct Parse *p, struct Ast *a, int e, int allow_api) {
  int *fv = a->val;
  int *fpty = p->fpty;
  int fi = fv[e];
  int rt = fn_retptr(fpty[fi]);
  if (rt >= 1 && rt <= 3) { return 1; }
  if (allow_api == 1 && fn_api(fpty[fi]) == 1) { return 1; }
  return 0;
}
// 右值算不算「地址值」：allow_num=1 时把显式常量（0=num）也算进来（对齐真 flint 的 ND_NUM 放行）
//   用途①（allow_num=1）= 指针目标的门槛；用途②（allow_num=0）= 认「这个值算不算地址」（标记用）
//   ⚠️ 同一个 allow_num 也是 `call_addr_like` 的 API 宽严开关（**不是巧合**：这两套用途与真 flint 的
//      `check_ptr_target` / `is_addr_value` 正好一一对应，8 个调用点无一例外 —— 见上面的根因注释）。
int rhs_addr_like(struct Parse *p, struct Ast *a, int e, int allow_num) {
  int *ty = a->ty;
  int *kd = a->kind;
  if (e < 0) { return 1; }                          // 解析已失败（另有报错出口）
  if (ty[e] != 0) { return 1; }                     // 地址类：取址 / 字符串 / 数组名 / 指针变量 / 地址链
  if (kd[e] == 0) { return allow_num; }             // 0=num 整数字面量
  if (kd[e] == 10) { return call_addr_like(p, a, e, allow_num); }
  if (kd[e] == 62) { return 1; }                    // 62=new（结果是地址）
  if (kd[e] == 6) { return slot_addr_mark(p, a->val[e]); }   // 6=变量读(val=相对槽)
  return 0;
}

// 当前 token 位置起是不是「**变量名紧跟复合赋值运算符**」（`a += 3` / `a++` 这类）？
//   2026-09-20：给 return 那条窄路当前置判据。判据必须**很紧**：
//   · 第 1 个 token 必须是标识符（ks==1）
//   · 第 2、3 个 token 必须紧跟着就是运算符（ks==3）
//   否则 `return setp(&v, 40, 2) + v.x + v.y;` 这种会被误判（`(`+`&` 也满足"两个符号"）
//   —— 本轮实测：判据放松时自举解释器自测第 45 项直接挂掉（r=200）。
//   1 = 是；0 = 不是。
int tok2_compound_ahead(struct Parse *p) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i + 1;                                   // 跳过变量名
  if (i + 2 >= p->n) { return 0; }
  if (ks[i] != 3 || ks[i + 1] != 3) { return 0; }
  if (ks[i + 2] == 0) { return 0; }                   // 运算符后面必须还跟着东西（不能是 ';' / ')' 结尾）
  int c1 = vs[i];
  int c2 = vs[i + 1];
  if (c2 == '=') {
    if (c1 == '+' || c1 == '-' || c1 == '*' || c1 == '/' || c1 == '%'
        || c1 == '&' || c1 == '|' || c1 == '^') { return 1; }
  }
  if (c1 == '+' && c2 == '+') { return 1; }
  if (c1 == '-' && c2 == '-') { return 1; }
  if (i + 3 < p->n && ks[i + 2] == 3 && ks[i + 3] != 0) {
    int c3 = vs[i + 2];
    if (c1 == '<' && c2 == '<' && c3 == '=') { return 1; }
    if (c1 == '>' && c2 == '>' && c3 == '=') { return 1; }
  }
  return 0;
}

// 当前 token 是符号 c？
int tok_is(struct Parse *p, int c) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i;
  if (i >= p->n) return 0;
  return ks[i] == 3 && vs[i] == c;
}
// 当前两 token 是否 c1 c2（== != <= >= && ||）
int tok2_is(struct Parse *p, int c1, int c2) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i;
  if (i + 1 >= p->n) return 0;
  return ks[i] == 3 && vs[i] == c1 && ks[i + 1] == 3 && vs[i + 1] == c2;
}
// 第 i 个 token 是标识符且文本 == kw？
int tok_ident_at(struct Parse *p, int i, char *kw) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  if (i >= p->n) return 0;
  if (ks[i] != 1) return 0;
  char *s = p->src;
  int pos = ps[i];
  int len = ls[i];
  int k = 0;
  while (kw[k] != 0) {
    if (k >= len) return 0;
    if (s[pos + k] != kw[k]) return 0;
    k = k + 1;
  }
  return k == len;
}
int tok_ident_eq(struct Parse *p, char *kw) {
  return tok_ident_at(p, p->i, kw);
}
int tok_is_num(struct Parse *p) {
  int *ks = p->ks;
  int i = p->i;
  return i < p->n && ks[i] == 2;
}
int tok_num_val(struct Parse *p) {
  int *vs = p->vs;
  return vs[p->i];
}

// —— 变量表（函数内相对槽；全局数组 + vbase/sbase 切片）——
// B2f：spec 见 spec_ty 注释（FLINT ≤4 参 → 打包成一个 int）
int declare_var_spec(struct Parse *p, int pos, int len, int spec) {
  int *vps = p->vps;
  int *vls = p->vls;
  int *vsp = p->vsp;
  int *vslots = p->vslots;
  char *s = p->src;
  int base = p->vbase;
  int sz = spec_n(spec);
  // B3a：作用域感知查重——从表尾往回扫，遇到「作用域标记」（vls[k]==0，parse_block 在嵌套块入口压入）即停；
  //   函数体顶层块不压标记 → 一路扫到 vbase（含形参）→ 形参与函数体顶层同名变量仍报错（对齐真 flint 实测）
  int k = p->nvars - 1;
  int stop = 0;
  while (k >= base && stop == 0) {
    if (vls[k] == 0) { stop = 1; }
    else {
      if (vls[k] == len) {
        int j = 0;
        int same = 1;
        while (j < len) {
          if (s[vps[k] + j] != s[pos + j]) { same = 0; }
          j = j + 1;
        }
        if (same != 0) return -1;
      }
      k = k - 1;
    }
  }
  if (p->nvars >= 16384) return -2;         // 变量表上限 **16384**（2026-09-21：512 → 16384 ——
                                            //   真实应用 apps\m2_float 在 512 处撞 -44；
                                            //   计数是**整个编译**的函数内变量总数，不是"每函数"）
  vps[p->nvars] = pos;
  vls[p->nvars] = len;
  vsp[p->nvars] = spec;
  vslots[p->nvars] = p->nslots;
  p->vad[p->nvars] = 0;                     // v1.4.31：新变量默认「没装过地址」
  p->nslots = p->nslots + sz;
  if (p->nslots > p->maxslots) { p->maxslots = p->nslots; }
  p->nvars = p->nvars + 1;
  return vslots[p->nvars - 1] - p->sbase;
}

// ===== 2026-09-21（卡 T-20260921-232138 第四刀 A1）：局部 int 标量「进寄存器」资格计划 =====
// 判据三条，全部**同源**于解析层自己的记录与节点（不另立一套口径）：
// 判据全部建在**节点**上（不查变量表 —— 实测教训：函数解析收尾时变量表已被块作用域回滚，
//   `p->nvars` 退回 `p->vbase` ⇒ 按变量表算永远是空的；见 parse_stmt_block 的 `p->nvars = fmark`）。
//   ① 候选 = **读写形态本身**：普通 int 标量的读恒为 kind 6（`vv` = 相对槽）、写恒为 7/8（`ll` = 槽）
//      ⇒ 数组/指针/结构体/char 的读写走别的 kind，**天然进不了候选**，不必再查类型表。
//   ② **形参也进池**（2026-09-22 第四刀 **A3-②**）：形参由序言写进帧槽 —— 本档让序言**写槽之后顺手把它
//      装进寄存器**（发射端 `em_preg_load32` + `preg_of`）⇒ 循环里不再每轮从帧里读一次"上界"这类形参。
//      ⚠️ 与内联器的关系：`try_inline_call` 内联时**形参叶子什么都不发**（值已经在 eax），既不读槽、
//         也不看本计划 ⇒ 两条路不冲突；形参被赋值（kind 7/8）与取址（kind 25）分别由 ① ③ 覆盖。
//      ⚠️ `nargs` 从此**不再用于筛候选**（形参与局部量一视同仁），保留参数只为不动调用点；
//         "char/指针形参" 天生不是 kind 6/7/8 候选，且被 ③ 的槽级排斥兜住。
//   ③ 排斥（**槽级**：任一处命中即整槽不提升）：
//      · kind 25 的 `vv`（取址 `lea rax,[rbp-off]`）—— `&x` ／ `x++` ／ `x--` ／ `x += e` ／
//        表达式位赋值（60/66）**一律经 lv_addr_from 造 kind 25**（本文件 1962-1965），一个都漏不掉；
//        而语句赋值走 `new_node(a, 7, slot, e2)`（本文件 3262）**不造地址节点** ⇒ 正常提升。
//      · 一切"别的带槽形态"引用的 `ll`/`vv`（数组/指针/结构体/char）—— 类型上本不该与 int 标量同槽，
//        留着当**保险**：块作用域会重用槽号，同槽的"邻居"可能正好是数组/指针变量。
// ⚠️ 位置：**解析期、发任何字节之前**定死（已入档教训 `位置只许发射前定死`：发射中途换位置必漏路径）。
// 排斥表：这些 kind 的 `ll` 是槽号（数组/指针/结构体/char 的读写与取址）
int preg_excl_ll(int k) {
  if (k == 23 || k == 24 || k == 28 || k == 29) { return 1; }
  if (k == 30 || k == 31 || k == 32 || k == 33) { return 1; }
  if (k == 35 || k == 36 || k == 37 || k == 38) { return 1; }
  if (k == 39 || k == 40 || k == 43) { return 1; }
  if (k == 51 || k == 52 || k == 55 || k == 56 || k == 57 || k == 58) { return 1; }
  return 0;
}
// 排斥表：这些 kind 的 `vv` 是槽号（取址 25 ／ 指针形参读 26 ／ char 标量读 42）
int preg_excl_vv(int k) {
  if (k == 25 || k == 26 || k == 42) { return 1; }
  return 0;
}
// "被引用"过近似标记：字段值落在本函数节点区间内就算引用过
//   为什么是**过近似**：多标只会让候选少提升几个（安全方向），标少了才会提升错。
int mark_field(int *mk, int n0, int nend, int v) {
  if (v >= n0) { if (v <= nend) { if (mk[v] != 2) { mk[v] = 1; } } }   // 值 2 = T1 标记，不许被"被引用"覆盖
  return 0;
}
// 该槽是否被排斥：① **活的** kind 25（真取址）② 其它带槽形态（数组/指针/结构体/char）任一处
//   ⚠️ ① 必须判活：解析器探测复合赋值时会先造 kind 25 再回退（`lv_compound` 探针），
//      那对节点（kind 6 读 + kind 25 取址）**作为孤儿留在 AST 里不被发射** ——
//      实测：`x = x + j;` 这种最普通的语句赋值也会留一对（探针打印 NODE 7/8、13/14）。
int preg_excluded(struct Parse *p, struct Ast *a, int slot) {
  int *kd = a->kind;
  int *ll = a->l;
  int *vv = a->val;
  int *mk = p->pmark;
  // 2026-10-18（task 2b / rev4）：T1「装地址的 int」槽**不进寄存器** ——
  //   它的语义是「槽里装完整 64 位地址、读一律 8 字节」；提升到 32 位寄存器（em_ld_reg/em_st_reg）
  //   会把高 32 位砍掉 ⇒ `char *q = s;` 立刻崩（rev4 的原症状）。
  // 真 flint 侧同一口径：SF_T1ADDR 槽不参与 slotmap 提升。
  //   ⚠️ 判据必须走**节点标记**（pmark 值 2），不能走 slot_addr_mark：本函数在 plan_regs 时刻
  //      已经过了函数体退出（`p->nvars` 回退到 vbase）⇒ 变量表里扫不到局部量。
  int i = p->pn0;
  while (i <= p->pnend) {
    int kt = kd[i];
    if (kt == 6 || kt == 7 || kt == 8) {
      int st = vv[i];
      if (kt != 6) { st = ll[i]; }
      if (st == slot) { if (mk[i] == 2) { return 1; } }
    }
    i = i + 1;
  }
  i = p->pn0;
  while (i <= p->pnend) {
    int k = kd[i];
    if (k == 25) {
      if (vv[i] == slot) { if (mk[i] == 1) { return 1; } }
    } else {
      if (preg_excl_vv(k) == 1) { if (vv[i] == slot) { return 1; } }
      if (preg_excl_ll(k) == 1) { if (ll[i] == slot) { return 1; } }
    }
    i = i + 1;
  }
  return 0;
}
int cand_has(int *cand, int n, int s) {
  int j = 0;
  while (j < n) {
    if (cand[j] == s) { return 1; }
    j = j + 1;
  }
  return 0;
}
int plan_regs(struct Parse *p, struct Ast *a, int fi, int nargs) {
  int *kd = a->kind;
  int *ll = a->l;
  int *rr = a->r;
  int *vv = a->val;
  int *mk = p->pmark;
  int *pn = p->preg_n;
  int *ps = p->preg_slot;
  pn[fi] = 0;
  int cand[8];                                        // 候选槽（临时；去重后逐个过排斥表）
  int nc = 0;
  int i = p->pn0;
  while (i <= p->pnend) { if (mk[i] != 2) { mk[i] = 0; } i = i + 1; }   // 清标记（只清本函数区间；值 2 = T1 标记，留着）
  i = p->pn0;
  while (i <= p->pnend) {                             // 过近似"被引用"标记（三个字段都当节点下标试）
    mark_field(mk, p->pn0, p->pnend, ll[i]);
    mark_field(mk, p->pn0, p->pnend, rr[i]);
    mark_field(mk, p->pn0, p->pnend, vv[i]);
    i = i + 1;
  }
  i = 0;                                              // 调用实参表里放的也是节点下标
  while (i < p->nargs) {
    mark_field(mk, p->pn0, p->pnend, p->args[i]);
    i = i + 1;
  }
  i = p->pn0;
  while (i <= p->pnend) {
    int k = kd[i];
    int s = -1;
    if (k == 6) { s = vv[i]; }                        // 变量读：槽在 vv
    else if (k == 7 || k == 8) { s = ll[i]; }         // 赋值 / 声明+初始化：槽在 ll
    if (s >= 0) {                                     // ② A3-②：形参（槽 0..nargs-1）与局部量一视同仁
      if (nc < 8) {
        if (cand_has(cand, nc, s) == 0) { cand[nc] = s; nc = nc + 1; }
      }
    }
    i = i + 1;
  }
  int j = 0;
  while (j < nc) {
    if (pn[fi] < 4) {                                 // 池 = rbx / r12 / r13 / r14（callee-saved）
      if (preg_excluded(p, a, cand[j]) == 0) {        // ③ 槽级排斥
        ps[fi * 4 + pn[fi]] = cand[j];
        pn[fi] = pn[fi] + 1;
      }
    }
    j = j + 1;
  }
  return 0;
}

int declare_int(struct Parse *p, int pos, int len) {
  return declare_var_spec(p, pos, len, 1);
}
int declare_arr(struct Parse *p, int pos, int len, int n) {
  return declare_var_spec(p, pos, len, 100000000 + n);
}
int declare_carr(struct Parse *p, int pos, int len, int n) {      // char 数组（n 字节，占 n 槽）
  return declare_var_spec(p, pos, len, 400000000 + n);
}
int declare_char(struct Parse *p, int pos, int len) {
  return declare_var_spec(p, pos, len, 500000000 + 1);
}
int declare_ptr(struct Parse *p, int pos, int len, int aspec) {     // aspec = aux*1000 + sid + 1
  int aux = aspec / 1000;
  int sid = aspec - aux * 1000 - 1;
  if (sid < 0) { sid = 0; }                     // 非 struct 指针：sid 归零
  return declare_var_spec(p, pos, len, 200000000 + aux * 1000000 + sid * 1000 + 1);
}
int declare_struct(struct Parse *p, int pos, int len, int sid) {
  return declare_var_spec(p, pos, len, 300000000 + sid * 1000 + st_nslots(p, sid));
}

// —— B2f：struct 表访问 ——
// sflat: [0]=个数 [1]=游标；表头 sid → 2+sid*4 = [pos, len, nfields, fbase]
//   字段项 f → [pos, len, fty(0=int 1=int* 2=char* 3=struct*), foff(字节), fsid]
int st_count(struct Parse *p) { int *sf = p->sflat; return sf[0]; }
int st_hdr(struct Parse *p, int sid, int k) { int *sf = p->sflat; return sf[2 + sid * 4 + k]; }
int st_nfields(struct Parse *p, int sid) { return st_hdr(p, sid, 2); }
int st_fbase(struct Parse *p, int sid) { return st_hdr(p, sid, 3); }
// ⚠️ B2k 结论：不能写成 `*(p->sflat + f + k)`——FLINT 裸指针 `+` 是**字节**步进（决策 40），
//   元素下标只有 `局部变量[i]` 才按 8 字节缩放；要解引用形式必须手写 `*(p->sflat + (f + k) * 8)`
int st_fld(struct Parse *p, int f, int k) { int *sf = p->sflat; return sf[f + k]; }
int st_fsid(struct Parse *p, int f) { return st_fld(p, f, 4); }   // v2.3：struct* 字段指向的结构体

int st_find(struct Parse *p, int pos, int len) {
  int *sf = p->sflat;
  char *s = p->src;
  int n = sf[0];
  int k = 0;
  while (k < n) {
    if (sf[2 + k * 4 + 1] == len) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[sf[2 + k * 4] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) return k;
    }
    k = k + 1;
  }
  return -1;
}

int st_find_field(struct Parse *p, int sid, int pos, int len) {
  int *sf = p->sflat;
  char *s = p->src;
  int base = st_fbase(p, sid);
  int nf = st_nfields(p, sid);
  int j = 0;
  while (j < nf) {
    int f = base + j * 5;
    if (sf[f + 1] == len) {
      int k = 0;
      int same = 1;
      while (k < len) {
        if (s[sf[f] + k] != s[pos + k]) { same = 0; }
        k = k + 1;
      }
      if (same != 0) return f;
    }
    j = j + 1;
  }
  return -1;
}

int st_add(struct Parse *p, int pos, int len) {
  int *sf = p->sflat;
  int sid = sf[0];
  // 2026-09-20（卡 T-20260920-203700 真实应用诊断）：**32 → 128** ——
  //   实测撞墙：boot 编真实应用 `apps\m2_float`（浮窗）时，合并流里 struct 共 **47 个**
  //   （app 自身 25 ＋ 库 `ui_lib` 17 / `http_lib` 4 / `io_lib` 1），超过旧上限 32 ⇒ **-146**。
  //   真 flint 侧**无此上限**（`src\parse.c` 的 `structs_cap` 从 8 起**翻倍扩容**）⇒ 这是纯
  //   **「boot 比真 flint 窄」**的上限断点。⚠️ 它属于**容量缺口**而不是语法缺口 ——
  //   差分门 217 个样本**全是小文件、一个都撞不到**，只有真实应用能撞出来（本轮实证）。
  //   配套：`sf[1]`（字段区起点）必须同步挪到 `2 + 128 * 4 = 514`（见 parse_program 的初始化）。
  if (sid >= 128) return -1;                   // struct 数上限（表头区 128 个）
  sf[2 + sid * 4] = pos;
  sf[2 + sid * 4 + 1] = len;
  sf[2 + sid * 4 + 2] = 0;
  sf[2 + sid * 4 + 3] = sf[1];
  sf[0] = sid + 1;
  return sid;
}

// —— B2j：真实 C 布局（对齐 SPEC v0.9.2 / 真 flint parse.c）——
//   int 字段 4 字节 / 对齐 4；指针·句柄字段 8 字节 / 对齐 8；offset 升序累加（基址 + off）
int st_falign(int fty) { if (fty == 0) { return 4; } if (fty == 4) { return 1; } return 8; }
int st_fsize(int fty) { if (fty == 0) { return 4; } if (fty == 4) { return 1; } return 8; }
// —— v2.4.0：struct 的**自身对齐** = max(直接字段对齐)（C 口径；与真 flint 的 StructDef.align 同源）——
//   为什么不能从字节大小反推：8 字节可能是「对齐 4 的 int+char 补齐」，也可能是「对齐 8 的指针」。
//   自递归（嵌套值字段取内层自己的对齐）；递归终止靠「内层必须已定义（-135）＋ 自嵌套值字段被
//   parse_structs 拒（-242）」——与真 flint 同一道闸，深度 = 嵌套层数。
int st_align_of(struct Parse *p, int sid) {
  int base = st_fbase(p, sid);
  int nf = st_nfields(p, sid);
  int ma = 1;
  int j = 0;
  while (j < nf) {
    int f = base + j * 5;
    int ft = st_fty(p, f);
    int al = 0;
    if (ft == 5) { al = st_align_of(p, st_fsid(p, f)); }
    else { al = st_falign(ft); }
    if (al > ma) { ma = al; }
    j = j + 1;
  }
  return ma;
}
// 布局游标：遍历已有字段累加（字段 ≤128，O(n²) 可接受，无需扩表头格式）
//   2026-09-20：字段项 [2] 现在 = **fty*1000 + 数组长度**（低三位长度、高位类型）——
//     数组占 长度 × 元素字节（int 元素 8 / char 元素 1），对齐仍按元素（真 flint parse.c:2138-2140 同口径）
//   ⚠️ 读 [2] 当类型用一律改 st_fty()（见下方 helper 注释）。
//   v2.4.0：fty==5（struct 值字段）= 按**内层自身对齐**落位、占**内层 size（按内层对齐取整）**——
//     与真 flint parse_structdef 的 `align_up(cur, in->align)` / `cur = off + in->size` 逐字节同口径。
int st_layout_cur(struct Parse *p, int sid) {
  int base = st_fbase(p, sid);
  int nf = st_nfields(p, sid);
  int cur = 0;
  int j = 0;
  while (j < nf) {
    int f = base + j * 5;
    int ft = st_fty(p, f);
    int fn2 = st_farr(p, f);
    if (ft == 5) {
      int isid = st_fsid(p, f);
      int ial = st_align_of(p, isid);
      int isz = st_layout_cur(p, isid);
      cur = (cur + ial - 1) / ial * ial;
      cur = cur + (isz + ial - 1) / ial * ial;
    } else {
      int al = st_falign(ft);
      cur = (cur + al - 1) / al * al;
      cur = cur + st_fsize(ft) * fn2;
    }
    j = j + 1;
  }
  return cur;
}

// —— 2026-09-22（卡 T-20260922-201154）：**局部 struct 变量要预留多少槽** ——
//   ⚠️ 两个"看着对"的算法都是错的，先看清发射端到底怎么编址：
//     · 字段基址（解析期）：`base_node = struct 基址槽 + 字段序号 - 字段字节偏移`（`fld_code` ＝ 序号*1000+偏移）
//     · 元素地址（发射期，`field_arr_addr`）：元素 i 的地址 = **base_node 地址 + 字段字节偏移 + i×步长**
//       （int/double 元素步长 8、char 元素步长 1）
//     ⇒ 合起来：元素 i 落在 `struct 基址(低槽, rbp-8*S) + 4+8i`（S = 该变量在槽表里的起始槽号），
//       即相对 rbp 的偏移 = -8S + 4 + 8i（S = 保留槽数）。
//     · 旧写法 `declare_struct(..., st_nfields(p,sid))`（字段**个数**）只留 2 槽 ⇒
//       `struct S { int n; int a[192]; }`（sarp1 实测）：帧 `sub $0x30,%rsp`、而 a[191] 落 rbp+1516
//       ⇒ **越过 rbp 写进调用者栈帧** ⇒ 12 次里崩 4~5 次（0xC0000005）；真 flint 帧 0x620、12/12 稳。
//     · 所以槽数要按「**字段跨度**」算：一个字段的跨度上界 = 字节偏移 + 元素宽 × 元素个数
//       （int 元素 8 / char 元素 1；标量 = 1 个元素），取所有字段的最大值再除以 8 向上取整。
//   ⚠️ 不能用 `st_layout_cur`（C 布局字节，那条只算 4 字节一个 int 字段）除以 8：
//       `4 + 8×192 = 1540` 才是真实跨度（真 flint 的帧 0x620 = 193 槽也正好覆盖它），
//       而 C 布局是 772 字节（97 槽）——**差距正是这次崩掉的那半个数组**。
//   判据（sarp1 双端）：帧 ≥ 0x620、产物 12/12 恒 18337 且与真 flint 一致；自举不动点仍成立。
int st_nslots(struct Parse *p, int sid) {
  int fbase = st_fbase(p, sid);
  int nf = st_nfields(p, sid);
  int maxspan = 1;                          // 至少 1 槽（空 struct 也不给 0）
  int j = 0;
  while (j < nf) {
    int f = fbase + j * 5;
    int ft = st_fty(p, f);
    int fn2 = st_farr(p, f);
    int span = st_fld(p, f, 3);             // 字段字节偏移
    if (ft == 5) { span = span + st_nslots(p, st_fsid(p, f)) * 8; }   // v2.4：嵌套值字段整块（内层槽数×8）
    else if (ft == 4) { span = span + fn2; }     // char 元素 1 字节
    else if (ft == 0) { span = span + fn2 * 4; }   // int 元素 4 字节（2026-10-17 int=4 ABI）
    else { span = span + fn2 * 8; }         // 指针 / struct* 元素 8 字节
    if (span > maxspan) { maxspan = span; }
    j = j + 1;
  }
  return (maxspan + 7) / 8;
}

// —— v2.1.0（缺口 -240 收口）：本地 struct 数组的登记 ——
//   总槽数 = 每元素槽数 × N（与真 flint `new_lvar` 的 `per * n` 同源；per = st_nslots）。
//   spec 编码见文件上方「本地 struct 数组 = ty 6」那一节：`600000000 + sid*100000 + 总槽数`。
//   返回相对槽号（= 保留区**最低**槽）；基址槽由使用方按 `+总槽数-1` 算成升序基址。
//   ⚠️ 容量守卫返回 -241（专用码，不是 -44）：这是 boot 的 spec 编码比真 flint 窄的地方，
//      必须响亮 —— 静默按 N 个槽分配会写穿帧（本仓 2026-09-22 的 sarp1 就是这一类）。
//      2026-10-24（容量第三刀）：上限 999 → **99999**（T 单独占低 5 位十进制；见上方长注释）。
int declare_sarr(struct Parse *p, int pos, int len, int sid, int n) {
  int per = st_nslots(p, sid);
  int t = per * n;
  if (t > 99999) { return -241; }
  return declare_var_spec(p, pos, len, 600000000 + sid * 100000 + t);
}

// fspec = fty*100000 + (fsid+1)*1000 + arr_len（fsid = -1 表示非 struct；arr_len ≥ 1）
//   ⚠️ 2026-09-20 实测踩坑（本轮最隐蔽的一个）：字段项 [2] 的语义改成了「fty*1000 + 数组长度」，
//   但 st_add_field 里仍写着 `sf[cur+2] = fty` —— 于是每个字段的"数组长度"都变成自己的类型码：
//   int 字段变成 1（看着像"长度 1"，碰巧对），**指针/struct* 字段（fty 1/2/3）变成 1/2/3** ——
//   `st_is_arr`（>1）就把 struct* 字段当成数组字段 ⇒ `p->x = a;` 报指针目标门槛 -198
//   （实测 zt3 / 自举解释器自测第 45 项直接挂）。改完记得全库把「读 [2] 当 fty」都换 st_fty()。
int st_add_field(struct Parse *p, int sid, int name, int fspec) {
  int *sf = p->sflat;
  int cur = sf[1];
  if (cur + 5 > 4096) return -1;              // 字段区上限 —— **与解析侧栈数组同尺寸**（`b1_parse.fl` /
                                              //   `samples\real2.fl` 的 `int sflat[4096]`）；旧写 16384 是
                                              //   空头支票（数组只有 1024 ⇒ 超过 102 个字段就静默越界写），
                                              //   2026-09-27 抬字段上限（64 → 128）时一并对齐
  int nf = sf[2 + sid * 4 + 2];
  int fty = fspec / 100000;                   // ← fty 从 fspec 拆回来
  int farr = fspec - fspec / 1000 * 1000;     // ← 数组长度（≥1）
  int fcur = st_layout_cur(p, sid);           // B2j：C 布局游标
  int fal = st_falign(fty);
  if (fty == 5) { fal = st_align_of(p, fspec / 1000 - fty * 100 - 1); }   // v2.4：按内层自身对齐落位
  fcur = (fcur + fal - 1) / fal * fal;
  sf[cur] = name / 1000;
  sf[cur + 1] = name - name / 1000 * 1000;
  sf[cur + 2] = fty * 1000 + farr;   // 字段项 [2] = 类型码*1000 + 数组长度（两者都留）
  sf[cur + 3] = fcur;            // 字段偏移（字节；地址 = struct 基址 + off，升序 C 布局）
  sf[cur + 4] = fspec / 1000 - fty * 100 - 1;
  sf[1] = cur + 5;
  sf[2 + sid * 4 + 2] = nf + 1;
  return nf;
}

// 返回表项下标（-1 = 未声明）——需要类型/槽号时用
// B3a：**从表尾往回扫**（内层优先）——同名遮蔽时取最近声明的那个；块退出时 nvars 回退，外层自动重现
int find_var_idx(struct Parse *p, int pos, int len) {
  int *vps = p->vps;
  int *vls = p->vls;
  char *s = p->src;
  int base = p->vbase;
  int k = p->nvars - 1;
  while (k >= base) {
    if (vls[k] == len) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[vps[k] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) return k;
    }
    k = k - 1;
  }
  return -1;
}

int find_var(struct Parse *p, int pos, int len) {
  int k = find_var_idx(p, pos, len);
  if (k < 0) return -1;
  int *vslots = p->vslots;
  return vslots[k] - p->sbase;
}

// —— B2l：托管（own/share）变量识别 ——
//   规格编码：spec = 2*1e8 + aux*1e6 + (声明它的函数下标 + 1)*1000 + 1（指针 n 恒 1）
//   → mg_kind(spec_aux) = 1/2 表示 own/share；spec_sid - 1 = 函数下标（发射期过滤本函数的托管变量）
int mg_var_kind(struct Parse *p, int k) {
  int *vsp = p->vsp;
  return mg_kind(spec_aux(vsp[k]));
}

// 表达式节点是否「托管指针变量读」（node 26；按槽号在当前函数变量表里回查）
int mg_node_kind(struct Parse *p, struct Ast *a, int idx) {
  if (idx < 0) { return 0; }
  int *kd = a->kind;
  if (kd[idx] != 26) { return 0; }
  int *vv = a->val;
  int slot = vv[idx];
  int *vslots = p->vslots;
  int k = p->vbase;
  while (k < p->nvars) {
    if (vslots[k] - p->sbase == slot) { return mg_var_kind(p, k); }
    k = k + 1;
  }
  return 0;
}

// ===== 2026-09-21（卡 T-20260921-194703）：**顶层全局变量** =====
// 口径（真 flint v1.3.0；勘明档案 = `tmp\global-recon.md`，交接要点见 `PROGRESS.md` 顶部）：
//   · 全局变量住在产物 `.data` 节，代码用 `[rip+disp32]` 指过去；**`.data` 只在存在全局变量时才建**
//     （真 flint 的 `TWO_SEC = (data_size > 0)`）⇒ **没有全局变量时产物形态逐字节不变**（自举不动点的硬约束）。
//   · 支持形态：int / char 标量与定长数组 ＋ 逗号声明表 ＋ 常量初值 ＋ 未初始化（= 0）；
//     **不支持指针类型的全局**（真 flint 直接拒，见 `记忆.md`「全局不能是指针」）。
//   · boot 侧宽度口径 = **本编译器自己的 int 口径**（8 字节槽 ＋ 4 字节读写），与函数内 int 变量一字不差；
//     「地址类值不进全局 int」是本仓既有纪律（`apps\m2_float\main.fl:697` 就写着这条）。
// 本节函数**只登记，不产 AST 也不产码**；产码在 `b1_emit.fl`：节点 67（全局取址 = `lea rax,[rip+disp32]`）
//   ＋ 复用既有 53（解引用读）/ 54（解引用写）/ 60（复合赋值）/ 1+3（元素地址链）—— 一条新发射路径都不加。
// 查找：全局表**不分作用域**，顺序恒为「先函数内、后全局」（局部遮蔽同名全局，与真 flint 同）。
int g_find(struct Parse *p, int pos, int len) {
  int *gp = p->gpos;
  int *gl = p->glen;
  char *s = p->src;
  int i = 0;
  while (i < p->nglobals) {
    if (gl[i] == len) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[gp[i] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) { return i; }
    }
    i = i + 1;
  }
  return -1;
}

// ============================================================================
// v2.1.0（2026-11-01）：enum 具名整数常量表 —— 与 src\parse.c 的 find_enum / add_enum_const 同口径
//   表体 = parse_program 的局部 int 数组（见 struct Parse 里 etok/eval/necons 的注释）。
//   名字**不拷贝**：元素的 token 下标 → ps[]/ls[] → 与源码缓冲逐字节比（与 g_find / find_func_at /
//   st_find 同一套纪律 —— 少一张字符串表，也不用碰字符串池的归属规则）。
//   查找顺序由**调用点**决定：局部变量 → 全局变量 → **枚举常量** → 函数
//   （与真 flint 的 parse_primary 逐条同序；常量只是字面量别名，不是变量、也不是函数）。
// ============================================================================
int enum_find(struct Parse *p, int pos, int len) {
  int *et = p->etok;
  int *ps = p->ps;
  int *ls = p->ls;
  char *s = p->src;
  int i = 0;
  while (i < p->necons) {
    int ti = et[i];
    if (ls[ti] == len) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[ps[ti] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) { return i; }
    }
    i = i + 1;
  }
  return -1;
}

int enum_val(struct Parse *p, int k) {
  int *ev = p->eval;
  return ev[k];
}

// 登记一个常量（tok = 常量名 token 下标）；返回下标，< 0 = 错误码（-272 = 表满）
int enum_add(struct Parse *p, int tok, int v) {
  int *et = p->etok;
  int *ev = p->eval;
  int k = p->necons;
  if (k >= enum_cap()) { return -272; }
  et[k] = tok;
  ev[k] = v;
  p->necons = k + 1;
  return k;
}

// 全局取址节点（kind 67，val = 全局下标）——机器侧 = `lea rax,[rip+disp32]`，disp32 在 build_pe 回填。
//   ty：int（标量 / 数组元素）= 1（4 字节 elem）｜char = 2（1 字节 elem）。
//   ⚠️ 这两个值与**本地** int / char 变量取址（kind 25）完全同款 —— 消费侧（53/54/60、地址链 1+3）
//      一个字都不用改，宽度/字节读写自然落对。
int g_addr_node(struct Parse *p, struct Ast *a, int gi) {
  int *gt = p->gty;
  int idx = new_node(a, 67, 0, 0);
  int *vv = a->val;
  vv[idx] = gi;
  if (gt[gi] == 1 || gt[gi] == 3) { return set_ty(a, idx, 2); }   // char 类
  return set_ty(a, idx, 1);                                        // int 类
}

// 全局数组元素**地址** = 首元素地址 + 下标 × 元素宽（int 4 字节 / char 1 字节）
//   （与 `lv_elem` 对本地数组的展开同构：节点 3 = 下标×宽，节点 1 = 基址+偏移）
int g_elem_addr(struct Parse *p, struct Ast *a, int gi, int iexpr) {
  int *gt = p->gty;
  int bs = g_addr_node(p, a, gi);
  int step = 4;                              // 2026-10-17 int=4 ABI：int 数组元素 4 字节
  if (gt[gi] == 3) { step = 1; }
  int sc = new_node(a, 0, 0, 0);
  int *vv = a->val;
  vv[sc] = step;
  int mul = new_node(a, 3, iexpr, sc);
  int ad = new_node(a, 1, bs, mul);
  return set_ty(a, ad, a->ty[bs]);
}

// 全局标量的**值读** = 取址 + 解引用读（节点 53，宽度随上面标的 ty）
int g_scalar_read(struct Parse *p, struct Ast *a, int gi) {
  return new_node(a, 53, g_addr_node(p, a, gi), 0);
}

// 登记一个全局（spec = 基础类型*1000000 + 是否数组*100000 + 元素数/字节数；**参数上限 4 必须打包**）
//   返回全局下标；< 0 = 错误码（-177 = 全局表上限）
int g_add(struct Parse *p, int pos, int len, int spec) {
  // v2.1.0：全局变量与**已登记**的枚举常量同名 = 硬错。真 flint 侧由 collect_globals **先扫**
  //   全局表，所以解析 enum 时就能看见"后面才写的"那个全局变量（报「枚举常量 'X' 与全局变量同名」）；
  //   boot 是按源码序登记的 ⇒ 必须在这里反向再挡一次，否则 `enum X { A }; int A;` 会变成
  //   「真 flint 拒、boot 静默收」的分岔（这类"只差顺序"的缺口最容易在差分门里漏网）。
  if (enum_find(p, pos, len) >= 0) { return -274; }
  int base = spec / 1000000;
  int isarr = spec / 100000 - base * 10;
  int n = spec - spec / 100000 * 100000;
  int gi = p->nglobals;
  if (gi >= 1024) { return -177; }                       // 全局表上限 1024（够 real app 用）
  int ty = base;                                         // 0=int 标量 1=char 标量
  if (isarr == 1) { ty = base + 2; }                     // 2=int 数组 3=char 数组
  int size = 8;
  if (ty == 1) { size = 1; }
  else if (ty == 2) { size = n * 4; }                    // 2026-10-17：int 数组元素 4 字节（与 src\parse.c 同口径）
  else if (ty == 3) { size = n; }
  int off = p->gcur;
  if (ty == 0) { off = (off + 7) / 8 * 8; }               // int 标量仍 8 字节槽
  else if (ty == 2) { off = (off + 3) / 4 * 4; }          // int 数组元素 4 字节对齐
  p->gpos[gi] = pos;
  p->glen[gi] = len;
  p->gty[gi] = ty;
  p->gn[gi] = n;
  p->gval[gi] = 0;
  p->ghas[gi] = 0;
  p->gdoff[gi] = off;
  p->nglobals = gi + 1;
  p->gcur = off + size;
  p->data_size = p->gcur;
  return gi;
}

// 记常量初值（0 也是合法初值 ⇒ 有无初值另用 ghas 标，别拿 0 当"没有"）
int g_setval(struct Parse *p, int gi, int val) {
  p->gval[gi] = val;
  p->ghas[gi] = 1;
  return 0;
}

// 全局变量的**表达式位**读法：`g`（标量读）｜`garr`（数组名 = 首元素地址）｜`garr[i]`（元素读）
//   调用前 p->i 指向名字 token；返回表达式节点（< 0 = 错误码，沿用本地同名形态的码）
int parse_global_ref(struct Parse *p, struct Ast *a, int gi) {
  int *gt = p->gty;
  p->i = p->i + 1;                                        // 吃名字
  if (tok_is(p, '[')) {
    if (gt[gi] == 0 || gt[gi] == 1) { return -13; }        // 标量不能下标
    p->i = p->i + 1;
    int e = parse_expr(p, a);
    if (e < 0) { return -14; }
    if (!tok_is(p, ']')) { return -15; }
    p->i = p->i + 1;
    return new_node(a, 53, g_elem_addr(p, a, gi, e), 0);   // 元素读 = 解引用读（宽度随 elem）
  }
  if (gt[gi] == 2 || gt[gi] == 3) { return g_addr_node(p, a, gi); }   // 数组名 = 首元素地址
  return g_scalar_read(p, a, gi);
}

// 全局变量的**语句位**赋值：`g = e;` ｜ `garr[i] = e;`
//   （复合赋值 / ++ / -- 不走这里：上游 parse_primary + lv_addr_from + lv_compound 已经接住，
//     因为节点 53 的 lv_addr_from 就是「返回它的地址操作数」——这正是选这条路的原因）
int parse_global_assign(struct Parse *p, struct Ast *a, int gi) {
  int *gt = p->gty;
  p->i = p->i + 1;                                        // 吃名字
  int ad = 0;
  if (tok_is(p, '[')) {
    if (gt[gi] == 0 || gt[gi] == 1) { return -13; }
    p->i = p->i + 1;
    int ix = parse_expr(p, a);
    if (ix < 0) { return -59; }
    if (!tok_is(p, ']')) { return -66; }
    p->i = p->i + 1;
    ad = g_elem_addr(p, a, gi, ix);
  } else {
    if (gt[gi] == 2 || gt[gi] == 3) { return -64; }        // 数组名整体赋值不支持
    ad = g_addr_node(p, a, gi);
  }
  if (!tok_is(p, '=')) { return -54; }
  p->i = p->i + 1;
  int e = parse_expr(p, a);
  if (e < 0) { return -55; }
  int idx = new_node(a, 54, ad, e);                       // 解引用写（宽度随地址 elem 类型）
  if (!tok_is(p, ';')) { return -57; }
  p->i = p->i + 1;
  return idx;
}

// —— 顶层声明解析：`int g = 1, h;` ｜ `char buf[64];` ｜ `int a[3], b;` ——
//   只登记 + 吃掉 token；返回 0（< 0 = 错误码）。**不产码**，所以没有 AST 节点。
//   ⚠️ 顶层分派的判据在 `parse_program`：`is_func_start_at` 为 0 的 int/char 开头项才进这里，
//      函数定义（含 void / struct*）一律仍走 `collect_funcs`。
int parse_globals(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int base = 0;
  if (tok_ident_eq(p, "int")) { p->i = p->i + 1; }
  else if (tok_ident_eq(p, "char")) { p->i = p->i + 1; base = 1; }
  else { return -183; }                                    // `double` 等：与 parse_rettype 同码
  int more = 1;
  while (more == 1) {
    if (p->i >= p->n || ks[p->i] != 1) { return -41; }
    if (tok_ident_eq(p, "int")) { return -42; }
    if (tok_ident_eq(p, "char")) { return -42; }
    if (tok_ident_eq(p, "struct")) { return -42; }
    int pos = ps[p->i];
    int len = ls[p->i];
    p->i = p->i + 1;
    if (tok_is(p, '*')) { return -175; }                   // 全局不支持指针类型（真 flint 同）
    if (tok_is(p, '[')) {                                  // —— 定长数组 ——
      p->i = p->i + 1;
      if (!tok_is_num(p)) { return -70; }
      int n = tok_num_val(p);
      if (n <= 0) { return -71; }
      p->i = p->i + 1;
      if (!tok_is(p, ']')) { return -72; }
      p->i = p->i + 1;
      if (tok_is(p, '=')) { return -73; }                  // 数组初始化暂不支持
      if (g_find(p, pos, len) >= 0) { return -178; }        // 重名全局
      int ia = g_add(p, pos, len, base * 1000000 + 100000 + n);
      if (ia < 0) { return ia; }
    } else {                                               // —— 标量 ——
      if (g_find(p, pos, len) >= 0) { return -178; }
      int is = g_add(p, pos, len, base * 1000000 + 1);
      if (is < 0) { return is; }
      if (tok_is(p, '=')) {
        p->i = p->i + 1;
        int neg = 0;
        if (tok_is(p, '-')) { neg = 1; p->i = p->i + 1; }
        if (!tok_is_num(p)) { return -174; }               // 初值只认字面量
        int val = tok_num_val(p);
        if (neg == 1) { val = 0 - val; }
        p->i = p->i + 1;
        // —— v1.4.28（B1-5）：初值后面**不许再留 token**（与真 flint 同口径，专码 -213）——
        //   真因：真 flint 的 `parse_global_init` 只吃**一个字面量**，随后由 `collect_globals`
        //   **静默跳到 ','/';'** ⇒ `int g = 0 - 1;` 编译 exit 0 而 **g == 0**（`- 1` 被吞）、
        //   `int g = 1 + x;` 连"初值必须是编译期常量"那道既有判据都绕过（x 是变量也照收）。
        //   真 flint 侧已按主 Agent 裁定改成**默认档硬错**（文案「全局变量初值只支持一个字面量
        //   （可带正负号）……」，位置指向那个多出来的 token）。
        //   boot 侧原来落到**通用 -47**（"期望 ';'"）—— 结论虽然相同，但错误码分不清"这就是全局
        //   初值的尾巴"；改用**专码 -213**（-199 之后、与 -211/-212 同族的第一个空位；boot 子集
        //   没有全局变量 ⇒ 单点常量做不到，照"boot 写死的口径一律拿探针复核"的纪律）。
        //   判据同源 = `test\边界探针.ps1` 的 global_init_expr / global_init_var / global_init_garbage
        //   ＋ `boot\samples\nb39.fl`（④ 负例 ＋ ④b 的"真 flint 侧同样拒绝"差分）。
        if (!tok_is(p, ',') && !tok_is(p, ';')) { return -213; }
        g_setval(p, is, val);
      }
    }
    if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
  }
  if (!tok_is(p, ';')) { return -47; }
  p->i = p->i + 1;
  return 0;
}

// ===== 2026-09-20（卡 T-20260920-001345）：struct 定长数组字段的表访问辅助 =====
// （void 那侧的 fn_is_void / check_void_value 定义在本文件上方，别重复定义）
// —— struct 数组字段（字段项第 3 项 = 数组长度；指针/struct* 字段恒为 1；不用 fsid 那一位）——
// —— 2026-09-20 口径统一（这一步踩过大坑，看仔细）：字段项 sf[f + k] 的含义是
//     [0]=名字位置  [1]=名字长度  [2]=**fty*1000 + 数组长度**  [3]=字节偏移  [4]=fsid
//   原来 [2] 存的是 fty 的副本；现在 [2] 低三位是数组长度（标量恒 1）、高位是 fty ——
//   两者都不丢，且字段区仍然是每项 5 个槽（表头区 2..129 / 字段区 130 起的布局没动）。
//   ⚠️ 后果：**任何"读 [2] 当 fty 用"的地方都必须改成 st_fty()**（实测漏一处就把 struct* 字段
//   当成数组字段，写字段时报 -198，自举解释器自测第 45 项直接挂）。
int st_farr(struct Parse *p, int f) { int v = st_fld(p, f, 2); return v - v / 1000 * 1000; }
int st_fty(struct Parse *p, int f) { return st_fld(p, f, 2) / 1000; }
int st_is_arr(struct Parse *p, int f) { return st_farr(p, f) > 1; }
// 下标步长按元素类型（int 元素 = 4 字节、char = 1 字节、指针/struct* = 8 字节）
// ⚠️ 元素类型码异常时不要瞎猜：一律退 8（宁可语义不符，也不能让步长变成 0/负数把地址算成自环）
int st_arr_step(int base_fty) { if (base_fty == 4) { return 1; } if (base_fty == 0) { return 4; } return 8; }
// 写回字段项的数组长度（建表时先按 1 存、解析到 `[n]` 再改写；st_add_field 已 4 参数不再加）
int st_set_farr(struct Parse *p, int sid, int idx, int n) {
  int *sf = p->sflat;
  int f = st_fbase(p, sid) + idx * 5;
  sf[f + 2] = n;
  return idx;
}
// 数组字段的元素地址 = 字段基址 + 下标 × 元素宽。⚠️ 不复用 field_sub_addr：那条路按 ty 定宽度，
//   而 `int buf[4]` 的元素地址要素是「地址类 + 8 字节步长」（ty=1 对 fld_ty 是 int* 的语义，不能混用）。
//   返回地址节点（ty = 元素类型码：int 数组 1 / char 数组 2）；<0 = 错误码
int field_arr_addr(struct Parse *p, struct Ast *a, int base, int base_fty) {
  p->i = p->i + 1;                            // 过 '['
  int e = parse_expr(p, a);
  if (e < 0) { return -14; }
  if (!tok_is(p, ']')) { return -15; }
  p->i = p->i + 1;
  int *vv = a->val;
  int sc = new_node(a, 0, 0, 0);
  vv[sc] = st_arr_step(base_fty);
  int mul = new_node(a, 3, e, sc);            // 下标 × 元素宽
  int ad = new_node(a, 1, base, mul);         // 字段基址 + 偏移（地址链走 64 位）
  int at = 1;
  if (base_fty == 4) { at = 2; }
  return set_ty(a, ad, at);
}
// —— v2.1.0（缺口 -240 收口）：struct 数组的元素地址 / 元素内字段地址 ——
//   只用**已有**节点拼（D11：零新增发射档、零 codegen 改动）：
//     元素 i 的地址 = kind 25（lea 基址槽）+ kind 3（下标 × 步长）+ kind 1（加）
//       · bslot  = 元素基址槽 = 保留区**最高**槽（帧槽升序基址；与 int/char 数组、struct 变量同口径）
//       · stride8 = 元素步长（字节）= 8*ceil(size/8) = st_nslots(sid)*8（与真 flint 的 8*per 同源）
//       · 结果 ty = 3（地址类）⇒ kind 53/54 的读写宽度、kind 1 的 64 位加法都自动走对分支
//     ⚠️ kind 3 的乘法在发射端是 **32 位 imul**（乘积再被父节点 kind 1 的地址链 movsxd）：
//        下标×步长 只要不超 int32 就够 —— 帧槽总长本来就被 2GB 上限挡在同一个界里。
//     ⚠️ 别拿 kind 23（本地 int 数组元素读）顶替：它的元素步长写死 4 字节、且带解引用；
//        这里要的是「地址」不是「值」，步长也随 struct 大小变。
int sarr_elem_addr(struct Ast *a, int bslot, int ix, int stride8) {
  int bs = new_node(a, 25, 0, 0);
  int *vv = a->val;
  vv[bs] = bslot;
  set_ty(a, bs, 1);
  int sc = new_node(a, 0, 0, 0);
  vv[sc] = stride8;
  int mul = new_node(a, 3, ix, sc);
  int ad = new_node(a, 1, bs, mul);
  return set_ty(a, ad, 3);
}
// —— 2026-10-24（v2.2）：struct 指针下标的元素地址 p[i]（p = struct S *）——
//   与 sarr_elem_addr 同形，只有**基址来源**不同：struct 数组的基址是帧槽地址（kind 25 lea），
//   struct 指针的基址是**指针变量的值**（kind 26 = 指针读，64 位）⇒ 再用 kind 3 乘步长、kind 1 加。
//   步长口径与 struct 数组**同一个式子**（st_nslots(sid)*8 = 8*ceil(size/8)）——
//   两处各算一套的话，同一个结构体会出现两种下标步长（真 flint 侧也按这条写）。
int sptr_elem_addr(struct Ast *a, int slot, int ix, int stride8) {
  int bp = new_node(a, 26, 0, 0);
  int *vv = a->val;
  vv[bp] = slot;
  set_ty(a, bp, 3);                       // 指针值 = 地址类（kind 1 的 64 位加法靠它）
  int sc = new_node(a, 0, 0, 0);
  vv[sc] = stride8;
  int mul = new_node(a, 3, ix, sc);
  int ad = new_node(a, 1, bp, mul);
  return set_ty(a, ad, 3);
}
// v2.3：**基址是节点**（不是变量槽）的元素地址 —— 链式下标 `s.next[i]` 用。
//   sptr_elem_addr 的 base 是「变量槽号」（它内部造 kind 26 读）；链上的基址是任意表达式节点，
//   传节点号进那个函数会被当成槽号 ⇒ 读出垃圾指针（实测 boot 编过但运行 0xC0000005）。
int elem_addr_node(struct Ast *a, int base, int ix, int stride8) {
  int *vv = a->val;
  int sc = new_node(a, 0, 0, 0);
  vv[sc] = stride8;
  int mul = new_node(a, 3, ix, sc);
  int ad = new_node(a, 1, base, mul);
  return set_ty(a, ad, 3);
}

// 元素内字段的地址 = 元素地址 + 字段字节偏移（foff = struct 表 [3]，C 布局）
//   wty = **存储宽度类**：int 字段 1（4 字节）／char 字段 2（1 字节）／指针字段 3（8 字节）
//     —— 就是 fld_addr_ty 的口径：kind 53/54 按它定读写宽度，make_incdec/lv_compound_at 按它定 ++ 宽度。
//   foff == 0 直接复用元素地址节点（省一条 add）——每个元素地址节点都只被**一处**消费（各调用点新建），
//   所以就地改 ty 安全；foff != 0 才是新节点。
int sarr_fld_addr(struct Ast *a, int el, int foff, int wty) {
  if (foff == 0) { return set_ty(a, el, wty); }
  int n0 = new_node(a, 0, 0, 0);
  int *vv = a->val;
  vv[n0] = foff;
  int ad = new_node(a, 1, el, n0);
  return set_ty(a, ad, wty);
}
// —— 2026-09-20：把「定长数组字段的下标」这一件事收敛成两个入口，读/写/表达式三条路径共用 ——
//   先前分散在 4 处（本地/指针 × 读/写），改动一处漏三处 ⇒ 表达式位根本没接（sarr1 报 -112）。
// 决定形态：字段是定长数组 → 1（走 field_arr_addr + 解引用）；否则按老路（指针字段下标）。
// ✅ 2026-09-20（卡 T-20260920-141033）：**读路径"会崩"的根因已定位并修掉** ——
//   真因两条（都在 `fld_arr_addr_loc/_ptr` 的基址节点上，详见那两处的长注释）：
//     ① 基址误用 kind 30/32（**字段值加载**）⇒ 把字段内容当地址；
//     ② 基址没 set_ty ⇒ is_addr_val 判 0 ⇒ 整条地址链退化成 32 位（地址高位被砍）。
//   修法 = 复用既有字段取址节点（**kind 52 本地 / kind 51 指针**）+ `set_ty(…, 3)`。
//   现口径：本函数不再是"临时开关"，返回真值（判据复用 st_is_arr = st_farr > 1）。
int fld_arr_kind(struct Parse *p, int f) {
  return st_is_arr(p, f);
}
// 形态 1：数组字段 → 元素**地址**节点。两个入口（FLINT 参数上限 4，只能拆开）：
//   · fld_arr_addr_loc：本地 struct 字段 —— 基址节点用 **kind 52（&v.f 字段取址）**、ll = 升序基址槽
//   · fld_arr_addr_ptr：struct 指针字段 —— 基址节点用 **kind 51（&p->f 字段取址）**、ll = 指针槽
//   sl_nf  = slot * 1000 + nfd（本地那个入口要 nfd 算升序基址；指针入口 nfd 传 0 ——
//            槽号放高位，别为了省参数把语义省含糊）
//   packed = fcd * 100 + 字段元素类型码（0=int 4=char）：FLINT 函数参数上限 4 个，把「字段号」
//            与「元素类型」挤进一个数传；field_arr_addr 只用元素类型定步长，低两位就是它的入参。
// 🔴 2026-09-20（卡 T-20260920-141033）**根因与修法**（上一疗程"读崩"的谜底，别再退回旧写法）：
//   原实现拿 **kind 30 / 32（本地/指针字段**值**读取）当前缀基址**，踩了两条：
//     ① kind 30/32 在发射端是 `lea rcx,[rbp-off]` + `mov eax/rax,[rcx+字段偏移]` = **值加载**
//        （对指针字段"恰好"等于要的地址，对**内联数组字段**就是"把数组头 4 字节的内容当地址"）；
//     ② 那两个节点**没标 ty**（默认 0）⇒ `is_addr_val()` 判 0 ⇒ 地址链整条退化成 32 位
//        （`imul eax,ecx` / `add eax,ecx`）⇒ 地址高位被砍。
//   实测产物（boot 崩的那版）：`lea rcx,[rbp-8] / mov eax,[rcx+0] / imul eax,ecx / add eax,ecx /
//     mov [rax],edx` → 一跑 **0xC0000005**；真 flint 同源产物：`lea rax,[rbp-0x20] / add rax,0x0 /
//     imul eax,eax,8 / movsxd rcx,eax / add rax,rcx`（地址链全程 64 位）。
//   正解 = 复用**既有的字段取址节点**（kind 52/51，与 `lv_addr_from` 里 `&x.f` 的用法一字不差）
//     ＋ **set_ty(…, 3)** 标成地址类 ⇒ 加法走 64 位分支。不用新节点、不碰发射器（自举不动点零风险）。
int fld_arr_addr_loc(struct Parse *p, struct Ast *a, int sl_nf, int packed) {
  int slot = sl_nf / 1000;
  int nfd = sl_nf - slot * 1000;
  int bs = slot + nfd - 1;                    // 升序基址 = 保留区最高槽（nfd = 变量预留槽数；见 declare_struct）
  int fcd = packed / 100;
  int fb = new_node(a, 52, bs, 0);            // &结构体.数组字段（字段取址：基址 + 字段字节偏移）
  int *vv = a->val;
  vv[fb] = fcd;
  set_ty(a, fb, 3);                           // ⚠️ 必须有：地址类，否则地址链退 32 位
  return field_arr_addr(p, a, fb, packed - fcd * 100);
}
int fld_arr_addr_ptr(struct Parse *p, struct Ast *a, int sl_nf, int packed) {
  int slot = sl_nf / 1000;
  int fcd = packed / 100;
  int fb = new_node(a, 51, slot, 0);          // &p->数组字段（指针字段取址）
  int *vv = a->val;
  vv[fb] = fcd;
  set_ty(a, fb, 3);                           // ⚠️ 同上
  return field_arr_addr(p, a, fb, packed - fcd * 100);
}

int find_func(struct Parse *p, int pos, int len) {
  int *fp = p->fpos;
  int *fl = p->flen;
  char *s = p->src;
  int k = 0;
  while (k < p->nfuncs) {
    if (fl[k] == len) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[fp[k] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) return k;
    }
    k = k + 1;
  }
  return -1;
}

// —— B2f：顶层 struct 声明（必须在函数前）——
// struct 名 { int a ; int *b ; char *c ; struct 其它 *d ; ... }
// 返回下一个 token 下标（= 函数区起点）；负 = 错误
int parse_structs(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  while (tok_ident_eq(p, "struct")) {
    p->i = p->i + 1;
    if (p->i >= p->n || ks[p->i] != 1) return -130;
    int npos = ps[p->i];
    int nlen = ls[p->i];
    p->i = p->i + 1;
    if (!tok_is(p, '{')) return -131;
    p->i = p->i + 1;
    if (st_find(p, npos, nlen) >= 0) return -179;   // B2w：结构体重复定义（对齐真 flint）
    int sid = st_add(p, npos, nlen);
    if (sid < 0) return -146;
    while (!tok_is(p, '}')) {
      if (p->i >= p->n) return -132;
      int fty = 0;
      int fsid = -1;
      if (tok_ident_eq(p, "int")) {
        p->i = p->i + 1;
        if (tok_is(p, '*')) { fty = 1; p->i = p->i + 1; }
      } else if (tok_ident_eq(p, "char")) {
        p->i = p->i + 1;
        if (tok_is(p, '*')) { fty = 2; p->i = p->i + 1; }
        else { fty = 4; }                      // B2k：char 标量字段（1 字节 / 对齐 1）
      } else if (tok_ident_eq(p, "struct")) {
        p->i = p->i + 1;
        if (p->i >= p->n || ks[p->i] != 1) return -134;
        fsid = st_find(p, ps[p->i], ls[p->i]);
        if (fsid < 0) return -135;
        p->i = p->i + 1;
        if (tok_is(p, '*')) { fty = 3; p->i = p->i + 1; }
        else {
          // ===== v2.4.0：struct **值字段**（`struct B b;`，内层必须已定义）=====
          //   自嵌套值字段 = 尺寸无穷 ⇒ 专码 -242（指针形态 `struct A *next;` 仍合法，见上一支）。
          //   当前结构体在建字段之前就已进表（st_add）⇒ 「刚登记的那个」就是自己。
          if (fsid == st_count(p) - 1) return -242;
          fty = 5;
        }
      } else { return -137; }
      if (p->i >= p->n || ks[p->i] != 1) return -138;
      if (tok_ident_at(p, p->i, "struct")) return -138;
      if (tok_ident_at(p, p->i, "char")) return -138;
      int fpos = ps[p->i];
      int flen = ls[p->i];
      p->i = p->i + 1;
      // 2026-09-20（卡 T-20260920-001345）：struct **定长数组字段**（真 flint v1.4.4 起支持）
      //   形态：`int buf[4];` / `char cbuf[6];` —— 元素宽按 FLINT 语言语义（int = 8 字节槽、char = 1 字节）、
      //   对齐 = 元素的 C 对齐，与既有下标缩放（元素 i 在 基址 + 8i / +i）完全一致（真 flint parse.c:2138-2140）。
      //   `int *p[2]` 这类**指针数组字段**本轮不做（真 flint 的读法本身含糊）→ -200 明确拒。
      int farr = 1;
      if (tok_is(p, '[')) {
        p->i = p->i + 1;
        if (!tok_is_num(p)) return -200;
        farr = tok_num_val(p);
        if (farr <= 0) return -200;
        p->i = p->i + 1;
        if (!tok_is(p, ']')) return -200;
        p->i = p->i + 1;
        if (fty == 1 || fty == 2 || fty == 3) return -200;   // 指针/struct* 数组字段不支持
        if (fty == 5) return -200;                           // v2.4：嵌套 struct **数组字段**也不做（同码）
      }
      if (!tok_is(p, ';')) return -139;
      p->i = p->i + 1;
      if (st_nfields(p, sid) >= 128) return -197;                // 2026-09-27：上限 64 → **128**（对齐真 flint
                                                                 //   现状：`src\parse.c` 同轮改成 128；起因 = FLGUI 的
                                                                 //   `GuiCtx` 已 64/64 满、面板要加的字段没地方放）。
                                                                 //   前一版 v1.4.31 把 32 → 64（2026-09-19 边界探针
                                                                 //   fields_65 实测真 flint = 64；旧写 32 = boot 比真
                                                                 //   flint 窄的真双端断点：真 flint 能编 33 字段、boot 报 -197）
      if (st_find_field(p, sid, fpos, flen) >= 0) return -140;   // 重复字段
      if (st_add_field(p, sid, fpos * 1000 + flen, fty * 100000 + (fsid + 1) * 1000 + farr) < 0) return -147;
      // ⚠️ 这里**不要再调 st_set_farr**：数组长度已经随 fspec 进表（见 st_add_field）。
      //   2026-09-20 实测踩坑：多调用一次会把刚写好的 [2] 覆盖成裸长度（fty 丢了）——
      //   症状是 `int *data` 字段的 fty 变 0、`int *d = b.data;` 报 -198（自测第 46 项挂）。
    }
    p->i = p->i + 1;
  }
  return p->i;
}

// —— B2g：按字面名找函数（print 展开用）——
int find_func_by(struct Parse *p, char *name) {
  int *fp = p->fpos;
  int *fl = p->flen;
  char *s = p->src;
  int k = 0;
  while (k < p->nfuncs) {
    int j = 0;
    int same = 1;
    while (name[j] != 0) {
      if (j >= fl[k]) { same = 0; }
      else if (s[fp[k] + j] != name[j]) { same = 0; }
      j = j + 1;
    }
    if (same != 0 && fl[k] == j) { return k; }
    k = k + 1;
  }
  return -1;
}
// B2n：按 token（位置+长度）找用户函数下标（api 声明不算；-1 = 无）
int find_func_at(struct Parse *p, int pos, int len) {
  int *fp = p->fpos;
  int *fl = p->flen;
  int *fpty = p->fpty;
  char *s = p->src;
  int k = 0;
  while (k < p->nfuncs) {
    if (fl[k] == len && fn_api(fpty[k]) == 0) {
      int j = 0;
      int same = 1;
      while (j < len) {
        if (s[fp[k] + j] != s[pos + j]) { same = 0; }
        j = j + 1;
      }
      if (same != 0) { return k; }
    }
    k = k + 1;
  }
  return -1;
}
// —— B2g：顶层 api 声明 —— api <dll> <ret> <name> ( <类型>, ... ) ;
// 返回下一个 token 下标（= 函数区起点）；负 = 错误
int parse_apis(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int *af = p->aflat;
  int *fpos = p->fpos;
  int *flen = p->flen;
  int *fna = p->fnargs;
  int *fpty = p->fpty;
  char *s = p->src;
  // B2h：af[0]/af[1]/nfuncs 的初始化移到 parse_program（顶层声明可交错，本函数可多次调用）
  while (tok_ident_eq(p, "api")) {
    p->i = p->i + 1;
    // 2026-09-21（卡 T-20260921-193226 私人工具定位·真实应用驱动）：**模块名也接受字符串字面量**。
    //   实测撞墙：真实应用 `apps\m2_float` 顶部写的是 `api "HwBridge.dll" int hw_init();`（带点全名）
    //   ⇒ 旧判据 `ks != 1` 直接 -170（真 flint 自 v1.4.8 起支持本形态，见 `test\samples\apimod1.fl`）。
    //   **为什么只能走字面量**：FLINT 的标识符词法**不吃 '.'**（`is_ident2` 只认字母/数字/下划线）
    //   ⇒ `api HwBridge.dll` 根本写不出来（点号会被切成符号 token）。
    //   tokenizer 对 kind 4（字符串）记的 `ps/len` = **引号内原文**（转义未解码）⇒ 直接当模块名用。
    if (p->i >= p->n) return -170;
    if (ks[p->i] != 1 && ks[p->i] != 4) return -170;
    int dpos = ps[p->i];
    int dlen = ls[p->i];
    p->i = p->i + 1;
    // —— v1.4.28（B1-3）：导入模块名（写出名）硬上限 63 字节，**与真 flint 同口径** ——
    //   真因：真 flint 写出端 `ImpGroup.dll` 是 `char[64]` ⇒ 名字超过 63 字节被 snprintf
    //   **静默截断**成"半个路径"的导入表（编译 exit 0、产物启动期 0xC0000135）。实测 70 个 'A'
    //   的模块名：产物文件里只剩 63 个 'A'。
    //   boot 的写出端是动态缓冲（本来不截断）⇒ 这一条**boot 比真 flint 宽**；但"语言口径只有一个"，
    //   超长在两端都必须是编译期硬错（工单 §0：真 flint 与 boot 同一份源码给同一结论）。
    //   判据与写出端一致：名字含 '.'(46) / '\'(92) / '/'(47) → 原样写；否则补 ".dll"（+4 字节）。
    //   ⚠️ 上限字面量必须与真 flint 的 `src\pe.c` IMPORT_DLL_NAME_MAX、`test\边界探针.ps1` 的
    //   `api_modname_over63` / `api_modname_63_ok` / `api_modname_path64` 三条一起看（boot 子集
    //   没有全局变量 ⇒ 做不成单点常量，写死 63 —— 与"boot 写死的上限一律拿探针复核"同一条纪律）。
    int needext = 1;
    int jd = 0;
    while (jd < dlen) {
      int cd = s[dpos + jd];
      if (cd == 46 || cd == 92 || cd == 47) { needext = 0; }
      jd = jd + 1;
    }
    int dnamelen = dlen;
    if (needext == 1) { dnamelen = dnamelen + 4; }
    //   错误码 -189 = 本文件 api 声明族（-170..-177）之后、-85（函数表满）同族的第一个空位；
    //   真 flint 侧的文案 = 「导入模块名过长：写出名最长 63 字节，现在 N 字节（…）」。
    if (dnamelen > 63) return -189;
    int retptr = 0;
    if (tok_ident_eq(p, "ptr")) { retptr = 1; p->i = p->i + 1; }
    else if (tok_ident_eq(p, "int")) { p->i = p->i + 1; }
    else if (tok_ident_eq(p, "void")) { p->i = p->i + 1; }
    else if (tok_ident_eq(p, "char")) {
      p->i = p->i + 1;
      if (!tok_is(p, '*')) return -171;
      p->i = p->i + 1;
      retptr = 1;
    } else if (tok_ident_eq(p, "struct")) {
      p->i = p->i + 1;
      if (p->i >= p->n || ks[p->i] != 1) return -171;
      if (st_find(p, ps[p->i], ls[p->i]) < 0) return -171;
      p->i = p->i + 1;
      if (!tok_is(p, '*')) return -171;
      p->i = p->i + 1;
      retptr = 1;
    } else { return -171; }
    if (p->i >= p->n || ks[p->i] != 1) return -172;
    int npos = ps[p->i];
    int nlen = ls[p->i];
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -173;
    p->i = p->i + 1;
    int argc = 0;
    if (tok_is(p, ')')) {
      p->i = p->i + 1;
    } else {
      argc = 1;
      int done = 0;
      while (p->i < p->n && done == 0) {
        if (tok_is(p, ',')) { argc = argc + 1; p->i = p->i + 1; }
        else if (tok_is(p, ')')) { done = 1; p->i = p->i + 1; }
        else { p->i = p->i + 1; }
      }
      if (done == 0) return -174;
    }
    // 任务卡 T-20260917-215230：对齐真 flint 的 API 实参上限（flint.h:246 = API_MAX_ARGS 16；
    // v1.4.0 由 12 提到 16，CreateFontA 14 参撞墙）。旧值 12 会让 lib\ui_lib.fl 的 CreateFontA
    // 声明在这里直接 parse err=-175 ⇒ 整个 UI 库在 boot 侧不可用（样本 b5b1.fl 留证）。
    if (argc > 16) return -175;
    if (!tok_is(p, ';')) return -176;
    p->i = p->i + 1;
    int dll = -1;
    int k = 0;
    while (k < af[0]) {
      if (af[2 + k * 2 + 1] == dlen) {
        int j = 0;
        int same = 1;
        while (j < dlen) {
          if (s[af[2 + k * 2] + j] != s[dpos + j]) { same = 0; }
          j = j + 1;
        }
        if (same != 0) { dll = k; }
      }
      k = k + 1;
    }
    if (dll < 0) {
      if (af[0] >= cap_groups()) return -177;      // 模块数上限（单点，2026-10-24）
      dll = af[0];
      af[2 + dll * 2] = dpos;
      af[2 + dll * 2 + 1] = dlen;
      af[0] = dll + 1;
    }
    if (p->nfuncs >= cap_funcs()) return -85;
    int fi = p->nfuncs;
    fpos[fi] = npos;
    flen[fi] = nlen;
    fna[fi] = argc;
    fpty[fi] = dll * 10000 + 1000 + retptr * 100;
    p->nfuncs = p->nfuncs + 1;
    af[1] = af[1] + 1;
  }
  return p->i;
}
// —— B2c：顶层预扫函数签名（支持前向调用；start = 函数区起点）——
// —— B3b：函数返回类型（对齐真 flint 决策 35：int* / char* / struct* 可返回）——
// B4b：补 char 值返回（ret=4）——真 flint 实测语义：返回值**不截断**（`char f(){return 300;}` 得 300），
//   截断只发生在 char 目标的存储处（`char c = f()` → 44），print 段按 char 打印（'A'）。
// 返回 0=int 1=int* 2=char* 3=struct* 4=char 值 5=void（负 = 错误）；成功后 p->i 指向函数名
// 2026-09-20（卡 T-20260920-001345）：+ void（对齐真 flint v0.6 起就有的 void；实测语义见样本 p1/p3/p5/q15/q16）
int parse_rettype(struct Parse *p) {
  int *ks = p->ks;
  int ret = 0;
  if (tok_ident_eq(p, "int")) {
    p->i = p->i + 1;
    if (tok_is(p, '*')) { ret = 1; }
  } else if (tok_ident_eq(p, "void")) {
    // 只认「void」（值、无 '*')：`void *f()` 真 flint 报「void 不能返回指针」（实测 q15）→ 这里同样拒
    p->i = p->i + 1;
    if (tok_is(p, '*')) return -199;
    ret = 5;
  } else if (tok_ident_eq(p, "char")) {
    p->i = p->i + 1;
    if (tok_is(p, '*')) { ret = 2; } else { ret = 4; }   // B4b：char 值返回
  } else if (tok_ident_eq(p, "struct")) {
    p->i = p->i + 1;
    if (p->i >= p->n || ks[p->i] != 1) return -181;
    if (st_find(p, p->ps[p->i], p->ls[p->i]) < 0) return -181;
    p->i = p->i + 1;
    if (!tok_is(p, '*')) return -182;          // struct 值返回不支持（只支持 struct*）
    ret = 3;
  } else {
    return -183;
  }
  if (ret == 1 || ret == 2 || ret == 3) { p->i = p->i + 1; }   // 吃掉 '*'（ret=0 int 值 / 4 char 值 无 '*'）
  return ret;
}

// 顶层 token i 是否「函数定义」起点——把 `struct X *f(` 与 `struct X {` 区分开
//   ⚠️ 2026-09-21（卡 T-20260921-194703）：**必须把 `void` 也算进来** —— 顶层分派现在拿本函数当
//   「函数 vs 全局变量声明」的判据，漏掉 void 会让 `void f() {}` 掉进 parse_globals 报 -183
//   （A 类 void 返回的样本当天就会整批变红）。
int is_func_start_at(struct Parse *p, int i) {
  int *ks = p->ks;
  int *vs = p->vs;
  int n = p->n;
  if (i >= n) return 0;
  if (tok_ident_at(p, i, "int") != 0 || tok_ident_at(p, i, "char") != 0 || tok_ident_at(p, i, "void") != 0) {
    i = i + 1;
    if (i < n && ks[i] == 3 && vs[i] == '*') { i = i + 1; }
    if (i + 1 < n && ks[i] == 1 && ks[i + 1] == 3 && vs[i + 1] == '(') { return 1; }
    return 0;
  }
  if (tok_ident_at(p, i, "struct") != 0) {
    i = i + 1;
    if (i >= n || ks[i] != 1) return 0;
    i = i + 1;
    if (i >= n || ks[i] != 3 || vs[i] != '*') return 0;
    i = i + 1;
    if (i + 1 < n && ks[i] == 1 && ks[i + 1] == 3 && vs[i + 1] == '(') { return 1; }
  }
  return 0;
}

int collect_funcs(struct Parse *p, int start) {
  int *ks = p->ks;
  int *vs = p->vs;
  int *ps = p->ps;
  int *ls = p->ls;
  int *fpos = p->fpos;
  int *flen = p->flen;
  int *fna = p->fnargs;
  int *fbd = p->fbody;
  int *fpty = p->fpty;                        // B3b：返回类型写进函数表（前向调用要按它定节点类型）
  int n = p->n;
  int i = start;
  // B2h/B2i：遇到 struct / api 声明即停（交给顶层循环处理）——顶层可任意交错
  // B3b：`struct X *f(` 是函数不是 struct 声明 → is_func_start_at 区分（FLINT 无 break，用 go 标志）
  int go = 1;
  while (i < n && ks[i] != 0 && go == 1) {
    if (tok_ident_at(p, i, "api") != 0) { go = 0; }
    // 2026-09-21（卡 T-20260921-194703）：**不是函数起点就停下** —— struct 声明、以及新支持的
    //   顶层全局变量声明，一律交回 parse_program 的顶层循环（那里按同一个判据分派）。
    //   原来只挡 struct：全局变量 `int g = 1;` 会在这里被当函数头，报 -82。
    else if (is_func_start_at(p, i) == 0) { go = 0; }
    else {
    int ftok = i;                             // B2h：函数起点 token 下标（体解析按它跳转）
    p->i = i;
    int ret = parse_rettype(p);
    if (ret < 0) return ret;
    i = p->i;
    if (i >= n || ks[i] != 1) return -81;
    if (tok_ident_at(p, i, "int")) return -81;
    if (tok_ident_at(p, i, "return")) return -81;
    if (tok_ident_at(p, i, "if")) return -81;
    if (tok_ident_at(p, i, "while")) return -81;
    if (tok_ident_at(p, i, "else")) return -81;
    if (ls[i] == 4 && ret != 0) {              // B3b：main 必须返回 int（对齐真 flint 文案）
                                                // 2026-09-20：void main 也走这条（真 flint 实测 q5/p5 报同一句）
      if (tok_ident_at(p, i, "main")) return -184;
    }
    int npos = ps[i];
    int nlen = ls[i];
    i = i + 1;
    if (!(i < n && ks[i] == 3 && vs[i] == '(')) return -82;
    i = i + 1;
    int nargs = 0;
    if (i < n && ks[i] == 3 && vs[i] == ')') {
      i = i + 1;
    } else {
      nargs = 1;
      while (i < n && !(ks[i] == 3 && vs[i] == ')')) {
        if (ks[i] == 3 && vs[i] == ',') nargs = nargs + 1;
        i = i + 1;
      }
      if (i >= n) return -83;
      i = i + 1;
    }
    if (nargs > 32) return -84;                // v1.4.26：形参/实参上限 4 → 32（对齐真 flint FUNC_MAX_ARGS）
    if (find_func(p, npos, nlen) >= 0) return -178;   // B2w：函数重复定义（对齐真 flint）
    // v2.1.0：函数与**已登记**的枚举常量同名 = 硬错。与 g_add 的反向守卫同因：真 flint 的函数表
    //   是**预扫**的，`enum X { f }; int f() {...}` 在真 flint 报「枚举常量 'f' 与函数同名」；
    //   boot 按源码序登记 ⇒ 函数写在 enum 后面时也必须在这里挡住，否则又是"顺序造成"的分岔。
    if (enum_find(p, npos, nlen) >= 0) return -275;
    if (p->nfuncs >= cap_funcs()) return -85;  // 函数表上限 = cap_funcs()（单点，2026-10-24；原 512 = B2h 扩容）
    int fi = p->nfuncs;
    fpos[fi] = npos;
    flen[fi] = nlen;
    fna[fi] = nargs;
    fbd[fi] = ftok;                            // B2h：暂存函数起点 token 下标（体解析后覆盖为块节点）
    fpty[fi] = ret * 100;                      // B3b：返回类型（形参掩码在 parse_function 里补上）
    p->nfuncs = p->nfuncs + 1;
    if (!(i < n && ks[i] == 3 && vs[i] == '{')) return -86;
    int depth = 0;
    int done = 0;
    while (i < n && done == 0) {
      if (ks[i] == 3 && vs[i] == '{') {
        depth = depth + 1;
        i = i + 1;
      } else if (ks[i] == 3 && vs[i] == '}') {
        depth = depth - 1;
        i = i + 1;
        if (depth == 0) done = 1;
      } else {
        i = i + 1;
      }
    }
    if (done == 0) return -87;
    }
  }
  p->i = i;                                    // B2h：交还扫描位置（顶层可交错，可多次调用）
  return p->nfuncs;
}

// —— 参数列表（相对槽 0..n-1）——返回指针位掩码（bit i = 第 i 个形参是指针）；负 = 错误 ——
// B2f：形参类型 int / int* / int[] / char* / struct 名*
int parse_params(struct Parse *p, struct Ast *a, int expect_n) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  if (tok_is(p, ')')) {
    p->i = p->i + 1;
    if (expect_n != 0) return -90;
    return 0;
  }
  int cnt = 0;
  int mask = 0;
  int more = 1;
  while (more == 1) {
    int is_ptr = 0;
    int is_char = 0;                            // B4b：char 值形参（真 flint 支持，boot 原 -91）
    int aux = 0;
    int sid = -1;
    if (tok_ident_eq(p, "int")) {
      p->i = p->i + 1;
      if (tok_is(p, '*')) { p->i = p->i + 1; is_ptr = 1; }
    } else if (tok_ident_eq(p, "char")) {
      p->i = p->i + 1;
      if (tok_is(p, '*')) { p->i = p->i + 1; is_ptr = 1; aux = 1; }
      else { is_char = 1; }                     // B4b：char c（1 字节语义，按字节读回）
    } else if (tok_ident_eq(p, "struct")) {
      p->i = p->i + 1;
      if (p->i >= p->n || ks[p->i] != 1) return -91;
      sid = st_find(p, ps[p->i], ls[p->i]);
      if (sid < 0) return -91;
      p->i = p->i + 1;
      if (!tok_is(p, '*')) return -91;
      p->i = p->i + 1;
      is_ptr = 1;
      aux = 2;
    } else { return -91; }
    if (p->i >= p->n || ks[p->i] != 1) return -92;
    if (tok_ident_eq(p, "int")) return -92;
    if (tok_ident_eq(p, "char")) return -92;
    if (tok_ident_eq(p, "struct")) return -92;
    if (tok_ident_eq(p, "return")) return -92;
    if (tok_ident_eq(p, "if")) return -92;
    if (tok_ident_eq(p, "while")) return -92;
    if (tok_ident_eq(p, "else")) return -92;
    int pos = ps[p->i];
    int len = ls[p->i];
    p->i = p->i + 1;
    if (tok_is(p, '[')) {                                        // int a[] = 指针形参
      if (is_ptr != 0 || is_char != 0) return -96;               // B4b：char a[] 未支持（别静默当 int*）
      p->i = p->i + 1;
      if (!tok_is(p, ']')) return -96;
      p->i = p->i + 1;
      is_ptr = 1;
      aux = 0;
    }
    int slot = 0;
    if (is_ptr == 1) { slot = declare_ptr(p, pos, len, aux * 1000 + sid + 1); }
    else if (is_char == 1) { slot = declare_char(p, pos, len); }  // B4b：char 值形参
    else { slot = declare_int(p, pos, len); }
    if (slot < 0) return -93;
    if (is_ptr == 1) { mask = mask + (1 << cnt); }
    cnt = cnt + 1;
    if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
  }
  if (!tok_is(p, ')')) return -94;
  p->i = p->i + 1;
  if (cnt != expect_n) return -95;
  return mask;
}

// —— B2m：指针字段直接下标 s.arr[i] / p->arr[i] ——
// 展开 = *(字段指针 + 下标 × 元素宽)，复用现有节点：1=add（地址链 64 位）3=mul 53=解引用读 54=解引用写
//   base = 字段读节点（30 本地字段 / 32 指针字段，ty 已置 fld_ty）；ftyd = 字段类型码
// 返回地址节点（ty = 字段 elem 类型：1=int* 4 字节 / 2=char* 1 字节 / 3=指针 8 字节）；<0 = 错误码
// 调用方已消费到 '[' 之前
int field_sub_addr(struct Parse *p, struct Ast *a, int base, int ftyd) {
  p->i = p->i + 1;                            // 过 '['
  int e = parse_expr(p, a);
  if (e < 0) return -14;
  if (!tok_is(p, ']')) return -15;
  p->i = p->i + 1;
  int scale = 4;                              // 2026-10-17 int=4 ABI：int* 元素 4 字节
  if (ftyd == 2) { scale = 1; }               // char* 字段 → 字节元素
  else if (ftyd == 3) { scale = 8; }          // struct* 字段：元素宽未知 → 保持旧口径 8
  int sc = new_node(a, 0, 0, 0);
  int *vv = a->val;
  vv[sc] = scale;
  int mul = new_node(a, 3, e, sc);            // 下标 × 元素宽（int）
  int ad = new_node(a, 1, base, mul);         // 字段指针 + 偏移（地址链走 64 位）
  return set_ty(a, ad, fld_ty(ftyd));
}

// —— v1.5.0：str([ 的前瞻判定（off = 相对当前 token 的偏移）：token[off] 是标识符 str 且紧跟 '(' '['
//   ⚠️ 必须定义在**第一个调用点之前**（parse_primary 里用它兜底报错）——boot 没有函数前向引用
int str_ahead(struct Parse *p, int off) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i + off;
  if (i + 2 >= p->n) return 0;
  if (tok_ident_at(p, i, "str") == 0) return 0;
  if (!(ks[i + 1] == 3 && vs[i + 1] == '(')) return 0;
  if (!(ks[i + 2] == 3 && vs[i + 2] == '[')) return 0;
  return 1;
}

// —— v2.3.x（2026-10-24）：str_into(dst[, cap], [...]) 的前瞻判定 ——
//   与 str_ahead 同族，两处差别：① 关键词是 str_into（8 字符，词边界由 tok_ident_at 保证）
//   ② 括号后**不要求** '['（前两个实参是表达式，段列表在最后）。两种形态共用这一个判据：
//     str_into(buf, [...])       —— 2 参数组形态（cap 由 dst 的数组声明推，见 parse_str_body）
//     str_into(p, cap, [...])    —— 3 参指针形态
//   与真 flint 的 is_str_call（src\parse.c :3036）**同口径**：只认 `str_into (`，此处不猜后面几参
//   （猜错就会把真 flint 放行的写法提前拒掉 —— boot 比 flint 窄同样算分岔）。
//   ⚠️ 必须定义在**第一个调用点之前**（parse_primary 的兜底报错用它）；boot 没有函数前向引用。
int str_into_ahead(struct Parse *p, int off) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i + off;
  if (i + 1 >= p->n) return 0;
  if (tok_ident_at(p, i, "str_into") == 0) return 0;
  if (!(ks[i + 1] == 3 && vs[i + 1] == '(')) return 0;
  return 1;
}

// ===== v1.6.0：方法调用点糖 recv.name(args) ⇒ 结构体名_name(&recv, args) =====
// 与真 flint 的 src\parse.c（v1.6.0 method_call / call_finish / call_arg_norm）**同口径**：
//   · 定义侧一个字都不改：方法就是首参为接收者指针的普通自由函数
//     （int M_f(struct M *self, int x)）；
//   · 命名约定 = 结构体名_方法名。先精确匹配；再**唯一**的大小写不敏感候选
//     （接住仓库里既有的小写前缀写法 struct Db ↔ db_find / struct In ↔ in_line）；
//     多个候选 = 响亮报错（-224），不猜；
//   · 接收者 = struct **值变量**（m.f(...) ⇒ M_f(&m, ...)）｜指向 struct 的**变量**
//     （p.f(...) 与 p->f(...) 都 ⇒ M_f(p, ...)，不额外取址）。
//     只认变量（与 boot 既有的 f()->x 缺口一致）：表达式结果一律响亮报错（-150/-153）；
//   · 实参链按**源序**建（接收者占第 0 格），与手写 M_f(&m, x, ...) 的 AST 同形
//     ⇒ 产物与手写形式逐字节同结果（D11 的 I1/I2：只用已有的调用节点，发射端一行不改）。
// 新错误码（既有最大码 = -212，以下四个未占用）：
//   -221 = 该名字是结构体的**字段**不是方法（括号判据的歧义闸门）
//   -222 = 糖摊平后的自由函数不存在
//   -223 = 方法名没带调用括号（糖形态必须带括号）
//   -224 = 大小写不敏感兜底命中多个（歧义）
// 糖名匹配：返回函数下标；-1 = 无；-2 = 大小写不敏感候选有歧义
int find_method_boot(struct Parse *p, int sid, int mpos, int mlen) {
  char nb[160];
  int sp = st_hdr(p, sid, 0);
  int sl = st_hdr(p, sid, 1);
  if (sl + 1 + mlen >= 160) { return -1; }
  char *s = p->src;
  int j = 0;
  while (j < sl) { nb[j] = s[sp + j]; j = j + 1; }
  nb[j] = '_';
  j = j + 1;
  int k = 0;
  while (k < mlen) { nb[j] = s[mpos + k]; j = j + 1; k = k + 1; }
  nb[j] = 0;
  int ex = find_func_by(p, nb);
  if (ex >= 0) { return ex; }
  int *fp = p->fpos;
  int *fl = p->flen;
  int found = -1;
  int cnt = 0;
  int q = 0;
  while (q < p->nfuncs) {
    if (fl[q] == sl + 1 + mlen) {
      if (s[fp[q] + sl] == '_') {
        int same = 1;
        int z = 0;
        while (z < mlen) {
          if (s[fp[q] + sl + 1 + z] != nb[sl + 1 + z]) { same = 0; }
          z = z + 1;
        }
        if (same == 1) {
          int ci = 1;
          int y = 0;
          while (y < sl) {
            int ca = s[sp + y];
            int cb = s[fp[q] + y];
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
            if (ca != cb) { ci = 0; }
            y = y + 1;
          }
          if (ci == 1) { found = q; cnt = cnt + 1; }
        }
      }
    }
    q = q + 1;
  }
  if (cnt > 1) { return -2; }
  return found;
}

// 名字不是字段、也不带括号：是「糖摊平后的名字」就返回 1（⇒ -223，必须带括号）
int sugar_needs_parens(struct Parse *p, int sid, int mpos, int mlen) {
  if (find_method_boot(p, sid, mpos, mlen) >= 0) { return 1; }
  return 0;
}

// 解析一次方法调用点：p->i 已经停在 '('，recv 是**已构造好的接收者实参节点**（值接收者 =
//   &recv 地址节点；指针接收者 = 指针值节点）。这里对 recv **不做任何求值**，只传地址/指针值。
int boot_method_call(struct Parse *p, struct Ast *a, int sid, int recv, int mpos, int mlen) {
  if (st_find_field(p, sid, mpos, mlen) >= 0) { return -221; }
  int fi = find_method_boot(p, sid, mpos, mlen);
  if (fi == -2) { return -224; }
  if (fi < 0) { return -222; }
  int *fna = p->fnargs;
  if (fna[fi] < 1) { return -222; }
  int atmp[32];
  atmp[0] = recv;
  return parse_call_tail(p, a, fi, atmp, 1);
}

// —— v2.1.0（缺口 -240 收口）：`a[i].字段` 的**读**（p->i 停在字段名上，'.' 已被调用方吃掉）——
//   形态与本地 struct 字段读（kind 30 / kind 55）同构，只是基址从「struct 变量基址槽」换成元素地址链：
//     int 字段  ：地址 + foff → kind 53（地址节点 ty=1 ⇒ mov eax,[rax] 4 字节）
//     char 字段 ：地址 + foff（ty=2 ⇒ movzx 1 字节）
//     指针字段  ：地址 + foff（ty=3 ⇒ 8 字节读），结果再标 fld_ty(1/2/3) 供 `*h[1].p` 这类父节点定宽
//     定长数组字段：地址 + foff 当**基址**交给 field_arr_addr（元素宽 4/1 由 st_arr_step 定）
//   错误码与本地 struct 字段那条路同源（-151 期望字段名 / -152 无此字段 / -223 糖名须带括号 / -13 标量不能下标）。
//   ⚠️ 为什么读路径必须单独一个函数：'&' 分支（地址）与语句写分支（kind 54）都要「元素地址 + foff」，
//      但只有读要造 kind 53；三者共用 sarr_fld_addr/sarr_elem_addr，别各写一份（本仓踩过"改一处漏三处"）。
int sarr_fld_read(struct Parse *p, struct Ast *a, int el, int sid) {
  int *ps = p->ps;
  int *ls = p->ls;
  if (p->i >= p->n || p->ks[p->i] != 1) { return -151; }
  int f = st_find_field(p, sid, ps[p->i], ls[p->i]);
  if (f < 0) {
    if (sugar_needs_parens(p, sid, ps[p->i], ls[p->i]) == 1) { return -223; }
    return -152;
  }
  p->i = p->i + 1;
  int fty = st_fty(p, f);
  int off = st_fld(p, f, 3);
  // ===== v2.4.0：嵌套 struct **值字段**（fty 5）=====
  //   `x.b` 是**一个 struct 对象**（不是值、也不是指针）：语义同真 flint 的地址节点
  //   （ND_ADD ty=TY_STRUCT）。⇒ 只把字节偏移叠到地址链上（ty=3 = 8 字节地址类），然后：
  //     · 后面还有 `.`  ⇒ 递归进内层字段表继续读（`x.b.c` = *(x + off_b + off_c)）
  //     · 后面什么都没有 ⇒ 返回这个字段地址（与真 flint 的「a.b 单独出现 = 地址节点」同形）
  //   值字段不能下标（`x.b[i]` = -13）—— 嵌套数组字段本就不做（parse_structs 也拒 -200）。
  if (fty == 5) {
    if (tok_is(p, '[')) { return -13; }
    int b5 = sarr_fld_addr(a, el, off, 3);
    if (!tok_is(p, '.')) { return b5; }
    p->i = p->i + 1;
    return sarr_fld_read(p, a, b5, st_fsid(p, f));
  }
  if (tok_is(p, '[') && fty != 3) {                      // 元素内定长数组字段：g[0].buf[j]
                                                         //   v2.3：struct* 字段的 '[' 是**指针下标**，留给下面的链处理
    if (fld_arr_kind(p, f) == 0) { return -13; }         // 标量字段不能下标
    return new_node(a, 53, field_arr_addr(p, a, sarr_fld_addr(a, el, off, 1), fty), 0);
  }
  if (fld_arr_kind(p, f) != 0) {                          // 数组字段名作表达式 = 首元素地址
    return sarr_fld_addr(a, el, off, 1);
  }
  int rd = new_node(a, 53, sarr_fld_addr(a, el, off, fld_addr_ty(fty)), 0);
  if (fty == 0 || fty == 4) { return rd; }                // 值类（int/char）：结果就是值
  set_ty(a, rd, fld_ty(fty));                             // 指针类：结果仍是地址（宽 8 字节已由地址 ty=3 定）
  if (fty != 3) { return rd; }
  // ===== 2026-10-24（v2.3）：struct* 字段 → **继续走链**：`s.next->v` / `s.next->next` / `s.next[i].v` ====
  //   口径 =「手上只要是 struct 指针值（ty=3 + 已知 sid）就能继续 `->` / `[]`」，非 struct* 的一跳即止。
  //   不复用 `->` 的 slot 版通路（kind 32 + 字段码）：那条路只认变量槽，而链的基址是任意表达式。
  //   elmode = 1 表示 base 已经是**元素地址**（`x[i]` 之后），此时只接 '.'（字段偏移直接叠在元素地址上）。
  int base = rd;
  int sid2 = st_fsid(p, f);
  int elmode = 0;
  while (1) {
    if (elmode == 0) {
      if (tok_is(p, '[')) {                     // 指针下标：元素地址；之后只接 '.'
        p->i = p->i + 1;
        int ix = parse_expr(p, a);
        if (ix < 0) { return -14; }
        if (!tok_is(p, ']')) { return -15; }
        p->i = p->i + 1;
        base = elem_addr_node(a, base, ix, st_nslots(p, sid2) * 8);
        elmode = 1;
        continue;
      }
      if (!tok2_is(p, '-', '>')) { return base; }
      p->i = p->i + 2;
    } else {
      if (!tok_is(p, '.')) { return base; }
      p->i = p->i + 1;
      elmode = 0;
    }
    if (p->i >= p->n || p->ks[p->i] != 1) { return -151; }
    int f2 = st_find_field(p, sid2, p->ps[p->i], p->ls[p->i]);
    if (f2 < 0) { return -152; }
    p->i = p->i + 1;
    int fty2 = st_fty(p, f2);
    if (fld_arr_kind(p, f2) != 0) { return -152; }          // 链上的数组字段不猜（要下标请先落变量）
    if (fty2 == 5) {                                        // v2.4：链上的嵌套值字段 → 地址链继续
      base = sarr_fld_addr(a, base, st_fld(p, f2, 3), 3);
      sid2 = st_fsid(p, f2);
      elmode = 1;                                           // 值字段 = struct 对象地址 ⇒ 后面只接 '.'
      continue;
    }
    int rd2 = new_node(a, 53, sarr_fld_addr(a, base, st_fld(p, f2, 3), fld_addr_ty(fty2)), 0);
    if (fty2 == 0 || fty2 == 4) { return rd2; }
    set_ty(a, rd2, fld_ty(fty2));
    if (fty2 != 3) { return rd2; }
    base = rd2;
    sid2 = st_fsid(p, f2);
  }
  return base;
}

// —— 2026-10-24（v2.3）：链式**取地址**（写语句 ＋ `&` 链共用）——
//   走法与 sarr_fld_read 的链同源，但返回**最后一跳字段的地址节点**（写语句拿它当 kind 54 的左值，
//   `&` 链直接返回它）。*outfty = 字段类型码（0/1/2/3/4）；-1 = 一跳都没走（调用方自行处理）。
//   数组字段落在 -2（返回首元素地址，链到此为止 —— 数组再链下去没有意义）。
//   v2.4.0：多一个 elmode0 —— 链**起点**是「struct 指针值」还是「struct 对象地址」：
//     · 0 = 指针值（`w->next->v` / `w->next[0].v` / `p->next->v`）：下一跳只接 `->` 或 `[`
//     · 1 = 对象地址（`a.b.c` 里的 `a.b`、元素地址 `a[i].b.c`）：下一跳只接 `.`
//   两种起点不能靠"看下一个 token"猜（`.x` 在指针起点上非法、`->x` 在对象起点上非法）——
//   让调用方按语义传，解析器不替人挑。
int chain_fld_addr(struct Parse *p, struct Ast *a, int base, int sid, int *outfty, int elmode0) {
  *outfty = -1;
  int cur = base;
  int csid = sid;
  int elmode = elmode0;
  while (1) {
    if (elmode == 0) {
      if (tok_is(p, '[')) {                     // 指针下标：元素地址
        p->i = p->i + 1;
        int ix = parse_expr(p, a);
        if (ix < 0) { return -14; }
        if (!tok_is(p, ']')) { return -15; }
        p->i = p->i + 1;
        cur = elem_addr_node(a, cur, ix, st_nslots(p, csid) * 8);
        elmode = 1;
        continue;
      }
      if (!tok2_is(p, '-', '>')) { return cur; }
      p->i = p->i + 2;
    } else {
      if (!tok_is(p, '.')) { return cur; }
      p->i = p->i + 1;
      elmode = 0;
    }
    if (p->i >= p->n || p->ks[p->i] != 1) { return -151; }
    int f = st_find_field(p, csid, p->ps[p->i], p->ls[p->i]);
    if (f < 0) { return -152; }
    p->i = p->i + 1;
    int fty = st_fty(p, f);
    int off = st_fld(p, f, 3);
    if (tok_is(p, '[')) {                       // 数组字段下标：首元素地址 + 下标
      if (st_is_arr(p, f) == 0) { return -47; }
      *outfty = -2;
      return field_arr_addr(p, a, sarr_fld_addr(a, cur, off, 1), fty);
    }
    if (st_is_arr(p, f) != 0) {                 // 数组字段名 = 首元素地址
      *outfty = -2;
      return sarr_fld_addr(a, cur, off, 1);
    }
    if (fty == 5) {                             // v2.4：嵌套值字段 → 地址链继续（后面只接 '.'）
      cur = sarr_fld_addr(a, cur, off, 3);
      csid = st_fsid(p, f);
      elmode = 1;
      continue;
    }
    int ad = sarr_fld_addr(a, cur, off, fld_addr_ty(fty));
    if (fty != 3) {
      *outfty = fty;
      return ad;
    }
    cur = new_node(a, 53, ad, 0);               // struct* 字段：读出指针值，继续走链
    set_ty(a, cur, 3);
    csid = st_fsid(p, f);
  }
  return cur;
}

// —— v2.4.0：`<链> = expr ;` 的公共尾巴（嵌套值字段的写语句用）——
//   p->i 停在这条链的**第一个运算符**上（`a.b` 已由调用方折成地址 ⇒ 此刻是 `.`；指针起点则是 `->`/`[`），
//   chain_fld_addr 吃掉整条 `.`/`->`/`[i]` 链并返回最后一跳字段的地址，
//   这里再吃 `= 右值 ;`、落 kind 54（写宽度由地址节点的 ty 定：int 字段 1 / char 2 / 指针·struct 3）。
//   与既有的 `w->next->v = 7` 那一支**逐节点同序**（那一支改成调用本函数，产物不变）。
//   错误码沿用既有口径：-54 期望 '=' / -55 右值 / -57 期望 ';' / -198 指针字段值门槛。
int chain_assign_tail(struct Parse *p, struct Ast *a, int base, int sid, int elmode0) {
  int oft = -1;
  int chad = chain_fld_addr(p, a, base, sid, &oft, elmode0);
  if (chad < 0) { return chad; }
  if (oft < 0) { return -54; }
  if (!tok_is(p, '=')) { return -54; }
  p->i = p->i + 1;
  int ev = parse_expr(p, a);
  if (ev < 0) { return -55; }
  if (oft >= 1 && oft != 4 && rhs_addr_like(p, a, ev, 1) == 0) { return -198; }
  int wr = new_node(a, 54, chad, ev);
  if (!tok_is(p, ';')) { return -57; }
  p->i = p->i + 1;
  return wr;
}

// 调用收尾：实参已缓冲在 atmp[0..argc-1]（普通调用 = 0 个、方法糖 = 接收者 1 个），
//   p->i 停在 '(' 之后的第一个 token。**从 parse_primary 的调用分支原样搬出来** ——
//   方法调用点糖与普通调用共用这一份实参语义（两条路各写一份必然分叉）。
int parse_call_tail(struct Parse *p, struct Ast *a, int fi, int *atmp, int argc) {
  int *ar = p->args;
  int *fna = p->fnargs;
  int *fpty = p->fpty;
  int amax = 32;                            // v1.4.26：**函数**实参上限 32
  if (fn_api(fpty[fi]) == 1) { amax = 16; } //   **API** 实参上限仍是 16
  if (!tok_is(p, ')')) {
    int more = 1;
    while (more == 1) {
      int e = parse_expr(p, a);
      if (e < 0) return -9;
      if (mg_node_kind(p, a, e) != 0) return -171;   // B2l：托管指针不能作实参（所有权语义）
      if (argc >= amax) return -10;
      atmp[argc] = e;
      argc = argc + 1;
      if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
    }
  }
  if (!tok_is(p, ')')) return -11;
  p->i = p->i + 1;
  if (argc != fna[fi]) return -12;
  // ===== v1.4.27 调用点实参**双向**核对（-211 值→指针形参 / -212 地址→值形参）=====
  //   逐条与原实现相同，只是搬进了本函数（口径见 parse_primary 调用分支的老注释）。
  if (fn_api(fpty[fi]) == 0) {
    int raw = fpty[fi] - fpty[fi] / 100 * 100;
    if (raw >= 16) {
      int pmk = raw - 16;
      int *kd7 = a->kind;
      int *ll7 = a->l;
      int *vv7 = a->val;
      int *ty7 = a->ty;
      int q = 0;
      while (q < argc) {
        if (q < 4) {
          int an = atmp[q];
          int is_ad = 0;
          if (ty7[an] >= 1) { is_ad = 1; }
          if (kd7[an] == 60 && ty7[ll7[an]] == 3) { is_ad = 1; }
          if (kd7[an] == 6 && slot_addr_mark(p, vv7[an]) == 1) { is_ad = 1; }
          int is_api = 0;
          if (kd7[an] == 10) { if (fn_api(fpty[vv7[an]]) == 1) { is_api = 1; } }
          if ((pmk >> q) & 1) {
            if (is_ad == 0 && kd7[an] != 0 && is_api == 0) { return -211; }
          } else {
            if (is_ad == 1) { return -212; }
          }
        }
        q = q + 1;
      }
    }
  }
  int base = p->nargs;
  int aq = 0;
  while (aq < argc) {
    if (p->nargs >= 65536) return -10;
    ar[p->nargs] = atmp[aq];
    p->nargs = p->nargs + 1;
    aq = aq + 1;
  }
  int idx = new_node(a, 10, base, argc);
  int *vv = a->val;
  vv[idx] = fi;
  // B3b：调用结果类型随返回类型（1=int* 2=char* 3=struct*；api 的 ptr 返回为 1）
  int rt = fn_retptr(fpty[fi]);
  if (rt == 1) { set_ty(a, idx, 1); }
  else if (rt == 2) { set_ty(a, idx, 2); }
  else if (rt == 3) { set_ty(a, idx, 3); }
  // B3b：调用结果直接下标 f()[i]（int*/char* 返回；对齐真 flint 实测 idp(a)[1]）
  if (rt == 1 || rt == 2) {
    if (tok_is(p, '[')) {
      p->i = p->i + 1;
      int eix = parse_expr(p, a);
      if (eix < 0) return -14;
      if (!tok_is(p, ']')) return -15;
      p->i = p->i + 1;
      int offix = eix;
      if (rt == 1) {
        int n8 = new_node(a, 0, 0, 0);
        vv[n8] = 4;                       // 2026-10-17 int=4 ABI：int* 返回值的元素 4 字节
        offix = new_node(a, 3, eix, n8);
      }
      int adix = new_node(a, 1, idx, offix);
      if (rt == 1) { set_ty(a, adix, 1); } else { set_ty(a, adix, 2); }
      return new_node(a, 53, adix, 0);
    }
  }
  return idx;
}

int parse_primary(struct Parse *p, struct Ast *a) {
  // v1.5.0：表达式里的 str([...]) 一律**响亮报错**（必须放在最前面：boot 的 ident 分支会先把它当
  //   函数调用 `str(...)` 吞掉，再被上层表达式的错误码掩成 -50 —— 那支报错不指「为什么不行」）
  //   它只在 3 个语句级形态可用（指针声明初始化 / 指针变量赋值右值 / 指针返回函数的 return），
  //   由 parse_stmt 与 parse_decl_body 在语句层展开成语句链 ⇒ 落到这里 = print 段/实参/条件/算术/嵌套/丢弃
  // v2.3.x：str_into 同罪同罚（它同样是"展开成语句链"的糖，不能夹进表达式里）
  if (str_ahead(p, 0) == 1 || str_into_ahead(p, 0) == 1) return -210;
  if (tok_is_num(p)) {
    int v = tok_num_val(p);
    p->i = p->i + 1;
    int idx = new_node(a, 0, 0, 0);
    int *vv = a->val;
    vv[idx] = v;
    return idx;
  }
  {
    int *ks0 = p->ks;
    int i0 = p->i;
    if (i0 < p->n && ks0[i0] == 4) {            // B2g：字符串字面量 → 池偏移
      int *ps0 = p->ps;
      int *ls0 = p->ls;
      char *s0 = p->src;
      char *pool = p->spool;
      int spos = ps0[i0];
      int slen = ls0[i0];
      p->i = p->i + 1;
      int off = p->spcur;
      int j = 0;
      while (j < slen) {
        int ch = s0[spos + j];
        if (ch == '\\') {
          j = j + 1;
          // 2026-10-18（task 2b / audit5）：**`\xNN` 转义解码**（1-2 位十六进制，大小写皆可）。
          //   与真 flint 的 tokenize parse_escape 同口径：最多吃 2 位 hex，遇非 hex 立即停
          //   （`"\x4Z"` = 0x04 后接 'Z'；`"\xAB"` 是单个字节 0xAB）。
          //   病根：原实现把 '\' 后的 'x' 原样当普通转义（esc_val 返回 'x'）⇒ "\x41B\x43" 解成
          //   'x','4','1','B','x','4','3'，audit5 第一个断言（s1[0]=='A'）就退 1。
          if (s0[spos + j] == 'x' || s0[spos + j] == 'X') {
            int hv = 0;
            int hn = 0;
            while (hn < 2 && j + 1 < slen && is_hex(s0[spos + j + 1]) != 0) {
              j = j + 1;
              hv = hv * 16 + hex_val(s0[spos + j]);
              hn = hn + 1;
            }
            ch = hv;
          } else {
            ch = esc_val(s0[spos + j]);
          }
        }
        if (p->spcur >= 262144) return -160;      // 池满
        pool[p->spcur] = ch;
        p->spcur = p->spcur + 1;
        j = j + 1;
      }
      pool[p->spcur] = 0;
      p->spcur = p->spcur + 1;
      int si = new_node(a, 41, 0, 0);
      int *vv0 = a->val;
      vv0[si] = off;
      return set_ty(a, si, 2);                  // B2j：字符串字面量 = char*（elem 1 字节）
    }
  }
  // ===== v1.8.0：C 风格转型 `(int)x` / `(char)x` / `(int*)p` / `(char*)p` =====
  //   位置 = 普通括号表达式之前（一元转换档）：`(int)x * 2` = ((int)x)*2；操作数取 parse_factor
  //   ⇒ postfix 比转型紧（`(int)x[0]` = (int)(x[0])，与 C 一致），前缀运算符可嵌套（`(int)-x`）。
  //   **boot 的类型宇宙只有 int(4B) / char / 指针 / struct**：没有 double / int_64 / int_32
  //   ⇒ 那两个类型的转型在这里本来就不认识（与 8 个 dbl* 样本的 BOOT_FAIL 是**同一个既有类型缺口**，
  //     不是"转型没做"；真 flint 侧 12 行语义全实现）。语义见 SPEC「C 风格转型」节。
  //   节点 70 编码（val）：0=(int) 恒等 ｜ 3=(char) 截断 0..255 ｜ 1=(int*) 2=(char*) 只换类型不发字节。
  //   ty：0=int 值 ｜ 1=地址·elem int ｜ 2=地址·elem char（与既有地址类节点同口径）。
  if (tok_is(p, '(')) {
    int nx = p->i + 1;
    int c_is_int = 0;
    int c_is_char = 0;
    if (nx < p->n && p->ks[nx] == 1) {
      if (tok_ident_at(p, nx, "int")) { c_is_int = 1; }
      else if (tok_ident_at(p, nx, "char")) { c_is_char = 1; }
    }
    if (c_is_int == 1 || c_is_char == 1) {
      p->i = p->i + 2;                                 // 吃 '(' 与类型词
      int ck = 0;
      // ⚠️ 不用三目 `?:`：boot 的解析器**没有三元运算符**（编译自身时 -57）。一并列写清。
      if (tok_is(p, '*')) {
        p->i = p->i + 1;
        if (c_is_int == 1) { ck = 1; } else { ck = 2; }
      } else {
        if (c_is_int == 1) { ck = 0; } else { ck = 3; }
      }
      if (!tok_is(p, ')')) { return -230; }             // 转型写法：(类型)表达式
      p->i = p->i + 1;
      int c_opnd = parse_factor(p, a);
      if (c_opnd < 0) { return c_opnd; }
      int *c_ty = a->ty;
      int c_st = c_ty[c_opnd];
      if (ck == 1 || ck == 2) {
        if (c_st < 1) { return -231; }                  // 整数不能转指针（T1 边界的对偶）
      } else {
        if (c_st >= 1) { return -232; }                 // 地址值不能转 int/char（T1 边界）
      }
      int c_n = new_node(a, 70, c_opnd, 0);
      int *c_v = a->val;
      c_v[c_n] = ck;
      if (ck == 1) { return set_ty(a, c_n, 1); }
      if (ck == 2) { return set_ty(a, c_n, 2); }
      return c_n;                                       // ck 0/3 → int 值（ty 保持 0）
    }
  }
  if (tok_is(p, '(')) {
    p->i = p->i + 1;
    int e = parse_expr(p, a);
    if (e < 0) return -1;
    if (!tok_is(p, ')')) return -2;
    p->i = p->i + 1;
    return e;
  }
  // v1.5.0：表达式里的 str([...]) 一律**响亮报错**（见 parse_primary 最前面那处检查；
  //   这里保留下面的旧注释位置不再重复判定）
  if (tok_is(p, '-')) {
    p->i = p->i + 1;
    int f = parse_factor(p, a);
    if (f < 0) return -3;
    return new_node(a, 5, f, 0);
  }
  if (tok_is(p, '!')) {                 // 一元逻辑非（'!=' 在 rel 层已消费）
    p->i = p->i + 1;
    int f = parse_factor(p, a);
    if (f < 0) return -4;
    return new_node(a, 20, f, 0);
  }
  if (tok_is(p, '~')) {                 // B2h：一元按位取反
    p->i = p->i + 1;
    int f2 = parse_factor(p, a);
    if (f2 < 0) return -4;
    return new_node(a, 49, f2, 0);
  }
  if (tok_is(p, '*')) {                 // B2j：*q 解引用读（宽度随被指对象类型）
    p->i = p->i + 1;
    int fo = parse_factor(p, a);
    if (fo < 0) return -5;
    int *tyo = a->ty;
    int et = tyo[fo];
    if (et == 0) return -157;           // 解引用非指针（拒绝）
    int di = new_node(a, 53, fo, 0);
    if (et == 3) { return set_ty(a, di, 1); }   // 指向指针槽 → 结果是地址类（8 字节读）
    return di;                                   // et 1/2 → int/char 值
  }
  if (tok_is(p, '&')) {                 // B2f：取址（本地变量/数组/struct）
    p->i = p->i + 1;
    int *ks2 = p->ks;
    int *ps2 = p->ps;
    int *ls2 = p->ls;
    if (p->i >= p->n || ks2[p->i] != 1) return -155;
    int k2 = find_var_idx(p, ps2[p->i], ls2[p->i]);
    if (k2 < 0) {
      // 2026-09-21（卡 T-20260921-194703）：&全局名 —— 地址 = 首地址（`&garr[i]` = 元素地址）。
      //   与本地那条同口径：标量取址给「单元素地址」，数组取址给「首元素地址」。
      int gk2 = g_find(p, ps2[p->i], ls2[p->i]);
      if (gk2 >= 0) {
        int *gt2 = p->gty;
        p->i = p->i + 1;
        if (tok_is(p, '[')) {
          if (gt2[gk2] == 0 || gt2[gk2] == 1) { return -47; }
          p->i = p->i + 1;
          int ixg = parse_expr(p, a);
          if (ixg < 0) { return -14; }
          if (!tok_is(p, ']')) { return -15; }
          p->i = p->i + 1;
          return g_elem_addr(p, a, gk2, ixg);
        }
        return g_addr_node(p, a, gk2);
      }
      // B2n：&函数名 = 函数地址值（回调地基，对齐真 flint 决策 28；名后紧跟 '(' 不算取址）
      int *vs2 = p->vs;
      int nx2 = p->i + 1;
      if (nx2 < p->n && ks2[nx2] == 3 && vs2[nx2] == '(') return -155;
      int fi2 = find_func_at(p, ps2[p->i], ls2[p->i]);
      if (fi2 < 0) return -155;
      int fa2 = new_node(a, 64, 0, 0);
      int *vvf = a->val;
      vvf[fa2] = fi2;
      p->i = p->i + 1;
      return set_ty(a, fa2, 1);
    }
    int *vslots2 = p->vslots;
    int *vsp2 = p->vsp;
    int spec2 = vsp2[k2];
    int ty2 = spec_ty(spec2);
    int sid2 = spec_sid(spec2);
    int slot2 = vslots2[k2] - p->sbase;
    int n2 = spec_n(spec2);                                     // B2j：数组/struct 取址 = 保留区最低槽
    // 2026-09-22（卡 T-20260922-201154）：**struct 与数组的"基址槽"不是同一头** ——
    //   · 数组：基址 = 保留区**最低**槽（元素升序排上去，老口径不变）；
    //   · struct：字段地址 = 基址 + 字段字节偏移（`fld_code` 的 序号*1000+偏移、`field_arr_addr` 同款），
    //     所以基址要取保留区**最高**槽（最低槽 + 槽数 - 1）—— 真 flint 同口径（sarp1 实测：
    //     struct 基址 `lea -0x608(%rbp)` ＝ 最高槽，字段 +4、元素 +8i ⇒ a[191] 落 -0x60C）。
    //     ⚠️ 原来两者同取"最低槽"是**错的**：struct 的字段基址因此越过保留区上界 4 字节、
    //       数组字段更是直接写穿整个帧（实测 12 次崩 4~5 次，0xC0000005）。
    //   · struct 数组（ty=6，v2.1.0）：保留区是 N 个元素连排 ⇒ 基址同样取**最高**槽，
    //     因为元素 i 的地址 = 基址 + i×步长（步长 = nslots×8），元素沿地址**升序**排上去。
    if (ty2 == 1 || ty2 == 3 || ty2 == 4 || ty2 == 6 || ty2 == 8) { slot2 = slot2 + n2 - 1; }
    p->i = p->i + 1;
    if (ty2 == 6) {                             // v2.1.0：&a[i] ／ &a[i].f ／ &a
      // &a[i] = **元素地址本身**（不套取址节点 —— 那条地址链就是地址，SPEC v2.1.0 明写）。
      if (tok_is(p, '[')) {
        p->i = p->i + 1;
        int ix6 = parse_expr(p, a);
        if (ix6 < 0) return -14;
        if (!tok_is(p, ']')) return -15;
        p->i = p->i + 1;
        int el6 = sarr_elem_addr(a, slot2, ix6, st_nslots(p, spec_sid(spec2)) * 8);
        if (!tok_is(p, '.')) { return el6; }
        p->i = p->i + 1;
        if (p->i >= p->n || ks2[p->i] != 1) return -156;
        int f6 = st_find_field(p, spec_sid(spec2), ps2[p->i], ls2[p->i]);
        if (f6 < 0) return -156;
        p->i = p->i + 1;
        int off6 = st_fld(p, f6, 3);
        if (st_fty(p, f6) == 3 && (tok2_is(p, '-', '>') || tok_is(p, '['))) {
          // v2.3：`&a[i].next->v` / `&a[i].next[0].v` —— 先读出指针字段，再沿链取最后一跳的地址
          int rd6 = new_node(a, 53, sarr_fld_addr(a, el6, off6, 3), 0);
          set_ty(a, rd6, 3);
          int oft6 = -1;
          return chain_fld_addr(p, a, rd6, st_fsid(p, f6), &oft6, 0);
        }
        if (tok_is(p, '[')) {                   // &a[i].buf[j]（元素内定长数组字段）
          if (st_is_arr(p, f6) == 0) return -47;
          return field_arr_addr(p, a, sarr_fld_addr(a, el6, off6, 1), st_fty(p, f6));
        }
        return sarr_fld_addr(a, el6, off6, fld_addr_ty(st_fty(p, f6)));
      }
      int a6 = new_node(a, 25, 0, 0);           // &a = 首元素地址（与 a 作表达式同值）
      int *vv6 = a->val;
      vv6[a6] = slot2;
      return set_ty(a, a6, 3);
    }
    if (ty2 == 2 && spec_aux(spec2) == 2 && tok_is(p, '[')) {   // v2.2：&p[i] ／ &p[i].f（元素地址本身）
      p->i = p->i + 1;
      int ixp = parse_expr(p, a);
      if (ixp < 0) return -14;
      if (!tok_is(p, ']')) return -15;
      p->i = p->i + 1;
      int sidp = spec_sid(spec2);
      int elp = sptr_elem_addr(a, slot2, ixp, st_nslots(p, sidp) * 8);
      if (!tok_is(p, '.')) { return elp; }
      p->i = p->i + 1;
      if (p->i >= p->n || ks2[p->i] != 1) return -156;
      int fp2 = st_find_field(p, sidp, ps2[p->i], ls2[p->i]);
      if (fp2 < 0) return -156;
      p->i = p->i + 1;
      int offp2 = st_fld(p, fp2, 3);
      if (tok_is(p, '[')) {
        if (st_is_arr(p, fp2) == 0) return -47;
        return field_arr_addr(p, a, sarr_fld_addr(a, elp, offp2, 1), st_fty(p, fp2));
      }
      return sarr_fld_addr(a, elp, offp2, fld_addr_ty(st_fty(p, fp2)));
    }
    if (tok2_is(p, '-', '>')) {                 // B2h：&p->f（struct* 字段地址）
      if (ty2 != 2 || spec_aux(spec2) != 2) return -156;
      p->i = p->i + 2;
      if (p->i >= p->n || ks2[p->i] != 1) return -156;
      int f2 = st_find_field(p, sid2, ps2[p->i], ls2[p->i]);
      if (f2 < 0) return -156;
      p->i = p->i + 1;
      int ai2 = new_node(a, 51, slot2, 0);
