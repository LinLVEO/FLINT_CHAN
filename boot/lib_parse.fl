          //   ⇒ a[i] 可直接作 struct S * 实参；&a[i] 就是这个值（'&' 分支直接返回它）；
          //     a[i].f 在这条地址链上再叠字段偏移（sarr_fld_read）。
          p->i = p->i + 1;
          int e6 = parse_expr(p, a);
          if (e6 < 0) return -14;
          if (!tok_is(p, ']')) return -15;
          p->i = p->i + 1;
          int el6 = sarr_elem_addr(a, slot + spec_n(spec) - 1, e6, st_nslots(p, spec_sid(spec)) * 8);
          if (tok_is(p, '.')) {                                   // a[i].字段
            p->i = p->i + 1;
            return sarr_fld_read(p, a, el6, spec_sid(spec));
          }
          if (tok_is(p, '[')) return -13;                          // a[i][j]：不猜（SPEC 禁区 5）
          return el6;
        }
        if (ty == 2 && spec_aux(spec) == 2) {                     // v2.2：struct 指针下标 p[i]
          // 语义与 a[i] 完全同形：p 的值 + i×步长 = 元素地址（ty=3 地址类）⇒ p[i].f 再叠字段偏移。
          p->i = p->i + 1;
          int xp = parse_expr(p, a);
          if (xp < 0) return -14;
          if (!tok_is(p, ']')) return -15;
          p->i = p->i + 1;
          int sidp = spec_sid(spec);
          int elp = sptr_elem_addr(a, slot, xp, st_nslots(p, sidp) * 8);
          if (tok_is(p, '.')) {                                   // p[i].字段
            p->i = p->i + 1;
            return sarr_fld_read(p, a, elp, sidp);
          }
          if (tok_is(p, '[')) return -13;                          // p[i][j]：不猜（与 a[i][j] 同一条禁区）
          return elp;
        }
        if (ty == 0 || ty == 3) return -13;                       // 标量/struct 不能下标
        p->i = p->i + 1;
        int e = parse_expr(p, a);
        if (e < 0) return -14;
        if (!tok_is(p, ']')) return -15;
        p->i = p->i + 1;
        // v2.2.0：二维 int 数组 `m[i][j]` —— 第二维折成 `i*cols + j`，再喂**既有** kind 23。
        //   ⇒ 发射侧零改动；线性下标表达式与一维下标走同一条路（表达式下标本来就被支持）。
        if (ty == 8) {
          if (!tok_is(p, '[')) return -277;                       // 只写一维：不猜（防静默读错行）
          p->i = p->i + 1;
          int e2 = parse_expr(p, a);
          if (e2 < 0) return -14;
          if (!tok_is(p, ']')) return -15;
          p->i = p->i + 1;
          int cols7 = spec / 1000000 - 800;
          int cn7 = new_node(a, 0, 0, 0);
          int *vvn7 = a->val;
          vvn7[cn7] = cols7;
          int ml7 = new_node(a, 3, e, cn7);
          int lin7 = new_node(a, 1, ml7, e2);
          return new_node(a, 23, slot + spec_n(spec) - 1, lin7);
        }
        if (ty == 1) return new_node(a, 23, slot + spec_n(spec) - 1, e);   // 本地 int 数组（升序基址）
        if (ty == 4) return new_node(a, 39, slot + spec_n(spec) - 1, e);   // 本地 char 数组（升序基址）
        if (spec_aux(spec) == 1) return new_node(a, 37, slot, e); // char* → 字节
        return new_node(a, 28, slot, e);                          // int*/struct* → 8 字节
      }
      if (ty == 1 || ty == 8) {                                   // 裸 int 数组名 = 取址（升序基址）
        int ai = new_node(a, 25, 0, 0);
        vv[ai] = slot + spec_n(spec) - 1;
        return set_ty(a, ai, 1);
      }
      if (ty == 4) {                                              // 裸 char 数组名 = 取址（升序基址）
        int ai2 = new_node(a, 25, 0, 0);
        vv[ai2] = slot + spec_n(spec) - 1;
        return set_ty(a, ai2, 2);                                 // B2j：char 数组 → char*
      }
      if (ty == 2) {                                              // 指针变量读（64 位）
        int pi = new_node(a, 26, 0, 0);
        vv[pi] = slot;
        int aux2 = spec_aux(spec);                                // B2j：elem 随指针类型
        int pt = 1;
        if (aux2 == 1) { pt = 2; }
        else if (aux2 == 2) { pt = 3; }
        return set_ty(a, pi, pt);
      }
      if (ty == 6) {                                              // v2.1.0：struct 数组名 = 首元素地址
        // 与「struct 变量名作表达式 = 首地址」同一条语义（SPEC v2.1.0）；基址 = 保留区最高槽。
        // 所以 `setn(a, 55)`（形参 struct Pair *）拿到的就是 &a[0]，与真 flint 同口径。
        int ai6 = new_node(a, 25, 0, 0);
        vv[ai6] = slot + spec_n(spec) - 1;
        return set_ty(a, ai6, 3);
      }
      if (ty == 3) return -154;                                   // struct 值不能当表达式
      if (ty == 5) {                                              // B2g char 标量读（字节）
        int ci = new_node(a, 42, 0, 0);
        vv[ci] = slot;
        return ci;
      }
      int idx = new_node(a, 6, 0, 0);
      vv[idx] = slot;
      // 2026-10-18（task 2b / rev4）：T1 —— 该槽已标「装过地址」⇒ 读节点打标（发射端 8 字节读）
      if (slot_addr_mark(p, slot) == 1) { p->pmark[idx] = 2; }
      return idx;
    }
  }
  return -4;
}

// —— B2k：复合赋值 / ++ / -- ——
// 把「已解析成值的左值节点」转成「地址节点」（-1 = 不是左值）
//   6=int 变量｜26=指针变量｜42=char 标量｜30/55=本地字段｜32/57=指针字段｜23/28/37/39=元素｜53=*q
int lv_elem(struct Ast *a, int n, int base_ty, int scale) {
  int *kd = a->kind;
  int *ll = a->l;
  int *rr = a->r;
  int *vv = a->val;
  int k = kd[n];
  int base = 0;
  if (k == 23 || k == 39) {                   // 本地数组：基址 = 最低槽（lea）
    int bs = new_node(a, 25, 0, 0);
    vv[bs] = ll[n];
    set_ty(a, bs, base_ty);
    base = bs;
  } else {                                    // 指针元素：基址 = 指针值
    int ps = new_node(a, 26, 0, 0);
    vv[ps] = ll[n];
    set_ty(a, ps, base_ty);
    base = ps;
  }
  int off = rr[n];
  if (scale != 1) {                           // 2026-10-17：int 元素 4 / 指针元素 8 都走这条
    int n8 = new_node(a, 0, 0, 0);
    vv[n8] = scale;
    off = new_node(a, 3, off, n8);            // 下标 * 元素宽
  }
  int ad = new_node(a, 1, base, off);         // 基址 + 偏移（地址类 → 64 位加）
  return set_ty(a, ad, base_ty);
}

int lv_addr_from(struct Ast *a, int n) {
  int *kd = a->kind;
  int *ll = a->l;
  int *vv = a->val;
  int *ty = a->ty;
  int k = kd[n];
  if (k == 53) { return ll[n]; }              // *q → 地址 = q 本身
  if (k == 6) {                               // int 变量（4 字节）
    int a1 = new_node(a, 25, 0, 0);
    vv[a1] = vv[n];
    return set_ty(a, a1, 1);
  }
  if (k == 26) {                              // 指针变量（8 字节：改的是指针本身）
    int a2 = new_node(a, 25, 0, 0);
    vv[a2] = vv[n];
    return set_ty(a, a2, 3);
  }
  if (k == 42) {                              // char 标量（1 字节）
    int a3 = new_node(a, 25, 0, 0);
    vv[a3] = vv[n];
    return set_ty(a, a3, 2);
  }
  if (k == 30) {                              // 本地 struct 字段
    int at = 3;
    if (ty[n] == 0) { at = 1; }
    int a4 = new_node(a, 52, ll[n], 0);
    vv[a4] = vv[n];
    return set_ty(a, a4, at);
  }
  if (k == 32) {                              // 指针 -> 字段
    int at2 = 3;
    if (ty[n] == 0) { at2 = 1; }
    int a5 = new_node(a, 51, ll[n], 0);
    vv[a5] = vv[n];
    return set_ty(a, a5, at2);
  }
  if (k == 55) {                              // B2k 本地 char 字段（1 字节）
    int a6 = new_node(a, 52, ll[n], 0);
    vv[a6] = vv[n];
    return set_ty(a, a6, 2);
  }
  if (k == 57) {                              // B2k 指针 -> char 字段（1 字节）
    int a7 = new_node(a, 51, ll[n], 0);
    vv[a7] = vv[n];
    return set_ty(a, a7, 2);
  }
  if (k == 23) { return lv_elem(a, n, 1, 4); }   // 本地 int 数组元素（4 字节）
  if (k == 28) { return lv_elem(a, n, 1, 4); }   // int* 元素（4 字节；struct* 未支持）
  if (k == 39) { return lv_elem(a, n, 2, 1); }   // 本地 char 数组元素
  if (k == 37) { return lv_elem(a, n, 2, 1); }   // char* 元素
  return -1;
}

// 构造自增/自减节点（op 1=++ 2=--；post 1=后缀）；宽度由地址节点类型定
int make_incdec(struct Ast *a, int addr, int op, int post) {
  int *ty = a->ty;
  int w = 4;
  if (ty[addr] == 2) { w = 1; }
  else if (ty[addr] == 3) { w = 8; }
  int n1 = new_node(a, 0, 0, 0);
  int *vv = a->val;
  vv[n1] = 1;
  int idx = new_node(a, 60, addr, n1);
  vv[idx] = op * 1000 + w * 100 + post;
  // v1.4.15（任务卡 T-20260918-005227）：8 字节目标（指针槽）→ 结果本身就是地址类，标上 ty
  //   供消费侧判宽度/零扩展。此前不标 ⇒ ty 默认 0 ⇒ `int *old = p++;` 被当「int → 指针」零扩展，
  //   发 mov eax,eax 把地址高 32 位抹掉（非 ASLR 侥幸对，一开 ASLR 就错地址/崩）。
  if (w == 8) { set_ty(a, idx, ty[addr]); }
  return idx;
}

// 探测**语句**里的复合赋值 / ++ / --（-1 = 不是；< -1 = 错误码）
//   节点 60：l = 地址表达式，r = 右值，val = op*1000 + 宽度*100 + 后缀标志
//   2026-09-20：核心拆到 lv_compound_at（不带 ';'），供「表达式位」复用（`return a += 3;` / for 头 init）
int lv_compound(struct Parse *p, struct Ast *a, int addr) {
  int idx = lv_compound_at(p, a, addr);
  if (idx == -1) { return -1; }
  if (idx < -1) { return idx; }
  if (!tok_is(p, ';')) { return -57; }
  p->i = p->i + 1;
  return idx;
}

// 复合赋值 / ++ / -- 的核心：探测运算符 + 解析右值 → 节点 60；**不吃 ';'**
//   -1 = 不是复合赋值；< -1 = 错误码（与 lv_compound 同码）
int lv_compound_at(struct Parse *p, struct Ast *a, int addr) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i;
  int op = 0;
  int post = 0;
  int guard = 0;                                    // 2026-09-20：`==` 前缀（`=` `=`）即置位
  if (i + 1 < p->n && ks[i] == 3 && ks[i + 1] == 3) {
    int c1 = vs[i];
    int c2 = vs[i + 1];
    if (c2 == '=') {
      if (c1 == '+') { op = 1; }
      else if (c1 == '-') { op = 2; }
      else if (c1 == '*') { op = 3; }
      else if (c1 == '/') { op = 4; }
      else if (c1 == '%') { op = 10; }            // B2l：%=（em_apply op 10 = 取余数 edx）
      else if (c1 == '&') { op = 5; }
      else if (c1 == '|') { op = 6; }
      else if (c1 == '^') { op = 7; }
      // ⚠️ 只有「`=` 后面还是 `=`」才排除（`==`）；`<=` `>=` `!=` 的前缀分别是 `<` `>` `!`，
      //   它们的**第二个 token** 才是 `=`，不会走到这里（到这里的 p->i 已经指着 `=` 了）——
      //   2026-09-20 实测：早先把 `=` 本身也置 guard，结果把 `a += 3` 的复合赋值判成"不是复合"
      //   直接跳过（comp3 报 -48）。别再把 c1=='=' 当 guard。
      else { if (c1 == '=') { guard = 1; } }
      if (op != 0) { p->i = p->i + 2; }
    } else if (c1 == '+' && c2 == '+') { op = 1; post = 1; p->i = p->i + 2; }
    else if (c1 == '-' && c2 == '-') { op = 2; post = 1; p->i = p->i + 2; }
  }
  if (op == 0 && i + 2 < p->n && ks[i] == 3 && ks[i + 1] == 3 && ks[i + 2] == 3) {
    int d1 = vs[i];
    int d2 = vs[i + 1];
    int d3 = vs[i + 2];
    if (d1 == '<' && d2 == '<' && d3 == '=') { op = 8; p->i = p->i + 3; }
    else if (d1 == '>' && d2 == '>' && d3 == '=') { op = 9; p->i = p->i + 3; }
  }
  if (op == 0) { return -1; }
  int *ty = a->ty;
  int w = 4;
  if (ty[addr] == 2) { w = 1; }
  else if (ty[addr] == 3) { w = 8; }
  if (w == 8 && (op == 3 || op == 4 || op == 10)) { return -170; }   // 指针不支持 * / % 复合
  int idx = 0;
  if (post == 1) {
    idx = make_incdec(a, addr, op, 1);
  } else {
    int r = parse_expr(p, a);
    if (r < 0) { return -55; }
    idx = new_node(a, 60, addr, r);
    int *vv = a->val;
    vv[idx] = op * 1000 + w * 100;
    if (w == 8) { set_ty(a, idx, ty[addr]); }   // v1.4.15：同上（8 字节目标 = 地址类结果）
  }
  return idx;
}

// ===== 2026-09-20（卡 T-20260920-001345）：赋值表达式（`i = 1` / `a += 3`）用于**表达式位** =====
// 真 flint 里赋值是表达式（src\parse.c:1129 `expr()` = `assign()`，实测 q3/q4/q9/q10 全通过），
//   但 boot 的 parse_expr 只到 or/and 层 ⇒ for 头 init 的 `i = 1` 与 `return a += 3;` 被拒
//   （-192 / -48）。真 flint 在 return 处的例外：`return;` 只能用在 void 函数（实测 p4 报错），
//   除此之外 `return 赋值表达式` 与 for 头 init 都是合法的。
// 本函数**不吃 ';'**：调用方各自处理分号（for 头是 ';'，return 是 ';'，语句位是 ';'）
//   -1 = 解析失败；其余 = 表达式节点
// ===== 2026-09-20（卡 T-20260920-001345）：**for 头三段**专用赋值段解析 =====
// 真 flint 里赋值是表达式（src\parse.c:1129 `expr()` = `assign()`；实测 q1/q3/q4/q9/q10/q13 全通过），
//   而 boot 的 `parse_expr` 只到 or/and 层 ⇒ for 头 init/inc 的 `i = 1` / `i = i + 1` 被拒
//   （-192 / -196）。真 flint 的例外只有一处：`return;` 只能出现在 void 函数（实测 p4 报错）。
// 本函数**专供 for 头 init / inc 段**（不吃 ';' 也不吃 ')'，调用方自己收尾）：
//   ① 先按 primary 解析（左值一定是 primary：变量 / 字段 / 元素 / *q / ++--）
//   ② 命中复合赋值（`+=` … `<<=`）→ 节点 60（判据明确，与比较运算符不会混淆）
//   ③ 命中简单赋值（`=` 且后面还能起表达式）→ 节点 66；RHS 递归（右结合）
//   ④ 都不是 → **把 token 位退回**，交回通用 parse_expr（`i < 3`、`f(x) + 1` 等）
// ⚠️ 关键：④ 的「退回」是这套写法成立的前提 —— `parse_primary` 会先吃掉一个 primary，
//   若不做退回，`for (i = 0; i < 3; ...)` 的 init 段会把条件段的 `<` 当左值继续解析（实测 -196）。
int parse_for_head_expr(struct Parse *p, struct Ast *a) {
  int *ks = p->ks;
  int *vs = p->vs;
  int save = p->i;
  // ⚠️⚠️ 2026-09-20 实测踩坑（本轮挂死 14 分钟的第二元凶，必须记住这条模式）：
  //   **解析器里任何「不消费 token 就返回」的路径都是死循环源**。早先这里加过一条
  //   「token 种类不对就直接 return parse_expr(p, a)」的守卫 —— 它对 `++i;`/`i++;` 这类
  //   以符号开头的段会**不消费就返回**，而调用方的 for 体/语句块循环看到 token 没动就原地转，
  //   表现为「100% CPU、无输出、无产物、永不结束」（实测 arr2/st2/arr3 全中）。
  //   正解：入口**一律先吃一个 primary**，只在拿不到 primary 或「不是赋值段」时才**先回退
  //   p->i 再**走通用解析器 —— 保证每条出口都前进或明确报错。
  int lhs = parse_primary(p, a);
  if (lhs < 0) { p->i = save; return parse_expr(p, a); }
  int ad = lv_addr_from(a, lhs);
  if (ad >= 0) {
    int cpd = lv_compound_at(p, a, ad);
    if (cpd != -1) { return cpd; }
  }
  int go = 0;
  if (ad >= 0 && p->i + 1 < p->n) {
    if (ks[p->i] == 3 && vs[p->i] == '=' && ks[p->i + 1] != 0) { go = 1; }
  }
  if (go == 1) {
    p->i = p->i + 1;                                  // 吃 '='
    int rhs = parse_for_head_expr(p, a);              // 右值：赋值 / 普通表达式都行
    if (rhs < 0) { return rhs; }
    return make_simple_assign(p, a, lhs, rhs);
  }
  p->i = save;                                        // 不是赋值段 → 退回，交给通用表达式解析器
  return parse_expr(p, a);
}


// 简单赋值节点（lhs = **值节点**，内部经 lv_addr_from 转地址）
//   统一产出节点 66（发射器侧「先右值 → 再地址 → 写」，不读旧值，对未初始化的目标也安全）。
//   0 = 成功；< 0 = 错误码（与「赋值语句」老路同码：-53 认不得左值 / -198 指针目标值门槛）
int make_simple_assign(struct Parse *p, struct Ast *a, int lhs, int rhs) {
  int ad = lv_addr_from(a, lhs);
  if (ad < 0) { return -53; }
  int *ty = a->ty;
  int aty = ty[ad];
  int w = 4;
  if (aty == 2) { w = 1; } else if (aty == 3) { w = 8; }
  if (w == 4) {
    // 与赋值语句老路一致：整型标量 ← 地址值 → 打「装过地址」标记（v1.4.31 指针目标门槛用）
    int *kd = a->kind;
    if (kd[lhs] == 6) {
      int v = a->val[lhs];
      if (rhs_addr_like(p, a, rhs, 0) != 0) { set_addr_mark(p, v); }
    }
  }
  if (w == 8) {
    if (rhs_addr_like(p, a, rhs, 1) == 0) { return -198; }   // v1.4.31：指针目标值门槛
  }
  int idx = new_node(a, 66, ad, rhs);
  int *vv = a->val;
  vv[idx] = w * 100;
  if (w == 8) { set_ty(a, idx, aty); }
  // 2026-10-18（task 2b / rev4）：T1 —— 目标是「装地址的 int」槽 ⇒ 8 字节写（发射端按此定宽）
  if (w == 4) { if (a->kind[lhs] == 6) { t1_mark_store(p, idx, a->val[lhs]); } }
  return idx;
}

// —— B2k：因子 = 前缀 ++/-- ｜ primary ｜ 后缀 ++/-- ——
int parse_factor(struct Parse *p, struct Ast *a) {
  // 2026-09-20（卡 T-20260920-001345）：**一元 `+` 本轮试过两次、两次都回归，已整条撤掉**。
  //   想要的形状 = 真 flint 的 `return +5 - -3 + -2;`（实测 6）。实测证据（两次都留了痕）：
  //   · 判据松（只看「是 `+` 且不是 `++`」）：`x++ + ++x` / `x++ + 1` / `1 + ++x` 三例全被
  //     误判成一元加，接着 prefix `++` 那条去要一个左值 ⇒ -48/-50（**inc6 从 OK 变红**）。
  //   · 判据紧（要求 `+` 与操作数源码紧邻、且下一个 token 不是符号）：上面三例**仍然红** ⇒
  //     说明 boot 的 `x++` 消费路径与这个判据另有交互，短时间没定位到。
  //   ⇒ **宁可整条撤掉**（回到 HEAD 行为；edge4 继续以 -48 记在缺口表里），也不留一个把
  //     inc6 这类既有正例弄红的半成品。要重做请单独立卡，拿 inc6 + edge4 两条一起钉。
  if (tok2_is(p, '+', '+')) {
    p->i = p->i + 2;
    int v1 = parse_primary(p, a);
    if (v1 < 0) { return v1; }
    int ad1 = lv_addr_from(a, v1);
    if (ad1 < 0) { return -171; }             // ++ 需要一个左值
    return make_incdec(a, ad1, 1, 0);
  }
  if (tok2_is(p, '-', '-')) {
    p->i = p->i + 2;
    int v2 = parse_primary(p, a);
    if (v2 < 0) { return v2; }
    int ad2 = lv_addr_from(a, v2);
    if (ad2 < 0) { return -171; }
    return make_incdec(a, ad2, 2, 0);
  }
  int base = parse_primary(p, a);
  if (base < 0) { return base; }
  if (tok2_is(p, '+', '+')) {
    p->i = p->i + 2;
    int ad3 = lv_addr_from(a, base);
    if (ad3 < 0) { return -171; }
    return make_incdec(a, ad3, 1, 1);
  }
  if (tok2_is(p, '-', '-')) {
    p->i = p->i + 2;
    int ad4 = lv_addr_from(a, base);
    if (ad4 < 0) { return -171; }
    return make_incdec(a, ad4, 2, 1);
  }
  return base;
}

int parse_term(struct Parse *p, struct Ast *a) {
  int node = parse_factor(p, a);
  if (node < 0) return -10;
  while (1) {
    if (tok_is(p, '*')) {
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -11;
      node = new_node(a, 3, node, f);
    } else if (tok_is(p, '/')) {
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -12;
      node = new_node(a, 4, node, f);
    } else if (tok_is(p, '%')) {                    // B2l：取模（C 语义：余数符号随被除数）
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -13;
      node = new_node(a, 61, node, f);
    } else {
      return node;
    }
  }
}

int parse_add(struct Parse *p, struct Ast *a) {
  int *tya = a->ty;
  int node = parse_term(p, a);
  if (node < 0) return -20;
  while (1) {
    if (tok_is(p, '+')) {
      p->i = p->i + 1;
      int t = parse_term(p, a);
      if (t < 0) return -21;
      int nt = addr_ty(tya[node], tya[t]);        // B2j：任一侧地址 → 结果也是地址链
      node = new_node(a, 1, node, t);
      if (nt >= 1) { set_ty(a, node, nt); }
    } else if (tok_is(p, '-')) {
      p->i = p->i + 1;
      int t = parse_term(p, a);
      if (t < 0) return -22;
      int nt2 = addr_ty(tya[node], tya[t]);
      node = new_node(a, 2, node, t);
      if (nt2 >= 1) { set_ty(a, node, nt2); }
    } else {
      return node;
    }
  }
}

// B2h：移位层（<< >>，左结合；C 优先级：移位高于关系）
int parse_shift(struct Parse *p, struct Ast *a) {
  int node = parse_add(p, a);
  if (node < 0) return -70;
  int more = 1;
  while (more == 1) {
    int op = 0;
    if (tok2_is(p, '<', '<')) { op = 44; p->i = p->i + 2; }
    else if (tok2_is(p, '>', '>')) { op = 45; p->i = p->i + 2; }
    else { more = 0; }
    if (op != 0) {
      int r = parse_add(p, a);
      if (r < 0) return -71;
      node = new_node(a, op, node, r);
    }
  }
  return node;
}

// B2d：关系层（== != < <= > >=，左结合；结果为 0/1）
int parse_rel(struct Parse *p, struct Ast *a) {
  int node = parse_shift(p, a);
  if (node < 0) return -30;
  int more = 1;
  while (more == 1) {
    int op = 0;
    if (tok2_is(p, '=', '=')) { op = 11; p->i = p->i + 2; }
    else if (tok2_is(p, '!', '=')) { op = 12; p->i = p->i + 2; }
    else if (tok2_is(p, '<', '=')) { op = 14; p->i = p->i + 2; }
    else if (tok2_is(p, '>', '=')) { op = 16; p->i = p->i + 2; }
    else if (tok_is(p, '<')) { op = 13; p->i = p->i + 1; }
    else if (tok_is(p, '>')) { op = 15; p->i = p->i + 1; }
    else { more = 0; }
    if (op != 0) {
      int r = parse_shift(p, a);
      if (r < 0) return -31;
      node = new_node(a, op, node, r);
    }
  }
  return node;
}

// B2h：按位与（&，须与 && 区分）
int parse_band(struct Parse *p, struct Ast *a) {
  int node = parse_rel(p, a);
  if (node < 0) return -74;
  int more = 1;
  while (more == 1) {
    if (tok_is(p, '&') && !tok2_is(p, '&', '&')) {
      p->i = p->i + 1;
      int r = parse_rel(p, a);
      if (r < 0) return -75;
      node = new_node(a, 46, node, r);
    } else { more = 0; }
  }
  return node;
}

// B2h：按位异或（^）
int parse_bxor(struct Parse *p, struct Ast *a) {
  int node = parse_band(p, a);
  if (node < 0) return -76;
  while (tok_is(p, '^')) {
    p->i = p->i + 1;
    int r = parse_band(p, a);
    if (r < 0) return -77;
    node = new_node(a, 47, node, r);
  }
  return node;
}

// B2h：按位或（|，须与 || 区分）
int parse_bor(struct Parse *p, struct Ast *a) {
  int node = parse_bxor(p, a);
  if (node < 0) return -78;
  int more = 1;
  while (more == 1) {
    if (tok_is(p, '|') && !tok2_is(p, '|', '|')) {
      p->i = p->i + 1;
      int r = parse_bxor(p, a);
      if (r < 0) return -79;
      node = new_node(a, 48, node, r);
    } else { more = 0; }
  }
  return node;
}

// B2d：逻辑与（&&，短路）
int parse_and(struct Parse *p, struct Ast *a) {
  int node = parse_bor(p, a);
  if (node < 0) return -40;
  while (tok2_is(p, '&', '&')) {
    p->i = p->i + 2;
    int r = parse_bor(p, a);
    if (r < 0) return -41;
    node = new_node(a, 21, node, r);
  }
  return node;
}

// B2d：逻辑或（||，短路）
int parse_or(struct Parse *p, struct Ast *a) {
  int node = parse_and(p, a);
  if (node < 0) return -50;
  while (tok2_is(p, '|', '|')) {
    p->i = p->i + 2;
    int r = parse_and(p, a);
    if (r < 0) return -51;
    node = new_node(a, 22, node, r);
  }
  return node;
}

int parse_expr(struct Parse *p, struct Ast *a) {
  return parse_or(p, a);
}

// —— B2d：语句块 { stmt* }（调用方已吃 '{'）——返回直接子语句数（base = nblk-cnt）
// ⚠️ 子语句先缓冲到局部数组，**全部解析完再一次性追加** blk——嵌套块的子语句会在解析期先入表，
//    边解析边追加会让父块的直接子语句与后代交错，base=nblk-cnt 取到的区间就错了（B2d 实证：got 43≠45）
// B2p：depth 区分「函数体顶层块」(0) 与「嵌套块」(1)——托管变量只在函数体顶层可声明（对齐真 flint 决策 20）
int parse_block(struct Parse *p, struct Ast *a, int depth) {
  int tmp[512];                             // B2h：单块直接子语句上限 512（原 64）
  int cnt = 0;
  int vmark = p->nvars;                     // B2g：块作用域（退出时回退变量表/槽计数）
  int smark = p->nslots;
  // B3a：嵌套块入口压「作用域标记」（空名 + 0 槽 + spec 0）——declare_var_spec 的查重扫到它就停，
  //   于是块内可声明与外层同名的变量（遮蔽）；块退出时 nvars 回退到 vmark 自动摘掉标记。
  //   顶层块（depth==0）不压：形参与函数体顶层变量同属一个作用域（对齐真 flint 实测：形参不可被遮蔽）
  if (depth != 0 && p->nvars < 512) {
    int *mvps = p->vps;
    int *mvls = p->vls;
    int *mvsp = p->vsp;
    int *mvslots = p->vslots;
    int *mvad = p->vad;
    int mi = p->nvars;
    mvps[mi] = 0;
    mvls[mi] = 0;
    mvsp[mi] = 0;
    mvslots[mi] = p->nslots;
    mvad[mi] = 0;                             // v1.4.31：作用域标记项不带「装地址」标记
    p->nvars = mi + 1;
  }
  while (!tok_is(p, '}')) {
    if (p->i >= p->n) return -100;
    if (cnt >= 512) return -101;
    int s = parse_stmt(p, a);
    if (s < 0) return s;
    tmp[cnt] = s;
    cnt = cnt + 1;
  }
  p->i = p->i + 1;   // 吃 '}'
  // B2p：托管变量（own/share）不可在嵌套块 / if·while·for 体内声明——真 flint 决策 20 同规
  //   （块退出后槽被复用，而出口清理只对最后一个绑定该槽的变量发码 → 循环里每轮泄漏一个对象）
  if (depth != 0) {
    int kk = vmark;
    while (kk < p->nvars) {
      if (mg_var_kind(p, kk) != 0) return -105;
      kk = kk + 1;
    }
  }
  p->nvars = vmark;
  p->nslots = smark;
  int *blk = p->blk;
  int i = 0;
  while (i < cnt) {
    if (p->nblk >= 131072) return -101;          // 块表上限 131072（2026-09-21 扩容；别与「单块直接子语句上限 512」混：后者是 tmp[512]）
    blk[p->nblk] = tmp[i];
    p->nblk = p->nblk + 1;
    i = i + 1;
  }
  return cnt;
}

// 语句位：'{' 开块；否则单语句包成 1 元素块（if/while 体统一按块处理）
int parse_stmt_block(struct Parse *p, struct Ast *a) {
  if (tok_is(p, '{')) {
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 1);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    return new_node(a, 19, base, cnt);
  }
  int s = parse_stmt(p, a);
  if (s < 0) return s;
  int *blk = p->blk;
  if (p->nblk >= 16384) return -104;
  blk[p->nblk] = s;
  p->nblk = p->nblk + 1;
  return new_node(a, 19, p->nblk - 1, 1);
}

// —— v1.5.0：段 → 输出函数下标（**print 与 str 共用的唯一一份分派**）——
//   fam = 0 → print 的 `_flint_out_{str,char,int}`；fam = 1 → str 的 `_flint_str_put_{str,char,int}`
//   （两条腿的段类型判定**逐条同口径**：char 值段 = char、char* 地址段(ty==2) = 串、其余 = int 十进制；
//     boot 无 double ⇒ 这一层没有 dbl 支，与真 flint 的差异记在 lib_str.fl 头注释里）
//   返回函数表下标；<0 = 注入库缺失（调用方按 -183/-213 报错）
int seg_out_fn(struct Parse *p, struct Ast *a, int e, int fam) {
  int *fpty = p->fpty;                      // B4b：判「char 值返回的调用」段（真 flint 按返回类型分派）
  int *avv = a->val;
  int *ty = a->ty;
  int *kd = a->kind;
  int kind = 2;                             // 2 = int 十进制（默认档）
  // B2i：char 值段识别扩展——char 标量(42) / char* 下标读(37) / char 数组下标读(39)
  if (kd[e] == 42 || kd[e] == 37 || kd[e] == 39) { kind = 1; }
  else if (kd[e] == 10 && fn_retptr(fpty[avv[e]]) == 4) { kind = 1; }   // B4b：char 值返回的调用
  else if (ty[e] == 2) { kind = 0; }                                    // B2j：ty 2 = char* 地址段
  if (fam == 0) {
    if (kind == 0) { return find_func_by(p, "_flint_out_str"); }
    if (kind == 1) { return find_func_by(p, "_flint_out_char"); }
    return find_func_by(p, "_flint_out_int");
  }
  if (kind == 0) { return find_func_by(p, "_flint_str_put_str"); }
  if (kind == 1) { return find_func_by(p, "_flint_str_put_char"); }
  return find_func_by(p, "_flint_str_put_int");
}

// —— v1.5.0：str 内建 —— str([段, ...]) → char*（拼进静态缓冲，**不**输出到 stdout）——
//   与真 flint **同口径**：只在 3 个语句级形态可用（char*/int* 声明初始化 / 赋值右值 / 指针返回函数的 return）。
//   v2.3.x 起同一个函数还服务 str_into(dst[, cap], [...])（调用方按 str_into_ahead 判形态，见函数内注释）。
//   展开 = **语句链**（begin + 各段 put + end），段序由语句序保证（不靠实参求值顺序 —— 真 flint 侧实测
//   实参是**右→左**求值，嵌套调用链会静默拼错；本文件 parse_print 的老写法是块语句，天然没这问题）。
// p->i 必须停在 'str' / 'str_into' 上。返回末尾收尾调用节点下标（str = `_flint_str_end()` 0 参；
// str_into = `_flint_str_end_to(dst, cap)` 2 参）——**函数下标已由本函数填入**，调用方只当值用。
//   值 = char*（失败时 0）；begin/各段 put 已按序追加进 blk 表 ⇒ 调用方用「进函数前记 mark = p->nblk」
//   取 cnt 并包成块节点。
int parse_str_body(struct Parse *p, struct Ast *a) {
  // v2.3.x（2026-10-24）：本函数同时服务 str([...]) 与 str_into(dst[, cap], [...])——
  //   两条腿的段机制/控制流**逐条相同**（begin + 各段 put），只有三处不同：
  //   ① 关键词后面多两个表达式实参（dst / cap）② 末尾换成 _flint_str_end_to ③ 2 参数组形态的
  //   cap 由 dst 的**数组声明**推出来。语义权威 = src\parse.c 的 str_parse_body（into 分支）。
  int into = str_into_ahead(p, 0);
  int fb = find_func_by(p, "_flint_str_begin");
  int fe = find_func_by(p, "_flint_str_end");
  if (into == 1) { fe = find_func_by(p, "_flint_str_end_to"); }
  if (fb < 0 || fe < 0) return -213;            // 注入库缺失（编译器内部问题）
  p->i = p->i + 1;                              // 吃 'str' / 'str_into'
  if (!tok_is(p, '(')) return -210;
  p->i = p->i + 1;
  int dstn = -1;
  int capn = -1;
  if (into == 1) {
    // —— dst：任意 char* 表达式（真 flint 用 assign 层；boot 的 parse_expr 就是这一层）——
    //    记下**第一个 token** 的 pos/len：2 参数组形态要拿它去查"这是不是本函数里声明的数组"。
    int dpos = -1;
    int dlen = 0;
    if (p->i < p->n && p->ks[p->i] == 1) { dpos = p->ps[p->i]; dlen = p->ls[p->i]; }
    dstn = parse_expr(p, a);
    if (dstn < 0) return -211;
    if (!tok_is(p, ',')) return -210;
    p->i = p->i + 1;
    if (tok_is(p, '[')) {
      // —— 2 参数组形态：cap = 数组声明里的字节数（含结尾 0），省掉手算容量这个容易错的活 ——
      //   真 flint 口径 = ty_arr_stride(elem_ty) * arr_len（src\parse.c :3125-3127）。
      //   boot 的数组长度编码在**变量规格**里（declare_arr 100000000+n / declare_carr 400000000+n）：
      //     ty 4（char 数组）⇒ spec_n 就是**字节数**（declare_carr 存的是字节数）；
      //     ty 1（int 数组）⇒ spec_n 是**元素数**，元素宽按真 flint 的 ty_arr_stride(int) = 4 乘。
      //   ⚠️ 别把 boot 自己的 8 字节槽宽写进来：cap 是**给用户看的字节数**，要和真 flint 同一个数
      //      （boot 的 int 数组实际占 8*n 槽 ⇒ 4*n 只会少用、永不越界，两个方向都安全）。
      if (dpos < 0) return -250;
      int dv = find_var_idx(p, dpos, dlen);
      if (dv < 0) return -250;
      int *vspc = p->vsp;
      int dspc = vspc[dv];
      int dtyc = spec_ty(dspc);
      if (dtyc != 4 && dtyc != 1) return -250;
      int capv = spec_n(dspc);
      if (dtyc == 1) { capv = capv * 4; }
      capn = new_node(a, 0, 0, 0);
      int *vvc = a->val;
      vvc[capn] = capv;
    } else {
      capn = parse_expr(p, a);
      if (capn < 0) return -211;
      if (!tok_is(p, ',')) return -210;
      p->i = p->i + 1;
    }
  }
  if (!tok_is(p, '[')) return -210;
  p->i = p->i + 1;
  int bnode = new_node(a, 10, 0, 0);            // 10 = call（0 参）
  int *vv = a->val;
  vv[bnode] = fb;
  int *blk = p->blk;
  if (p->nblk >= 131072) return -101;
  blk[p->nblk] = bnode;
  p->nblk = p->nblk + 1;
  if (!tok_is(p, ']')) {
    int more = 1;
    while (more == 1) {
      // ===== v1.6.2：段位置里的裸 `endl` = 换行段（C++ 的 std::endl 用法）=====
      //   与真 flint 同口径（src\parse.c 的 at_endl_seg / endl_seg_node）：段位置 + 后面紧跟 ',' 或 ']'，
      //   展开成**已有的**字符串字面量 "\n" ⇒ 零 codegen 改动（D11 的 I1）。
      //   ⚠️ **内联两份**（本处与 parse_print）：boot 函数表 507/512、余量 5，为一条糖去加函数要吃预算，
      //   故不抽函数；“两条腿不许分叉”由永久探针 test\facts\f015_endl.fl 双端钉住。
      int e = -1;
      int endl_hit = 0;
      if (tok_ident_eq(p, "endl")) {
        int je = p->i + 1;
        if (je < p->n && p->ks[je] == 3 && (p->vs[je] == ',' || p->vs[je] == ']')) { endl_hit = 1; }
      }
      if (endl_hit == 1) {
        p->i = p->i + 1;                          // 吃 endl
        // ⚠️ 池是**字段** `int *spool`（见 :143）⇒ 下标前必须先**局部化成 char\***（本文件 :80 的纪律）。
        //    直接写 `p->spool[i] = 10` 会按 **int\* 的元素宽**走（int 元素 = 8 字节槽）⇒ 落点是**第 i*8 个字节**、
        //    还一次写 8 字节；池里"第 i 个字节"因此仍是 0 ⇒ **endl 静默变成空串**（探针 f015 双端一比就露：
        //    flint 42 ／ boot 17）。局部化成 char\* 后按 1 字节缩放，与 parse_primary 里字符串字面量逐字同形。
        //    注：这是**第一版我的错**，不是新缺陷 —— 文件头 :80 早就写了"字段数组必须先局部化再下标"。
        char *poole = p->spool;
        int spce = p->spcur;
        if (spce >= 262144) return -160;          // 池满（与字符串字面量同一个码）
        poole[spce] = 10;                         // 一个 '\n' 字节 + 结尾 0
        poole[spce + 1] = 0;
        p->spcur = spce + 2;
        int offe = spce;
        int sie = new_node(a, 41, 0, 0);
        int *vve = a->val;
        vve[sie] = offe;
        e = set_ty(a, sie, 2);                    // 与字符串字面量同型：char* 段
      } else {
        e = parse_expr(p, a);
      }
      if (e < 0) return -211;
      int fi2 = seg_out_fn(p, a, e, 1);
      if (fi2 < 0) return -213;
      if (p->nargs >= 65536) return -10;
      int *ar = p->args;
      ar[p->nargs] = e;
      int base = p->nargs;
      p->nargs = p->nargs + 1;
      int call = new_node(a, 10, base, 1);
      int *vv2 = a->val;
      vv2[call] = fi2;
      if (p->nblk >= 131072) return -101;
      blk = p->blk;
      blk[p->nblk] = call;
      p->nblk = p->nblk + 1;
      if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
    }
  }
  if (!tok_is(p, ']')) return -211;
  p->i = p->i + 1;
  if (tok_is(p, ',')) return -212;              // str 不接受 print 的第二参（换行标志）
  if (!tok_is(p, ')')) return -210;
  p->i = p->i + 1;
  // 末尾收尾调用：str → _flint_str_end()（0 参）；str_into → _flint_str_end_to(dst, cap)（2 参）。
  //   实参链存法与 seg 的 put 调用、parse_call_tail 一致：args[base] = 第 1 个，往后按序。
  //   ⚠️ 顺序 = dst 先、cap 后（真 flint：dst->next = cap）—— 发射端按这个序喂 rcx/rdx。
  int nbase = 0;
  int narc = 0;
  if (into == 1) {
    int *are = p->args;
    if (p->nargs + 1 >= 65536) return -10;
    nbase = p->nargs;
    are[nbase] = dstn;
    are[nbase + 1] = capn;
    p->nargs = p->nargs + 2;
    narc = 2;
  }
  int endn = new_node(a, 10, nbase, narc);
  int *vve = a->val;
  vve[endn] = fe;                               // 收尾函数下标在这里填（调用方只当值用，别再覆盖）
  return endn;
}

// —— B2g：print 内建 —— print ( [ 段, ... ] [, 换行] ) ;
// 展开为对隐藏函数 _flint_out_str/_char/_int 的调用链（块语句）
int parse_print(struct Parse *p, struct Ast *a) {
  int *avv = a->val;
  int *ar = p->args;
  int *ty = a->ty;
  int *kd = a->kind;
  int tmp[256];                             // B2h：单条 print 段数上限 256（原 32）
  int cnt = 0;
  int fi_str = find_func_by(p, "_flint_out_str");
  int fi_char = find_func_by(p, "_flint_out_char");
  int fi_int = find_func_by(p, "_flint_out_int");
  if (fi_str < 0 || fi_char < 0 || fi_int < 0) return -182;
  p->i = p->i + 1;                          // 吃 'print'
  if (!tok_is(p, '(')) return -180;
  p->i = p->i + 1;
  if (!tok_is(p, '[')) return -181;
  p->i = p->i + 1;
  if (!tok_is(p, ']')) {
    int more = 1;
    while (more == 1) {
      // ===== v1.6.2：段位置里的裸 `endl` = 换行段 —— 与 parse_str_body 那份**逐字同口径**（见那里的注释）=====
      int e = -1;
      int endl_hit = 0;
      if (tok_ident_eq(p, "endl")) {
        int je = p->i + 1;
        if (je < p->n && p->ks[je] == 3 && (p->vs[je] == ',' || p->vs[je] == ']')) { endl_hit = 1; }
      }
      if (endl_hit == 1) {
        p->i = p->i + 1;                          // 吃 endl
        // ⚠️ 池是**字段** `int *spool`（见 :143）⇒ 下标前必须先**局部化成 char\***（本文件 :80 的纪律）。
        //    直接写 `p->spool[i] = 10` 会按 **int\* 的元素宽**走（int 元素 = 8 字节槽）⇒ 落点是**第 i*8 个字节**、
        //    还一次写 8 字节；池里"第 i 个字节"因此仍是 0 ⇒ **endl 静默变成空串**（探针 f015 双端一比就露：
        //    flint 42 ／ boot 17）。局部化成 char\* 后按 1 字节缩放，与 parse_primary 里字符串字面量逐字同形。
        //    注：这是**第一版我的错**，不是新缺陷 —— 文件头 :80 早就写了"字段数组必须先局部化再下标"。
        char *poole = p->spool;
        int spce = p->spcur;
        if (spce >= 262144) return -160;          // 池满（与字符串字面量同一个码）
        poole[spce] = 10;                         // 一个 '\n' 字节 + 结尾 0
        poole[spce + 1] = 0;
        p->spcur = spce + 2;
        int offe = spce;
        int sie = new_node(a, 41, 0, 0);
        int *vve = a->val;
        vve[sie] = offe;
        e = set_ty(a, sie, 2);                    // 与字符串字面量同型：char* 段
      } else {
        e = parse_expr(p, a);
      }
      if (e < 0) return -183;
      if (cnt >= 256) return -184;
      if (p->nargs >= 65536) return -10;
      // v1.5.0：段类型分派搬进 seg_out_fn（print 与 str 共用唯一一份判定，杜绝两条腿分叉）
      int fi2 = seg_out_fn(p, a, e, 0);
      if (fi2 < 0) return -182;
      ar[p->nargs] = e;
      int base = p->nargs;
      p->nargs = p->nargs + 1;
      int call = new_node(a, 10, base, 1);
      int *vv = a->val;
      vv[call] = fi2;
      tmp[cnt] = call;
      cnt = cnt + 1;
      if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
    }
  }
  if (!tok_is(p, ']')) return -185;
  p->i = p->i + 1;
  if (tok_is(p, ',')) {                     // 可选换行参数（常量）
    p->i = p->i + 1;
    if (!tok_is_num(p)) return -186;
    int nl = tok_num_val(p);
    p->i = p->i + 1;
    if (nl != 0) {
      char *pool = p->spool;
      if (p->spcur >= 262144) return -160;
      int off = p->spcur;
      pool[off] = 10;
      p->spcur = off + 1;
      pool[p->spcur] = 0;
      p->spcur = p->spcur + 1;
      int sn = new_node(a, 41, 0, 0);
      int *vv2 = a->val;
      vv2[sn] = off;
      set_ty(a, sn, 2);                       // B2j：换行串 = char*
      if (p->nargs >= 65536) return -10;
      ar[p->nargs] = sn;
      int base2 = p->nargs;
      p->nargs = p->nargs + 1;
      int call2 = new_node(a, 10, base2, 1);
      int *vv3 = a->val;
      vv3[call2] = fi_str;
      tmp[cnt] = call2;
      cnt = cnt + 1;
    }
  }
  if (!tok_is(p, ')')) return -187;
  p->i = p->i + 1;
  if (!tok_is(p, ';')) return -188;
  p->i = p->i + 1;
  int *blk = p->blk;
  int i = 0;
  while (i < cnt) {
    if (p->nblk >= 131072) return -101;
    blk[p->nblk] = tmp[i];
    p->nblk = p->nblk + 1;
    i = i + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}
// —— B4a：类型前缀（int / int* / char / char* / struct 名 / struct 名* + own/share 标注）——
// 返回「打包规格」= ty*1000000 + aux*100000 + (sid+1)*100 + mg，负值 = 错误码。
// （FLINT 自产函数 ≤4 参 → 不能用 5 个输出参数，故打包成一个 int；-1 用 sid=-1 的 0 表示）
int parse_type_prefix(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int ty = 0;
  int aux = 0;
  int sid = -1;
  int mg = 0;
  if (tok_ident_eq(p, "int")) {
    p->i = p->i + 1;
    if (tok_is(p, '*')) { ty = 2; aux = 0; p->i = p->i + 1; }
  } else if (tok_ident_eq(p, "char")) {
    p->i = p->i + 1;
    if (!tok_is(p, '*')) { ty = 4; }
    else { p->i = p->i + 1; ty = 2; aux = 1; }
  } else {                                            // struct 名 [*]
    p->i = p->i + 1;
    if (p->i >= p->n || ks[p->i] != 1) return -142;
    sid = st_find(p, ps[p->i], ls[p->i]);
    if (sid < 0) return -143;
    p->i = p->i + 1;
    ty = 3;
    if (tok_is(p, '*')) { p->i = p->i + 1; ty = 2; aux = 2; }
  }
  if (tok_ident_eq(p, "own")) {
    if (ty != 2 || aux != 0) return -168;             // char*/struct* 无托管语义
    mg = 1; p->i = p->i + 1;
  } else if (tok_ident_eq(p, "share")) {
    if (ty != 2 || aux != 0) return -168;
    mg = 2; p->i = p->i + 1;
  }
  return ty * 1000000 + aux * 100000 + (sid + 1) * 100 + mg;
}

// —— B4a：声明符主体（类型规格已由调用方解析；spec = parse_type_prefix 的打包值）——
// 普通声明走 parse_decl，for 头多声明走 parse_decl_multi（共用同一类型规格）。
int parse_decl_body(struct Parse *p, struct Ast *a, int spec) {
  int *ps = p->ps;
  int *ls = p->ls;
  int ty = spec / 1000000;
  int aux = spec / 100000 % 10;
  int sid = spec / 100 - spec / 100000 * 1000 - 1;
  int mg = spec % 100;
  if (p->i >= p->n || p->ks[p->i] != 1) return -41;
  if (tok_ident_eq(p, "int")) return -42;
  if (tok_ident_eq(p, "char")) return -42;
  if (tok_ident_eq(p, "struct")) return -42;
  if (tok_ident_eq(p, "own")) return -168;
  if (tok_ident_eq(p, "share")) return -168;
  if (tok_ident_eq(p, "return")) return -43;
  if (tok_ident_eq(p, "if")) return -43;
  if (tok_ident_eq(p, "while")) return -43;
  if (tok_ident_eq(p, "else")) return -43;
  int pos = ps[p->i];
  int len = ls[p->i];
  p->i = p->i + 1;
  if (tok_is(p, '[')) {                               // 数组（长度必须字面量）
    if (ty != 0 && ty != 3 && ty != 4) { return -144; }
    // ===== v2.1.0（2026-10-24，卡「最后一个自举缺口 -240」）：struct 数组 `struct S a[N];` 已接 =====
    //   这一格原先 `return -240`（BOOT_FAIL）。三条"为什么不做"的理由逐条被证伪/收口：
    //   ① 规格编码：不再把 slots×N 往低 3 位塞 —— 改用 ty=6 专用编码
    //      `600000000 + sid*100000 + T`（T = 总槽数 = st_nslots(sid)*N；低 5 位给
    //      declare_var_spec 当槽数，sid 占 10^5 位；N 不进编码，可由 T/per 反算）。
    //      ⚠️ 2026-11-01：sid 段由 10^6 收到 10^5 —— 旧编码在 sid≥100 时进位到 7*10^8，
    //         被 spec_ty 读成 ty=7（实测 boot 报 parse err=-54）。详见文件上方 ty 6 那一节。
    //   ② 发射档：**一个都不加**（D11）—— 元素地址 = kind 25(lea) + kind 3(×步长) + kind 1(加)，
    //      字段 = 元素地址 + 字段偏移 → kind 53/54（解引用读/写）与 kind 60（复合赋值/++）原样复用；
    //      地址节点 ty 标 1/2/3（存储宽度类）⇒ 读/写宽度自动落对（b1_emit gen_expr 既有分支）。
    //   ③ 函数表：新增 4 个 helper（declare_sarr / sarr_elem_addr / sarr_fld_addr /
    //      sarr_fld_read），余量足够（见 tools\boot余量.ps1 的账）。
    //   ⚠️ 诚实边界（boot 比真 flint 窄的**容量**断点，不是语法断点）：总槽数 ≤ 99999
    //      （2026-10-24 由 999 抬到 99999，即 N ≤ 99999/st_nslots(sid)）；超限报 -241
    //      （专用码，绝不静默少分配 —— 那会写穿帧）。真 flint 只受 2GB 帧上限约束。
    p->i = p->i + 1;
    if (!tok_is_num(p)) return -70;
    int n = tok_num_val(p);
    if (n <= 0) return -71;
    p->i = p->i + 1;
    if (!tok_is(p, ']')) return -72;
    p->i = p->i + 1;
    int aslot = 0;
    int is2d = 0;                                     // v2.5.0：本数组是不是二维 int（ty=8）
    int nelem = n;                                    // v2.5.0：元素总数（一维 = n；二维 = 行×列）
    // ===== v2.2.0（2026-11-01）：二维 int 数组 `int m[行][列];`（ty=7；编码见 spec 那段注释）=====
    //   落地 = 只登记（槽数 = 行×列），`m[i][j]` 的下标折叠在 parse_primary/parse_stmt 里；
    //   发射侧零新增（D11）。边界：三维不猜（-277）；列数/总数超编码格报 -241（不静默截断）。
    if (ty == 0 && tok_is(p, '[')) {
      p->i = p->i + 1;
      if (!tok_is_num(p)) return -70;
      int ncol = tok_num_val(p);
      if (ncol <= 0) return -71;
      p->i = p->i + 1;
      if (!tok_is(p, ']')) return -72;
      p->i = p->i + 1;
      if (tok_is(p, '[')) return -277;
      if (ncol > 99) return -241;                     // cols 占 10^6 格（两位十进制）
      if (n > 99999) return -241;                     // 与 struct 数组同一条帧槽偏移编码带
      int tot = n * ncol;
      if (tot > 99999) return -241;
      is2d = 1;
      nelem = tot;
      aslot = declare_var_spec(p, pos, len, 800000000 + ncol * 1000000 + tot);
    }
    else if (ty == 4) { aslot = declare_carr(p, pos, len, n); }
    else if (ty == 3) {
      aslot = declare_sarr(p, pos, len, sid, n);      // v2.1.0：本地 struct 数组（槽数 = nslots×N）
      if (aslot == -241) { return -241; }
    }
    else { aslot = declare_arr(p, pos, len, n); }
    if (aslot < 0) return -44;
    // ===== v2.5.0（2026-11-01）：局部 int 数组整体初始化 `int a[N] = {v0, v1, ...};` =====
    //   语义权威 = 真 flint 端 src\parse.c 的 decl_list v2.5.0 分支（**同一份语言语义，改一端必须改另一端**）：
    //     · 元素数 k ≤ N，不足 N 的补 0（C 口径），k > N = 编译期硬错；
    //     · 元素只收 int 表达式（负号 / enum 常量 / 简单算式都走既有 parse_expr）；
    //     · 空 `{}` 拒（至少写一个元素；全零请写 {0}）；尾逗号放行；
    //     · 二维 ty=8 同一路：帧里是 row-major 连续块，按**线性下标** 0..R*C-1 填（r 下标不折 cols，
    //       等价于 m[i/C][i%C]；与真 flint 的 arr_init_elem_stmt 同为「一维线性」口径）；
    //     · 明确不做（保持响亮报错）：char/struct 数组（沿用 -73）、`int a[] = {...}` 省略长度
    //       （长度那一格先报 -70）、嵌套大括号、字符串初始化；**全局数组初始化本函数不碰**
    //       （parse_globals 的 -73 原样保留；真 flint 的全局 braced init 走 parse_global_init，
    //        boot 未实现 = 已登记的容量/功能缺口，不在本条范围）。
    //   落地 = parse 期展开成**逐元素写**节点（kind 24：l = 升序基址槽（同读/写路径 slot+n-1）、
    //   r = 常量下标、val = 值表达式），与 `a[i] = v` 语句的既有形态逐字同形 ⇒ 发射侧零改动（D11）。
    //   展开的语句**包在独立块节点里**（父块只多 1 个直接子语句）⇒ 不占 parse_block 的 tmp[512] 名额。
    //   ⚠️ 容量断点（boot 比真 flint 窄的**容量**断点，不是语法断点）：初值元素总数 ≤ 64（-283 响亮报错）。
    //      64 是保守值：AST 表 262144 节点、单块子节点 512、代码缓冲 2MiB —— 本可更多，但先按小口径
    //      钉住（每个元素还要解析一棵表达式树，64 已覆盖手写初始化表的常见规模）。
    //   错误码（-277 之后的空位）：
    //     -280 初值不是 `{`（写了标量初值）  -281 空 `{}`
    //     -282 元素比声明长度多             -283 初值元素总数超过 64（boot 容量断点）
    if (tok_is(p, '=')) {
      if (ty != 0) { return -73; }                     // char / struct 数组：整块布局未定，沿用旧码
      p->i = p->i + 1;                                 // 吃 '='
      if (!tok_is(p, '{')) { return -280; }            // 标量初值：数组没有标量初值语义
      if (nelem > 64) { return -283; }                 // 容量断点（见上）
      int abase = aslot + nelem - 1;                   // 升序基址（与 3047 / 4954 两处读写路径同口径）
      int amark = p->nblk;
      p->i = p->i + 1;                                 // 吃 '{'
      if (tok_is(p, '}')) { return -281; }             // 空 {}：真 flint 同口径拒
      int aix = 0;
      int amore = 1;
      int *aivv = a->val;
      int *aiblk = p->blk;
      while (amore == 1) {
        if (aix >= nelem) { return -282; }             // 元素比声明长度多
        int aiv = parse_expr(p, a);
        if (aiv < 0) { return -45; }
        int aiix = new_node(a, 0, 0, 0);               // 常量下标节点（kind 0）
        aivv[aiix] = aix;
        int aiw = new_node(a, 24, abase, aiix);        // 与 `a[i] = v` 同形（kind 24）
        aivv[aiw] = aiv;
        if (p->nblk >= 131072) { return -101; }
        aiblk[p->nblk] = aiw;
        p->nblk = p->nblk + 1;
        aix = aix + 1;
        amore = 0;
        if (tok_is(p, ',')) {
          p->i = p->i + 1;
          if (!tok_is(p, '}')) { amore = 1; }          // 尾逗号：`}` 就在下一个 token ⇒ 收尾
        }
      }
      if (!tok_is(p, '}')) { return -47; }
      p->i = p->i + 1;                                 // 吃 '}'
      while (aix < nelem) {                            // 不足 N：补 0（C 口径）
        int aiz = new_node(a, 0, 0, 0);
        aivv[aiz] = 0;
        int aizx = new_node(a, 0, 0, 0);
        aivv[aizx] = aix;
        int aizw = new_node(a, 24, abase, aizx);
        aivv[aizw] = aiz;
        if (p->nblk >= 131072) { return -101; }
        aiblk[p->nblk] = aizw;
        p->nblk = p->nblk + 1;
        aix = aix + 1;
      }
      int acnt = p->nblk - amark;
      if (tok_is(p, ',')) { return new_node(a, 19, amark, acnt); }   // 多声明：`int a[2] = {1,2}, b;`（真 flint 放行）
      if (!tok_is(p, ';')) { return -47; }
      p->i = p->i + 1;
      return new_node(a, 19, amark, acnt);             // 整条声明 = 含 N 条逐元素写的块
    }
    // 数组初始化暂不支持（char/struct 数组走上一条的 -73；int 数组已由 v2.5.0 接住）
    // 2026-09-20（卡 T-20260920-144154）：数组声明符后面可以接 `,` —— 真 flint 实测放行
    //   `int a[3], b;`（boot 原先在这里直接 -47 = 双端断点）。把 `,` 留给调用方的多声明循环。
    // ⚠️ 2026-10-24（struct 数组收口）：**struct 数组例外** —— 真 flint 实测 `struct P a[2], b;`
    //   报「期望 ';'」（与上面 struct **值**多声明同一条口径，见本函数 3476 一带的注释）。
    //   boot 若默默放行就是「boot 比真 flint 宽」的静默分岔（本轮实测：boot 编过并跑出 11、
    //   真 flint 编译期硬错）⇒ 沿用 -47（= 本文件的「期望 ';'」）。
    if (ty == 3 && tok_is(p, ',')) { return -47; }
    if (tok_is(p, ',')) { return new_node(a, 19, p->nblk, 0); }
    if (!tok_is(p, ';')) return -47;
    p->i = p->i + 1;
    return new_node(a, 19, p->nblk, 0);               // 数组声明 = 空块
  }
  if (ty == 4) { ty = 5; }                            // char 标量（B2g）
  int slot = 0;
  if (ty == 0) { slot = declare_int(p, pos, len); }
  else if (ty == 5) { slot = declare_char(p, pos, len); }
  else if (ty == 2) {
    if (mg == 1) { slot = declare_var_spec(p, pos, len, 200000000 + 10 * 1000000 + (p->main_idx + 1) * 1000 + 1); }
    else if (mg == 2) { slot = declare_var_spec(p, pos, len, 200000000 + 20 * 1000000 + (p->main_idx + 1) * 1000 + 1); }
    else { slot = declare_ptr(p, pos, len, aux * 1000 + sid + 1); }
  }
  else { slot = declare_struct(p, pos, len, sid); }
  if (slot < 0) return -44;
  if (mg != 0) {                                      // —— B2l：own/share 必须初始化 + 初始化式限制 ——
    if (!tok_is(p, '=')) return -164;
    p->i = p->i + 1;
    int emg = parse_expr(p, a);
    if (emg < 0) return -165;
    int *kdm = a->kind;
    if (mg == 1) {
      if (kdm[emg] != 62) return -166;                // own 只能由 new 初始化（独占所有权）
      int io = new_node(a, 36, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return io;
    }
    if (kdm[emg] == 62) {                             // share = new（头部计数已为 1）
      int ish = new_node(a, 36, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return ish;
    }
    if (mg_node_kind(p, a, emg) == 2) {               // share = share 变量（引用计数 +1 后接管）
      int iac = new_node(a, 63, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return iac;
    }
    return -167;                                      // share 只能由 new / share 变量初始化
  }
  if (tok_is(p, '=')) {
    if (ty == 3) return -145;                         // struct 值初始化暂不支持
    // v1.5.0：char *s = str([...]); —— str 的语句级展开（只在**指针**声明初始化放行）
    // v2.3.x：char *t = str_into(buf, [...]) / str_into(p, cap, [...]) 同路（同一条语句链，末尾换成 end_to）
    //   ⚠️ 此处 p->i 还停在 '=' 上 ⇒ 前瞻用 str_ahead(p, 1)（踩过：写成 0 直接落到 parse_expr ⇒ -45）
    if (ty == 2 && mg == 0 && (str_ahead(p, 1) == 1 || str_into_ahead(p, 1) == 1)) {
      int mark = p->nblk;
      p->i = p->i + 1;                                // 吃 '='
      int endn = parse_str_body(p, a);
      if (endn < 0) return endn;
      set_ty(a, endn, 2);                             // 末尾调用返回 char*（地址类，与串段同解码）
      int *blkn = p->blk;
      if (p->nblk >= 131072) return -101;
      blkn[p->nblk] = new_node(a, 36, slot, endn);    // 36 = 指针变量存（见下 ty==2 → nk=36）
      p->nblk = p->nblk + 1;
      int cntn = p->nblk - mark;
      if (tok_is(p, ',')) return -210;                // 多声明 + str 初始化：不支持（响亮报错，不猜）
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return new_node(a, 19, p->nblk - cntn, cntn);
    }
    p->i = p->i + 1;
    int e = parse_expr(p, a);
    if (e < 0) return -45;
    if (ty == 2 && mg_node_kind(p, a, e) != 0) return -169;   // B2l：托管指针不能拷贝给裸指针
    if (ty == 2 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }        // v1.4.31：指针目标值门槛
    if (ty == 0 && rhs_addr_like(p, a, e, 0) != 0) { set_addr_mark(p, slot); }   // v1.4.31：标记「装过地址的 int」
    int nk = 8;
    if (ty == 2) { nk = 36; }
    if (ty == 5) { nk = 43; }                          // char 标量初始化（字节存）
    int idx = new_node(a, nk, slot, e);
    if (ty == 0) { t1_mark_store(p, idx, slot); }      // 2026-10-18（task 2b / rev4）：T1 装地址的 int → 8 字节写
    if (tok_is(p, ',')) { return idx; }                // B4a：for 头多声明（`,` 交由 parse_decl_multi 继续）
    if (!tok_is(p, ';')) return -47;
    p->i = p->i + 1;
    return idx;
  }
  if (tok_is(p, ',')) {                              // B4a：多声明（无初始化项）
    // 2026-09-20（卡 T-20260920-144154）：**struct 值多声明按真 flint 口径拒绝** ——
    //   真 flint 实测 `struct P s, t;` 在第 2 个名字处报「期望 ';'」（`struct P s;` 单声明是放行的）
    //   ⇒ boot 若默默放行就变成「boot 比真 flint 宽」的静默分岔（差分门的 OK→FLINT_FAIL 那一类）。
    //   错误码沿用 -47（= 本文件的「期望 ';'」），与真 flint 的文案同义。
    if (ty == 3) { return -47; }
    return new_node(a, 8, slot, -1);
  }
  if (!tok_is(p, ';')) return -47;
  p->i = p->i + 1;
  if (ty == 0) return new_node(a, 8, slot, -1);       // int 无初始化：r = -1
  return new_node(a, 19, p->nblk, 0);                 // 指针/struct 声明 = 空块
}

// —— 2026-09-20（卡 T-20260920-144154）：**后续声明符自带的 `*`** ——
//   真 flint 实测口径（本次逐条跑过）：
//     `int *p = &x, *q = &y;` ✓ ／ `int a, *q;` ✓ ／ `char *a, *b;` ✓
//     `struct P *a, *b;` ✗（报「期望变量名」）⇒ **只有 int/char 基础类型放行**。
//   ⚠️ **只对「第一个之后的声明符」调用本函数**：第一个声明符的 `*` 已由 `parse_type_prefix` 吃掉，
//      若对第一个也放行，`int **q`（真 flint 拒绝：声明后需跟变量名）会被静默当成单层指针
//      = **静默错类型**（本仓最忌讳的一类 —— 编得过、值不对）。
//   ⚠️ 返回**改写后的 spec**（没见到 `*` 就原样返回），把 `*` 的规格换算做在这里，
//      `parse_decl_body` 一行都不用动。返回负数 = 报错码。
int decl_cont_spec(struct Parse *p, int spec) {
  int bty = spec / 1000000;
  int baux = spec / 100000 % 10;
  int base = 0;
  if (bty == 0) { base = 0; }                        // int
  else if (bty == 4) { base = 1; }                   // char
  else if (bty == 3) { base = 2; }                   // struct 值
  else { base = baux; }                              // bty == 2：aux 就是基础类型
  if (!tok_is(p, '*')) { return spec; }
  if (base == 2) { return -41; }                     // struct 指针重复 `*`：真 flint 拒绝
  p->i = p->i + 1;
  return 2000000 + base * 100000;                    // ty=2 + aux=base（与 parse_type_prefix 同编码）
}

// —— 2026-09-20（卡 T-20260920-144154）：普通**语句**位置的多声明 ——
//   本函数**取代了旧的 parse_decl**（旧函数 = 本函数去掉 `,` 分支那条路，已删：留着是两套真相）。
//   B4a 只把多声明做进了 for 头（parse_decl_multi）；语句位置此前只解析**一个**声明符
//   ⇒ `int a = 1, b, c = 3;` 里的 `,` 被当成下一句的开头 ⇒ parse_or 报 -51
//   （实测样本 decl1 / multi_init，两端复现：boot 报 -51、真 flint 正常出产物）。
//   ⚠️ 单个声明符时**必须原样返回那个节点、不许包块** —— parse_decl_multi 的口径是「一律包一层块」，
//      照搬到语句位置会让**所有既有单声明样本的 AST 形状改变**（块的子节点表整个换位置），
//      徒增回归面。所以这里走「先按老路解析第一个声明符，**只有真见到 `,` 才转多声明**」。
//   多声明路径与 parse_decl_multi 同构：先全部缓冲到 tmp、再一次性追加进 blk
//   （边解析边追加会让 `base/cnt` 取到的区间混进别的语句 —— B2d 已在 parse_block 上踩过一次）。
int parse_decl_stmt(struct Parse *p, struct Ast *a) {
  int spec = parse_type_prefix(p);
  if (spec < 0) { return spec; }
  int first = parse_decl_body(p, a, spec);
  if (first < 0) { return first; }
  if (!tok_is(p, ',')) { return first; }        // 单声明符：与已被取代的旧 parse_decl 一字不差
  int tmp[32];
  tmp[0] = first;
  int cnt = 1;
  while (tok_is(p, ',')) {
    if (cnt >= 32) { return -101; }
    p->i = p->i + 1;
    int dspec = decl_cont_spec(p, spec);        // 后续声明符可自带 `*`（口径见 decl_cont_spec）
    if (dspec < 0) { return dspec; }
    int d = parse_decl_body(p, a, dspec);       // 后续声明符共用同一基础类型（j 不带 int）
    if (d < 0) { return d; }
    tmp[cnt] = d;
    cnt = cnt + 1;
  }
  int *blk = p->blk;
  int j = 0;
  while (j < cnt) {
    if (p->nblk >= 131072) { return -101; }
    blk[p->nblk] = tmp[j];
    p->nblk = p->nblk + 1;
    j = j + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}

// —— 旧的 parse_decl（类型前缀 + **一个**声明符）已于 2026-09-20 删除 ——
//   它唯一调用者就是 parse_stmt，现由 parse_decl_stmt 顶替（单声明符路径行为逐字一致）。
//   留两套等价函数 = 后来人可能改一处忘另一处 ⇒ 直接删掉。

// —— B4a：for 头的多声明 init（`for (int i = 0, j = 10; ...)`）——
// 类型前缀只解析一次，后续声明符共用（`int i = 0, j = 10;` 的 j 不带 int）；
// parse_decl_body 自己会吃掉结尾的 ';'（普通声明语句需要），因此这里不再找分号。
int parse_decl_multi(struct Parse *p, struct Ast *a) {
  int tmp[32];
  int cnt = 0;
  int spec = parse_type_prefix(p);
  if (spec < 0) { return spec; }
  int more = 1;
  while (more == 1) {
    if (cnt >= 32) { return -101; }
    int dspec = spec;
    if (cnt > 0) {                              // 2026-09-20：第一个之后的声明符可自带 `*`
      dspec = decl_cont_spec(p, spec);
      if (dspec < 0) { return dspec; }
    }
    int d = parse_decl_body(p, a, dspec);
    if (d < 0) { return d; }
    tmp[cnt] = d;
    cnt = cnt + 1;
    if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
  }
  int *blk = p->blk;
  int j = 0;
  while (j < cnt) {
    if (p->nblk >= 131072) { return -101; }
    blk[p->nblk] = tmp[j];
    p->nblk = p->nblk + 1;
    j = j + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}

// —— B2d：单语句 —— 声明 / 赋值 / return / if / while / 块 ——
// v1.6.0：语句首是不是「方法调用点糖」形态（`recv.name(` 或 `recv->name(`）——
//   语句级会被下面的「赋值路径」先把 `m.add(` 当字段赋值吃掉并报 -152/-150，
//   所以「调用语句（表达式语句）」那条路必须先认出这个形态，交给 parse_expr → parse_primary。
int method_call_ahead(struct Parse *p) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i;
  if (i + 3 < p->n && ks[i] == 1 && ks[i + 1] == 3) {
    if (vs[i + 1] == '.' && ks[i + 2] == 1 && ks[i + 3] == 3 && vs[i + 3] == '(') { return 1; }
    if (i + 4 < p->n && vs[i + 1] == '-' && ks[i + 2] == 3 && vs[i + 2] == '>'
        && ks[i + 3] == 1 && ks[i + 4] == 3 && vs[i + 4] == '(') { return 1; }
  }
  return 0;
}

int parse_stmt(struct Parse *p, struct Ast *a) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int *vs = p->vs;
  int *kd = a->kind;                          // B2k：字段写节点改判 char 档（31→56 / 33→58）
  if (tok_is(p, '{')) {                       // 块语句
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 1);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    return new_node(a, 19, base, cnt);
  }
  if (tok_ident_eq(p, "break") || tok_ident_eq(p, "continue")) {
    // 2026-09-21（卡 T-20260921-194703）：I 类 break/continue（真实应用 `apps\m2_float\config.fl`
    //   用了两处 `break`）。判据：必须在循环体内 ⇒ 解析期用 loopdepth 拦住"循环外的 break"，
    //   否则发射端会发一条**目标未知**的 jmp（跳哪儿全看补丁表，属静默错码）。
    //   AST：68 = break ｜ 69 = continue（都无操作数）；机器侧 = 一条 `E9 rel32`，
    //   目标由**所属循环**收尾时回填（while → 条件处；for → **增量段**，C 语义）
    int isbrk = 1;
    if (tok_ident_eq(p, "continue")) { isbrk = 0; }
    if (p->loopdepth <= 0) { return -202; }
    p->i = p->i + 1;
    if (!tok_is(p, ';')) { return -57; }
    p->i = p->i + 1;
    if (isbrk == 0) { return new_node(a, 69, 0, 0); }
    return new_node(a, 68, 0, 0);
  }
  if (tok_ident_eq(p, "if")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -110;
    p->i = p->i + 1;
    int cond = parse_expr(p, a);
    if (cond < 0) return -111;
    int chk_if = check_void_value_rec(p, a, cond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
    if (chk_if < 0) return chk_if;
    if (!tok_is(p, ')')) return -112;
    p->i = p->i + 1;
    int thenb = parse_stmt_block(p, a);
    if (thenb < 0) return thenb;
    int elseb = -1;
    if (tok_ident_eq(p, "else")) {
      p->i = p->i + 1;
      elseb = parse_stmt_block(p, a);
      if (elseb < 0) return elseb;
    }
    int idx = new_node(a, 17, cond, thenb);
    int *vv = a->val;
    vv[idx] = elseb;
    return idx;
  }
  if (tok_ident_eq(p, "while")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -120;
    p->i = p->i + 1;
    int cond = parse_expr(p, a);
    if (cond < 0) return -121;
    int chk_wh = check_void_value_rec(p, a, cond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
    if (chk_wh < 0) return chk_wh;
    if (!tok_is(p, ')')) return -122;
    p->i = p->i + 1;
    p->loopdepth = p->loopdepth + 1;                  // 2026-09-21：循环体内 `break`/`continue` 合法
    int body = parse_stmt_block(p, a);
    p->loopdepth = p->loopdepth - 1;
    if (body < 0) return body;
    return new_node(a, 18, cond, body);
  }
  // —— B4a：for (init?; cond?; inc?) body ——
  // 语义与真 flint 的 ND_FOR 一致：init 只跑一次 → cond 判（空 = 恒真）→ body → inc → 回判。
  // for 头单独一层作用域（init 声明的变量只在 for 内可见）——压作用域标记，块退出时 nvars/nslots 回退。
  // AST：kind 65 = for(l=init, r=cond, val=body 块节点, ty=inc 语句节点)（-1 = 该段为空；不复用块表，四段各自发射）
  //   v1.6.1：**不再打包**（旧 `(inc+1)*100000+body` 在 inc 下标 ≥ 21475 时 int32 溢出 ⇒ 静默丢段）；详见文件头 kind 表。
  if (tok_ident_eq(p, "for")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -190;
    p->i = p->i + 1;
    int fmark = p->nvars;
    int fsmark = p->nslots;
    if (p->nvars < 512) {                     // 作用域标记（空名 + 0 槽 + spec 0），B3a 同款
      int *mvps = p->vps;
      int *mvls = p->vls;
      int *mvsp = p->vsp;
      int *mvslots = p->vslots;
      int *mvad = p->vad;
      int mi = p->nvars;
      mvps[mi] = 0;
      mvls[mi] = 0;
      mvsp[mi] = 0;
      mvslots[mi] = p->nslots;
      mvad[mi] = 0;                           // v1.4.31：作用域标记项不带「装地址」标记
      p->nvars = mi + 1;
    }
    int finit = -1;
    if (!tok_is(p, ';')) {
      if (tok_ident_eq(p, "int") || tok_ident_eq(p, "char") || tok_ident_eq(p, "struct")) {
        finit = parse_decl_multi(p, a);       // B4a：支持 `int i = 0, j = 10;`（自带分号，缺分号 → -192）
        if (finit < 0) { p->nvars = fmark; p->nslots = fsmark; return finit; }
      } else {
        // 2026-09-20（卡 T-20260920-001345）：init 段允许**赋值表达式**（`i = 1`）——
        //   真 flint 实测 q1 通过（`for (i = 1; i <= 100; i = i + 1)`）、q13（`s += 4`）也通过；
        //   旧写 parse_expr 只到 or/and 层 ⇒ `i = 1` 解析成 `i` 后卡在 '=' → -192
        int ie = parse_for_head_expr(p, a);
        if (ie < 0) { p->nvars = fmark; p->nslots = fsmark; return -191; }
        if (!tok_is(p, ';')) { p->nvars = fmark; p->nslots = fsmark; return -192; }
        p->i = p->i + 1;
        finit = new_node(a, 50, ie, 0);
      }
    } else {
      p->i = p->i + 1;
    }
    int fcond = -1;
    if (!tok_is(p, ';')) {
          fcond = parse_expr(p, a);
      if (fcond < 0) { p->nvars = fmark; p->nslots = fsmark; return -193; }
      int vcf = check_void_value_rec(p, a, fcond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
      if (vcf < 0) { p->nvars = fmark; p->nslots = fsmark; return vcf; }
    }
    if (!tok_is(p, ';')) { p->nvars = fmark; p->nslots = fsmark; return -194; }
    p->i = p->i + 1;
    int finc = -1;
    if (!tok_is(p, ')')) {
      int i0 = 14;
      while (i0 < 24) {
        i0 = i0 + 1;
      }
      int ie2 = parse_for_head_expr(p, a);
      if (ie2 < 0) { p->nvars = fmark; p->nslots = fsmark; return -195; }
      int vci = check_void_value_rec(p, a, ie2, 100000 + 4096);     // 2026-09-20：void 调用不能当 inc 段的值
      if (vci < 0) { p->nvars = fmark; p->nslots = fsmark; return vci; }
      finc = new_node(a, 50, ie2, 0);
    }
    if (!tok_is(p, ')')) { p->nvars = fmark; p->nslots = fsmark; return -196; }
    p->i = p->i + 1;
    p->loopdepth = p->loopdepth + 1;                  // 2026-09-21：for 体同样是循环体
    int fbody = parse_stmt_block(p, a);
    p->loopdepth = p->loopdepth - 1;
    if (fbody < 0) { p->nvars = fmark; p->nslots = fsmark; return fbody; }    p->nvars = fmark;
    p->nslots = fsmark;
    int fidx = new_node(a, 65, finit, fcond);
    int *fv = a->val;
    int *ft = a->ty;
    // ===== v1.6.1（2026-10-15）：for 节点**不再打包** =====
    //   原写法 `(finc + 1) * 100000 + fbody` 是 int32 打包算术：inc 下标 ≥ **21475** 时
    //   `21475 * 100000 = 2,147,500,000 > INT32_MAX` ⇒ 溢出回绕成负值 ⇒ 解码端拿到**负下标**：
    //   for 体与自增被**静默丢弃**（一个字节都不发）并越界读 AST 表（偶发 0xC0000005）。
    //   新编码：`val` = body 块节点号（与 kind 17 的 else 段同口径，恒为 kind 19 块节点）、
    //           `ty` = inc 语句节点号（-1 = 空段）。两位都是普通节点下标，无算术、无溢出。
    //   ⚠️ 读点必须**同步改**，漏一个就出错（草案漏了 ②，实测 b1_parse.exe 无限循环）：
    //     ① b1_emit.fl `emit_stmt` k==65（代码发射，带越界守卫）
    //     ② b1_parse.fl `ex_stmt` k==65（解释器自测 —— 就是漏掉的那一个）
    //     ③ 本文件 plan_regs 只把 val 当过近似"节点被引用"标记（fbody 恒为 kind 19 块节点，
    //        而 pmark 只在 k==25 那一行被判读 ⇒ 对提升计划惰性、不改变产物）；
    //        preg_excluded 读 val 前先过 `preg_excl_vv(k)`，而 preg_excl_vv(65) == 0 ⇒ 不命中。
    fv[fidx] = fbody;
    ft[fidx] = finc;
