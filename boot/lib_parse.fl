        p->i = p->i + 1;
        int nfd = st_nslots(p, sid);                              // 2026-09-22（卡 T-20260922-201154）：struct 变量预留**槽数**
        int ftyd = st_fty(p, f);
        int fcd = fld_code(p, sid, f);
        if (tok_is(p, '[')) {                                     // B2m：s.arr[i] 直接下标读
          // 2026-09-20（卡 T-20260920-141033）：**必须"先看 '[' 再判 char 标量"** ——
          //   原顺序把 `char cbuf[6]` 字段的 `b.cbuf[0]` 判成「char 标量字段读」并**当场 return**，
          //   剩下的 '[' 没人消费 ⇒ sarr1 / sarr3 报 **-112**（char 形态的数组字段整条不可达）。
          if (fld_arr_kind(p, f) != 0) {                          // 定长数组字段（int/char 两种元素）
            int fad = fld_arr_addr_loc(p, a, slot * 1000 + nfd, fcd * 100 + ftyd);
            if (fad < 0) return fad;
            return new_node(a, 53, fad, 0);
          }
          if (ftyd == 4) return -13;                              // char 字段不能下标
          if (ftyd == 0) return -13;                              // int 字段不能下标
          int idx = new_node(a, 30, slot + nfd - 1, 0);
          vv[idx] = fcd;
          set_ty(a, idx, fld_ty(ftyd));
          int sad = field_sub_addr(p, a, idx, ftyd);
          if (sad < 0) return sad;
          int dr = new_node(a, 53, sad, 0);
          int *tyr = a->ty;
          if (tyr[sad] == 3) { return set_ty(a, dr, 1); }         // 指向指针槽 → 结果地址类
          return dr;
        }
        if (fld_arr_kind(p, f) != 0) {                            // 2026-09-20：数组字段名 = **首元素地址**
          // 与真 flint 同语义（`src\parse.c` v1.4.4：数组字段作表达式 = 首元素地址，数组名退化同款）。
          //   sarr1 的 `put4(b.buf)` 吃的就是这条：老代码这里发 kind 30（**值加载**），
          //   等于把数组头 4 字节的**内容**当指针传给 `int *p` ⇒ 形参一写就 0xC0000005。
          //   地址链基址照旧用字段取址节点（kind 52）+ 标地址类，别再退回值加载。
          int fa = new_node(a, 52, slot + nfd - 1, 0);
          vv[fa] = fcd;
          int et = 1;
          if (ftyd == 4) { et = 2; }                              // char 数组 → char*
          return set_ty(a, fa, et);
        }
        if (ftyd == 4) {                                          // B2k：char 标量字段（1 字节读）
          int cidx = new_node(a, 55, slot + nfd - 1, 0);
          vv[cidx] = fcd;
          return cidx;
        }
        int idx0b = new_node(a, 30, slot + nfd - 1, 0);
        vv[idx0b] = fcd;
        if (ftyd >= 1) { set_ty(a, idx0b, fld_ty(ftyd)); }
        return idx0b;
      }
      if (tok2_is(p, '-', '>')) {                                 // —— 指针 -> 字段 ——
        if (ty != 2 || spec_aux(spec) != 2) return -153;
        int sid = spec_sid(spec);
        p->i = p->i + 2;
        if (p->i >= p->n || ks[p->i] != 1) return -151;
        int f = st_find_field(p, sid, ps[p->i], ls[p->i]);
        if (f < 0) return -152;
        p->i = p->i + 1;
        int fcd2 = fld_code(p, sid, f);
        int ftyd2 = st_fty(p, f);
        if (tok_is(p, '[')) {                                     // B2m：p->arr[i] 直接下标读
          // 2026-09-20（卡 T-20260920-141033）：先看 '[' 再看 char 标量（理由同本地那条 -112）
          if (st_is_arr(p, f) != 0) {                             // 定长数组字段
            int fad2 = fld_arr_addr_ptr(p, a, slot * 1000, fcd2 * 100 + ftyd2);
            if (fad2 < 0) return fad2;
            return new_node(a, 53, fad2, 0);
          }
          if (ftyd2 == 4) return -13;                             // char 字段不能下标
          if (ftyd2 == 0) return -13;                             // int 字段不能下标
          int idx2b = new_node(a, 32, slot, 0);
          vv[idx2b] = fcd2;
          set_ty(a, idx2b, fld_ty(ftyd2));
          int sad2 = field_sub_addr(p, a, idx2b, ftyd2);
          if (sad2 < 0) return sad2;
          int dr2 = new_node(a, 53, sad2, 0);
          int *tyr2 = a->ty;
          if (tyr2[sad2] == 3) { return set_ty(a, dr2, 1); }
          return dr2;
        }
        if (st_is_arr(p, f) != 0) {                            // 2026-09-20：数组字段名 = **首元素地址**
          // 同本地那条：基址用字段取址节点（kind 51）+ 标地址类（值加载会让形参指针变成垃圾）
          int fa2 = new_node(a, 51, slot, 0);
          vv[fa2] = fcd2;
          int et2 = 1;
          if (ftyd2 == 4) { et2 = 2; }
          return set_ty(a, fa2, et2);
        }
        if (ftyd2 == 4) {                                      // B2k：char 标量字段（1 字节读）
          int cidx2 = new_node(a, 57, slot, 0);
          vv[cidx2] = fcd2;
          return cidx2;
        }
        int idx = new_node(a, 32, slot, 0);
        vv[idx] = fcd2;
        if (ftyd2 >= 1) { set_ty(a, idx, fld_ty(ftyd2)); }
        return idx;
      }
      if (tok_is(p, '[')) {                                       // —— 下标读 ——
        if (ty == 0 || ty == 3) return -13;                       // 标量/struct 不能下标
        p->i = p->i + 1;
        int e = parse_expr(p, a);
        if (e < 0) return -14;
        if (!tok_is(p, ']')) return -15;
        p->i = p->i + 1;
        if (ty == 1) return new_node(a, 23, slot + spec_n(spec) - 1, e);   // 本地 int 数组（升序基址）
        if (ty == 4) return new_node(a, 39, slot + spec_n(spec) - 1, e);   // 本地 char 数组（升序基址）
        if (spec_aux(spec) == 1) return new_node(a, 37, slot, e); // char* → 字节
        return new_node(a, 28, slot, e);                          // int*/struct* → 8 字节
      }
      if (ty == 1) {                                              // 裸 int 数组名 = 取址（升序基址）
        int ai = new_node(a, 25, 0, 0);
        vv[ai] = slot + spec_n(spec) - 1;
        return set_ty(a, ai, 1);
      }
      if (ty == 4) {                                              // 裸 char 数组名 = 取址（升序基址）
        int ai2 = new_node(a, 25, 0, 0);
        vv[ai2] = slot + spec_n(spec) - 1;
        return set_ty(a, ai2, 2);                                 // B2j：char 数组 → char*
      }
      if (ty == 2) {                                              // 指针变量读（64 位）
        int pi = new_node(a, 26, 0, 0);
        vv[pi] = slot;
        int aux2 = spec_aux(spec);                                // B2j：elem 随指针类型
        int pt = 1;
        if (aux2 == 1) { pt = 2; }
        else if (aux2 == 2) { pt = 3; }
        return set_ty(a, pi, pt);
      }
      if (ty == 3) return -154;                                   // struct 值不能当表达式
      if (ty == 5) {                                              // B2g char 标量读（字节）
        int ci = new_node(a, 42, 0, 0);
        vv[ci] = slot;
        return ci;
      }
      int idx = new_node(a, 6, 0, 0);
      vv[idx] = slot;
      return idx;
    }
  }
  return -4;
}

// —— B2k：复合赋值 / ++ / -- ——
// 把「已解析成值的左值节点」转成「地址节点」（-1 = 不是左值）
//   6=int 变量｜26=指针变量｜42=char 标量｜30/55=本地字段｜32/57=指针字段｜23/28/37/39=元素｜53=*q
int lv_elem(struct Ast *a, int n, int base_ty, int scale) {
  int *kd = a->kind;
  int *ll = a->l;
  int *rr = a->r;
  int *vv = a->val;
  int k = kd[n];
  int base = 0;
  if (k == 23 || k == 39) {                   // 本地数组：基址 = 最低槽（lea）
    int bs = new_node(a, 25, 0, 0);
    vv[bs] = ll[n];
    set_ty(a, bs, base_ty);
    base = bs;
  } else {                                    // 指针元素：基址 = 指针值
    int ps = new_node(a, 26, 0, 0);
    vv[ps] = ll[n];
    set_ty(a, ps, base_ty);
    base = ps;
  }
  int off = rr[n];
  if (scale == 8) {
    int n8 = new_node(a, 0, 0, 0);
    vv[n8] = 8;
    off = new_node(a, 3, off, n8);            // 下标 * 8
  }
  int ad = new_node(a, 1, base, off);         // 基址 + 偏移（地址类 → 64 位加）
  return set_ty(a, ad, base_ty);
}

int lv_addr_from(struct Ast *a, int n) {
  int *kd = a->kind;
  int *ll = a->l;
  int *vv = a->val;
  int *ty = a->ty;
  int k = kd[n];
  if (k == 53) { return ll[n]; }              // *q → 地址 = q 本身
  if (k == 6) {                               // int 变量（4 字节）
    int a1 = new_node(a, 25, 0, 0);
    vv[a1] = vv[n];
    return set_ty(a, a1, 1);
  }
  if (k == 26) {                              // 指针变量（8 字节：改的是指针本身）
    int a2 = new_node(a, 25, 0, 0);
    vv[a2] = vv[n];
    return set_ty(a, a2, 3);
  }
  if (k == 42) {                              // char 标量（1 字节）
    int a3 = new_node(a, 25, 0, 0);
    vv[a3] = vv[n];
    return set_ty(a, a3, 2);
  }
  if (k == 30) {                              // 本地 struct 字段
    int at = 3;
    if (ty[n] == 0) { at = 1; }
    int a4 = new_node(a, 52, ll[n], 0);
    vv[a4] = vv[n];
    return set_ty(a, a4, at);
  }
  if (k == 32) {                              // 指针 -> 字段
    int at2 = 3;
    if (ty[n] == 0) { at2 = 1; }
    int a5 = new_node(a, 51, ll[n], 0);
    vv[a5] = vv[n];
    return set_ty(a, a5, at2);
  }
  if (k == 55) {                              // B2k 本地 char 字段（1 字节）
    int a6 = new_node(a, 52, ll[n], 0);
    vv[a6] = vv[n];
    return set_ty(a, a6, 2);
  }
  if (k == 57) {                              // B2k 指针 -> char 字段（1 字节）
    int a7 = new_node(a, 51, ll[n], 0);
    vv[a7] = vv[n];
    return set_ty(a, a7, 2);
  }
  if (k == 23) { return lv_elem(a, n, 1, 8); }   // 本地 int 数组元素
  if (k == 28) { return lv_elem(a, n, 1, 8); }   // int*/struct* 元素
  if (k == 39) { return lv_elem(a, n, 2, 1); }   // 本地 char 数组元素
  if (k == 37) { return lv_elem(a, n, 2, 1); }   // char* 元素
  return -1;
}

// 构造自增/自减节点（op 1=++ 2=--；post 1=后缀）；宽度由地址节点类型定
int make_incdec(struct Ast *a, int addr, int op, int post) {
  int *ty = a->ty;
  int w = 4;
  if (ty[addr] == 2) { w = 1; }
  else if (ty[addr] == 3) { w = 8; }
  int n1 = new_node(a, 0, 0, 0);
  int *vv = a->val;
  vv[n1] = 1;
  int idx = new_node(a, 60, addr, n1);
  vv[idx] = op * 1000 + w * 100 + post;
  // v1.4.15（任务卡 T-20260918-005227）：8 字节目标（指针槽）→ 结果本身就是地址类，标上 ty
  //   供消费侧判宽度/零扩展。此前不标 ⇒ ty 默认 0 ⇒ `int *old = p++;` 被当「int → 指针」零扩展，
  //   发 mov eax,eax 把地址高 32 位抹掉（非 ASLR 侥幸对，一开 ASLR 就错地址/崩）。
  if (w == 8) { set_ty(a, idx, ty[addr]); }
  return idx;
}

// 探测**语句**里的复合赋值 / ++ / --（-1 = 不是；< -1 = 错误码）
//   节点 60：l = 地址表达式，r = 右值，val = op*1000 + 宽度*100 + 后缀标志
//   2026-09-20：核心拆到 lv_compound_at（不带 ';'），供「表达式位」复用（`return a += 3;` / for 头 init）
int lv_compound(struct Parse *p, struct Ast *a, int addr) {
  int idx = lv_compound_at(p, a, addr);
  if (idx == -1) { return -1; }
  if (idx < -1) { return idx; }
  if (!tok_is(p, ';')) { return -57; }
  p->i = p->i + 1;
  return idx;
}

// 复合赋值 / ++ / -- 的核心：探测运算符 + 解析右值 → 节点 60；**不吃 ';'**
//   -1 = 不是复合赋值；< -1 = 错误码（与 lv_compound 同码）
int lv_compound_at(struct Parse *p, struct Ast *a, int addr) {
  int *ks = p->ks;
  int *vs = p->vs;
  int i = p->i;
  int op = 0;
  int post = 0;
  int guard = 0;                                    // 2026-09-20：`==` 前缀（`=` `=`）即置位
  if (i + 1 < p->n && ks[i] == 3 && ks[i + 1] == 3) {
    int c1 = vs[i];
    int c2 = vs[i + 1];
    if (c2 == '=') {
      if (c1 == '+') { op = 1; }
      else if (c1 == '-') { op = 2; }
      else if (c1 == '*') { op = 3; }
      else if (c1 == '/') { op = 4; }
      else if (c1 == '%') { op = 10; }            // B2l：%=（em_apply op 10 = 取余数 edx）
      else if (c1 == '&') { op = 5; }
      else if (c1 == '|') { op = 6; }
      else if (c1 == '^') { op = 7; }
      // ⚠️ 只有「`=` 后面还是 `=`」才排除（`==`）；`<=` `>=` `!=` 的前缀分别是 `<` `>` `!`，
      //   它们的**第二个 token** 才是 `=`，不会走到这里（到这里的 p->i 已经指着 `=` 了）——
      //   2026-09-20 实测：早先把 `=` 本身也置 guard，结果把 `a += 3` 的复合赋值判成"不是复合"
      //   直接跳过（comp3 报 -48）。别再把 c1=='=' 当 guard。
      else { if (c1 == '=') { guard = 1; } }
      if (op != 0) { p->i = p->i + 2; }
    } else if (c1 == '+' && c2 == '+') { op = 1; post = 1; p->i = p->i + 2; }
    else if (c1 == '-' && c2 == '-') { op = 2; post = 1; p->i = p->i + 2; }
  }
  if (op == 0 && i + 2 < p->n && ks[i] == 3 && ks[i + 1] == 3 && ks[i + 2] == 3) {
    int d1 = vs[i];
    int d2 = vs[i + 1];
    int d3 = vs[i + 2];
    if (d1 == '<' && d2 == '<' && d3 == '=') { op = 8; p->i = p->i + 3; }
    else if (d1 == '>' && d2 == '>' && d3 == '=') { op = 9; p->i = p->i + 3; }
  }
  if (op == 0) { return -1; }
  int *ty = a->ty;
  int w = 4;
  if (ty[addr] == 2) { w = 1; }
  else if (ty[addr] == 3) { w = 8; }
  if (w == 8 && (op == 3 || op == 4 || op == 10)) { return -170; }   // 指针不支持 * / % 复合
  int idx = 0;
  if (post == 1) {
    idx = make_incdec(a, addr, op, 1);
  } else {
    int r = parse_expr(p, a);
    if (r < 0) { return -55; }
    idx = new_node(a, 60, addr, r);
    int *vv = a->val;
    vv[idx] = op * 1000 + w * 100;
    if (w == 8) { set_ty(a, idx, ty[addr]); }   // v1.4.15：同上（8 字节目标 = 地址类结果）
  }
  return idx;
}

// ===== 2026-09-20（卡 T-20260920-001345）：赋值表达式（`i = 1` / `a += 3`）用于**表达式位** =====
// 真 flint 里赋值是表达式（src\parse.c:1129 `expr()` = `assign()`，实测 q3/q4/q9/q10 全通过），
//   但 boot 的 parse_expr 只到 or/and 层 ⇒ for 头 init 的 `i = 1` 与 `return a += 3;` 被拒
//   （-192 / -48）。真 flint 在 return 处的例外：`return;` 只能用在 void 函数（实测 p4 报错），
//   除此之外 `return 赋值表达式` 与 for 头 init 都是合法的。
// 本函数**不吃 ';'**：调用方各自处理分号（for 头是 ';'，return 是 ';'，语句位是 ';'）
//   -1 = 解析失败；其余 = 表达式节点
// ===== 2026-09-20（卡 T-20260920-001345）：**for 头三段**专用赋值段解析 =====
// 真 flint 里赋值是表达式（src\parse.c:1129 `expr()` = `assign()`；实测 q1/q3/q4/q9/q10/q13 全通过），
//   而 boot 的 `parse_expr` 只到 or/and 层 ⇒ for 头 init/inc 的 `i = 1` / `i = i + 1` 被拒
//   （-192 / -196）。真 flint 的例外只有一处：`return;` 只能出现在 void 函数（实测 p4 报错）。
// 本函数**专供 for 头 init / inc 段**（不吃 ';' 也不吃 ')'，调用方自己收尾）：
//   ① 先按 primary 解析（左值一定是 primary：变量 / 字段 / 元素 / *q / ++--）
//   ② 命中复合赋值（`+=` … `<<=`）→ 节点 60（判据明确，与比较运算符不会混淆）
//   ③ 命中简单赋值（`=` 且后面还能起表达式）→ 节点 66；RHS 递归（右结合）
//   ④ 都不是 → **把 token 位退回**，交回通用 parse_expr（`i < 3`、`f(x) + 1` 等）
// ⚠️ 关键：④ 的「退回」是这套写法成立的前提 —— `parse_primary` 会先吃掉一个 primary，
//   若不做退回，`for (i = 0; i < 3; ...)` 的 init 段会把条件段的 `<` 当左值继续解析（实测 -196）。
int parse_for_head_expr(struct Parse *p, struct Ast *a) {
  int *ks = p->ks;
  int *vs = p->vs;
  int save = p->i;
  // ⚠️⚠️ 2026-09-20 实测踩坑（本轮挂死 14 分钟的第二元凶，必须记住这条模式）：
  //   **解析器里任何「不消费 token 就返回」的路径都是死循环源**。早先这里加过一条
  //   「token 种类不对就直接 return parse_expr(p, a)」的守卫 —— 它对 `++i;`/`i++;` 这类
  //   以符号开头的段会**不消费就返回**，而调用方的 for 体/语句块循环看到 token 没动就原地转，
  //   表现为「100% CPU、无输出、无产物、永不结束」（实测 arr2/st2/arr3 全中）。
  //   正解：入口**一律先吃一个 primary**，只在拿不到 primary 或「不是赋值段」时才**先回退
  //   p->i 再**走通用解析器 —— 保证每条出口都前进或明确报错。
  int lhs = parse_primary(p, a);
  if (lhs < 0) { p->i = save; return parse_expr(p, a); }
  int ad = lv_addr_from(a, lhs);
  if (ad >= 0) {
    int cpd = lv_compound_at(p, a, ad);
    if (cpd != -1) { return cpd; }
  }
  int go = 0;
  if (ad >= 0 && p->i + 1 < p->n) {
    if (ks[p->i] == 3 && vs[p->i] == '=' && ks[p->i + 1] != 0) { go = 1; }
  }
  if (go == 1) {
    p->i = p->i + 1;                                  // 吃 '='
    int rhs = parse_for_head_expr(p, a);              // 右值：赋值 / 普通表达式都行
    if (rhs < 0) { return rhs; }
    return make_simple_assign(p, a, lhs, rhs);
  }
  p->i = save;                                        // 不是赋值段 → 退回，交给通用表达式解析器
  return parse_expr(p, a);
}


// 简单赋值节点（lhs = **值节点**，内部经 lv_addr_from 转地址）
//   统一产出节点 66（发射器侧「先右值 → 再地址 → 写」，不读旧值，对未初始化的目标也安全）。
//   0 = 成功；< 0 = 错误码（与「赋值语句」老路同码：-53 认不得左值 / -198 指针目标值门槛）
int make_simple_assign(struct Parse *p, struct Ast *a, int lhs, int rhs) {
  int ad = lv_addr_from(a, lhs);
  if (ad < 0) { return -53; }
  int *ty = a->ty;
  int aty = ty[ad];
  int w = 4;
  if (aty == 2) { w = 1; } else if (aty == 3) { w = 8; }
  if (w == 4) {
    // 与赋值语句老路一致：整型标量 ← 地址值 → 打「装过地址」标记（v1.4.31 指针目标门槛用）
    int *kd = a->kind;
    if (kd[lhs] == 6) {
      int v = a->val[lhs];
      if (rhs_addr_like(p, a, rhs, 0) != 0) { set_addr_mark(p, v); }
    }
  }
  if (w == 8) {
    if (rhs_addr_like(p, a, rhs, 1) == 0) { return -198; }   // v1.4.31：指针目标值门槛
  }
  int idx = new_node(a, 66, ad, rhs);
  int *vv = a->val;
  vv[idx] = w * 100;
  if (w == 8) { set_ty(a, idx, aty); }
  return idx;
}

// —— B2k：因子 = 前缀 ++/-- ｜ primary ｜ 后缀 ++/-- ——
int parse_factor(struct Parse *p, struct Ast *a) {
  // 2026-09-20（卡 T-20260920-001345）：**一元 `+` 本轮试过两次、两次都回归，已整条撤掉**。
  //   想要的形状 = 真 flint 的 `return +5 - -3 + -2;`（实测 6）。实测证据（两次都留了痕）：
  //   · 判据松（只看「是 `+` 且不是 `++`」）：`x++ + ++x` / `x++ + 1` / `1 + ++x` 三例全被
  //     误判成一元加，接着 prefix `++` 那条去要一个左值 ⇒ -48/-50（**inc6 从 OK 变红**）。
  //   · 判据紧（要求 `+` 与操作数源码紧邻、且下一个 token 不是符号）：上面三例**仍然红** ⇒
  //     说明 boot 的 `x++` 消费路径与这个判据另有交互，短时间没定位到。
  //   ⇒ **宁可整条撤掉**（回到 HEAD 行为；edge4 继续以 -48 记在缺口表里），也不留一个把
  //     inc6 这类既有正例弄红的半成品。要重做请单独立卡，拿 inc6 + edge4 两条一起钉。
  if (tok2_is(p, '+', '+')) {
    p->i = p->i + 2;
    int v1 = parse_primary(p, a);
    if (v1 < 0) { return v1; }
    int ad1 = lv_addr_from(a, v1);
    if (ad1 < 0) { return -171; }             // ++ 需要一个左值
    return make_incdec(a, ad1, 1, 0);
  }
  if (tok2_is(p, '-', '-')) {
    p->i = p->i + 2;
    int v2 = parse_primary(p, a);
    if (v2 < 0) { return v2; }
    int ad2 = lv_addr_from(a, v2);
    if (ad2 < 0) { return -171; }
    return make_incdec(a, ad2, 2, 0);
  }
  int base = parse_primary(p, a);
  if (base < 0) { return base; }
  if (tok2_is(p, '+', '+')) {
    p->i = p->i + 2;
    int ad3 = lv_addr_from(a, base);
    if (ad3 < 0) { return -171; }
    return make_incdec(a, ad3, 1, 1);
  }
  if (tok2_is(p, '-', '-')) {
    p->i = p->i + 2;
    int ad4 = lv_addr_from(a, base);
    if (ad4 < 0) { return -171; }
    return make_incdec(a, ad4, 2, 1);
  }
  return base;
}

int parse_term(struct Parse *p, struct Ast *a) {
  int node = parse_factor(p, a);
  if (node < 0) return -10;
  while (1) {
    if (tok_is(p, '*')) {
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -11;
      node = new_node(a, 3, node, f);
    } else if (tok_is(p, '/')) {
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -12;
      node = new_node(a, 4, node, f);
    } else if (tok_is(p, '%')) {                    // B2l：取模（C 语义：余数符号随被除数）
      p->i = p->i + 1;
      int f = parse_factor(p, a);
      if (f < 0) return -13;
      node = new_node(a, 61, node, f);
    } else {
      return node;
    }
  }
}

int parse_add(struct Parse *p, struct Ast *a) {
  int *tya = a->ty;
  int node = parse_term(p, a);
  if (node < 0) return -20;
  while (1) {
    if (tok_is(p, '+')) {
      p->i = p->i + 1;
      int t = parse_term(p, a);
      if (t < 0) return -21;
      int nt = addr_ty(tya[node], tya[t]);        // B2j：任一侧地址 → 结果也是地址链
      node = new_node(a, 1, node, t);
      if (nt >= 1) { set_ty(a, node, nt); }
    } else if (tok_is(p, '-')) {
      p->i = p->i + 1;
      int t = parse_term(p, a);
      if (t < 0) return -22;
      int nt2 = addr_ty(tya[node], tya[t]);
      node = new_node(a, 2, node, t);
      if (nt2 >= 1) { set_ty(a, node, nt2); }
    } else {
      return node;
    }
  }
}

// B2h：移位层（<< >>，左结合；C 优先级：移位高于关系）
int parse_shift(struct Parse *p, struct Ast *a) {
  int node = parse_add(p, a);
  if (node < 0) return -70;
  int more = 1;
  while (more == 1) {
    int op = 0;
    if (tok2_is(p, '<', '<')) { op = 44; p->i = p->i + 2; }
    else if (tok2_is(p, '>', '>')) { op = 45; p->i = p->i + 2; }
    else { more = 0; }
    if (op != 0) {
      int r = parse_add(p, a);
      if (r < 0) return -71;
      node = new_node(a, op, node, r);
    }
  }
  return node;
}

// B2d：关系层（== != < <= > >=，左结合；结果为 0/1）
int parse_rel(struct Parse *p, struct Ast *a) {
  int node = parse_shift(p, a);
  if (node < 0) return -30;
  int more = 1;
  while (more == 1) {
    int op = 0;
    if (tok2_is(p, '=', '=')) { op = 11; p->i = p->i + 2; }
    else if (tok2_is(p, '!', '=')) { op = 12; p->i = p->i + 2; }
    else if (tok2_is(p, '<', '=')) { op = 14; p->i = p->i + 2; }
    else if (tok2_is(p, '>', '=')) { op = 16; p->i = p->i + 2; }
    else if (tok_is(p, '<')) { op = 13; p->i = p->i + 1; }
    else if (tok_is(p, '>')) { op = 15; p->i = p->i + 1; }
    else { more = 0; }
    if (op != 0) {
      int r = parse_shift(p, a);
      if (r < 0) return -31;
      node = new_node(a, op, node, r);
    }
  }
  return node;
}

// B2h：按位与（&，须与 && 区分）
int parse_band(struct Parse *p, struct Ast *a) {
  int node = parse_rel(p, a);
  if (node < 0) return -74;
  int more = 1;
  while (more == 1) {
    if (tok_is(p, '&') && !tok2_is(p, '&', '&')) {
      p->i = p->i + 1;
      int r = parse_rel(p, a);
      if (r < 0) return -75;
      node = new_node(a, 46, node, r);
    } else { more = 0; }
  }
  return node;
}

// B2h：按位异或（^）
int parse_bxor(struct Parse *p, struct Ast *a) {
  int node = parse_band(p, a);
  if (node < 0) return -76;
  while (tok_is(p, '^')) {
    p->i = p->i + 1;
    int r = parse_band(p, a);
    if (r < 0) return -77;
    node = new_node(a, 47, node, r);
  }
  return node;
}

// B2h：按位或（|，须与 || 区分）
int parse_bor(struct Parse *p, struct Ast *a) {
  int node = parse_bxor(p, a);
  if (node < 0) return -78;
  int more = 1;
  while (more == 1) {
    if (tok_is(p, '|') && !tok2_is(p, '|', '|')) {
      p->i = p->i + 1;
      int r = parse_bxor(p, a);
      if (r < 0) return -79;
      node = new_node(a, 48, node, r);
    } else { more = 0; }
  }
  return node;
}

// B2d：逻辑与（&&，短路）
int parse_and(struct Parse *p, struct Ast *a) {
  int node = parse_bor(p, a);
  if (node < 0) return -40;
  while (tok2_is(p, '&', '&')) {
    p->i = p->i + 2;
    int r = parse_bor(p, a);
    if (r < 0) return -41;
    node = new_node(a, 21, node, r);
  }
  return node;
}

// B2d：逻辑或（||，短路）
int parse_or(struct Parse *p, struct Ast *a) {
  int node = parse_and(p, a);
  if (node < 0) return -50;
  while (tok2_is(p, '|', '|')) {
    p->i = p->i + 2;
    int r = parse_and(p, a);
    if (r < 0) return -51;
    node = new_node(a, 22, node, r);
  }
  return node;
}

int parse_expr(struct Parse *p, struct Ast *a) {
  return parse_or(p, a);
}

// —— B2d：语句块 { stmt* }（调用方已吃 '{'）——返回直接子语句数（base = nblk-cnt）
// ⚠️ 子语句先缓冲到局部数组，**全部解析完再一次性追加** blk——嵌套块的子语句会在解析期先入表，
//    边解析边追加会让父块的直接子语句与后代交错，base=nblk-cnt 取到的区间就错了（B2d 实证：got 43≠45）
// B2p：depth 区分「函数体顶层块」(0) 与「嵌套块」(1)——托管变量只在函数体顶层可声明（对齐真 flint 决策 20）
int parse_block(struct Parse *p, struct Ast *a, int depth) {
  int tmp[512];                             // B2h：单块直接子语句上限 512（原 64）
  int cnt = 0;
  int vmark = p->nvars;                     // B2g：块作用域（退出时回退变量表/槽计数）
  int smark = p->nslots;
  // B3a：嵌套块入口压「作用域标记」（空名 + 0 槽 + spec 0）——declare_var_spec 的查重扫到它就停，
  //   于是块内可声明与外层同名的变量（遮蔽）；块退出时 nvars 回退到 vmark 自动摘掉标记。
  //   顶层块（depth==0）不压：形参与函数体顶层变量同属一个作用域（对齐真 flint 实测：形参不可被遮蔽）
  if (depth != 0 && p->nvars < 512) {
    int *mvps = p->vps;
    int *mvls = p->vls;
    int *mvsp = p->vsp;
    int *mvslots = p->vslots;
    int *mvad = p->vad;
    int mi = p->nvars;
    mvps[mi] = 0;
    mvls[mi] = 0;
    mvsp[mi] = 0;
    mvslots[mi] = p->nslots;
    mvad[mi] = 0;                             // v1.4.31：作用域标记项不带「装地址」标记
    p->nvars = mi + 1;
  }
  while (!tok_is(p, '}')) {
    if (p->i >= p->n) return -100;
    if (cnt >= 512) return -101;
    int s = parse_stmt(p, a);
    if (s < 0) return s;
    tmp[cnt] = s;
    cnt = cnt + 1;
  }
  p->i = p->i + 1;   // 吃 '}'
  // B2p：托管变量（own/share）不可在嵌套块 / if·while·for 体内声明——真 flint 决策 20 同规
  //   （块退出后槽被复用，而出口清理只对最后一个绑定该槽的变量发码 → 循环里每轮泄漏一个对象）
  if (depth != 0) {
    int kk = vmark;
    while (kk < p->nvars) {
      if (mg_var_kind(p, kk) != 0) return -105;
      kk = kk + 1;
    }
  }
  p->nvars = vmark;
  p->nslots = smark;
  int *blk = p->blk;
  int i = 0;
  while (i < cnt) {
    if (p->nblk >= 131072) return -101;          // 块表上限 512
    blk[p->nblk] = tmp[i];
    p->nblk = p->nblk + 1;
    i = i + 1;
  }
  return cnt;
}

// 语句位：'{' 开块；否则单语句包成 1 元素块（if/while 体统一按块处理）
int parse_stmt_block(struct Parse *p, struct Ast *a) {
  if (tok_is(p, '{')) {
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 1);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    return new_node(a, 19, base, cnt);
  }
  int s = parse_stmt(p, a);
  if (s < 0) return s;
  int *blk = p->blk;
  if (p->nblk >= 16384) return -104;
  blk[p->nblk] = s;
  p->nblk = p->nblk + 1;
  return new_node(a, 19, p->nblk - 1, 1);
}

// —— B2g：print 内建 —— print ( [ 段, ... ] [, 换行] ) ;
// 展开为对隐藏函数 _flint_out_str/_char/_int 的调用链（块语句）
int parse_print(struct Parse *p, struct Ast *a) {
  int *fna = p->fnargs;
  int *fpty = p->fpty;                      // B4b：判「char 值返回的调用」段（真 flint 按返回类型分派）
  int *avv = a->val;
  int *ar = p->args;
  int *ty = a->ty;
  int *kd = a->kind;
  int tmp[256];                             // B2h：单条 print 段数上限 256（原 32）
  int cnt = 0;
  int fi_str = find_func_by(p, "_flint_out_str");
  int fi_char = find_func_by(p, "_flint_out_char");
  int fi_int = find_func_by(p, "_flint_out_int");
  if (fi_str < 0 || fi_char < 0 || fi_int < 0) return -182;
  p->i = p->i + 1;                          // 吃 'print'
  if (!tok_is(p, '(')) return -180;
  p->i = p->i + 1;
  if (!tok_is(p, '[')) return -181;
  p->i = p->i + 1;
  if (!tok_is(p, ']')) {
    int more = 1;
    while (more == 1) {
      int e = parse_expr(p, a);
      if (e < 0) return -183;
      if (cnt >= 256) return -184;
      if (p->nargs >= 65536) return -10;
      int fi2 = fi_int;
      // B2i：char 值段识别扩展——char 标量(42) / char* 下标读(37) / char 数组下标读(39)
      if (kd[e] == 42 || kd[e] == 37 || kd[e] == 39) { fi2 = fi_char; }
      else if (kd[e] == 10 && fn_retptr(fpty[avv[e]]) == 4) { fi2 = fi_char; }   // B4b：char 值返回的调用
      else if (ty[e] == 2) { fi2 = fi_str; }        // B2j：ty 2 = char* 地址段（原 ==1 全地址）
      ar[p->nargs] = e;
      int base = p->nargs;
      p->nargs = p->nargs + 1;
      int call = new_node(a, 10, base, 1);
      int *vv = a->val;
      vv[call] = fi2;
      tmp[cnt] = call;
      cnt = cnt + 1;
      if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
    }
  }
  if (!tok_is(p, ']')) return -185;
  p->i = p->i + 1;
  if (tok_is(p, ',')) {                     // 可选换行参数（常量）
    p->i = p->i + 1;
    if (!tok_is_num(p)) return -186;
    int nl = tok_num_val(p);
    p->i = p->i + 1;
    if (nl != 0) {
      char *pool = p->spool;
      if (p->spcur >= 262144) return -160;
      int off = p->spcur;
      pool[off] = 10;
      p->spcur = off + 1;
      pool[p->spcur] = 0;
      p->spcur = p->spcur + 1;
      int sn = new_node(a, 41, 0, 0);
      int *vv2 = a->val;
      vv2[sn] = off;
      set_ty(a, sn, 2);                       // B2j：换行串 = char*
      if (p->nargs >= 65536) return -10;
      ar[p->nargs] = sn;
      int base2 = p->nargs;
      p->nargs = p->nargs + 1;
      int call2 = new_node(a, 10, base2, 1);
      int *vv3 = a->val;
      vv3[call2] = fi_str;
      tmp[cnt] = call2;
      cnt = cnt + 1;
    }
  }
  if (!tok_is(p, ')')) return -187;
  p->i = p->i + 1;
  if (!tok_is(p, ';')) return -188;
  p->i = p->i + 1;
  int *blk = p->blk;
  int i = 0;
  while (i < cnt) {
    if (p->nblk >= 131072) return -101;
    blk[p->nblk] = tmp[i];
    p->nblk = p->nblk + 1;
    i = i + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}
// —— B4a：类型前缀（int / int* / char / char* / struct 名 / struct 名* + own/share 标注）——
// 返回「打包规格」= ty*1000000 + aux*100000 + (sid+1)*100 + mg，负值 = 错误码。
// （FLINT 自产函数 ≤4 参 → 不能用 5 个输出参数，故打包成一个 int；-1 用 sid=-1 的 0 表示）
int parse_type_prefix(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int ty = 0;
  int aux = 0;
  int sid = -1;
  int mg = 0;
  if (tok_ident_eq(p, "int")) {
    p->i = p->i + 1;
    if (tok_is(p, '*')) { ty = 2; aux = 0; p->i = p->i + 1; }
  } else if (tok_ident_eq(p, "char")) {
    p->i = p->i + 1;
    if (!tok_is(p, '*')) { ty = 4; }
    else { p->i = p->i + 1; ty = 2; aux = 1; }
  } else {                                            // struct 名 [*]
    p->i = p->i + 1;
    if (p->i >= p->n || ks[p->i] != 1) return -142;
    sid = st_find(p, ps[p->i], ls[p->i]);
    if (sid < 0) return -143;
    p->i = p->i + 1;
    ty = 3;
    if (tok_is(p, '*')) { p->i = p->i + 1; ty = 2; aux = 2; }
  }
  if (tok_ident_eq(p, "own")) {
    if (ty != 2 || aux != 0) return -168;             // char*/struct* 无托管语义
    mg = 1; p->i = p->i + 1;
  } else if (tok_ident_eq(p, "share")) {
    if (ty != 2 || aux != 0) return -168;
    mg = 2; p->i = p->i + 1;
  }
  return ty * 1000000 + aux * 100000 + (sid + 1) * 100 + mg;
}

// —— B4a：声明符主体（类型规格已由调用方解析；spec = parse_type_prefix 的打包值）——
// 普通声明走 parse_decl，for 头多声明走 parse_decl_multi（共用同一类型规格）。
int parse_decl_body(struct Parse *p, struct Ast *a, int spec) {
  int *ps = p->ps;
  int *ls = p->ls;
  int ty = spec / 1000000;
  int aux = spec / 100000 % 10;
  int sid = spec / 100 - spec / 100000 * 1000 - 1;
  int mg = spec % 100;
  if (p->i >= p->n || p->ks[p->i] != 1) return -41;
  if (tok_ident_eq(p, "int")) return -42;
  if (tok_ident_eq(p, "char")) return -42;
  if (tok_ident_eq(p, "struct")) return -42;
  if (tok_ident_eq(p, "own")) return -168;
  if (tok_ident_eq(p, "share")) return -168;
  if (tok_ident_eq(p, "return")) return -43;
  if (tok_ident_eq(p, "if")) return -43;
  if (tok_ident_eq(p, "while")) return -43;
  if (tok_ident_eq(p, "else")) return -43;
  int pos = ps[p->i];
  int len = ls[p->i];
  p->i = p->i + 1;
  if (tok_is(p, '[')) {                               // 数组（长度必须字面量）
    if (ty != 0 && ty != 4) return -144;
    p->i = p->i + 1;
    if (!tok_is_num(p)) return -70;
    int n = tok_num_val(p);
    if (n <= 0) return -71;
    p->i = p->i + 1;
    if (!tok_is(p, ']')) return -72;
    p->i = p->i + 1;
    int aslot = 0;
    if (ty == 4) { aslot = declare_carr(p, pos, len, n); }
    else { aslot = declare_arr(p, pos, len, n); }
    if (aslot < 0) return -44;
    if (tok_is(p, '=')) return -73;                   // 数组初始化暂不支持
    // 2026-09-20（卡 T-20260920-144154）：数组声明符后面可以接 `,` —— 真 flint 实测放行
    //   `int a[3], b;`（boot 原先在这里直接 -47 = 双端断点）。把 `,` 留给调用方的多声明循环。
    if (tok_is(p, ',')) { return new_node(a, 19, p->nblk, 0); }
    if (!tok_is(p, ';')) return -47;
    p->i = p->i + 1;
    return new_node(a, 19, p->nblk, 0);               // 数组声明 = 空块
  }
  if (ty == 4) { ty = 5; }                            // char 标量（B2g）
  int slot = 0;
  if (ty == 0) { slot = declare_int(p, pos, len); }
  else if (ty == 5) { slot = declare_char(p, pos, len); }
  else if (ty == 2) {
    if (mg == 1) { slot = declare_var_spec(p, pos, len, 200000000 + 10 * 1000000 + (p->main_idx + 1) * 1000 + 1); }
    else if (mg == 2) { slot = declare_var_spec(p, pos, len, 200000000 + 20 * 1000000 + (p->main_idx + 1) * 1000 + 1); }
    else { slot = declare_ptr(p, pos, len, aux * 1000 + sid + 1); }
  }
  else { slot = declare_struct(p, pos, len, sid); }
  if (slot < 0) return -44;
  if (mg != 0) {                                      // —— B2l：own/share 必须初始化 + 初始化式限制 ——
    if (!tok_is(p, '=')) return -164;
    p->i = p->i + 1;
    int emg = parse_expr(p, a);
    if (emg < 0) return -165;
    int *kdm = a->kind;
    if (mg == 1) {
      if (kdm[emg] != 62) return -166;                // own 只能由 new 初始化（独占所有权）
      int io = new_node(a, 36, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return io;
    }
    if (kdm[emg] == 62) {                             // share = new（头部计数已为 1）
      int ish = new_node(a, 36, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return ish;
    }
    if (mg_node_kind(p, a, emg) == 2) {               // share = share 变量（引用计数 +1 后接管）
      int iac = new_node(a, 63, slot, emg);
      if (!tok_is(p, ';')) return -47;
      p->i = p->i + 1;
      return iac;
    }
    return -167;                                      // share 只能由 new / share 变量初始化
  }
  if (tok_is(p, '=')) {
    if (ty == 3) return -145;                         // struct 值初始化暂不支持
    p->i = p->i + 1;
    int e = parse_expr(p, a);
    if (e < 0) return -45;
    if (ty == 2 && mg_node_kind(p, a, e) != 0) return -169;   // B2l：托管指针不能拷贝给裸指针
    if (ty == 2 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }        // v1.4.31：指针目标值门槛
    if (ty == 0 && rhs_addr_like(p, a, e, 0) != 0) { set_addr_mark(p, slot); }   // v1.4.31：标记「装过地址的 int」
    int nk = 8;
    if (ty == 2) { nk = 36; }
    if (ty == 5) { nk = 43; }                          // char 标量初始化（字节存）
    int idx = new_node(a, nk, slot, e);
    if (tok_is(p, ',')) { return idx; }                // B4a：for 头多声明（`,` 交由 parse_decl_multi 继续）
    if (!tok_is(p, ';')) return -47;
    p->i = p->i + 1;
    return idx;
  }
  if (tok_is(p, ',')) {                              // B4a：多声明（无初始化项）
    // 2026-09-20（卡 T-20260920-144154）：**struct 值多声明按真 flint 口径拒绝** ——
    //   真 flint 实测 `struct P s, t;` 在第 2 个名字处报「期望 ';'」（`struct P s;` 单声明是放行的）
    //   ⇒ boot 若默默放行就变成「boot 比真 flint 宽」的静默分岔（差分门的 OK→FLINT_FAIL 那一类）。
    //   错误码沿用 -47（= 本文件的「期望 ';'」），与真 flint 的文案同义。
    if (ty == 3) { return -47; }
    return new_node(a, 8, slot, -1);
  }
  if (!tok_is(p, ';')) return -47;
  p->i = p->i + 1;
  if (ty == 0) return new_node(a, 8, slot, -1);       // int 无初始化：r = -1
  return new_node(a, 19, p->nblk, 0);                 // 指针/struct 声明 = 空块
}

// —— 2026-09-20（卡 T-20260920-144154）：**后续声明符自带的 `*`** ——
//   真 flint 实测口径（本次逐条跑过）：
//     `int *p = &x, *q = &y;` ✓ ／ `int a, *q;` ✓ ／ `char *a, *b;` ✓
//     `struct P *a, *b;` ✗（报「期望变量名」）⇒ **只有 int/char 基础类型放行**。
//   ⚠️ **只对「第一个之后的声明符」调用本函数**：第一个声明符的 `*` 已由 `parse_type_prefix` 吃掉，
//      若对第一个也放行，`int **q`（真 flint 拒绝：声明后需跟变量名）会被静默当成单层指针
//      = **静默错类型**（本仓最忌讳的一类 —— 编得过、值不对）。
//   ⚠️ 返回**改写后的 spec**（没见到 `*` 就原样返回），把 `*` 的规格换算做在这里，
//      `parse_decl_body` 一行都不用动。返回负数 = 报错码。
int decl_cont_spec(struct Parse *p, int spec) {
  int bty = spec / 1000000;
  int baux = spec / 100000 % 10;
  int base = 0;
  if (bty == 0) { base = 0; }                        // int
  else if (bty == 4) { base = 1; }                   // char
  else if (bty == 3) { base = 2; }                   // struct 值
  else { base = baux; }                              // bty == 2：aux 就是基础类型
  if (!tok_is(p, '*')) { return spec; }
  if (base == 2) { return -41; }                     // struct 指针重复 `*`：真 flint 拒绝
  p->i = p->i + 1;
  return 2000000 + base * 100000;                    // ty=2 + aux=base（与 parse_type_prefix 同编码）
}

// —— 2026-09-20（卡 T-20260920-144154）：普通**语句**位置的多声明 ——
//   本函数**取代了旧的 parse_decl**（旧函数 = 本函数去掉 `,` 分支那条路，已删：留着是两套真相）。
//   B4a 只把多声明做进了 for 头（parse_decl_multi）；语句位置此前只解析**一个**声明符
//   ⇒ `int a = 1, b, c = 3;` 里的 `,` 被当成下一句的开头 ⇒ parse_or 报 -51
//   （实测样本 decl1 / multi_init，两端复现：boot 报 -51、真 flint 正常出产物）。
//   ⚠️ 单个声明符时**必须原样返回那个节点、不许包块** —— parse_decl_multi 的口径是「一律包一层块」，
//      照搬到语句位置会让**所有既有单声明样本的 AST 形状改变**（块的子节点表整个换位置），
//      徒增回归面。所以这里走「先按老路解析第一个声明符，**只有真见到 `,` 才转多声明**」。
//   多声明路径与 parse_decl_multi 同构：先全部缓冲到 tmp、再一次性追加进 blk
//   （边解析边追加会让 `base/cnt` 取到的区间混进别的语句 —— B2d 已在 parse_block 上踩过一次）。
int parse_decl_stmt(struct Parse *p, struct Ast *a) {
  int spec = parse_type_prefix(p);
  if (spec < 0) { return spec; }
  int first = parse_decl_body(p, a, spec);
  if (first < 0) { return first; }
  if (!tok_is(p, ',')) { return first; }        // 单声明符：与已被取代的旧 parse_decl 一字不差
  int tmp[32];
  tmp[0] = first;
  int cnt = 1;
  while (tok_is(p, ',')) {
    if (cnt >= 32) { return -101; }
    p->i = p->i + 1;
    int dspec = decl_cont_spec(p, spec);        // 后续声明符可自带 `*`（口径见 decl_cont_spec）
    if (dspec < 0) { return dspec; }
    int d = parse_decl_body(p, a, dspec);       // 后续声明符共用同一基础类型（j 不带 int）
    if (d < 0) { return d; }
    tmp[cnt] = d;
    cnt = cnt + 1;
  }
  int *blk = p->blk;
  int j = 0;
  while (j < cnt) {
    if (p->nblk >= 131072) { return -101; }
    blk[p->nblk] = tmp[j];
    p->nblk = p->nblk + 1;
    j = j + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}

// —— 旧的 parse_decl（类型前缀 + **一个**声明符）已于 2026-09-20 删除 ——
//   它唯一调用者就是 parse_stmt，现由 parse_decl_stmt 顶替（单声明符路径行为逐字一致）。
//   留两套等价函数 = 后来人可能改一处忘另一处 ⇒ 直接删掉。

// —— B4a：for 头的多声明 init（`for (int i = 0, j = 10; ...)`）——
// 类型前缀只解析一次，后续声明符共用（`int i = 0, j = 10;` 的 j 不带 int）；
// parse_decl_body 自己会吃掉结尾的 ';'（普通声明语句需要），因此这里不再找分号。
int parse_decl_multi(struct Parse *p, struct Ast *a) {
  int tmp[32];
  int cnt = 0;
  int spec = parse_type_prefix(p);
  if (spec < 0) { return spec; }
  int more = 1;
  while (more == 1) {
    if (cnt >= 32) { return -101; }
    int dspec = spec;
    if (cnt > 0) {                              // 2026-09-20：第一个之后的声明符可自带 `*`
      dspec = decl_cont_spec(p, spec);
      if (dspec < 0) { return dspec; }
    }
    int d = parse_decl_body(p, a, dspec);
    if (d < 0) { return d; }
    tmp[cnt] = d;
    cnt = cnt + 1;
    if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
  }
  int *blk = p->blk;
  int j = 0;
  while (j < cnt) {
    if (p->nblk >= 131072) { return -101; }
    blk[p->nblk] = tmp[j];
    p->nblk = p->nblk + 1;
    j = j + 1;
  }
  return new_node(a, 19, p->nblk - cnt, cnt);
}

// —— B2d：单语句 —— 声明 / 赋值 / return / if / while / 块 ——
int parse_stmt(struct Parse *p, struct Ast *a) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  int *vs = p->vs;
  int *kd = a->kind;                          // B2k：字段写节点改判 char 档（31→56 / 33→58）
  if (tok_is(p, '{')) {                       // 块语句
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 1);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    return new_node(a, 19, base, cnt);
  }
  if (tok_ident_eq(p, "break") || tok_ident_eq(p, "continue")) {
    // 2026-09-21（卡 T-20260921-194703）：I 类 break/continue（真实应用 `apps\m2_float\config.fl`
    //   用了两处 `break`）。判据：必须在循环体内 ⇒ 解析期用 loopdepth 拦住"循环外的 break"，
    //   否则发射端会发一条**目标未知**的 jmp（跳哪儿全看补丁表，属静默错码）。
    //   AST：68 = break ｜ 69 = continue（都无操作数）；机器侧 = 一条 `E9 rel32`，
    //   目标由**所属循环**收尾时回填（while → 条件处；for → **增量段**，C 语义）
    int isbrk = 1;
    if (tok_ident_eq(p, "continue")) { isbrk = 0; }
    if (p->loopdepth <= 0) { return -202; }
    p->i = p->i + 1;
    if (!tok_is(p, ';')) { return -57; }
    p->i = p->i + 1;
    if (isbrk == 0) { return new_node(a, 69, 0, 0); }
    return new_node(a, 68, 0, 0);
  }
  if (tok_ident_eq(p, "if")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -110;
    p->i = p->i + 1;
    int cond = parse_expr(p, a);
    if (cond < 0) return -111;
    int chk_if = check_void_value_rec(p, a, cond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
    if (chk_if < 0) return chk_if;
    if (!tok_is(p, ')')) return -112;
    p->i = p->i + 1;
    int thenb = parse_stmt_block(p, a);
    if (thenb < 0) return thenb;
    int elseb = -1;
    if (tok_ident_eq(p, "else")) {
      p->i = p->i + 1;
      elseb = parse_stmt_block(p, a);
      if (elseb < 0) return elseb;
    }
    int idx = new_node(a, 17, cond, thenb);
    int *vv = a->val;
    vv[idx] = elseb;
    return idx;
  }
  if (tok_ident_eq(p, "while")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -120;
    p->i = p->i + 1;
    int cond = parse_expr(p, a);
    if (cond < 0) return -121;
    int chk_wh = check_void_value_rec(p, a, cond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
    if (chk_wh < 0) return chk_wh;
    if (!tok_is(p, ')')) return -122;
    p->i = p->i + 1;
    p->loopdepth = p->loopdepth + 1;                  // 2026-09-21：循环体内 `break`/`continue` 合法
    int body = parse_stmt_block(p, a);
    p->loopdepth = p->loopdepth - 1;
    if (body < 0) return body;
    return new_node(a, 18, cond, body);
  }
  // —— B4a：for (init?; cond?; inc?) body ——
  // 语义与真 flint 的 ND_FOR 一致：init 只跑一次 → cond 判（空 = 恒真）→ body → inc → 回判。
  // for 头单独一层作用域（init 声明的变量只在 for 内可见）——压作用域标记，块退出时 nvars/nslots 回退。
  // AST：kind 65 = for(l=init, r=cond, val=inc*100000+body)（-1 = 该段为空；不复用块表，四段各自发射）
  if (tok_ident_eq(p, "for")) {
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -190;
    p->i = p->i + 1;
    int fmark = p->nvars;
    int fsmark = p->nslots;
    if (p->nvars < 512) {                     // 作用域标记（空名 + 0 槽 + spec 0），B3a 同款
      int *mvps = p->vps;
      int *mvls = p->vls;
      int *mvsp = p->vsp;
      int *mvslots = p->vslots;
      int *mvad = p->vad;
      int mi = p->nvars;
      mvps[mi] = 0;
      mvls[mi] = 0;
      mvsp[mi] = 0;
      mvslots[mi] = p->nslots;
      mvad[mi] = 0;                           // v1.4.31：作用域标记项不带「装地址」标记
      p->nvars = mi + 1;
    }
    int finit = -1;
    if (!tok_is(p, ';')) {
      if (tok_ident_eq(p, "int") || tok_ident_eq(p, "char") || tok_ident_eq(p, "struct")) {
        finit = parse_decl_multi(p, a);       // B4a：支持 `int i = 0, j = 10;`（自带分号，缺分号 → -192）
        if (finit < 0) { p->nvars = fmark; p->nslots = fsmark; return finit; }
      } else {
        // 2026-09-20（卡 T-20260920-001345）：init 段允许**赋值表达式**（`i = 1`）——
        //   真 flint 实测 q1 通过（`for (i = 1; i <= 100; i = i + 1)`）、q13（`s += 4`）也通过；
        //   旧写 parse_expr 只到 or/and 层 ⇒ `i = 1` 解析成 `i` 后卡在 '=' → -192
        int ie = parse_for_head_expr(p, a);
        if (ie < 0) { p->nvars = fmark; p->nslots = fsmark; return -191; }
        if (!tok_is(p, ';')) { p->nvars = fmark; p->nslots = fsmark; return -192; }
        p->i = p->i + 1;
        finit = new_node(a, 50, ie, 0);
      }
    } else {
      p->i = p->i + 1;
    }
    int fcond = -1;
    if (!tok_is(p, ';')) {
          fcond = parse_expr(p, a);
      if (fcond < 0) { p->nvars = fmark; p->nslots = fsmark; return -193; }
      int vcf = check_void_value_rec(p, a, fcond, 100000 + 4096);   // 2026-09-20：void 调用不能当条件值
      if (vcf < 0) { p->nvars = fmark; p->nslots = fsmark; return vcf; }
    }
    if (!tok_is(p, ';')) { p->nvars = fmark; p->nslots = fsmark; return -194; }
    p->i = p->i + 1;
    int finc = -1;
    if (!tok_is(p, ')')) {
      int i0 = 14;
      while (i0 < 24) {
        i0 = i0 + 1;
      }
      int ie2 = parse_for_head_expr(p, a);
      if (ie2 < 0) { p->nvars = fmark; p->nslots = fsmark; return -195; }
      int vci = check_void_value_rec(p, a, ie2, 100000 + 4096);     // 2026-09-20：void 调用不能当 inc 段的值
      if (vci < 0) { p->nvars = fmark; p->nslots = fsmark; return vci; }
      finc = new_node(a, 50, ie2, 0);
    }
    if (!tok_is(p, ')')) { p->nvars = fmark; p->nslots = fsmark; return -196; }
    p->i = p->i + 1;
    p->loopdepth = p->loopdepth + 1;                  // 2026-09-21：for 体同样是循环体
    int fbody = parse_stmt_block(p, a);
    p->loopdepth = p->loopdepth - 1;
    if (fbody < 0) { p->nvars = fmark; p->nslots = fsmark; return fbody; }    p->nvars = fmark;
    p->nslots = fsmark;
    int fidx = new_node(a, 65, finit, fcond);
    int *fv = a->val;
    // ⚠️ 打包成非负值：(inc+1)*100000 + body——FLINT 的 % 随被除数符号（C 语义），
    //    用 `inc*100000+body`（空段 = -1）会让 vv%100000 得负数，body 取不回来（B4a 实测踩过）
    fv[fidx] = (finc + 1) * 100000 + fbody;
    return fidx;
  }
  if (tok_ident_eq(p, "int") || tok_ident_eq(p, "char") || tok_ident_eq(p, "struct")) {
    return parse_decl_stmt(p, a);             // B2f：声明语句（2026-09-20：支持多声明 `int a=1, b, c=3;`）
  }
  if (tok_ident_eq(p, "print")) {
    return parse_print(p, a);
  }
  if (tok_ident_eq(p, "return")) {
    p->i = p->i + 1;
    // 2026-09-20（卡 T-20260920-001345）：`return;`（空返回）——真 flint 实测只允许出现在 void 函数
    //   （p1 通过、p4「int 函数里 return;」报「'return;' 只能用在 void 函数」）→ 这里同口径，新码 -199
    if (tok_is(p, ';')) {
      if (p->ret_void == 0) return -199;
      p->i = p->i + 1;
      return new_node(a, 9, -1, 0);          // 9=return，l=-1 → 发射端不取值（EAX 不定，void 调用方不看）
    }
    if (p->ret_void != 0) return -201;       // void 函数不能 return 表达式（真 flint 实测 p3 报此错）
    // 2026-09-20（卡 T-20260920-001345）：G 类 `return a += 3;`。
    //   boot 的 parse_expr 对 `a += 3` 返回 -50（parse_add 吃到 `+` 后把 `= 3` 当右操作数），
    //   所以必须先探复合赋值。**判据只能极窄**：第 1 个 token 是标识符、且**紧跟**着运算符
    //   （见 tok2_compound_ahead）。判据一放松（只要"两个符号 token"），
    //   `return setp(&v, 40, 2) + v.x + v.y;` 会被误判 ⇒ 走窄路 ⇒ 报 -198 ⇒
    //   自举解释器自测第 45 项直接挂（实测撞过两次）。窄路失败要**回退 p->i 重来**，
    //   且每条出口都必须前进（"不消费就返回"是死循环源 —— arr2/st2 曾挂 14 分钟）。
    int e = 0;
    int got_cpd = 0;
    // ⚠️ 2026-09-20 实测踩坑（inc6 从 OK 变红就是这个）：`parse_primary` **会消费后缀 `++`**
    //   （`x++` 整体是它的 primary）。所以窄路必须**先排除「标识符紧跟 `++`/`--`」**，
    //   否则 `return x++ + 1;` 会被吃掉 `x++`、把 `p->i` 留在空格后的 `+` 上，
    //   再回退重来也救不回（回退是按 token 位，节点已建）⇒ 报 -50。
    //   判据 = 第 1 个 token 是标识符 + 紧跟复合赋值运算符（tok2_compound_ahead，**不含 ++/--**）
    //         + 后面不是 `++`/`--`（tok2_is 排除两例）。
    int k10 = 0;
    if (p->i < p->n) { k10 = ks[p->i]; }
    // 窄路只认「标识符 + **紧跟复合赋值运算符**」（`+=` `-=` … `<<=` `>>=`）——
    //   必须是「两个符号 token 且后者含 `=`」或三 token 的 `<<=`/`>>=`。
    //   ⚠️ 这是被实测逼出来的第三条判据：光看「第 1 个是标识符」会把 `sq(6) + 6`（自举自测第 26 项）、
    //   `setp(&v, 40, 2) + …`（第 45 项）、`x++ + 1`（inc6）全带进窄路 ⇒ 走 parse_primary 时
    //   把函数调用/后缀 `++` 整段吃掉 → 报 -50/-198。加上这条后三条样本同时绿。
    int op10 = 0;
    if (p->i + 1 < p->n && ks[p->i + 1] == 3) {
      int c1 = vs[p->i + 1];
      int c2 = 0;
      if (p->i + 2 < p->n && ks[p->i + 2] == 3) { c2 = vs[p->i + 2]; }
      if (c2 == '=') {
        if (c1 == '+' || c1 == '-' || c1 == '*' || c1 == '/' || c1 == '%'
            || c1 == '&' || c1 == '|' || c1 == '^') { op10 = 1; }
      }
      if (c1 == '<' && c2 == '<') {
        int c3 = 0;
        if (p->i + 3 < p->n && ks[p->i + 3] == 3) { c3 = vs[p->i + 3]; }
        if (c3 == '=') { op10 = 1; }
      }
      if (c1 == '>' && c2 == '>') {
        int c4 = 0;
        if (p->i + 3 < p->n && ks[p->i + 3] == 3) { c4 = vs[p->i + 3]; }
        if (c4 == '=') { op10 = 1; }
      }
    }
    if (k10 == 1 && op10 != 0) {
      int sv0 = p->i;
      int lvp = parse_primary(p, a);
      if (lvp >= 0 && p->i > sv0) {
        int adz = lv_addr_from(a, lvp);
        if (adz >= 0) {
          int cpd = lv_compound_at(p, a, adz);
          if (cpd != -1) { e = cpd; got_cpd = 1; }
        }
      }
      if (got_cpd == 0) { p->i = sv0; }
    }
    if (got_cpd == 0) {
      e = parse_expr(p, a);
    }
    if (e < 0) return -48;
    if (mg_node_kind(p, a, e) != 0) return -172;      // B2l：托管指针不能作 return 值（出口释放 → 悬垂）
    int vv0 = check_void_value(p, a, e);     // 2026-09-20：void 调用不能当值（真 flint 实测 p8 报此错）
    if (vv0 < 0) return vv0;
    int idx = new_node(a, 9, e, 0);
    if (!tok_is(p, ';')) return -50;
    p->i = p->i + 1;
    return idx;
  }
  if (tok_ident_eq(p, "else")) return -115;   // else 无 if
  // B2h：调用语句（表达式语句）——真实库大量出现 `foo(a);`（B2d 边界，自举必需）
  if (p->i + 1 < p->n && ks[p->i] == 1 && ks[p->i + 1] == 3 && vs[p->i + 1] == '(') {
    int e3 = parse_expr(p, a);
    if (e3 < 0) return e3;
    // 2026-09-20：表达式语句的根允许是 void 调用（`v();`），但实参里不允许（真 flint 同口径）
    int vv3 = check_void_value(p, a, e3);
    if (vv3 < 0) return vv3;
    if (!tok_is(p, ';')) return -56;
    p->i = p->i + 1;
    return new_node(a, 50, e3, 0);
  }
  if (tok_is(p, '*')) {                        // B2j：*q = expr ;（解引用写）
    p->i = p->i + 1;
    int lv = parse_factor(p, a);
    if (lv < 0) return lv;
    // B2k：*q op= e（地址 = q 本身；宽度按被指对象）
    {
      int cpd = lv_compound(p, a, lv);
      if (cpd != -1) { return cpd; }
    }
    int *tyl = a->ty;
    int et = tyl[lv];
    if (et == 0) return -157;                  // 解引用非指针（拒绝）
    if (!tok_is(p, '=')) return -54;
    p->i = p->i + 1;
    int de = parse_expr(p, a);
    if (de < 0) return -55;
    int didx = new_node(a, 54, lv, de);
    if (!tok_is(p, ';')) return -57;
    p->i = p->i + 1;
    return didx;
  }
  // B2k：前缀 ++/-- 语句（++x; / ++arr[i]; / ++v.f; / ++*q;）
  if (tok2_is(p, '+', '+') || tok2_is(p, '-', '-')) {
    int inc = parse_factor(p, a);
    if (inc < 0) return inc;
    if (!tok_is(p, ';')) return -57;
    p->i = p->i + 1;
    return inc;
  }
  {                                            // 赋值：左值 = expr ;
    if (p->i >= p->n || ks[p->i] != 1) return -51;
    {
      int kmg = find_var_idx(p, ps[p->i], ls[p->i]);
      if (kmg >= 0 && mg_var_kind(p, kmg) != 0) return -170;   // B2l：托管指针不能重赋值/复合/自增
    }
    // B2k：先试复合赋值 / ++ / --（解析左值 → 取地址 → 探测运算符；不是则回退重解析）
    {
      int sv = p->i;
      int pv = parse_primary(p, a);
      if (pv >= 0) {
        // B4a：先处理「后缀 ++/--」——lv_compound 只看接下来的 2~3 个符号，
        //   `x++ + 10` 这类写法会把后缀 ++ 误当复合赋值（实测踩过）；后缀优先级最高，单独判。
        if (p->i + 1 < p->n && ks[p->i] == 3 && ks[p->i + 1] == 3) {
          int q1 = vs[p->i];
          int q2 = vs[p->i + 1];
          if ((q1 == '+' && q2 == '+') || (q1 == '-' && q2 == '-')) {
            int adp = lv_addr_from(a, pv);
            if (adp >= 0) {
              int opi = 1;
              if (q1 == '-') { opi = 2; }
              p->i = p->i + 2;
              if (!tok_is(p, ';')) { return -57; }
              p->i = p->i + 1;
              return make_incdec(a, adp, opi, 1);
            }
          }
        }
        int ad0 = lv_addr_from(a, pv);
        if (ad0 >= 0) {
          int cp = lv_compound(p, a, ad0);
          if (cp != -1) { return cp; }
        }
      }
      p->i = sv;
    }
    int k = find_var_idx(p, ps[p->i], ls[p->i]);
    if (k < 0) {
      // 2026-09-21（卡 T-20260921-194703）：全局变量赋值语句。
      //   复合赋值 / ++ / -- **不走这里** —— 上面的探针先跑 parse_primary + lv_addr_from，
      //   而节点 53（解引用读）的 lv_addr_from 就是「返回它的地址操作数」⇒ 节点 60 自动接住。
      int gk3 = g_find(p, ps[p->i], ls[p->i]);
      if (gk3 < 0) return -53;
      return parse_global_assign(p, a, gk3);
    }
    int *vsp = p->vsp;
    int *vslots = p->vslots;
    int spec = vsp[k];
    int ty = spec_ty(spec);
    int slot = vslots[k] - p->sbase;
    p->i = p->i + 1;
    if (tok_is(p, '.')) {                      // B2f：本地 struct 字段写
      if (ty != 3) return -150;
      int sid = spec_sid(spec);
      p->i = p->i + 1;
      if (p->i >= p->n || ks[p->i] != 1) return -151;
      int f = st_find_field(p, sid, ps[p->i], ls[p->i]);
      if (f < 0) return -152;
      p->i = p->i + 1;
      if (tok_is(p, '[')) {                    // B2m：s.arr[i] = expr（指针字段直接下标写）
        int fst = st_fty(p, f);
        int fcd1 = fld_code(p, sid, f);
        int fbn = new_node(a, 30, slot + st_nslots(p, sid) - 1, 0);
        int fad = 0;
        if (fld_arr_kind(p, f) != 0) {         // 2026-09-20：定长数组字段 `int buf[4]`
          fad = fld_arr_addr_loc(p, a, slot * 1000 + st_nslots(p, sid), fcd1 * 100 + fst);
        } else {
          if (fst == 0 || fst == 4) return -13;  // int/char 字段不能下标
          int *vvb = a->val;
          vvb[fbn] = fcd1;
          set_ty(a, fbn, fld_ty(fst));
          fad = field_sub_addr(p, a, fbn, fst);
        }
        if (fad < 0) return fad;
        if (!tok_is(p, '=')) return -54;
        p->i = p->i + 1;
        int fe = parse_expr(p, a);
        if (fe < 0) return -55;
        int fw = new_node(a, 54, fad, fe);
        if (!tok_is(p, ';')) return -57;
        p->i = p->i + 1;
        return fw;
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int idx = new_node(a, 31, slot + st_nslots(p, sid) - 1, e);   // 2026-09-22：预留槽数
      int *vv = a->val;
      int ftyd2 = st_fty(p, f);
      if (ftyd2 >= 1 && ftyd2 != 4 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }   // v1.4.31：指针字段值门槛
      vv[idx] = fld_code(p, sid, f);
      if (ftyd2 == 4) { kd[idx] = 56; }                              // B2k：char 标量字段（1 字节写）
      else if (ftyd2 >= 1) { set_ty(a, idx, fld_ty(ftyd2)); }
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (tok2_is(p, '-', '>')) {                // B2f：指针 -> 字段写
      if (ty != 2 || spec_aux(spec) != 2) return -153;
      int sid = spec_sid(spec);
      p->i = p->i + 2;
      if (p->i >= p->n || ks[p->i] != 1) return -151;
      int f = st_find_field(p, sid, ps[p->i], ls[p->i]);
      if (f < 0) return -152;
      p->i = p->i + 1;
      if (tok_is(p, '[')) {                    // B2m：p->arr[i] = expr（指针字段直接下标写）
        int fst2 = st_fty(p, f);
        int fcd3 = fld_code(p, sid, f);
        int fbn2 = new_node(a, 32, slot, 0);
        int fad2 = 0;
        if (st_is_arr(p, f) != 0) {            // 2026-09-20：定长数组字段
          fad2 = fld_arr_addr_ptr(p, a, slot * 1000, fcd3 * 100 + fst2);
        } else {
          if (fst2 == 0 || fst2 == 4) return -13;
          int *vvb2 = a->val;
          vvb2[fbn2] = fcd3;
          set_ty(a, fbn2, fld_ty(fst2));
          fad2 = field_sub_addr(p, a, fbn2, fst2);
        }
        if (fad2 < 0) return fad2;
        if (!tok_is(p, '=')) return -54;
        p->i = p->i + 1;
        int fe2 = parse_expr(p, a);
        if (fe2 < 0) return -55;
        int fw2 = new_node(a, 54, fad2, fe2);
        if (!tok_is(p, ';')) return -57;
        p->i = p->i + 1;
        return fw2;
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int idx = new_node(a, 33, slot, e);
      int *vv = a->val;
      int ftyd3 = st_fty(p, f);
      if (ftyd3 >= 1 && ftyd3 != 4 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }   // v1.4.31：指针字段值门槛
      vv[idx] = fld_code(p, sid, f);
      if (ftyd3 == 4) { kd[idx] = 58; }                              // B2k：char 标量字段（1 字节写）
      else if (ftyd3 >= 1) { set_ty(a, idx, fld_ty(ftyd3)); }
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (tok_is(p, '[')) {                      // B2e：下标赋值
      if (ty == 0 || ty == 3) return -74;      // 标量/struct 不能下标
      p->i = p->i + 1;
      int ix = parse_expr(p, a);
      if (ix < 0) return -59;
      if (!tok_is(p, ']')) return -66;
      p->i = p->i + 1;
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int nk = 24;                             // 本地 int 数组
      if (ty == 4) { nk = 40; }                // 本地 char 数组（字节，升序基址）
      else if (ty == 2) {
        if (spec_aux(spec) == 1) { nk = 38; }  // char* 字节
        else { nk = 29; }                      // int*/struct* 8 字节
      }
      int lslot = slot;
      if (ty == 4) { lslot = slot + spec_n(spec) - 1; }       // char 数组（升序基址）
      if (ty == 1) { lslot = slot + spec_n(spec) - 1; }       // B2i：int 数组也升序（与指针语义一致）
      int idx = new_node(a, nk, lslot, ix);
      int *vv = a->val;
      vv[idx] = e;
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (ty == 5) {                             // B2g char 标量写（字节）
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int ce = parse_expr(p, a);
      if (ce < 0) return -55;
      int cidx = new_node(a, 43, slot, ce);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return cidx;
    }
    if (ty == 2) {                             // B2f：指针变量赋值（64 位）
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      if (rhs_addr_like(p, a, e, 1) == 0) { return -198; }     // v1.4.31：指针目标值门槛
      int idx = new_node(a, 35, slot, e);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (ty != 0) return -64;                   // 数组名/struct 整体赋值不支持
    if (!tok_is(p, '=')) return -54;
    p->i = p->i + 1;
    int e2 = parse_expr(p, a);
    if (e2 < 0) return -55;
    if (rhs_addr_like(p, a, e2, 0) != 0) { set_addr_mark(p, slot); }   // v1.4.31：int ← 地址值 → 标记
    int idx2 = new_node(a, 7, slot, e2);
    if (!tok_is(p, ';')) return -57;
    p->i = p->i + 1;
    return idx2;
  }
}

// —— B2f：多函数程序（struct 声明区 + 函数区）——
int parse_program(struct Parse *p, struct Ast *a) {
  int *sf = p->sflat;
  int *af = p->aflat;
  // ⚠️ 字段数组必须先局部化再下标：`*(p->ks + i)` 是**字节**偏移（裸指针 ± 字节步进），
  //    元素下标要靠 `局部变量[i]` 的 8 字节缩放（B2k 实测：写成解引用会静默读错位置）
  int *ksp = p->ks;
  sf[0] = 0;
  sf[1] = 514;            // 2026-09-20：表头区 2..513（**128** struct × 4），字段区 514 起
                          //   （原为 130 = 32 struct；随 st_add 上限 32→128 同步挪，见 st_add 注释）
  af[0] = 0;              // B2h：api/dll 表初始化（parse_apis 可多次调用）
  af[1] = 0;
  p->nfuncs = 0;
  p->i = 0;
  p->nglobals = 0;        // 2026-09-21（卡 T-20260921-194703）：全局变量表 + `.data` 游标复位（一次编译一份）
  p->gcur = 0;
  p->data_size = 0;
  p->loopdepth = 0;       // 2026-09-21：循环嵌套深度复位（break/continue 合法性判据）
  // —— B2h 顶层扫描：头部 struct/api 任意交替（api 必须在任何函数之前，导入表按序建），
  //    之后 struct 与函数定义可交错——真实库/自举源都是这个形状（b1_parse.fl 就有函数后的 struct）——
  int guard = 0;
  int phase1 = 1;                              // FLINT 无 break → 用标志位退出
  while (phase1 == 1 && p->i < p->n && ksp[p->i] != 0) {
    if (guard >= 4096) return -66;             // 顶层声明项数上限（B2h）
    guard = guard + 1;
    if (tok_ident_eq(p, "struct")) {
      int se = parse_structs(p);
      if (se < 0) return se;
    } else if (tok_ident_eq(p, "api")) {
      int ae = parse_apis(p);
      if (ae < 0) return ae;
    } else {
      phase1 = 0;                              // 进入函数区
    }
  }
  guard = 0;
  while (p->i < p->n && ksp[p->i] != 0) {
    if (guard >= 4096) return -66;
    guard = guard + 1;
    if (tok_ident_eq(p, "struct")) {
      int se2 = parse_structs(p);
      if (se2 < 0) return se2;
    } else if (tok_ident_eq(p, "api")) {
      int ae2 = parse_apis(p);                 // B2i：api 声明可出现在顶层任意位置
      if (ae2 < 0) return ae2;
    } else {
      // 2026-09-21（卡 T-20260921-194703）：**函数定义 vs 顶层全局变量声明** 在这里分派 ——
      //   判据与 collect_funcs 的停止条件同一个（`is_func_start_at`），两处必须同步改。
      if (is_func_start_at(p, p->i) != 0) {
        int fe = collect_funcs(p, p->i);
        if (fe < 0) return fe;
      } else {
        int ge = parse_globals(p);
        if (ge < 0) return ge;
      }
    }
  }
  if (p->nfuncs == 0) return -60;
  int *fp = p->fpos;
  int *fl = p->flen;
  char *s = p->src;
  p->main_idx = -1;
  int k = 0;
  while (k < p->nfuncs) {
    if (fl[k] == 4) {
      if (s[fp[k]] == 'm' && s[fp[k] + 1] == 'a' && s[fp[k] + 2] == 'i' && s[fp[k] + 3] == 'n') {
        if (p->main_idx < 0) p->main_idx = k;
      }
    }
    k = k + 1;
  }
  if (p->main_idx < 0) return -61;

  int *fvc = p->fvar_cnt;
  int *fbd = p->fbody;
  int *fna = p->fnargs;
  int *fpty = p->fpty;
  int real_main = p->main_idx;               // B2l：main_idx 在下面被借作「当前函数下标」，循环后必须还原
  int fi = 0;
  while (fi < p->nfuncs) {
    if (fn_api(fpty[fi]) == 1) {              // B2g：api 声明无函数体，跳过
      fvc[fi] = 0;
      fbd[fi] = 0;
      fi = fi + 1;
    } else {
    p->i = fbd[fi];                           // B2h：跳到该函数起点 token（collect_funcs 记的）
    p->vbase = p->nvars;
    p->sbase = p->nslots;                     // B2e：函数槽基址（相对槽 = vslots - sbase）
    p->maxslots = p->nslots;                  // B2g：槽数峰值
    p->main_idx = fi;                         // ⚠️ B2l：解析期暂存「当前函数下标」（托管变量编码用；函数全部解析完会重算真正的 main_idx）
    p->pn0 = a->cnt;                          // 第四刀：本函数节点区间起点（含形参节点）
    int sb = p->sbase;
    int *ks = p->ks;
    int ret = parse_rettype(p);               // B3b：int / int* / char* / struct X*；2026-09-20 + void
    if (ret < 0) return ret;
    p->ret_void = 0;
    if (ret == 5) { p->ret_void = 1; }        // 2026-09-20：void → return 语句走另一支语义
    if (p->i >= p->n || ks[p->i] != 1) return -63;
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -64;
    p->i = p->i + 1;
    int pr = parse_params(p, a, fna[fi]);
    if (pr < 0) return pr;
    // v1.4.26：打包项只保留**前 4 个形参**的指针位（`pr % 16`）—— 全掩码在形参多于 7 个时会进位、
    //   污染 retptr/api/dll 三个十进制位（7 个形参 ⇒ pr 到 128 ⇒ fn_retptr 读成"返回类型 +1"）。
    //   第 5 个起一律落栈且装载走 64 位（不需要掩码位，见 b1_emit 形参装载）。
    // v1.4.27（卡 T-20261012-210751）：低两位再加一个 **"形参已知"标志位（`+ 16`）** —— 调用点的
    //   双向实参核对（见 parse_primary）靠它区分「这个函数的形参表已经解析到」。
    //   为什么需要它：`collect_funcs` 只登记名字/个数/返回类型，掩码要等**定义**解析到才落表
    //   ⇒ 前向调用（调用点在定义之前）时掩码还是 0，若照 0 判就会把 `g(&x)`（g 的形参是 int*、
    //   定义在下方）**误报**成"地址装进 int 形参"。标志位把"未知"与"确实没有指针形参"分开。
    //   ⚠️ 掩码字段仍是 16..31（< 100）⇒ fn_retptr / fn_api / fn_dll 三个十进制位解析全不受影响；
    //   低两位的唯一消费者 `fn_mask()` 只读 bit0..3（b1_emit 形参装载 `(pm >> j) & 1`，j < 4）
    //   ⇒ 标志位（bit4）不会被发射端看见。
    fpty[fi] = ret * 100 + pr % 16 + 16;      // B2e/B3b：返回类型 + 前 4 个形参指针位 + 形参已知位
    if (!tok_is(p, '{')) return -65;
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 0);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    fbd[fi] = new_node(a, 19, base, cnt);     // 函数体块节点
    fvc[fi] = p->maxslots - sb;               // B2g：帧 = 槽数峰值（块作用域可复用槽）
    // 第四刀（卡 T-20260921-232138）：提升计划 —— 位置在这一步**定死**（发任何字节之前）
    p->pnend = fbd[fi];                       // 节点区间终点 = 函数体块节点（最后建的那个）
    plan_regs(p, a, fi, fna[fi]);
    p->nslots = p->sbase;                     // B2l：函数槽回收 → 各函数相对槽从 0 起（托管变量清理按相对槽发码）
    fi = fi + 1;
    }
  }
  p->main_idx = real_main;                   // B2l：还原真正的 main 下标（借位结束）
  return p->nfuncs;
}
