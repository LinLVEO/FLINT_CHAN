      if (st_fty(p, f) == 5) {
        if (tok_is(p, '=')) { return -64; }
        int b5 = new_node(a, 25, 0, 0);
        int *vvb5 = a->val;
        vvb5[b5] = slot + st_nslots(p, sid) - 1;
        set_ty(a, b5, 1);
        int adb5 = sarr_fld_addr(a, b5, st_fld(p, f, 3), 3);    // b 的字段地址 = struct 基址 + off_b
        return chain_assign_tail(p, a, adb5, st_fsid(p, f), 1); // 对象地址起点 ⇒ 下一跳是 '.'
      }
      if (tok_is(p, '[')) {                    // B2m：s.arr[i] = expr（指针字段直接下标写）
        int fst = st_fty(p, f);
        int fcd1 = fld_code(p, sid, f);
        int fbn = new_node(a, 30, slot + st_nslots(p, sid) - 1, 0);
        int fad = 0;
        if (fld_arr_kind(p, f) != 0) {         // 2026-09-20：定长数组字段 `int buf[4]`
          fad = fld_arr_addr_loc(p, a, slot * 1000 + st_nslots(p, sid), fcd1 * 100 + fst);
        } else {
          if (fst == 0 || fst == 4) return -13;  // int/char 字段不能下标
          int *vvb = a->val;
          vvb[fbn] = fcd1;
          set_ty(a, fbn, fld_ty(fst));
          fad = field_sub_addr(p, a, fbn, fst);
        }
        if (fad < 0) return fad;
        if (!tok_is(p, '=')) return -54;
        p->i = p->i + 1;
        int fe = parse_expr(p, a);
        if (fe < 0) return -55;
        int fw = new_node(a, 54, fad, fe);
        if (!tok_is(p, ';')) return -57;
        p->i = p->i + 1;
        return fw;
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int idx = new_node(a, 31, slot + st_nslots(p, sid) - 1, e);   // 2026-09-22：预留槽数
      int *vv = a->val;
      int ftyd2 = st_fty(p, f);
      if (ftyd2 >= 1 && ftyd2 != 4 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }   // v1.4.31：指针字段值门槛
      vv[idx] = fld_code(p, sid, f);
      if (ftyd2 == 4) { kd[idx] = 56; }                              // B2k：char 标量字段（1 字节写）
      else if (ftyd2 >= 1) { set_ty(a, idx, fld_ty(ftyd2)); }
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (ty == 6 && tok_is(p, '[')) {           // v2.1.0（缺口 -240 收口）：a[i].f = e ／ a[i].buf[j] = e
      // 与真 flint 同形（src\parse.c postfix 的 v2.1.0 块）：元素地址 = 基址 + i×步长，
      //   字段写 = 元素地址 + 字段偏移 → 解引用写（kind 54，宽度随地址节点 ty）。
      //   ⚠️ 为什么必须在这条**语句级**显式分支里做，而不能只靠表达式路径：
      //     语句赋值只认「变量名 + 固定后缀形态」逐条展开（本函数里 `->` / `[` / ty==5 / ty==2 那一串），
      //      探针路（本函数开头「parse_primary + lv_addr_from + lv_compound」那一支）只接**复合赋值/++/--**，`=` 不接 ⇒ 不写这一支就落到下标赋值
      //      老路（ty 不是 0/3 ⇒ 被当本地 int 数组）⇒ 静默按 4 字节宽写 struct 元素（错）。
      p->i = p->i + 1;
      int ix6 = parse_expr(p, a);
      if (ix6 < 0) return -59;
      if (!tok_is(p, ']')) return -66;
      p->i = p->i + 1;
      int sid6 = spec_sid(spec);
      int el6 = sarr_elem_addr(a, slot + spec_n(spec) - 1, ix6, st_nslots(p, sid6) * 8);
      if (!tok_is(p, '.')) { return -154; }    // a[i] = ...：struct 没有整体值语义（同真 flint）
      p->i = p->i + 1;
      if (p->i >= p->n || ks[p->i] != 1) return -151;
      int f6 = st_find_field(p, sid6, ps[p->i], ls[p->i]);
      if (f6 < 0) return -152;
      p->i = p->i + 1;
      int off6 = st_fld(p, f6, 3);
      int fty6 = st_fty(p, f6);
      int fad6 = 0;
      // v2.4.0：`a[i].b.c = e`（元素里再嵌一层 struct 值字段）—— 交给链式写
      if (fty6 == 5) {
        if (tok_is(p, '=')) { return -64; }
        int ad6 = sarr_fld_addr(a, el6, st_fld(p, f6, 3), 3);
        return chain_assign_tail(p, a, ad6, st_fsid(p, f6), 1);
      }
      if (tok_is(p, '[')) {                    // 元素内定长数组字段（g[0].buf[j]）
        if (fld_arr_kind(p, f6) == 0) return -13;
        fad6 = field_arr_addr(p, a, sarr_fld_addr(a, el6, off6, 1), fty6);
        if (fad6 < 0) return fad6;
      } else {
        if (fld_arr_kind(p, f6) != 0) return -64;    // 数组字段名整体赋值不支持
        fad6 = sarr_fld_addr(a, el6, off6, fld_addr_ty(fty6));
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int fe6 = parse_expr(p, a);
      if (fe6 < 0) return -55;
      if (fty6 >= 1 && fty6 != 4 && rhs_addr_like(p, a, fe6, 1) == 0) { return -198; }   // 指针字段值门槛（与本地 struct 字段写那一支同源，见上面 4266）
      int fw6 = new_node(a, 54, fad6, fe6);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return fw6;
    }
    if (ty == 2 && spec_aux(spec) == 2 && tok_is(p, '[')) {   // v2.2：p[i].f = e ／ p[i].buf[j] = e
      // 与上面 ty==6 那一支同形，只有基址来源不同（sptr_elem_addr 用指针的**值**当基址）。
      p->i = p->i + 1;
      int ixp = parse_expr(p, a);
      if (ixp < 0) return -59;
      if (!tok_is(p, ']')) return -66;
      p->i = p->i + 1;
      int sidp = spec_sid(spec);
      int elp = sptr_elem_addr(a, slot, ixp, st_nslots(p, sidp) * 8);
      if (!tok_is(p, '.')) { return -154; }    // p[i] = ...：struct 没有整体值语义
      p->i = p->i + 1;
      if (p->i >= p->n || ks[p->i] != 1) return -151;
      int fp = st_find_field(p, sidp, ps[p->i], ls[p->i]);
      if (fp < 0) return -152;
      p->i = p->i + 1;
      int offp = st_fld(p, fp, 3);
      int ftyp = st_fty(p, fp);
      int fadp = 0;
      // v2.4.0：`p[i].b.c = e` —— 与上面 ty==6 那一支同源
      if (ftyp == 5) {
        if (tok_is(p, '=')) { return -64; }
        int adp = sarr_fld_addr(a, elp, st_fld(p, fp, 3), 3);
        return chain_assign_tail(p, a, adp, st_fsid(p, fp), 1);
      }
      if (tok_is(p, '[')) {                    // 元素内定长数组字段（p[i].buf[j]）
        if (fld_arr_kind(p, fp) == 0) return -13;
        fadp = field_arr_addr(p, a, sarr_fld_addr(a, elp, offp, 1), ftyp);
        if (fadp < 0) return fadp;
      } else {
        if (fld_arr_kind(p, fp) != 0) return -64;
        fadp = sarr_fld_addr(a, elp, offp, fld_addr_ty(ftyp));
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int fep = parse_expr(p, a);
      if (fep < 0) return -55;
      if (ftyp >= 1 && ftyp != 4 && rhs_addr_like(p, a, fep, 1) == 0) { return -198; }
      int fwp = new_node(a, 54, fadp, fep);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return fwp;
    }
    if (tok2_is(p, '-', '>')) {                // B2f：指针 -> 字段写
      if (ty != 2 || spec_aux(spec) != 2) return -153;
      int sid = spec_sid(spec);
      p->i = p->i + 2;
      if (p->i >= p->n || ks[p->i] != 1) return -151;
      int f = st_find_field(p, sid, ps[p->i], ls[p->i]);
      if (f < 0) return -152;
      p->i = p->i + 1;
      // v2.4.0：`p->b.c = e`（b 是嵌套 struct 值字段）—— 基址 = 指针变量的值（kind 26，ty=3）
      if (st_fty(p, f) == 5) {
        if (tok_is(p, '=')) { return -64; }    // struct 没有整体值语义
        int pb5 = new_node(a, 26, 0, 0);
        int *vvp5 = a->val;
        vvp5[pb5] = slot;
        set_ty(a, pb5, 3);
        int adp5 = sarr_fld_addr(a, pb5, st_fld(p, f, 3), 3);
        return chain_assign_tail(p, a, adp5, st_fsid(p, f), 1);
      }
      if (st_fty(p, f) == 3 && !tok_is(p, '=')) {    // v2.3：链上继续 -> / [i] 之后再赋值
        // `w->next->v = 7` / `w->next[0].v = 7`：先把指针字段读出来当基址，再沿链取地址，
        //   最后照普通字段写的口径落 kind 54（宽度由地址节点的 ty 决定，与 s.f = e 同一条路）。
        int *vvp = a->val;
        int pb = new_node(a, 26, 0, 0);
        vvp[pb] = slot;
        set_ty(a, pb, 3);
        int rdw = new_node(a, 53, sarr_fld_addr(a, pb, st_fld(p, f, 3), 3), 0);
        set_ty(a, rdw, 3);
        return chain_assign_tail(p, a, rdw, st_fsid(p, f), 0);
      }
      if (tok_is(p, '[')) {                    // B2m：p->arr[i] = expr（指针字段直接下标写）
        int fst2 = st_fty(p, f);
        int fcd3 = fld_code(p, sid, f);
        int fbn2 = new_node(a, 32, slot, 0);
        int fad2 = 0;
        if (st_is_arr(p, f) != 0) {            // 2026-09-20：定长数组字段
          fad2 = fld_arr_addr_ptr(p, a, slot * 1000, fcd3 * 100 + fst2);
        } else {
          if (fst2 == 0 || fst2 == 4) return -13;
          int *vvb2 = a->val;
          vvb2[fbn2] = fcd3;
          set_ty(a, fbn2, fld_ty(fst2));
          fad2 = field_sub_addr(p, a, fbn2, fst2);
        }
        if (fad2 < 0) return fad2;
        if (!tok_is(p, '=')) return -54;
        p->i = p->i + 1;
        int fe2 = parse_expr(p, a);
        if (fe2 < 0) return -55;
        int fw2 = new_node(a, 54, fad2, fe2);
        if (!tok_is(p, ';')) return -57;
        p->i = p->i + 1;
        return fw2;
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int idx = new_node(a, 33, slot, e);
      int *vv = a->val;
      int ftyd3 = st_fty(p, f);
      if (ftyd3 >= 1 && ftyd3 != 4 && rhs_addr_like(p, a, e, 1) == 0) { return -198; }   // v1.4.31：指针字段值门槛
      vv[idx] = fld_code(p, sid, f);
      if (ftyd3 == 4) { kd[idx] = 58; }                              // B2k：char 标量字段（1 字节写）
      else if (ftyd3 >= 1) { set_ty(a, idx, fld_ty(ftyd3)); }
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (tok_is(p, '[')) {                      // B2e：下标赋值
      if (ty == 0 || ty == 3 || ty == 6) return -74;      // 标量/struct/struct 数组不能走本支（6 已被上面接住；防御）
      p->i = p->i + 1;
      int ix = parse_expr(p, a);
      if (ix < 0) return -59;
      if (!tok_is(p, ']')) return -66;
      p->i = p->i + 1;
      // v2.2.0：二维 int 数组 `m[i][j] = e` —— 与读路径同一条折叠（i*cols + j），复用 kind 24
      if (ty == 8) {
        if (!tok_is(p, '[')) return -277;
        p->i = p->i + 1;
        int ix2 = parse_expr(p, a);
        if (ix2 < 0) return -59;
        if (!tok_is(p, ']')) return -66;
        p->i = p->i + 1;
        int cols7 = spec / 1000000 - 800;
        int cn7 = new_node(a, 0, 0, 0);
        int *vvn7 = a->val;
        vvn7[cn7] = cols7;
        int ml7 = new_node(a, 3, ix, cn7);
        ix = new_node(a, 1, ml7, ix2);
      }
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      int nk = 24;                             // 本地 int 数组
      if (ty == 4) { nk = 40; }                // 本地 char 数组（字节，升序基址）
      else if (ty == 2) {
        if (spec_aux(spec) == 1) { nk = 38; }  // char* 字节
        else { nk = 29; }                      // int*/struct* 8 字节
      }
      int lslot = slot;
      if (ty == 4) { lslot = slot + spec_n(spec) - 1; }       // char 数组（升序基址）
      if (ty == 1 || ty == 8) { lslot = slot + spec_n(spec) - 1; }  // B2i：int 数组也升序（与指针语义一致）
      int idx = new_node(a, nk, lslot, ix);
      int *vv = a->val;
      vv[idx] = e;
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (ty == 5) {                             // B2g char 标量写（字节）
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int ce = parse_expr(p, a);
      if (ce < 0) return -55;
      int cidx = new_node(a, 43, slot, ce);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return cidx;
    }
    if (ty == 2) {                             // B2f：指针变量赋值（64 位）
      if (!tok_is(p, '=')) return -54;
      p->i = p->i + 1;
      int e = parse_expr(p, a);
      if (e < 0) return -55;
      if (rhs_addr_like(p, a, e, 1) == 0) { return -198; }     // v1.4.31：指针目标值门槛
      int idx = new_node(a, 35, slot, e);
      if (!tok_is(p, ';')) return -57;
      p->i = p->i + 1;
      return idx;
    }
    if (ty != 0) return -64;                   // 数组名/struct 整体赋值不支持
    if (!tok_is(p, '=')) return -54;
    p->i = p->i + 1;
    int e2 = parse_expr(p, a);
    if (e2 < 0) return -55;
    if (rhs_addr_like(p, a, e2, 0) != 0) { set_addr_mark(p, slot); }   // v1.4.31：int ← 地址值 → 标记
    int idx2 = new_node(a, 7, slot, e2);
    t1_mark_store(p, idx2, slot);                      // 2026-10-18（task 2b / rev4）：T1 装地址的 int → 8 字节写
    if (!tok_is(p, ';')) return -57;
    p->i = p->i + 1;
    return idx2;
  }
}

// —— v2.1.0：**flint 的 is_keyword 逐字镜像**（src\parse.c:148 那张清单，一个不多一个不少）——
//   为什么要单列一张：boot 平时不靠"关键字表"挡名字，而是靠"用到那处才报码"；可枚举常量名可以
//   **一直不出现**在表达式里 ⇒ 不在这里挡就成「真 flint 拒、boot 收」的静默分岔。
//   ⚠️ 清单里**没有** struct / api / main —— 与真 flint 一致（它们是上下文识别，不是关键字）。
int tok_is_kw_at(struct Parse *p, int i) {
  if (tok_ident_at(p, i, "int") != 0) { return 1; }
  if (tok_ident_at(p, i, "char") != 0) { return 1; }
  if (tok_ident_at(p, i, "void") != 0) { return 1; }
  if (tok_ident_at(p, i, "return") != 0) { return 1; }
  if (tok_ident_at(p, i, "if") != 0) { return 1; }
  if (tok_ident_at(p, i, "else") != 0) { return 1; }
  if (tok_ident_at(p, i, "while") != 0) { return 1; }
  if (tok_ident_at(p, i, "for") != 0) { return 1; }
  if (tok_ident_at(p, i, "new") != 0) { return 1; }
  if (tok_ident_at(p, i, "own") != 0) { return 1; }
  if (tok_ident_at(p, i, "share") != 0) { return 1; }
  if (tok_ident_at(p, i, "ptr") != 0) { return 1; }
  if (tok_ident_at(p, i, "double") != 0) { return 1; }
  if (tok_ident_at(p, i, "int_64") != 0) { return 1; }
  if (tok_ident_at(p, i, "uint_8") != 0) { return 1; }
  if (tok_ident_at(p, i, "uint_32") != 0) { return 1; }
  if (tok_ident_at(p, i, "uint_64") != 0) { return 1; }
  if (tok_ident_at(p, i, "switch") != 0) { return 1; }
  if (tok_ident_at(p, i, "case") != 0) { return 1; }
  if (tok_ident_at(p, i, "default") != 0) { return 1; }
  return 0;
}

// —— v2.1.0（2026-11-01）：enum 具名整数常量定义 ——
//   口径与 src\parse.c 的 parse_enumdef **逐条同形**（同一份语言语义，改一端必须改另一端）：
//     · 首项 = 0，后续 = 上一项 + 1；
//     · 显式赋值只认「整数字面量 / 已登记的枚举常量 / '-' + 上面两种」；
//     · 常量名与全局变量/函数/已有常量同名 = 编译期硬错（真 flint 报中文，boot 报专码）；
//     · 末尾分号可选；至少一个常量；名字不许是关键字（flint 的 is_keyword 清单）；
//     · 常量在解析期就折成整数字面量 ⇒ 发射侧零改动、产物与真 flint 逐字节相同。
//   ⚠️ 两个**反向守卫**（g_add / collect_funcs）是本条语义的另一半：真 flint 的全局表与函数表是
//     **预扫**的，所以 `enum X { A }; int A;` 在解析 enum 时就能看见后面的全局变量；boot 按源码序
//     登记 ⇒ 必须在"后登记的那一端"再挡一次，否则只差顺序就成了「真 flint 拒、boot 静默收」。
//   错误码（紧接 -240..-266 之后的空位；boot 的码是内部码，真 flint 侧文案见上）：
//     -267 枚举定义形态错（缺名字/项名非法/缺 '{' 或 '}'）
//     -268 枚举常量赋值只认整数字面量或已登记的枚举常量
//     -269 枚举常量与全局变量同名        -270 枚举常量与函数同名
//     -271 枚举常量重复声明              -272 枚举常量表满（enum_cap()）
//     -273 enum 里至少要有一个常量       -274 全局变量与枚举常量同名（g_add 反向守卫）
//     -275 函数与枚举常量同名（collect_funcs 反向守卫）
//     -276 函数体用了**写在它后面**的 enum 常量（真 flint 按源码序登记 ⇒ 未声明；见 parse_primary）
int parse_enumdef(struct Parse *p) {
  int *ks = p->ks;
  int *ps = p->ps;
  int *ls = p->ls;
  p->i = p->i + 1;                                     // 吃 'enum'
  if (p->i >= p->n || ks[p->i] != 1) { return -267; }  // enum 后需要名字
  if (tok_is_kw_at(p, p->i) != 0) { return -267; }
  p->i = p->i + 1;                                     // 吃枚举名（不入表：不做枚举类型/枚举变量）
  if (!tok_is(p, '{')) { return -267; }
  p->i = p->i + 1;
  int next = 0;
  int cnt = 0;
  int more = 1;                                        // FLINT 无 break 依赖 → 用标志位收尾
  while (more == 1 && !tok_is(p, '}')) {
    if (p->i >= p->n || ks[p->i] != 1) { return -267; }
    if (tok_is_kw_at(p, p->i) != 0) { return -267; }
    int ctok = p->i;                                   // 常量名 token 下标（入表；兼作声明先后判据）
    int cpos = ps[p->i];
    int clen = ls[p->i];
    p->i = p->i + 1;
    int val = next;
    if (tok_is(p, '=')) {
      p->i = p->i + 1;
      int neg = 0;
      if (tok_is(p, '-')) { neg = 1; p->i = p->i + 1; }
      if (tok_is_num(p)) {
        val = tok_num_val(p);
        p->i = p->i + 1;
      } else {
        if (p->i >= p->n || ks[p->i] != 1) { return -268; }
        int ei = enum_find(p, ps[p->i], ls[p->i]);
        if (ei < 0) { return -268; }
        val = enum_val(p, ei);
        p->i = p->i + 1;
      }
      if (neg == 1) { val = 0 - val; }
    }
    if (g_find(p, cpos, clen) >= 0) { return -269; }
    if (find_func_at(p, cpos, clen) >= 0) { return -270; }
    if (enum_find(p, cpos, clen) >= 0) { return -271; }
    int ad = enum_add(p, ctok, val);
    if (ad < 0) { return ad; }
    next = val + 1;
    cnt = cnt + 1;
    if (tok_is(p, ',')) { p->i = p->i + 1; } else { more = 0; }
  }
  if (!tok_is(p, '}')) { return -267; }
  p->i = p->i + 1;
  if (tok_is(p, ';')) { p->i = p->i + 1; }              // 末尾分号可选（`enum A { X };` 与 `enum A { X }` 都收）
  if (cnt == 0) { return -273; }
  return 0;
}

// —— B2f：多函数程序（struct 声明区 + 函数区）——
int parse_program(struct Parse *p, struct Ast *a) {
  int *sf = p->sflat;
  int *af = p->aflat;
  // ⚠️ 字段数组必须先局部化再下标：`*(p->ks + i)` 是**字节**偏移（裸指针 ± 字节步进），
  //    元素下标要靠 `局部变量[i]` 的 8 字节缩放（B2k 实测：写成解引用会静默读错位置）
  int *ksp = p->ks;
  // ===== v2.1.0（2026-11-01）：enum 常量表的**表体**（本函数的局部数组）=====
  //   为什么放这里：FLINT 的全局不能是 struct/指针、struct 里也不能嵌数组 ⇒ 表体没有别的落脚点。
  //   放在 parse_program 的帧里 ⟺ 生命周期正好等于"一次编译"（parse_enumdef 与 parse_primary
  //   都在它返回之前跑完）；p->etok/eval 只是把这两根指针带进 Parse。
  //   ⚠️ 数组长度必须 == enum_cap()（512）：数组长度在 FLINT 里只能写字面量 ⇒ 这两处是**同一个数**，
  //      改一处必须改另一处（本仓「容量单点」纪律的唯一例外，代价是这一行注释）。
  int etok[512];
  int eval[512];
  p->etok = &etok;
  p->eval = &eval;
  p->necons = 0;
  sf[0] = 0;
  sf[1] = 514;            // 2026-09-20：表头区 2..513（**128** struct × 4），字段区 514 起
                          //   （原为 130 = 32 struct；随 st_add 上限 32→128 同步挪，见 st_add 注释）
  af[0] = 0;              // B2h：api/dll 表初始化（parse_apis 可多次调用）
  af[1] = 0;
  p->nfuncs = 0;
  p->i = 0;
  p->nglobals = 0;        // 2026-09-21（卡 T-20260921-194703）：全局变量表 + `.data` 游标复位（一次编译一份）
  p->gcur = 0;
  p->data_size = 0;
  p->loopdepth = 0;       // 2026-09-21：循环嵌套深度复位（break/continue 合法性判据）
  // —— B2h 顶层扫描：头部 struct/api 任意交替（api 必须在任何函数之前，导入表按序建），
  //    之后 struct 与函数定义可交错——真实库/自举源都是这个形状（b1_parse.fl 就有函数后的 struct）——
  int guard = 0;
  int phase1 = 1;                              // FLINT 无 break → 用标志位退出
  while (phase1 == 1 && p->i < p->n && ksp[p->i] != 0) {
    if (guard >= 4096) return -66;             // 顶层声明项数上限（B2h）
    guard = guard + 1;
    if (tok_ident_eq(p, "struct")) {
      int se = parse_structs(p);
      if (se < 0) return se;
    } else if (tok_ident_eq(p, "enum")) {
      // v2.1.0（2026-11-01）：enum 与 struct 同级（真 flint 的顶层循环里也是并列分支）；
      //   常量登记进表后**吃掉整段 enum**，不产 AST、不产码。
      int ee = parse_enumdef(p);
      if (ee < 0) return ee;
    } else if (tok_ident_eq(p, "api")) {
      int ae = parse_apis(p);
      if (ae < 0) return ae;
    } else {
      phase1 = 0;                              // 进入函数区
    }
  }
  guard = 0;
  while (p->i < p->n && ksp[p->i] != 0) {
    if (guard >= 4096) return -66;
    guard = guard + 1;
    if (tok_ident_eq(p, "struct")) {
      int se2 = parse_structs(p);
      if (se2 < 0) return se2;
    } else if (tok_ident_eq(p, "enum")) {
      // v2.1.0：enum 可出现在函数之后的顶层任意位置（真 flint 同：它的第二遍循环也是并列分支）
      int ee2 = parse_enumdef(p);
      if (ee2 < 0) return ee2;
    } else if (tok_ident_eq(p, "api")) {
      int ae2 = parse_apis(p);                 // B2i：api 声明可出现在顶层任意位置
      if (ae2 < 0) return ae2;
    } else {
      // 2026-09-21（卡 T-20260921-194703）：**函数定义 vs 顶层全局变量声明** 在这里分派 ——
      //   判据与 collect_funcs 的停止条件同一个（`is_func_start_at`），两处必须同步改。
      if (is_func_start_at(p, p->i) != 0) {
        int fe = collect_funcs(p, p->i);
        if (fe < 0) return fe;
      } else {
        int ge = parse_globals(p);
        if (ge < 0) return ge;
      }
    }
  }
  if (p->nfuncs == 0) return -60;
  int *fp = p->fpos;
  int *fl = p->flen;
  char *s = p->src;
  p->main_idx = -1;
  int k = 0;
  while (k < p->nfuncs) {
    if (fl[k] == 4) {
      if (s[fp[k]] == 'm' && s[fp[k] + 1] == 'a' && s[fp[k] + 2] == 'i' && s[fp[k] + 3] == 'n') {
        if (p->main_idx < 0) p->main_idx = k;
      }
    }
    k = k + 1;
  }
  if (p->main_idx < 0) return -61;

  int *fvc = p->fvar_cnt;
  int *fbd = p->fbody;
  int *fna = p->fnargs;
  int *fpty = p->fpty;
  int real_main = p->main_idx;               // B2l：main_idx 在下面被借作「当前函数下标」，循环后必须还原
  int fi = 0;
  while (fi < p->nfuncs) {
    if (fn_api(fpty[fi]) == 1) {              // B2g：api 声明无函数体，跳过
      fvc[fi] = 0;
      fbd[fi] = 0;
      fi = fi + 1;
    } else {
    p->i = fbd[fi];                           // B2h：跳到该函数起点 token（collect_funcs 记的）
    p->vbase = p->nvars;
    p->sbase = p->nslots;                     // B2e：函数槽基址（相对槽 = vslots - sbase）
    p->maxslots = p->nslots;                  // B2g：槽数峰值
    p->main_idx = fi;                         // ⚠️ B2l：解析期暂存「当前函数下标」（托管变量编码用；函数全部解析完会重算真正的 main_idx）
    p->pn0 = a->cnt;                          // 第四刀：本函数节点区间起点（含形参节点）
    int sb = p->sbase;
    int *ks = p->ks;
    int ret = parse_rettype(p);               // B3b：int / int* / char* / struct X*；2026-09-20 + void
    if (ret < 0) return ret;
    p->ret_void = 0;
    if (ret == 5) { p->ret_void = 1; }        // 2026-09-20：void → return 语句走另一支语义
    p->ret_ptr = 0;                           // v1.5.0：ret == 2 = 指针返回（return str([...]) 的许可判据）
    if (ret == 2) { p->ret_ptr = 1; }
    if (p->i >= p->n || ks[p->i] != 1) return -63;
    p->i = p->i + 1;
    if (!tok_is(p, '(')) return -64;
    p->i = p->i + 1;
    int pr = parse_params(p, a, fna[fi]);
    if (pr < 0) return pr;
    // v1.4.26：打包项只保留**前 4 个形参**的指针位（`pr % 16`）—— 全掩码在形参多于 7 个时会进位、
    //   污染 retptr/api/dll 三个十进制位（7 个形参 ⇒ pr 到 128 ⇒ fn_retptr 读成"返回类型 +1"）。
    //   第 5 个起一律落栈且装载走 64 位（不需要掩码位，见 b1_emit 形参装载）。
    // v1.4.27（卡 T-20261012-210751）：低两位再加一个 **"形参已知"标志位（`+ 16`）** —— 调用点的
    //   双向实参核对（见 parse_primary）靠它区分「这个函数的形参表已经解析到」。
    //   为什么需要它：`collect_funcs` 只登记名字/个数/返回类型，掩码要等**定义**解析到才落表
    //   ⇒ 前向调用（调用点在定义之前）时掩码还是 0，若照 0 判就会把 `g(&x)`（g 的形参是 int*、
    //   定义在下方）**误报**成"地址装进 int 形参"。标志位把"未知"与"确实没有指针形参"分开。
    //   ⚠️ 掩码字段仍是 16..31（< 100）⇒ fn_retptr / fn_api / fn_dll 三个十进制位解析全不受影响；
    //   低两位的唯一消费者 `fn_mask()` 只读 bit0..3（b1_emit 形参装载 `(pm >> j) & 1`，j < 4）
    //   ⇒ 标志位（bit4）不会被发射端看见。
    fpty[fi] = ret * 100 + pr % 16 + 16;      // B2e/B3b：返回类型 + 前 4 个形参指针位 + 形参已知位
    if (!tok_is(p, '{')) return -65;
    p->i = p->i + 1;
    int cnt = parse_block(p, a, 0);
    if (cnt < 0) return cnt;
    int base = p->nblk - cnt;
    fbd[fi] = new_node(a, 19, base, cnt);     // 函数体块节点
    fvc[fi] = p->maxslots - sb;               // B2g：帧 = 槽数峰值（块作用域可复用槽）
    // 第四刀（卡 T-20260921-232138）：提升计划 —— 位置在这一步**定死**（发任何字节之前）
    p->pnend = fbd[fi];                       // 节点区间终点 = 函数体块节点（最后建的那个）
    plan_regs(p, a, fi, fna[fi]);
    p->nslots = p->sbase;                     // B2l：函数槽回收 → 各函数相对槽从 0 起（托管变量清理按相对槽发码）
    fi = fi + 1;
    }
  }
  p->main_idx = real_main;                   // B2l：还原真正的 main 下标（借位结束）
  return p->nfuncs;
}
