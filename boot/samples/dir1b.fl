// dir1b.fl — 2026-09-21（卡 T-20260921-215305 第一刀）：**二元运算右值直寻址档**（右值 = 立即数）
// 期望退出码 = 255：四条"右值立即数"（imul/and/xor/or 的累加器形态）+ 两条"左值立即数 + 右值变量"
// （add/sub 的 [rbp-off] 形态，方向敏感）+ 两条老路负对照（复合节点右值 ⇒ 必须逐字节走老路）。
int main() {
  int c = 50;
  int a = 100;
  int b = 7;
  int r = 0;
  if (c * 3 == 150) { r = r | 1; }          // imul eax, eax, imm32
  if ((c & 14) == 2) { r = r | 2; }         // and eax, imm32
  if ((c ^ 8) == 58) { r = r | 4; }         // xor eax, imm32
  if ((c | 3) == 51) { r = r | 8; }         // or eax, imm32
  if (3 + c == 53) { r = r | 16; }          // add eax, [rbp-off]（左值立即数）
  if (100 - c == 50) { r = r | 32; }        // sub eax, [rbp-off]（方向：lv - rv）
  if (a + (b * 2) == 114) { r = r | 64; }   // 老路负对照（右值是 imul 节点）
  if ((a * 2) + b == 207) { r = r | 128; }  // 新档（左值是 imul 节点、右值是变量）
  if (r == 255) { r = 42; }                 // 8 位全亮才 42（$diff 口径）；否则退出码 = 未亮的位掩码
  return r;
}
