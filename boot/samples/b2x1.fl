// b2x1.fl — B2x：include 免相对路径（本文件目录没有 num_lib.fl/fmt_lib.fl
//   → 回退到 <exe目录>..\lib\；与真 flint 同一套候选顺序）
include "num_lib.fl"
include "fmt_lib.fl"
int main() {
  char b[16];
  int p = std::itoa(42, b);
  if (p != 2) return 1;
  if (b[0] != '4') return 2;
  if (b[1] != '2') return 3;
  p = std::fmt_int(b, 0, 7);
  std::fmt_end(b, p);
  if (b[0] != '7') return 4;
  return 42;
}
