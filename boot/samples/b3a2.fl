// b3a2 — B3a 同名遮蔽（数组/指针）：兄弟块各自同名 + 遮蔽后类型仍正确
int main() {
  int r = 0;
  int v[2];
  v[0] = 5; v[1] = 6;
  {
    int v[2];                         // 同名数组遮蔽
    v[0] = 50; v[1] = 60;
    if (v[1] == 60) { r |= 1; }
  }
  if (v[1] == 6) { r |= 2; }          // 外层数组完好
  {
    int v[3];                         // 兄弟块同名（槽复用）
    v[2] = 9;
    if (v[2] == 9) { r |= 4; }
  }
  int *p = v;
  {
    int *p = v + 4;                   // 同名指针遮蔽（+4 = 字节步进 → 指向 v[1]）
    if (p[0] == 6) { r |= 8; }
  }
  if (p[0] == 5) { r |= 16; }         // 外层指针未变
  if (r != 31) return 1;
  return 42;
}
