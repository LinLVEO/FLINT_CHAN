// reg2.fl — 2026-09-21（卡 T-20260921-232138 第四刀 A1）哨兵（**负对照**）：
//   「取过地址 / ++ / 复合赋值 / 表达式位赋值」的局部量**不许进寄存器**，但值必须照样对。
// 期望 42（8 位全亮）。位定义：
//   位 1   `&x` 交给指针、经指针改写后再读 x —— 误提升就会读到寄存器里的陈旧值
//   位 2   `y++` / `++y`（节点 60，含后缀旧值语义）
//   位 4   `z += 4`（节点 60 复合赋值）
//   位 8   for 头的 `k = k + 1`（节点 66 表达式位赋值）+ 循环体里的普通 int 局部量（可提升）
//   位 16  `&w` 作实参传给函数（地址进实参表）
//   位 32  char 标量（不进候选）与指针局部量混在同一函数
//   位 64  struct 局部量字段读写（不进候选）—— 同函数里的 int 局部量仍要正确
//   位 128 本地数组元素读写（不进候选）+ int 局部量累加正确
struct RG2 { int lo; int hi; }

int rg2_put(int *p, int v) { *p = v; return 0; }
int rg2_take(int *p) { return *p; }

int main() {
  int r = 0;
  int x = 5;
  int *p = &x;
  *p = 7;
  if (x == 7) { r = r | 1; }
  int y = 10;
  y++;
  if (y == 11) { r = r | 2; }
  ++y;
  if (y == 12) { r = r | 2; }
  int z = 1;
  z += 4;
  if (z == 5) { r = r | 4; }
  int k = 0;
  int t = 0;
  for (k = 0; k < 3; k = k + 1) { t = t + 2; }
  if (t == 6) { r = r | 8; }
  int w = 0;
  rg2_put(&w, 9);
  if (rg2_take(&w) == 9) { r = r | 16; }
  char c = 65;
  if (c == 65) { r = r | 32; }
  struct RG2 st;
  st.lo = 3;
  st.hi = 4;
  if (st.lo + st.hi == 7) { r = r | 64; }
  int arr[3];
  arr[0] = 1; arr[1] = 2; arr[2] = 3;
  int u = 0;
  u = u + arr[0]; u = u + arr[1]; u = u + arr[2];
  if (u == 6) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
