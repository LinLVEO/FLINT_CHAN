// rev5b.fl — 差分：地址链解引用的**读写宽度**按指向类型定（char* 链 = 1 字节）
// 真 flint v1.0.13 修正前：`*(charPtr + n)` 按 int 读 4 字节 / 写 4 字节 → 本条会踩坏邻居字节（返回 1）
// boot 侧本来就是对的 → 本条同时钉「真 flint 与 boot 在此语义上不再双标」。期望两者同为 42。
int main() {
  int r = 0;
  char b[4];
  b[0] = 'X'; b[1] = 'Y'; b[2] = 'Z'; b[3] = 0;
  if (*(b + 1) == 'Y') r = r | 1;              // bit0 链上读 1 字节
  *(b + 1) = 'W';                              // 链上写 1 字节（修前写 4 字节 → b[2] 被清零）
  if (b[0] == 'X' && b[1] == 'W' && b[2] == 'Z') r = r | 2;   // bit1 邻居字节完好
  char *s = "AB";
  if (*(s + 1) == 'B') r = r | 4;              // bit2 数据段字符串链
  if (r != 7) return 1;
  return 42;
}
