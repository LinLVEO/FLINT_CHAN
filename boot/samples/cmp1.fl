// cmp1.fl -- 2026-09-22 (card T-20260921-232138, 4th knife A3-(1)): sentinel for the
//   "register-aware compare" tier: both sides are pool-register / frame-slot / immediate
//   => emit ONE cmp instead of the old path (mov/push/mov/pop/xchg/cmp = 5~6 instructions).
// Grid = form x target x PREMISE (premise pinned too -- A2's lesson: a cell whose premise
//   does not hold goes silently dead, the sentinel still reports "pass").
//   bit 1    REG  <- REG   : two locals, both fit in the pool (premise: small function)
//   bit 2    REG  <- SLOT  : 5 locals (premise: pool = 4 => the 5th stays in the frame)
//   bit 4    REG  <- IMM   : imm8 and NEGATIVE imm8 (the negative one is a unary-minus node
//                            wrapping a literal => `cmp rXd, imm8` with a sign-extended byte)
//   bit 8    SLOT <- REG   : same 5-local shape, operands swapped
//   bit 16   SLOT <- IMM   : cmp [rbp-off], imm8
//   bit 32   six operators x while/for, direction sensitive (each reversed direction loses the bit)
//   bit 64   address-class compare MUST take the old 64-bit path (pointer vs 0) and stay correct
//   bit 128  compare used as a VALUE (setcc path) must be untouched
// NOTE: bits 2/8/16 rest on "pool = 4". If the pool grows to 7 the 5th local moves into a
//   register => those cells silently change (values still right, form is not). Whoever widens
//   the pool must come back and re-list these cells (archived: `sentinel must pin its premise`).
// expected 42 (all 8 bits lit)

int c1_a() {                     // bit 1: REG <- REG
  int a = 0;
  int b = 4;
  while (a < b) { a = a + 3; b = b + 2; }
  return a * 100 + b;            // 12*100 + 12 = 1212
}
int c1_b() {                     // bit 2: REG <- SLOT (5 locals: a,b,c,d promoted, e not)
  int a = 1;
  int b = 3;
  int c = 0;
  int d = 0;
  int e = 5;
  while (b < e) { b = b + 1; c = c + 1; }   // 3<5 -> 2 rounds: b=5, c=2
  d = c + 1;
  return b * 10 + e + d;                     // 50+5+3 = 58
}
int c1_c() {                     // bit 8: SLOT <- REG (same shape, left operand is the frame slot)
  int a = 1;
  int b = 4;
  int c = 0;
  int d = 0;
  int e = 1;
  while (e < b) { e = e + 1; c = c + 1; }   // 1<4 -> 3 rounds: e=4, c=3
  d = c + 1;
  return e * 10 + b + d;                     // 40+4+4 = 48
}
int c1_d() {                     // bit 16: SLOT <- IMM
  int a = 1;
  int b = 2;
  int c = 0;
  int d = 0;
  int e = 96;
  while (e < 100) { e = e + 2; c = c + 1; }  // 96,98 -> e=100, c=2
  d = c + 1;
  return e + b + d;                          // 100+2+3 = 105
}
int c1_e() {                     // bit 4: REG <- IMM (imm8, then negative imm8)
  int a = 10;
  int b = 0;
  while (a > 2) { a = a - 3; b = b + 1; }   // 10,7,4 -> 3 rounds: a=1, b=3
  if (a > -5) { b = b + 100; }
  return b;                                  // 103
}
int c1_f(int n) {                // bit 32: six operators, direction sensitive (n = 4)
  int i = 0;
  int s = 0;
  while (i < n) { s = s + 1; i = i + 1; }    // <  -> s=4, i=4
  while (i > n) { s = s + 1000; i = i - 1; } // >  -> false
  while (i <= n) { s = s + 2; i = i + 1; }   // <= -> once: s=6, i=5
  while (i >= n) { s = s + 4; i = i - 2; }   // >= -> once: s=10, i=3
  for (i = 0; i < 2; i = i + 1) { s = s + 8; }  // for: s=26, i=2
  while (i != 0) { s = s + 16; i = i - 1; }  // != -> twice: s=58, i=0
  while (i == 0) { s = s + 32; i = 1; }      // == -> once: s=90, i=1
  return s;                                   // 90
}
int c1_g() {                     // bit 64: address-class compare must stay on the 64-bit old path
  int x = 5;
  int *p = &x;
  int r = 0;
  if (p == 0) { r = r + 1; }
  if (p != 0) { r = r + 2; }
  return r;                      // 2
}
int c1_h() {                     // bit 128: compare used as a value (setcc path, untouched)
  int a = 3;
  int b = 7;
  int t = 0;
  t = a < b;
  int u = 0;
  u = b > a;
  if (t == 1) { if (u == 1) { return 42; } }
  return 0;
}
int main() {
  int r = 0;
  if (c1_a() == 1212) { r = r | 1; }
  if (c1_b() == 58) { r = r | 2; }
  if (c1_e() == 103) { r = r | 4; }
  if (c1_c() == 48) { r = r | 8; }
  if (c1_d() == 105) { r = r | 16; }
  if (c1_f(4) == 90) { r = r | 32; }
  if (c1_g() == 2) { r = r | 64; }
  if (c1_h() == 42) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
