// fus2.fl — 2026-09-22（卡 T-20260921-232138 第四刀 A2）：**就地融合的负例与毒形态**哨兵
// 本样本的重点不是"融合生效"，而是**不该融合的一律退回老路、数值全对**。
// 期望 42（8 位全亮才 42）。位定义：
//   位 1   `x = x + x` —— **脊柱底读本槽**（安全：那时 rXd 还是原值）⇒ 应融合，结果 = 2x
//   位 2   `x = (x + y) + x` —— **外层读本槽**（rXd 已累积）⇒ **必须退老路**，期望 (x+y)+x
//   位 3   `x = (x + y) + (x + 1)` —— 外层右值是**含本槽的复杂表达式** ⇒ 必须退老路
//   位 4   目标是**形参**（形参不进候选）⇒ 老路，值必须对
//   位 5   目标是**数组元素**（`arr[i] = arr[i] + x`）⇒ 不进本档
//   位 6   指针算术 `p = p + 1`（地址类，64 位）⇒ 必须走老路：偏移 0 读到首元素、加过之后 p 不再等于首地址
//          （**不假设步长**：`int*` 的 ± 步长与本档无关，别把口径写进哨兵）
//   位 7   **三层左脊柱** `((m + a) & 7) ^ b` ⇒ 逐层就地
//   位 8   循环里的融合累加（多轮迭代，累积值必须对）
int fus2_param(int n, int m) { n = n + m; return n; }   // 两参 ⇒ 不走单实参内联档

int main() {
  int r = 0;

  int x = 3;
  int y = 5;
  x = x + x;                                  // 位 1：3 + 3 = 6
  if (x == 6) { r = r | 1; }

  x = (x + y) + x;                            // 位 2：(6 + 5) + 6 = 17
  if (x == 17) { r = r | 2; }

  x = (x + y) + (x + 1);                      // 位 3：(17 + 5) + (17 + 1) = 40
  if (x == 40) { r = r | 4; }

  if (fus2_param(39, 3) == 42) { r = r | 8; }  // 位 4

  int arr[2];
  arr[0] = 10;
  arr[1] = 20;
  int i = 0;
  arr[i] = arr[i] + x;                        // 位 5：10 + 40 = 50
  if (arr[0] == 50) { r = r | 16; }

  int buf[3];
  buf[0] = 11;
  buf[1] = 22;
  buf[2] = 44;
  int *p = buf;
  int ok6 = 0;
  if (*p == 11) { ok6 = ok6 + 1; }            // 位 6(a)：偏移 0 = 首元素
  p = p + 1;                                  // 位 6(b)：地址类语句 ⇒ 不进本档，但必须真的加
  if (p != buf) { ok6 = ok6 + 1; }
  if (ok6 == 2) { r = r | 32; }

  int m = 5;
  int a = 3;
  int b = 6;
  m = ((m + a) & 0x7) ^ b;                    // 位 7：((5+3)&7)^6 = 0^6 = 6
  if (m == 6) { r = r | 64; }

  int s = 0;
  int k = 0;
  while (k < 10) {                            // 位 8：0+1+…+9 = 45
    s = (s + k) & 0x3FFFFFFF;
    k = k + 1;
  }
  if (s == 45) { r = r | 128; }

  if (r == 255) { r = 42; }
  return r;
}
