// b2j1.fl — B2j 指针算术 p±n（64 位、字节单位，同 SPEC `a[i] = *(a+i*4)`）
//   + *q 解引用读/写：期望 42
int main() {
  int a[4];
  a[0] = 1;
  a[1] = 2;
  a[2] = 3;
  a[3] = 0;
  int *p = a;
  int *q = p + 12;          // 第 4 个元素（int 元素 4 字节槽）
  *q = 36;
  int *r = q - 4;           // 第 3 个元素
  *r = 3;
  return a[0] + a[1] + a[2] + a[3];
}
