// b2k4：*q 的地址单位 = 字节（B2k 固化决策 40）——裸指针 ± 是字节步进，只有下标 a[i] 按元素缩放
//   2026-10-17（int=4 字节 ABI）：int 元素 = 4 字节 ⇒ 元素 i 的字节偏移 = i*4
//   → 「字段数组」不能写 *(p + i) 当元素下标（须 *(p + i * 4) 或先局部化再下标）；
//     本样本把该语义钉死，防止将来把裸 ± 改成元素缩放
struct Buf { int *p; int n; }
int main() {
  int a[2];
  struct Buf b;
  b.p = a;
  b.n = 2;
  a[0] = 0;
  a[1] = 0;
  *(b.p + 0) = 42;                 // 字节 0 → a[0]
  *(b.p + 4) = 7;                  // 字节 4 → a[1]（int 元素步长 4 字节）
  int ok = 0;
  if (a[0] == 42) { ok += 1; }
  if (a[1] == 7) { ok += 1; }
  if (*(b.p + 4) == 7) { ok += 1; }
  // 字节 2..5 = a[0] 高 2 字节(0,0) + a[1] 低 2 字节(7,0) = 0x00070000 = 458752
  //   （按字节偏移读 ⇒ 跨元素拼出的定值；若按元素缩放会读到 a[2] = 越界垃圾）
  if (*(b.p + 2) == 458752) { ok += 1; }
  if (ok == 4) { return 42; }
  return ok;
}
