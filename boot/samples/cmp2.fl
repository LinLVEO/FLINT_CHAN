// cmp2.fl -- 2026-09-22 (card T-20260921-232138, 3rd knife: killing the real app's xchg, family 1 = compare)
//   sentinel for the ACCUMULATOR tier: left side = arbitrary expression (still evaluated into eax,
//   same order as the old path), right side = LEAF (immediate / frame slot / pool register)
//   => ONE `cmp eax,<rv>` instead of the old path (push rax / ... / pop rcx / xchg eax,ecx / cmp).
//   This tier also closes the VALUE path (cmp+setcc) onto the shared entry `gen_cmp_any`.
// Grid = form x target x PREMISE (premise pinned too -- A2's lesson: a cell whose premise does not
//   hold goes silently dead and the sentinel still reports "pass").
//   bit 1    rv = imm8 (positive), lv = non-leaf (array element)
//   bit 2    rv = NEGATIVE imm (unary minus wrapping a literal), cond path + value path
//   bit 4    rv = imm32 outside the imm8 band, both directions (positive and negative)
//   bit 8    rv = frame SLOT: 5th int local, address taken (premise: pool = 4 AND address-taken
//            locals are never promoted -- pinned twice on purpose)
//   bit 16   rv = POOL REGISTER (promoted local), lv = non-leaf => REX.B branch on the r/m side
//   bit 32   six operators, direction sensitive (each reversed direction would add 1000)
//   bit 64   VALUE path (setcc) -- the half that was not wired to the shared entry before
//   bit 128  negative controls: address-class compare (stays on the 64-bit old path), rv = non-leaf
//            (must fall back, evaluation order preserved), and a mem,mem compare (x86 has no such form)
// NOTE: bit 8 rests on "pool = 4". If the pool grows, re-list that cell (archived: sentinel premise).
// expected 42 (all 8 bits lit)

int c2_a() {                     // bit 1: rv = imm8, lv = arr[i] (non-leaf)
  int arr[4];
  int i = 0;
  int s = 0;
  arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
  while (arr[i] < 35) { s = s + 1; i = i + 1; }    // 10,20,30 pass, 40 stops => s=3, i=3
  return s * 10 + i;                               // 33
}
int c2_b() {                     // bit 2: rv = negative imm (unary minus + literal)
  int arr[3];
  int i = 0;
  int s = 0;
  arr[0] = -8; arr[1] = -3; arr[2] = 5;
  while (arr[i] > -5) { s = s + 1; i = i + 1; }    // -8 > -5 is false => 0 rounds
  s = s + (arr[1] < -1);                           // value path: -3 < -1 => +1
  s = s + (arr[0] < -4);                           // value path: -8 < -4 => +1
  if (arr[2] > -1) { s = s + 10; }                 // 5 > -1 => +10
  return s;                                        // 12
}
int c2_c() {                     // bit 4: rv = imm32 outside the imm8 band, both directions
  int arr[4];
  int i = 0;
  int s = 0;
  arr[0] = 100; arr[1] = 200; arr[2] = 300; arr[3] = 2000;
  while (arr[i] < 1000) { s = s + 1; i = i + 1; }  // 100,200,300 pass, 2000 stops => s=3, i=3
  if (arr[0] > 50) { s = s + 1000; }               // imm8 direction: 100 > 50
  if (arr[2] < 99999) { s = s + 10000; }           // imm32 positive: 300 < 99999
  if (arr[0] > -1000) { s = s + 100000; }          // imm32 negative: 100 > -1000
  return s;                                        // 111003
}
int c2_d() {                     // bit 8: rv = frame slot (never promoted), lv = non-leaf
  int arr[4];
  int i = 0;
  int s = 0;
  int lim = 25;
  int extra = 7;
  int *pe = &extra;
  arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
  *pe = 25;                                        // extra = 25 through the pointer
  while (arr[i] < lim) { s = s + 1; i = i + 1; }   // 10,20 pass, 30 stops => s=2, i=2
  if (arr[i] < extra) { s = s + 100; }             // 30 < 25 false (slot rv, reversed)
  if (arr[0] < extra) { s = s + 10; }              // 10 < 25 true => s=12
  return s;                                        // 12
}
int c2_e() {                     // bit 16: rv = pool register (promoted local), lv = non-leaf
  int arr[4];
  int lim = 35;
  int i = 0;
  int s = 0;
  arr[0] = 10; arr[1] = 20; arr[2] = 30; arr[3] = 40;
  while (arr[i] < lim) { s = s + 1; i = i + 1; }   // 10,20,30 pass, 40 stops => s=3, i=3
  if (arr[i] > lim) { s = s + 100; }               // 40 > 35 => s=103
  if (arr[0] > lim) { s = s + 1000; }              // 10 > 35 false
  return s;                                        // 103
}
int c2_f() {                     // bit 32: six operators, direction sensitive
  int arr[3];
  int s = 0;
  arr[0] = 5; arr[1] = 10; arr[2] = 15;
  if (arr[0] < 6) { s = s + 1; }
  if (arr[2] > 14) { s = s + 2; }
  if (arr[0] <= 5) { s = s + 4; }
  if (arr[2] >= 15) { s = s + 8; }
  if (arr[1] == 10) { s = s + 16; }
  if (arr[1] != 10) { s = s + 32; }
  if (arr[2] < 15) { s = s + 1000; }               // reversed: must stay false
  if (arr[0] > 5) { s = s + 1000; }                // reversed: must stay false
  if (arr[0] >= 6) { s = s + 1000; }               // reversed: must stay false
  if (arr[2] <= 14) { s = s + 1000; }              // reversed: must stay false
  return s;                                        // 31
}
int c2_g() {                     // bit 64: VALUE path (cmp + setcc) on the accumulator tier
  int arr[3];
  int n = 30;
  int s = 0;
  arr[0] = 10; arr[1] = 20; arr[2] = 30;
  s = s + (arr[0] < 20);                           // lv non-leaf, rv imm      => 1
  s = s + (arr[1] < n);                            // lv non-leaf, rv pool reg => 2
  s = s + (arr[2] <= 30);                          // <=                       => 3
  s = s + (arr[0] == 10);                          // ==                       => 4
  s = s + (arr[0] != 10);                          // !=  false                => 4
  s = s + (arr[2] > 5);                            // >                        => 5
  s = s + (arr[2] >= 31);                          // >=  false                => 5
  if (s == 5) { return 42; }
  return s;
}
int c2_h() {                     // bit 128: negative controls must keep the old path
  int x = 5;
  int y = 7;
  int z = 9;
  int m = 3;
  int k = 4;
  int *p = &x;
  int *pm = &m;
  int *pk = &k;
  int r = 0;
  if (p == 0) { r = r + 1; }                       // address class: 64-bit old path, false
  if (p != 0) { r = r + 2; }                       // address class: true => r=2
  if (x < (y + z)) { r = r + 4; }                  // rv non-leaf => old path: 5 < 16 => r=6
  if (z < (x * y)) { r = r + 8; }                  // rv non-leaf => old path: 9 < 35 => r=14
  if (x < y) { r = r + 16; }                       // slot vs pool reg => r=30
  if (m < k) { r = r + 32; }                       // both frame slots (mem,mem) => old path, r=62
  if (r == 62) { r = 42; }
  return r;
}
int main() {
  int r = 0;
  if (c2_a() == 33) { r = r | 1; }                 // main itself: lv = call (non-leaf), rv = imm
  if (c2_b() == 12) { r = r | 2; }
  if (c2_c() == 111003) { r = r | 4; }
  if (c2_d() == 12) { r = r | 8; }
  if (c2_e() == 103) { r = r | 16; }
  if (c2_f() == 31) { r = r | 32; }
  if (c2_g() == 42) { r = r | 64; }
  if (c2_h() == 42) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
