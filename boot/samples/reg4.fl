// reg4.fl — 2026-09-21（卡 T-20260921-232138 第四刀 A1）哨兵：**大帧**
//   `int big[64]` = 512 字节 ⇒ 帧 ≥ 128：序言走**逐页探测**路径、保存区偏移 ≥ 128 走 **disp32**。
// 期望 42（8 位全亮）。位定义：
//   位 1   大数组把帧顶起来之后，提升量仍写对读对
//   位 2   4 个提升量共存（池满档）
//   位 4   大数组**写满之后**再读提升量（保存区没被数组踩到）
//   位 8   提升量作累加器跨 64 轮循环（每轮一次寄存器读写）
//   位 16  提升量与数组求和结果混合运算
//   位 32  循环内用提升量当乘数（右值直寻址的寄存器形态）
//   位 64  数组最后一个元素读回正确（帧下限没被挪动）
//   位 128 全亮合并
int main() {
  int r = 0;
  int big[64];
  int a = 1;
  int b = 2;
  int c = 3;
  int d = 4;
  int i = 0;
  while (i < 64) { big[i] = i; i = i + 1; }
  a = a + 1; b = b + 2; c = c + 3; d = d + 4;
  if (a == 2) { r = r | 1; }
  if (b == 4) { r = r | 2; }
  if (c == 6) { r = r | 4; }
  if (d == 8) { r = r | 8; }
  int s = 0;
  int k = 0;
  while (k < 64) { s = s + big[k]; k = k + 1; }
  if (s == 2016) { r = r | 16; }
  a = a + s;
  if (a == 2018) { r = r | 32; }
  int t = 0;
  int q = 0;
  while (q < 64) { t = t + c; q = q + 1; }
  if (t == 384) { r = r | 64; }
  if (big[63] == 63) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
