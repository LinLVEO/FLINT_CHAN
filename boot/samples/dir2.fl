// dir2.fl — 2026-09-21（卡 T-20260921-215305 第二刀）：**比较 → 标志位**（条件处 cmp + 反面 jcc）
// 期望退出码 = 42（8 位全亮才 42）。六个比较算子 × if/else/while/for 四种条件位置：
//   位 1  `<`  if 真  ｜ 位 2  `>`  if 真  ｜ 位 4  `<=` if 真  ｜ 位 8  `>=` if 真
//   位 16 `!=` if 真  ｜ 位 32 `==` **假分支**（反面跳转必须跳出去）
//   位 64 while 条件（`i < 3` 走三轮） ｜ 位 128 for 条件（`j <= 3` 求和 = 6）
// 反向对照：`while (b < a)` 条件为假 —— 若反面条件码写反，循环体会被执行、r 被清零 ⇒ 掉位。
int main() {
  int a = 5;
  int b = 7;
  int r = 0;
  if (a < b) { r = r | 1; }
  if (b > a) { r = r | 2; }
  if (a <= b) { r = r | 4; }
  if (b >= a) { r = r | 8; }
  if (a != b) { r = r | 16; }
  if (a == b) { r = 0; } else { r = r | 32; }
  while (b < a) { r = 0; }
  int i = 0;
  while (i < 3) { i = i + 1; }
  if (i == 3) { r = r | 64; }
  int j = 0;
  int s = 0;
  for (j = 0; j <= 3; j = j + 1) { s = s + j; }
  if (s == 6) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
