// reg1.fl — 2026-09-21（卡 T-20260921-232138 第四刀 A1）：**局部 int 标量进寄存器**哨兵（基础形态）
// 期望 42（8 位全亮才 42；没全亮时退出码 = 未亮的位掩码，门外一眼看出缺哪位）。位定义：
//   位 1   循环累加（`x = x + j`：左值走寄存器、右值是**变量** ⇒ 走右值直寻址的寄存器形态）
//   位 2   循环计数（`j = j + 1`：右值是立即数 ⇒ 走累加器形态）
//   位 4   循环条件读（`j < lim`，两个局部量都在寄存器里）
//   位 8   函数级多变量共存（4 个局部量 + 链式改写，超过一档也要全对）
//   位 16  **跨调用存活**（提升的量在调用另一个函数之后仍正确 —— callee-saved 的意义）
//   位 32  提升量与**形参**混用（形参不提升，值必须仍对）
//   位 64  提升量作实参传给**不内联**的函数（两个形参 ⇒ 老路调用）
//   位 128 提升量与**数组元素**混用（数组不进候选，互不干扰）
int rg1_sum(int n) { return n + 1; }
int rg1_add2(int x, int y) { return x + y; }
int rg1_use(int n) { int t = 0; t = t + n; t = t + 1; return t; }

int main() {
  int r = 0;
  int x = 0;
  int j = 0;
  while (j < 10) { x = x + j; j = j + 1; }
  if (x == 45) { r = r | 1; }
  if (j == 10) { r = r | 2; }
  int k = 0;
  int lim = 7;
  while (k < lim) { k = k + 1; }
  if (k == 7) { r = r | 4; }
  int a = 1; int b = 2; int c = 3; int d = 4;
  a = a + b; c = c + d; a = a + c; b = b + d;
  if (a == 10) { if (b == 6) { if (c == 7) { if (d == 4) { r = r | 8; } } } }
  int m = 5;
  m = m + rg1_sum(3);
  if (m == 9) { r = r | 16; }
  if (rg1_use(41) == 42) { r = r | 32; }
  if (rg1_add2(m, 1) == 10) { r = r | 64; }
  int arr[4];
  arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
  int s = 0;
  int i = 0;
  while (i < 4) { s = s + arr[i]; i = i + 1; }
  if (s == 10) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
