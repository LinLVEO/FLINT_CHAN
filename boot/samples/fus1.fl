// fus1.fl — 2026-09-22（卡 T-20260921-232138 第四刀 A2）：**就地融合（左脊柱）**哨兵 —— 基础形态
// 期望 42（8 位全亮才 42；没全亮时退出码 = 未亮的位掩码，门外一眼看出缺哪位）。位定义：
//   位 1   `x = x + y`     —— 右值 = **已提升**的变量（本档最省的一条：`add rXd, rYd`）
//   位 2   `x = x + 7`     —— 右值 = 立即数（imm8 形态：`83 /0 ib`）
//   位 3   `x = x + 100000`—— 右值 = 立即数（超出 imm8 ⇒ `81 /0 id`）
//   位 4   `x = x & MASK`  —— 右值 = 立即数 + 位运算（组 1 的 /4）
//   位 5   `x = (x + y) & 0xFFFF` —— **两层左脊柱**（先加后掩，逐层就地）
//   位 6   `x = x + (y * 3 + z)`  —— 脊柱底 + **任意右值**（先求值到 eax 再 `add rXd, eax`）
//   位 7   `x = x - y`     —— 减法方向必须是 lv - rv（老路 xchg 后同向）
//   位 8   `x = x * y` / `x = x | y` / `x = x ^ y` —— 其余算子同族
int main() {
  int r = 0;
  int x = 1;
  int y = 2;
  int z = 3;

  x = x + y;
  if (x == 3) { r = r | 1; }

  x = x + 7;
  if (x == 10) { r = r | 2; }

  x = x + 100000;
  if (x == 100010) { r = r | 4; }

  x = x & 0xFFFF;
  if (x == 34474) { r = r | 8; }

  z = (z + y) & 0x000F;
  if (z == 5) { r = r | 16; }

  x = x + (y * 3 + z);
  if (x == 34485) { r = r | 32; }

  x = x - y;
  if (x == 34483) { r = r | 64; }

  int a = 3;
  int b = 4;
  a = a * b;
  if (a == 12) {
    a = a | 16;
    if (a == 28) {
      a = a ^ 12;
      if (a == 16) {
        b = b * 2;
        if (b == 8) { r = r | 128; }
      }
    }
  }

  if (r == 255) { r = 42; }
  return r;
}
