// acc1.fl -- 2026-09-22 (card T-20260922-025551, 5th knife B = IN-PLACE MEMORY-DESTINATION OPS)
//   sentinel for `a[idx] = a[idx] <op> v` folding into one `<op> [mem], v`.
//   Old path costs 10 instructions for that statement: the index is evaluated TWICE (once for the store
//   address, once inside the value's own read) plus push/pop plus separate load-op-store. Real flint
//   emits 3 (`add DWORD PTR [rbp+rax*8-0x28],ebx`). Measured: that single statement is 10 of the 19
//   instructions in boot's k2 loop body.
//   PRECONDITIONS this tier pins (each has its own cell below):
//     both index expressions must be STRUCTURALLY IDENTICAL (so they denote the same element) and the
//     index must be SIDE-EFFECT FREE -- the old path evaluates it twice, so folding would drop one
//     observable call; the array read must sit on the LEFT of the op; imul has no mem-dest form.
// Grid = form x target x PREMISE:
//   bit 1    `a[j & 3] = a[j & 3] + i` (the k2 shape; source = promoted local => register source)
//   bit 2    immediate sources: imm8 (+10), NEGATIVE immediate (+ -5), imm32 (+1000)
//   bit 4    the other four ops: `-` (direction sensitive), `&`, `|`, `^`
//   bit 8    index is an EXPRESSION and both sides match: `a[(i+1) & 3] = a[(i+1) & 3] + 100`
//   bit 16   source = UNPROMOTED slot (address taken => never promoted) => mov ecx,[rbp-off] then op
//   bit 32   big frame: array base past 128 bytes => the SIB disp32 branch
//   bit 64   negative controls (must fall back, values still correct):
//              different indices (`a[i] = a[i+1] + 1`), array read on the RIGHT (`a[0] = v + a[0]`),
//              imul (`a[1] = a[1] * 2` -- no mem-dest form)
//   bit 128  negative control: IMPURE index (function call). The old path calls it twice; folding
//              would call it ONCE -- the cell asserts the call count is still 2 (value 62, not 61).
// expected 42 (all 8 bits lit)

int g_calls = 0;
int acc_idx3() { g_calls = g_calls + 1; return 0; }

int acc_promoted(int n) {          // bit 1: the k2 shape
  int a[4];
  int i = 0;
  int j = 0;
  int s = 0;
  a[0] = 0; a[1] = 0; a[2] = 0; a[3] = 0;
  while (i < n) {
    a[j & 3] = a[j & 3] + i;
    j = j + 1;
    i = i + 1;
  }
  s = a[0] + a[1] + a[2] + a[3];   // a = 4,6,8,10
  return s;                        // 28
}
int acc_imm() {                    // bit 2: immediate sources (imm8 / negative imm8 / imm32)
  int a[4];
  int i = 0;
  int s = 0;
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  i = 0;
  while (i < 4) { a[i] = a[i] + 10; i = i + 1; }     // 11,12,13,14
  i = 0;
  while (i < 4) { a[i] = a[i] + -5; i = i + 1; }     // 6,7,8,9
  i = 0;
  while (i < 4) { a[i] = a[i] + 1000; i = i + 1; }   // 1006,1007,1008,1009
  s = a[0] + a[1] + a[2] + a[3];
  return s;                        // 4030
}
int acc_ops() {                    // bit 4: the other four ops
  int a[4];
  int i = 0;
  int s = 0;
  a[0] = 100; a[1] = 100; a[2] = 100; a[3] = 100;
  i = 0;
  while (i < 4) { a[i] = a[i] - 7; i = i + 1; }      // 93
  i = 0;
  while (i < 4) { a[i] = a[i] & 60; i = i + 1; }     // 93 & 60 = 28
  i = 0;
  while (i < 4) { a[i] = a[i] | 3; i = i + 1; }      // 31
  i = 0;
  while (i < 4) { a[i] = a[i] ^ 15; i = i + 1; }     // 16
  s = a[0] + a[1] + a[2] + a[3];
  return s;                        // 64
}
int acc_expr_idx() {               // bit 8: index is an expression, both sides identical
  int a[4];
  int i = 0;
  int s = 0;
  a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
  while (i < 4) {
    a[(i + 1) & 3] = a[(i + 1) & 3] + 100;   // +100 on indices 1,2,3,0
    i = i + 1;
  }
  s = a[0] + a[1] + a[2] + a[3];
  return s;                        // 500
}
int acc_slot_src() {               // bit 16: source = unpromoted slot
  int a[4];
  int v = 5;
  int *pv = &v;
  int i = 0;
  int s = 0;
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  *pv = 9;
  while (i < 4) { a[i] = a[i] + v; i = i + 1; }      // +9
  s = a[0] + a[1] + a[2] + a[3];
  return s;                        // 46
}
int acc_big() {                    // bit 32: big frame => SIB disp32
  int pad[30];
  int a[4];
  int i = 0;
  int s = 0;
  pad[0] = 1; pad[29] = 2;
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  while (i < 4) { a[i] = a[i] + 1; i = i + 1; }      // 2,3,4,5
  s = a[0] + a[1] + a[2] + a[3];                     // 14
  return s + pad[0] + pad[29];                       // 17
}
int acc_neg_fold() {               // bit 64: three negative controls, values must stay correct
  int a[4];
  int i = 0;
  int s = 0;
  int v = 7;
  a[0] = 10; a[1] = 20; a[2] = 30; a[3] = 40;
  i = 0;
  while (i < 3) { a[i] = a[i + 1] + 1; i = i + 1; }  // different indices: 21,31,41,40
  s = s + a[0] + a[1] + a[2] + a[3];                 // 133
  a[0] = v + a[0];                                   // read on the RIGHT: 28
  s = s + a[0];                                      // 161
  a[1] = a[1] * 2;                                   // imul: no mem-dest form: 62
  s = s + a[1];                                      // 223
  return s;                        // 223
}
int acc_neg_pure() {               // bit 128: impure index must keep BOTH evaluations
  int a[4];
  int s = 0;
  a[0] = 1; a[1] = 2; a[2] = 3; a[3] = 4;
  a[acc_idx3()] = a[acc_idx3()] + 5;   // a[0] = 6, and acc_idx3 must have been called twice
  s = a[0] * 10 + g_calls;
  return s;                        // 62 (61 would mean the call was folded away)
}
int main() {
  int r = 0;
  if (acc_promoted(8) == 28) { r = r | 1; }
  if (acc_imm() == 4030) { r = r | 2; }
  if (acc_ops() == 64) { r = r | 4; }
  if (acc_expr_idx() == 500) { r = r | 8; }
  if (acc_slot_src() == 46) { r = r | 16; }
  if (acc_big() == 17) { r = r | 32; }
  if (acc_neg_fold() == 223) { r = r | 64; }
  if (acc_neg_pure() == 62) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
