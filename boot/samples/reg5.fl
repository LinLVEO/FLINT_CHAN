// reg5.fl — 2026-09-21（卡 T-20260921-232138 第四刀 A1）哨兵：**块作用域槽复用**
//   解析器在块退出时会回退槽号 ⇒ 不同块里的变量**共用同一槽号**（发射端的查表只认槽号）。
//   判据：同槽的"邻居"若是数组/指针/取过址的变量，整槽都不许提升（排斥表），且值必须全对。
// 期望 42（8 位全亮）。位定义：
//   位 1   块内 int 局部量改写外层提升量
//   位 2   块内嵌块（两层）里的 int 局部量
//   位 4   只在一个块里用的小 int 局部量
//   位 8   **`&outer` 取址之后**（同槽邻居是指针）外层变量的值仍正确
//   位 16  块内的本地数组（不进候选）与同函数里的提升量共存
//   位 32  块内变量退出后，外层提升量的值不受影响
//   位 64  同槽号在不同块里被不同 int 变量反复使用（含外层累加）
//   位 128 三个块依次累加同一个外层提升量
int main() {
  int r = 0;
  int outer = 5;
  {
    int inner = 7;
    outer = outer + inner;
  }
  if (outer == 12) { r = r | 1; }
  {
    int t = 3;
    { int u = 4; t = t + u; }
    if (t == 7) { r = r | 2; }
  }
  {
    int a1 = 1;
    a1 = a1 + 1;
    if (a1 == 2) { r = r | 4; }
  }
  {
    int *pp = &outer;
    *pp = *pp + 1;
  }
  if (outer == 13) { r = r | 8; }
  {
    int arr[2];
    arr[0] = 5;
    arr[1] = 6;
    if (arr[0] + arr[1] == 11) { r = r | 16; }
  }
  {
    int c1 = 9;
    if (c1 == 9) { r = r | 32; }
  }
  int z = 0;
  {
    int z2 = 4;
    z = z + z2;
  }
  {
    int z3 = 6;
    z = z + z3;
  }
  if (z == 10) { r = r | 64; }
  int fin = 0;
  { int f1 = 1; fin = fin + f1; }
  { int f2 = 2; fin = fin + f2; }
  { int f3 = 3; fin = fin + f3; }
  if (fin == 6) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
