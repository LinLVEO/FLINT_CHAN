// reg3.fl — 2026-09-21（卡 T-20260921-232138 第四刀 A1）哨兵：**callee-saved 跨调用存活**（含嵌套）
// 期望 42（8 位全亮）。位定义：
//   位 1   调用一个"自己也提升两个局部量"的函数（保存/恢复要能嵌套）
//   位 2   两层嵌套调用（每层都提升）
//   位 4   循环内反复调用，提升量每轮都要存活
//   位 8   **递归**（每层帧各有自己的保存区）
//   位 16  **API 调用**之后提升量不变（Win64 非易失约定）
//   位 32  if / else 两个分支里都改写提升量（位置发射前定死，分支都要走到）
//   位 64  提升量跨 while 与 for 两种循环
//   位 128 调用点前有表达式副作用（右值直寻址档与调用混用）
api kernel32 int GetCurrentProcessId();

int rg3_inner(int n) {
  int a = n;
  int b = 2;
  a = a + b;
  b = a + 1;
  return a + b;
}
int rg3_outer(int n) {
  int a = n;
  a = a + rg3_inner(1);
  return a + rg3_inner(2);
}
int rg3_rec(int n) {
  int t = 0;
  if (n > 0) { t = rg3_rec(n - 1); }
  return t + n;
}

int main() {
  int r = 0;
  if (rg3_inner(1) == 7) { r = r | 1; }
  if (rg3_outer(4) == 20) { r = r | 2; }
  int v = 7;
  int i = 0;
  while (i < 5) { v = v + rg3_inner(i); i = i + 1; }
  if (v == 52) { r = r | 4; }
  if (rg3_rec(4) == 10) { r = r | 8; }
  int pv = 11;
  int pid = GetCurrentProcessId();
  pv = pv + 1;
  if (pv == 12) { if (pid > 0) { r = r | 16; } }
  int br = 0;
  int sel = 3;
  if (sel > 2) { br = br + 5; } else { br = br + 9; }
  if (br == 5) { r = r | 32; }
  int w1 = 0;
  int w2 = 0;
  int cnt = 0;
  while (w1 < 3) { w1 = w1 + 1; }
  for (w2 = 0; w2 < 3; w2 = w2 + 1) { cnt = cnt + 1; }
  if (w1 == 3) { if (w2 == 3) { if (cnt == 3) { r = r | 64; } } }
  int e = 1;
  int f = 2;
  e = e + f + rg3_inner(0);
  if (e == 8) { r = r | 128; }
  if (r == 255) { r = 42; }
  return r;
}
