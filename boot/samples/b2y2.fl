// b2y2.fl — B2z 流式 io（boot 侧差分）：20 项位掩码 = 1048575 → 退出码 42
include "io_lib.fl"
int main() {
  struct FileSt f;
  char w[8];
  char r[8];
  int m = 0;
  int i = 0;
  while (i < 5) { w[i] = 'A' + i; i = i + 1; }                                  // "ABCDE"
  f.h = 0;
  if (std::open(&f, "E:\\FLINT\\test\\tmp\\b2y2.tmp", 1) == 1) m |= 1;
  if (std::write(&f, w, 5) == 5) m |= 2;
  if (std::close(&f) == 1) m |= 4;
  if (std::open(&f, "E:\\FLINT\\test\\tmp\\b2y2.tmp", 0) == 1) m |= 8;
  if (std::tell(&f) == 0) m |= 16;
  if (std::read(&f, r, 3) == 3) m |= 32;
  if (r[0] == 'A' && r[2] == 'C') m |= 64;
  if (std::tell(&f) == 3) m |= 128;
  if (std::seek(&f, 0, 0) == 0) m |= 256;
  if (std::read(&f, r, 5) == 5) m |= 512;
  if (r[4] == 'E') m |= 1024;
  if (std::eof(&f) == 1) m |= 2048;
  if (std::read(&f, r, 5) == 0) m |= 4096;
  if (std::close(&f) == 1) m |= 8192;
  if (std::open(&f, "E:\\FLINT\\test\\tmp\\b2y2.tmp", 2) == 1) m |= 16384;
  w[0] = 'F'; w[1] = 'G';
  if (std::write(&f, w, 2) == 2) m |= 32768;
  if (std::close(&f) == 1) m |= 65536;
  if (std::file_size("E:\\FLINT\\test\\tmp\\b2y2.tmp") == 7) m |= 131072;
  f.h = 0;
  if (std::read(&f, r, 5) == -1) m |= 262144;
  if (std::close(&f) == 0) m |= 524288;
  if (m != 1048575) return 1;
  return 42;
}
