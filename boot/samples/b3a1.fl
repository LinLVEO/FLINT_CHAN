// b3a1 — B3a 同名遮蔽：块内可声明与外层同名的变量（内层赋值不影响外层；多层嵌套）
// 对齐真 flint 实测：嵌套块遮蔽允许 / 同作用域重复声明报错 / 形参不可被遮蔽
int main() {
  int r = 0;
  int x = 1;
  {
    int x = 10;
    x = x + 5;
    if (x == 15) { r |= 1; }
    {
      int x = 100;
      x = x + 1;
      if (x == 101) { r |= 2; }
    }
    if (x == 15) { r |= 4; }          // 内层块退出后回到本层
  }
  if (x == 1) { r |= 8; }             // 外层完全没被影响
  char c = 65;
  {
    int c = 7;                        // 同名但类型不同（char → int）
    if (c == 7) { r |= 16; }
  }
  if (c == 65) { r |= 32; }
  if (r != 63) return 1;
  return 42;
}
