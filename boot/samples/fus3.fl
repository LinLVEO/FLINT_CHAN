// fus3.fl — 2026-09-22（卡 T-20260921-232138 第四刀 A2）：**发射器能力表**哨兵
// 来历：A2 第一版把「imul + 立即数不进本档」这条排除项写在"外层"分支里，而**脊柱底那一层走早返回**
//   ⇒ `x = x * 立即数` 被判成"已融合"却一个字节都没发 = **整条语句被静默吞掉**。
//   样本门 / 1009 回归 / 差分门 / 等价门**全绿**，只有真实应用冒烟门抓到（浮窗 cfg_pow2 的
//   `m = m * 2` 被算空 ⇒ config 的 sw 位掩码算出 12 而不是 8063）。
// 本样本按「发射形态 × 靶子」逐格钉住**每一个发射器**，尤其**少候选函数**（局部量 ≤ 4 ⇒ 目标必定被提升）。
// 期望 42（8 位全亮才 42）。位定义：
//   位 1   `m = m * 2` 在**只有 2 个局部量**的循环函数里 ⇒ imul+imm 必须**退老路**（本样本的正题）
//   位 2   `x = x * y`（imul + 池寄存器 ⇒ em_alu_rr 的 imul 形态）
//   位 3   `x = x * n`（imul + **未提升**的形参槽 ⇒ em_alu_rslot 的 imul 形态）
//   位 4   `x = (x + y) * 2`（**外层**是 imul+imm ⇒ 整条退老路）
//   位 5   `x = (x * y) + 1`（脊柱底 imul+寄存器 ＋ 外层 +imm ⇒ 两层都融合）
//   位 6   `s = s + 5` 少候选函数的加法（融合生效且累积正确）
//   位 7   **5 个局部量**（超出池 4 ⇒ 有一个不提升）链式改写，值必须全对
//   位 8   脊柱底 + **右值含本槽**（`x = x + (x * 2)`：右值里的 x 必须是**原值** 3+6=9）
int f3_a(int n) {                       // 位 1：cfg_pow2 的同一形状（2 个局部量）
  int m = 1;
  int i = 0;
  while (i < n) { m = m * 2; i = i + 1; }
  return m;
}
int f3_b(int n) {                       // 位 2
  int y = 3;
  int x = 2;
  int i = 0;
  while (i < n) { x = x * y; i = i + 1; }
  return x;
}
int f3_c(int n) {                       // 位 3
  int x = 1;
  int i = 0;
  while (i < 3) { x = x * n; i = i + 1; }
  return x;
}
int f3_d() {                            // 位 4
  int x = 3;
  int y = 5;
  x = (x + y) * 2;
  return x;
}
int f3_e() {                            // 位 5
  int x = 3;
  int y = 4;
  x = (x * y) + 1;
  return x;
}
int f3_f(int n) {                       // 位 6
  int s = 0;
  int i = 0;
  while (i < n) { s = s + 5; i = i + 1; }
  return s;
}
int f3_g() {                            // 位 7：5 个局部量 > 池 4
  int a = 1;
  int b = 2;
  int c = 3;
  int d = 4;
  int e = 5;
  a = a + b;
  b = b + c;
  c = c + d;
  d = d + e;
  e = e + a;
  return a * 1000 + b * 100 + c * 10 + d + e;   // 3,5,7,9,8 → 3587
}
int f3_h() {                            // 位 8：右值含本槽（要的是**原值**）
  int x = 3;
  x = x + (x * 2);
  return x;
}
int main() {
  int r = 0;
  if (f3_a(4) == 16) { r = r | 1; }     // 2^4
  if (f3_b(3) == 54) { r = r | 2; }     // 2×3^3
  if (f3_c(2) == 8) { r = r | 4; }      // 1×2^3
  if (f3_d() == 16) { r = r | 8; }      // (3+5)×2
  if (f3_e() == 13) { r = r | 16; }     // 3×4+1
  if (f3_f(4) == 20) { r = r | 32; }    // 5×4
  if (f3_g() == 3587) { r = r | 64; }
  if (f3_h() == 9) { r = r | 128; }     // 3 + (3×2)
  if (r == 255) { r = 42; }
  return r;
}
