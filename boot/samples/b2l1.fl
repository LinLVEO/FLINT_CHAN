// b2l1.fl — B2l：二元取模 %（C 语义：余数符号随被除数）
// 退出码 42 = 全部断言通过
int main() {
  if (100 % 7 != 2) { return 1; }
  if (100 / 7 != 14) { return 2; }
  if (0 - 7 % 3 != 0 - 1) { return 3; }        // -7 % 3 = -1（向零截断）
  if (7 % (0 - 3) != 1) { return 4; }          // 7 % -3 = 1
  if (1234 % 100 != 34) { return 5; }
  if ((10 + 3) % 5 != 3) { return 6; }         // 括号与优先级
  int a = 97;
  int b = 10;
  if (a % b != 7) { return 7; }
  if (a % b % 4 != 3) { return 8; }            // 左结合
  if (a % (b % 7) != 1) { return 9; }          // 嵌套
  if (a * b % 7 != 4) { return 10; }           // 97*10=970, 970-138*7=4
  return 42;
}
