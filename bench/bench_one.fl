// bench_one.fl —— FLINT 侧"单核"宿主（一次只量一个核；轮数来自 bench_counts.fl）
// 立卡：T-20260919-010437（周期0「尺子与账本」）
// 编译：E:\FLINT-lab\flint.exe bench_one.fl -o bench_one.exe
// 运行（工作目录须在 bench\）：bench_one.exe <核号 1|2|3> <测几遍>
//
// 为什么改成单核（2026-09-19）：三核串在一次运行里跑，累计时间无法分辨"每核各花了多久"，
// 且判据"该核真跑了 N 轮"拿不到独立证据。单核 + 时间下界判据之后，每一项都能单独撒谎或不撒谎。
//
// 输出（与 对账2.ps1 / bench_one.c 同族）：
//   impl=flint kernel=<k> n=<轮数> iters=<遍数> qpf=<频率> qpcraw=<背靠背 QPC 差>
//   result=<核的返回值> ticks=<累计时钟刻度>
api kernel32 int QueryPerformanceCounter(int);
api kernel32 int QueryPerformanceFrequency(int);
api kernel32 ptr GetCommandLineA();

struct QPC { int lo; int hi; }

include "bench_core.fl"
include "bench_counts.fl"
include "io_lib.fl"

// 从命令行取两个十进制整数（第 1 个 = 核号，第 2 个 = 测几遍）
int bo_arg(int want) {
  char *cmd = GetCommandLineA();
  int i = 0;
  int idx = 0;
  int acc = 0;
  int got = 0;
  while (cmd[i] != 0) {
    int c = cmd[i];
    if (c >= 48) {
      if (c <= 57) {
        acc = acc * 10 + (c - 48);
        got = 1;
      } else {
        if (got == 1) { if (idx == want) { return acc; } idx = idx + 1; acc = 0; got = 0; }
      }
    } else {
      if (got == 1) { if (idx == want) { return acc; } idx = idx + 1; acc = 0; got = 0; }
    }
    i = i + 1;
  }
  if (got == 1) { if (idx == want) { return acc; } }
  return 0;
}

int main() {
  int k = bo_arg(0);
  int iters = bo_arg(1);
  if (iters <= 0) { iters = 3; }
  int n = BC_N;

  struct QPC qf; struct QPC qa; struct QPC qb;
  qf.lo = 0; qf.hi = 0; qa.lo = 0; qa.hi = 0; qb.lo = 0; qb.hi = 0;
  QueryPerformanceFrequency(&qf);
  QueryPerformanceCounter(&qa);
  QueryPerformanceCounter(&qb);
  int qraw = qb.lo - qa.lo;
  if (qraw < 0) { qraw = 0 - qraw; }

  struct QPC s; struct QPC e;
  int r = 0;
  int ticks = 0;
  int acc = 0;
  int rep = 0;
  while (rep < iters) {
    s.lo = 0; s.hi = 0; e.lo = 0; e.hi = 0;
    QueryPerformanceCounter(&s);
    if (k == 1) { r = bc_k1(n); }
    if (k == 2) { r = bc_k2(n); }
    if (k == 3) { r = bc_k3(n); }
    QueryPerformanceCounter(&e);
    ticks = ticks + (e.lo - s.lo);
    acc = acc + r;
    rep = rep + 1;
  }

  print(["impl=flint kernel=", k, " n=", n, " iters=", iters, " qpf=", qf.lo, " qpcraw=", qraw, "\n"]);
  print(["result=", r, " ticks=", ticks, " absorb=", acc, "\n"]);
  return r & 255;
}
