// probe_k2.fl —— 诊断：bc_k2 在 FLINT 侧到底算了什么（逐步打印 i/j/s）
// 立卡：T-20260919-010437（周期0）—— 基准三方对账时 flint 侧 k2=525408 vs 权威 1500000，
// 本文件只做一件事：把"每轮状态"打出来，与手算/Node 对帐，定位是**结果算错**还是**判据口径错**。
int main() {
  int a[4];
  int i = 0;
  int j = 0;
  int s = 0;
  a[0] = 0; a[1] = 0; a[2] = 0; a[3] = 0;
  while (i < 10) {
    a[j & 3] = a[j & 3] + i;
    s = s + a[(j + 1) & 3];
    print(["i=", i, " j=", j, " s=", s, " a0=", a[0], " a1=", a[1], " a2=", a[2], " a3=", a[3], "\n"]);
    j = j + 1;
    i = i + 1;
  }
  print(["final s=", s, "\n"]);
  return s & 7;
}
