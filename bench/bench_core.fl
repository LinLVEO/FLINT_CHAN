// bench_core.fl —— 不可折叠基准组（FLINT 侧；与 bench_core.c 形状逐字对应）
// 立卡：T-20260919-010437（周期0「尺子与账本」）
//
// 为什么需要它：FLINT明细.md §4.10 实测——gcc -O2 把玩具循环整体折叠，
// "那一侧一圈都没跑"，跨编译器倍数因此报不了（量到的是空气）。
// 本组三个核的设计目标 = **两侧都必须真跑**：
//   k1 依赖链    每轮值依赖上一轮（gcc 只能折常数、折不掉依赖），最终按 n 取模消费
//   k2 数组环走  下标是数据（j & 3），常量折叠折不出"每轮从内存读"
//   k3 函数调用  每轮一次真实 call（n 是运行时参数 → 折不出调用次数）
// 每条核最后都用 (n - 1) 收尾 ⇒ 结果依赖运行时参数、**编译器无法预知**。
//
// 语言边界内写法（见 记忆.md「⛔ FLINT 语言边界表」）：
//   函数参数最多 4 个 / 数组在函数内声明 / char 数组不能整体初始化 /
//   变量与数组元素是 8 字节槽 / int 字面量直接写正数、负数走一元负号 /
//   不用 % 与 /（FLINT 侧除法是软件实现，会污染被测形状）→ 用 & 3、& 7 取低位。
//
// 判据（三份实现必须逐位一致）：bench_core.fl / bench_core.c / bench_core.js

int bc_inc(int x) { return x + 3; }

// k1：依赖链 —— 值依赖前一轮，收尾按 n 取模
int bc_k1(int n) {
  int x = 0;
  int j = 0;
  while (j < n) {
    x = (x + j) & 0x3FFFFFFF;
    j = j + 1;
  }
  return x & (n - 1);
}

// k2：数组环走 —— 下标由数据决定（& 3），每轮真读内存
int bc_k2(int n) {
  int a[4];
  int i = 0;
  int j = 0;
  int s = 0;
  a[0] = 0; a[1] = 0; a[2] = 0; a[3] = 0;
  while (i < n) {
    a[j & 3] = a[j & 3] + i;
    s = s + a[(j + 1) & 3];
    j = j + 1;
    i = i + 1;
  }
  return s & (n - 1);
}

// k3：每轮一次真实函数调用
int bc_k3(int n) {
  int a = 0;
  int i = 0;
  while (i < n) {
    a = bc_inc(a + i);
    i = i + 1;
  }
  return a & (n - 1);
}
