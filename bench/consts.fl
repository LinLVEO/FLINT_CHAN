// consts.fl —— 基准运行的编译期常量（"结果对账"与"真跑了多少轮"共用一份来源）
// 立卡：T-20260919-010437（周期0「尺子与账本」）
//
// ⚠️ ITERS 与 bench_flint.dat 的 n 不是同一件事：
//    n     = 每核**轮数**（工作量）—— 由 对账.ps1 写进二进制文件，改它不必重编
//    ITERS = 每核**测几遍**（重复次数）—— 改它要重编（与 C 侧 iters 参数同名同义）
//
// ⚠️ 大整数请分块写（F.1 实测：tokenize 对超长字面量有坑，安全写法 20*1000*1000）

// ⚠️ ITERS 取 10 而不是 3：QPC 两次背靠背调用相差 ~10~30 个刻度（100ns 级的定时器粒度），
//    重复次数太少时"量化误差"会挤进单轮耗时（本组单核耗时只有几十 µs）。ITERS×轮数 越大越稳。

int ITERS = 10;

// 配置读失败/非法时的兜底轮数（**必须是 >= 1024 的 2 的幂**；绝不静默跑 0 轮）
// v1.4.28（B1-5）：这里原来写的是 `20 * 1000 * 100` —— 全局初值只吃**一个字面量**，那个乘法
//   **从来没被求值过**，兜底值一直是 **20**（远低于本行要求的 1024，也低于 `对账.ps1` 的 N=2097152）。
//   尾巴现在改成默认档硬错 ⇒ 写成一个字面量，取原表达式的**字面求值结果 2000000**。
//   ⚠️ 与本行"必须是 2 的幂"这句话仍不一致（2000000 不是 2 的幂）—— 这是**改动前就有的矛盾**，
//   本刀只负责把被静默吞掉的乘法补回来，不擅自改数值口径（要不要改成 2097152 = 2^21 归所有者）。
int BF_FALLBACK = 2000000;
